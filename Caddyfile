# Caddyfile for sbomify
# Reverse proxy with automatic HTTPS/TLS via Let's Encrypt
{
	admin {$CADDY_ADMIN:off}

	# Email for Let's Encrypt notifications (REQUIRED for production)
	# Set ACME_EMAIL environment variable
	email {$ACME_EMAIL:admin@example.com}

	# Use Let's Encrypt production by default
	# Set ACME_CA to staging for testing: https://acme-staging-v02.api.letsencrypt.org/directory
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}

	# Docker network IP ranges included below.
	# For Cloudflare, get latest IP ranges from https://www.cloudflare.com/ips/
	# and add below to the servers block if using CF
	servers {
		# Trusted proxies include:
		# - Private IP ranges (Docker bridge, local network)
		# - Cloudflare IPv4 ranges (https://www.cloudflare.com/ips/)
		trusted_proxies static 172.16.0.0/12 10.0.0.0/8 192.168.0.0/16 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		trusted_proxies_strict
		# Resolves {client_ip} to the origin address. Consulted ONLY for
		# requests whose direct peer is in the list above, so a client that
		# reaches this edge without going through Cloudflare cannot set its own
		# {client_ip} — Caddy falls back to the peer it actually sees.
		# Cf-Connecting-Ip is first because Cloudflare overwrites it on every
		# request it proxies, so unlike X-Forwarded-For it is a single address
		# that a client cannot prepend to.
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For X-Real-IP
	}

	# On-demand TLS configuration
	# Ask Django backend which domains are allowed to get certificates
	on_demand_tls {
		ask http://sbomify-backend:8000/api/v1/internal/domains
	}
}

# Snippet: Common proxy configuration
(proxy_common) {
	# Caddy readiness check for Docker
	@health {
		path /health
	}
	handle @health {
		log_skip
		respond "OK" 200
	}

	@django_health {
		path /UuPha8mu/*
	}
	handle @django_health {
		log_skip
		reverse_proxy sbomify-backend:8000 {
			header_up X-Real-IP {client_ip}
			header_up Host {host}
			header_down -Server
		}
	}

	# Internal API endpoints - block external access
	@internal_api {
		path /api/v1/internal/*
	}
	handle @internal_api {
		@allowed_internal {
			client_ip 172.16.0.0/12 10.0.0.0/8 192.168.0.0/16
		}
		handle @allowed_internal {
			reverse_proxy sbomify-backend:8000 {
				header_up X-Real-IP {client_ip}
				header_up Host {host}
				header_down -Server
			}
		}
		handle {
			respond "Forbidden" 403
		}
	}

	# Main reverse proxy to Django backend
	# Note: Caddy automatically handles WebSocket upgrades (ws/wss) via reverse_proxy
	reverse_proxy sbomify-backend:8000 {
		# Headers.
		#
		# {client_ip}, never {remote_host}: behind Cloudflare the peer address
		# is a Cloudflare edge node, so {remote_host} collapsed every visitor
		# onto a handful of addresses. Django keys its per-IP rate limits and
		# its audit fields on X-Real-IP (core.utils.get_client_ip), so that made
		# the anonymous budget a shared pool one scanner could drain for
		# everyone, and wrote the CDN's address into the audit trail.
		#
		# header_up REPLACES the header, so a client-supplied X-Real-IP never
		# survives this hop. That is what makes Caddy the only resolver of the
		# origin address and why Django must keep reading X-Real-IP alone: raw
		# Cf-Connecting-Ip is forwarded upstream untouched and is spoofable by
		# anything that reaches this edge directly.
		header_up X-Real-IP {client_ip}
		header_up Host {host}
		header_down -Server

		# Timeouts (0 = no timeout, required for WebSocket connections)
		transport http {
			dial_timeout 10s
			response_header_timeout 30s
			read_timeout 0
			write_timeout 0
		}

		# Active health checks
		health_uri /UuPha8mu/
		health_interval 10s
		health_timeout 3s
		health_status 200

		# Aggressive retry logic for resilience
		lb_try_duration 60s
		lb_try_interval 100ms
		fail_duration 30s
		max_fails 5
	}

	# Compression
	encode gzip zstd
}

# HTTPS - All domains (main app + custom domains)
# Uses on-demand TLS - asks backend which domains are allowed
https:// {
	tls {
		on_demand
	}

	log {
		output stdout
		format console
		level {$LOG_LEVEL:INFO}
	}

	# Security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	import proxy_common
}

# HTTP (port 80) - Handle both Cloudflare Tunnel and direct traffic
:80 {
	log {
		output stdout
		format console
		level {$LOG_LEVEL:INFO}
	}

	# Health check endpoints - serve directly without HTTPS redirect
	# This prevents TLS certificate requests for internal health checks
	@health path /health
	handle @health {
		log_skip
		respond "OK" 200
	}

	@django_health path /UuPha8mu/*
	handle @django_health {
		log_skip
		reverse_proxy sbomify-backend:8000 {
			header_up X-Real-IP {client_ip}
			header_up Host {host}
			header_down -Server
		}
	}

	# Serve directly if already behind HTTPS proxy (Cloudflare Tunnel)
	@behind_https_proxy header X-Forwarded-Proto https
	handle @behind_https_proxy {
		header {
			X-Frame-Options "SAMEORIGIN"
			X-Content-Type-Options "nosniff"
			X-XSS-Protection "1; mode=block"
			Referrer-Policy "strict-origin-when-cross-origin"
			Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
			-Server
		}

		# Internal API endpoints - block external access
		@internal_api path /api/v1/internal/*
		handle @internal_api {
			@allowed_internal client_ip 172.16.0.0/12 10.0.0.0/8 192.168.0.0/16
			handle @allowed_internal {
				reverse_proxy sbomify-backend:8000 {
					header_up X-Real-IP {client_ip}
					header_up Host {host}
					header_down -Server
				}
			}
			handle {
				respond "Forbidden" 403
			}
		}

		# Main reverse proxy to Django backend
		# Note: Caddy automatically handles WebSocket upgrades (ws/wss) via reverse_proxy
		reverse_proxy sbomify-backend:8000 {
			header_up X-Real-IP {client_ip}
			header_up Host {host}
			header_down -Server
			# Timeouts (0 = no timeout, required for WebSocket connections)
			transport http {
				dial_timeout 10s
				response_header_timeout 30s
				read_timeout 0
				write_timeout 0
			}
			health_uri /UuPha8mu/
			health_interval 10s
			health_timeout 3s
			health_status 200
			lb_try_duration 60s
			lb_try_interval 100ms
			fail_duration 30s
			max_fails 5
		}

		encode gzip zstd
	}

	# Otherwise redirect to HTTPS (for public domain names)
	handle {
		redir https://{host}{uri} permanent
	}
}
