{
  "name": "sbomify-frontend-components",
  "private": true,
  "version": "26.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "copy-fontawesome": "cp -r node_modules/@fortawesome/fontawesome-free/webfonts sbomify/static/ && cp node_modules/@fortawesome/fontawesome-free/css/all.min.css sbomify/static/css/fontawesome.min.css",
    "copy-htmx-ext": "mkdir -p sbomify/static/js && cp node_modules/htmx-ext-alpine-morph/dist/alpine-morph.min.js sbomify/static/js/htmx-ext-alpine-morph.min.js",
    "copy-deps": "bun run copy-fontawesome && bun run copy-htmx-ext",
    "build": "bun run copy-deps && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"sbomify/apps/core/js/**/*.{js,ts}\" \"sbomify/apps/sboms/js/**/*.{js,ts}\" \"sbomify/apps/teams/js/**/*.{js,ts}\" \"sbomify/apps/billing/js/**/*.{js,ts}\" \"sbomify/apps/documents/js/**/*.{js,ts}\" \"sbomify/apps/vulnerability_scanning/js/**/*.{js,ts}\" \"sbomify/apps/plugins/js/**/*.{js,ts}\" \"*.{js,ts}\"",
    "lint-fix": "eslint \"sbomify/apps/core/js/**/*.{js,ts}\" \"sbomify/apps/sboms/js/**/*.{js,ts}\" \"sbomify/apps/teams/js/**/*.{js,ts}\" \"sbomify/apps/billing/js/**/*.{js,ts}\" \"sbomify/apps/documents/js/**/*.{js,ts}\" \"sbomify/apps/vulnerability_scanning/js/**/*.{js,ts}\" \"sbomify/apps/plugins/js/**/*.{js,ts}\" \"*.{js,ts}\" --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,html}\" --ignore-path .gitignore",
    "type-check": "tsc --noEmit --skipLibCheck -p tsconfig.app.json",
    "test": "bun test",
    "test:run": "bun test"
  },
  "dependencies": {
    "@alpinejs/anchor": "^3.16.3",
    "@alpinejs/collapse": "^3.16.3",
    "@alpinejs/focus": "^3.16.3",
    "@alpinejs/intersect": "^3.16.3",
    "@alpinejs/mask": "^3.16.3",
    "@alpinejs/morph": "^3.16.3",
    "@alpinejs/persist": "^3.16.3",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@mdi/font": "^7.4.47",
    "@sentry/browser": "^10.71.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.3.0",
    "alpinejs": "3.16.3",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "chart.js": "^4.5.1",
    "clipboard": "^2.0.11",
    "dompurify": "^3.4.13",
    "dotenv": "^17.4.2",
    "highlight.js": "^11.12.0",
    "htmx-ext-alpine-morph": "^2.0.2",
    "js-cookie": "^3.0.8",
    "jsbarcode": "^3.12.3",
    "license-expressions": "^0.8.0",
    "marked": "^18.0.11",
    "postcss": "^8.5.26",
    "signature_pad": "^5.1.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "7.29.7",
    "esbuild": "0.28.1",
    "lodash": "4.18.1",
    "picomatch": "4.0.4",
    "fast-uri": "3.1.5",
    "flatted": "3.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/alpinejs": "^3.13.11",
    "@types/marked": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "markdownlint-cli": "0.49.1",
    "prettier": "^3.9.6"
  }
}
