{% extends "core/base.html.j2" %}
{% block title %}Payment Cancelled{% endblock %}
{% block content %}
    <main id="main-content" class="max-w-3xl mx-auto px-4 py-8">
        <c-layout.frame>
        <c-layout.page-header title="Payment cancelled" subtitle="No charges were made to your account." />
        <c-cards.card>
        <div class="flex flex-col gap-5">
            <c-typography.description>If you experienced any issues during checkout, please contact our support team for assistance.</c-typography.description>
            <div class="flex flex-wrap gap-3">
                <c-buttons.secondary href="{% url 'core:dashboard' %}">Back to dashboard</c-buttons.secondary>
                <c-buttons.primary @click="window.history.back()">Try again</c-buttons.primary>
            </div>
        </div>
        </c-cards.card>
        </c-layout.frame>
    </main>
{% endblock %}
