{% extends "core/base.html.j2" %}
{% block title %}Payment Successful{% endblock %}
{% block content %}
    <main id="main-content" class="max-w-3xl mx-auto px-4 py-8">
        <c-layout.frame>
        <c-layout.page-header title="Payment successful" subtitle="Thank you for your purchase." />
        <c-cards.card>
        <div class="flex flex-col gap-5">
            <c-feedback.alert variant="success">Your subscription is now active and you can start using all the features of your plan.</c-feedback.alert>
            <c-typography.description>You will receive a confirmation email shortly with your receipt and subscription details.</c-typography.description>
            <c-buttons.primary href="{% url 'core:dashboard' %}" class="self-start">Go to dashboard</c-buttons.primary>
        </div>
        </c-cards.card>
        </c-layout.frame>
    </main>
{% endblock %}
