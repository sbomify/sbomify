{% extends "core/emails/base.html.j2" %}
{% block title %}Your sbomify trial ends in {{ days_remaining }} day{{ days_remaining|pluralize }}{% endblock %}
{% block content %}
    <h1>Your trial ends soon</h1>
    <p>Hi {{ user_name }},</p>
    <p>
        Your trial for <strong>{{ team_name }}</strong> ends in <strong>{{ days_remaining }} days</strong>.
        Upgrade to a paid plan to keep access to all features.
    </p>
    <p style="text-align: center; margin: 32px 0;">
        <a href="{{ upgrade_url }}" class="button">Upgrade now</a>
    </p>
{% endblock %}
