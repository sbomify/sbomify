{% extends "core/dashboard_base.htmx.j2" %}
{% load teams %}
{% block title %}Plans and billing · sbomify{% endblock %}
{% block content %}
    {{ plan_selection_data|json_script:"plan-selection-data" }}
    <c-layout.frame x-data="planSelection(window.parseJsonScript('plan-selection-data'))">
    <c-layout.page-header title="Plans and billing" subtitle="Choose a plan for {{ team.name|workspace_display }}.">
    <c-buttons.secondary size="sm" href="{% url 'teams:team_settings' team_key %}"><i class="fas fa-gear" aria-hidden="true"></i>Workspace settings</c-buttons.secondary>
    </c-layout.page-header>
    <c-feedback.alert variant="warning" icon="fas fa-calendar" x-show="cancelAtPeriodEnd" x-cloak>
    Your plan ends on <span x-text="formatDate(currentPeriodEnd)"></span>. Manage your subscription to change this.
    </c-feedback.alert>
    <c-feedback.alert icon="fas fa-calendar" x-show="!cancelAtPeriodEnd && currentPeriodEnd && currentPlan !== 'community'" x-cloak>
    Your plan renews on <span x-text="formatDate(currentPeriodEnd)"></span>.
    </c-feedback.alert>
    <section class="flex flex-col gap-3" aria-label="Current usage">
        <c-layout.section-header title="Current usage" subtitle="Resources in this workspace." level="2" />
        <div class="grid grid-cols-3 gap-3">
            <c-layout.stat-card compact value="{{ usage.users }}" label="Members" accent="muted" />
            <c-layout.stat-card compact value="{{ usage.products }}" label="Products" accent="muted" />
            <c-layout.stat-card compact value="{{ usage.components }}" label="Components" accent="muted" />
        </div>
    </section>
    <section class="flex flex-col gap-4" aria-label="Plans">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <c-layout.section-header title="Compare plans" subtitle="Choose the access and support your workspace needs." level="2" />
            <div class="flex flex-wrap items-center gap-3">
                <c-navigation.segmented aria-label="Billing period">
                <c-navigation.segment ::data-active="billingPeriod === 'monthly'" ::aria-pressed="billingPeriod === 'monthly'" @click="billingPeriod = 'monthly'">Monthly</c-navigation.segment>
                <c-navigation.segment ::data-active="billingPeriod === 'annual'" ::aria-pressed="billingPeriod === 'annual'" @click="billingPeriod = 'annual'">Annual</c-navigation.segment>
                </c-navigation.segmented>
                {% if annual_savings_percent %}
                    <c-badges.success size="sm">Save {{ annual_savings_percent|floatformat:0 }}% annually</c-badges.success>
                {% endif %}
            </div>
        </div>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
            {% for plan in plans %}<c-billing.plan-card :plan="plan" />{% endfor %}
        </div>
    </section>
    <section class="flex flex-col gap-3" aria-label="Plan questions">
        <c-layout.section-header title="Plan questions" subtitle="Help with trials, upgrades and billing." level="2" />
        <c-cards.card flush>
        <c-navigation.accordion>
        <template x-for="faq in faqs" :key="faq.id">
            <c-navigation.accordion-item state="faq.expanded" @click="toggleFAQ(faq.id)">
            <c-slot name="label"><span x-text="faq.question"></span></c-slot>
            <span x-text="faq.answer"></span>
            </c-navigation.accordion-item>
        </template>
        </c-navigation.accordion>
        </c-cards.card>
    </section>
    </c-layout.frame>
{% endblock %}
{% block scripts %}
    {{ block.super }}
    {% load django_vite %}
    {% vite_asset 'sbomify/apps/billing/js/main.ts' %}
{% endblock %}
