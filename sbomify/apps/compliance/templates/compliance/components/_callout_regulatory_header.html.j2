{% comment %}
    Regulatory callout header — icon chip + title + legal-basis pill + description.
    Shared by Step 1 (Harmonised standard, Support period) and Step 3 (per-finding
    Justification). Use inside the library callout wrapper:

        <div role="status" aria-live="polite" class="tw-callout tw-callout-warning">
            {% include "compliance/components/_callout_regulatory_header.html.j2"
                with icon="fa-shield-halved" title="Harmonised standard required"
                pill_label="CRA Art 32(2)" pill_href=cra_oj_url description="…" %}
            <div class="tw-callout-body">… checkbox, textarea+helper, etc. …</div>
        </div>
{% endcomment %}
<div class="tw-callout-header">
    <span class="tw-icon-chip tw-icon-chip-warning tw-icon-chip-circle"
          aria-hidden="true">
        <i class="fas {{ icon }}"></i>
    </span>
    <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
            <span class="font-semibold text-sm text-text">{{ title }}</span>
            <a href="{{ pill_href }}"
               target="_blank"
               rel="noopener noreferrer"
               class="tw-badge-warning tw-badge-sm hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-warning focus-visible:ring-offset-2 focus-visible:ring-offset-surface">
                {{ pill_label }}
                <i class="fas fa-up-right-from-square text-[9px] opacity-70 ml-1"
                   aria-hidden="true"></i>
            </a>
        </div>
        <p class="text-xs text-text-muted mt-1 m-0 leading-snug">{{ description }}</p>
    </div>
</div>
