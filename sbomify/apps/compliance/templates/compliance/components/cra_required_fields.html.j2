<div x-show="missingFields.length" x-cloak>
    <c-feedback.alert variant="info" title="Before you continue">
    <c-slot name="body">
    <ul class="flex flex-col gap-2" aria-label="Required information">
        <template x-for="field in missingFields" :key="field.target">
            <li>
                <c-buttons.secondary size="sm" @click="focusRequiredField(field.target)"><span class="whitespace-normal text-left" x-text="field.message"></span></c-buttons.secondary>
            </li>
        </template>
    </ul>
    </c-slot>
    </c-feedback.alert>
</div>
