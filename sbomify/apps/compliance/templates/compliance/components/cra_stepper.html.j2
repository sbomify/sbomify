{# CRA Wizard Step Progress Bar #}
{# Expects: step (int), step_names (dict), completed_steps (list), assessment_id (str) #}
<nav aria-label="Wizard progress" class="mb-8">
    <div class="tw-stepper">
        {% for step_num, step_label in step_names.items %}
            {% if step_num in completed_steps and step_num != step %}
                <a href="{% url 'compliance:cra_step' assessment_id=assessment_id step=step_num %}"
                   class="tw-stepper-item">
                    <span class="tw-stepper-circle tw-stepper-circle-completed">
                        <i class="fas fa-check text-xs" aria-hidden="true"></i>
                    </span>
                    <span class="tw-stepper-label hidden sm:inline">{{ step_label }}</span>
                </a>
            {% elif step_num == step %}
                <span class="tw-stepper-item" aria-current="step">
                    <span class="tw-stepper-circle tw-stepper-circle-active">{{ step_num }}</span>
                    <span class="tw-stepper-label tw-stepper-label-active hidden sm:inline">{{ step_label }}</span>
                </span>
            {% else %}
                <span class="tw-stepper-item">
                    <span class="tw-stepper-circle">{{ step_num }}</span>
                    <span class="tw-stepper-label hidden sm:inline">{{ step_label }}</span>
                </span>
            {% endif %}
            {% if not forloop.last %}
                <span class="tw-stepper-connector{% if step_num in completed_steps %} tw-stepper-connector-completed{% endif %}"></span>
            {% endif %}
        {% endfor %}
    </div>
</nav>
