{# CRA Wizard Step Progress Bar #}
{# Expects: step (int), step_names (dict), completed_steps (list), assessment_id (str) #}
{# A completed step is a link back to it: the anchor wraps the step, because a #}
{# step is not a link everywhere else the rail is used. #}
<nav aria-label="Wizard progress" class="mb-8">
    <c-navigation.stepper>
    {% for step_num, step_label in step_names.items %}
        {% if step_num in completed_steps and step_num != step %}
            <a href="{% url 'compliance:cra_step' assessment_id=assessment_id step=step_num %}">
                <c-navigation.stepper-step state="completed" label="{{ step_label }}" label_class="hidden sm:inline">
                <i class="fas fa-check text-xs" aria-hidden="true"></i>
                </c-navigation.stepper-step>
            </a>
        {% elif step_num == step %}
            <c-navigation.stepper-step state="active" label="{{ step_label }}" label_class="hidden sm:inline" aria-current="step">{{ step_num }}</c-navigation.stepper-step>
        {% else %}
            <c-navigation.stepper-step label="{{ step_label }}" label_class="hidden sm:inline">{{ step_num }}</c-navigation.stepper-step>
        {% endif %}
        {% if not forloop.last %}
            {% if step_num in completed_steps %}
                <c-navigation.stepper-connector completed />
            {% else %}
                <c-navigation.stepper-connector />
            {% endif %}
        {% endif %}
    {% endfor %}
    </c-navigation.stepper>
</nav>
