{# Document card — used inside x-for loop with `doc` variable (docKinds item) in scope #}
<c-cards.card flush>
{# Wraps on a phone: the status and actions drop under the name rather than squeezing it. #}
<div class="px-4 py-3 flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
    <div class="flex min-w-0 flex-1 items-center gap-3">
        <i class="fas fa-file-lines text-text-muted" aria-hidden="true"></i>
        <span class="min-w-0 font-medium text-text text-sm" x-text="doc.label"></span>
    </div>
    <div class="ml-auto flex shrink-0 items-center gap-2">
        <template x-if="getDocStatus(doc.key) === 'current'">
            <c-badges.success>Current</c-badges.success>
        </template>
        <template x-if="getDocStatus(doc.key) === 'stale'">
            <c-badges.warning>Stale</c-badges.warning>
        </template>
        <template x-if="getDocStatus(doc.key) === 'not_generated'">
            <c-badges.secondary>Not generated</c-badges.secondary>
        </template>
        <c-buttons.ghost size="sm" @click="previewDocument(doc.key, doc.label)" ::aria-label="'Preview ' + doc.label">
        <i class="fas fa-eye" aria-hidden="true"></i>
        </c-buttons.ghost>
        <c-buttons.ghost size="sm" @click="generateDocument(doc.key)" ::disabled="generatingDoc === doc.key" ::aria-label="'Generate ' + doc.label">
        <span x-show="generatingDoc === doc.key">
            {% include "core/components/brand/loader.html.j2" with class="tw-loader-inline" %}
        </span>
        <i x-show="generatingDoc !== doc.key"
           class="fas fa-rotate"
           aria-hidden="true"></i>
        </c-buttons.ghost>
    </div>
</div>
</c-cards.card>
