{# Declaration of Conformity link for the public product page: a side panel. #}
{# Expects: has_doc (bool), product (object), preferred_base_url (str) #}
{% if has_doc %}
    {# Resolved first, so no template tag sits inside an href for the formatter to break. #}
    {% url 'compliance:product_doc_public' product_id=product.id as doc_path %}
    <c-branded.panel title="EU Declaration of Conformity">
    <p class="text-sm text-text-muted my-0">
        The manufacturer's declaration that this product conforms to the EU Cyber
        Resilience Act (Regulation 2024/2847) and the standards listed in Annex V.
    </p>
    <div class="flex">
        <c-buttons.secondary size="sm" href="{{ preferred_base_url|default:'' }}{{ doc_path }}">
        View declaration
        <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
        </c-buttons.secondary>
    </div>
    </c-branded.panel>
{% endif %}
