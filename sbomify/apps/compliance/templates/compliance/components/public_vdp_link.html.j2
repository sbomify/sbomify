{# VDP link for the public product page: a side panel. #}
{# Expects: has_vdp (bool), product (object), preferred_base_url (str), is_custom_domain (bool) #}
{% if has_vdp %}
    {# Resolved first, so no template tag sits inside an href for the formatter to break. #}
    {% url 'compliance:product_vdp_public' product_id=product.id as vdp_path %}
    <c-branded.panel title="Reporting a vulnerability">
    <p class="text-sm text-text-muted my-0">
        How to report security vulnerabilities for this product, and what to expect from our response.
    </p>
    <div class="flex flex-col items-start gap-2">
        <c-buttons.secondary size="sm" href="{{ preferred_base_url|default:'' }}{{ vdp_path }}">
        Vulnerability disclosure policy
        <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
        </c-buttons.secondary>
        {% if is_custom_domain %}
            <c-buttons.ghost size="sm" href="{{ preferred_base_url|default:'' }}/.well-known/security.txt" target="_blank" rel="noopener">
            security.txt
            <i class="fas fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>
            </c-buttons.ghost>
        {% endif %}
    </div>
    </c-branded.panel>
{% endif %}
