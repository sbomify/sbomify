{% extends "compliance/cra_wizard_base.html.j2" %}
{% block step_wrapper %}
    <div x-data="craStep1()" class="flex flex-col gap-6">
        {{ step_data_json|json_script:"step-data" }}
        {{ assessment_meta|json_script:"assessment-meta" }}
        {{ step_urls|json_script:"step-urls" }}
        {# Step content #}
        <div>
            {# Manufacturer — Annex V item 2 guard #}
            <c-layout.form-section stacked title="Manufacturer" description="Legal details from your workspace’s Parties settings.">
            <c-slot name="actions">
            <c-buttons.secondary size="sm" id="manufacturer-settings" href="{% url 'teams:team_settings_tab' team_key=team.key tab='contact-profiles' %}" target="_blank" rel="noopener" data-testid="mfr-settings-link" aria-label="Edit manufacturer in Parties (opens in a new tab)">Edit details<i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i></c-buttons.secondary>
            </c-slot>
            <div class="flex flex-col gap-4">
                <dl x-show="manufacturer" class="flex flex-col gap-3 m-0">
                    <c-layout.description-row label="Legal name"><span data-testid="mfr-name" x-text="manufacturer?.name || 'Not set'"></span></c-layout.description-row>
                    <c-layout.description-row label="Email"><span x-text="manufacturer?.email || 'Not set'"></span></c-layout.description-row>
                    <c-layout.description-row label="Address"><span x-text="manufacturer?.address || 'Not set'"></span></c-layout.description-row>
                </dl>
                <c-feedback.alert variant="warning" title="Manufacturer name needs updating" x-show="manufacturerIsPlaceholder" x-cloak data-testid="mfr-placeholder-banner">
                Set your legal manufacturer name in Parties before continuing.
                </c-feedback.alert>
                <c-forms.hint>After editing, reload this step to use the saved details.</c-forms.hint>
            </div>
            </c-layout.form-section>
            {# CRA Classification #}
            <c-layout.form-section stacked title="Classification" description="Select the product category that determines the conformity assessment procedure">
            <div class="flex flex-col gap-4">
                {# Category cards #}
                <div>
                    {# The extra 4px sits on the grid: two margin utilities on the label would fight. #}
                    <c-forms.label for="product-category" required>Product category</c-forms.label>
                    <c-forms.select id="product-category" x-model="category">
                    <option value="default">Default: standard digital products</option>
                    <option value="class_i">Class I: important products</option>
                    <option value="class_ii">Class II: critical products</option>
                    <option value="critical">Critical: highly critical infrastructure</option>
                    </c-forms.select>
                </div>
                {# Open Source Steward toggle #}
                <c-layout.select-row>
                <c-forms.checkbox-input x-model="isOpenSourceSteward" id="oss-steward" />
                <span class="text-text select-none">This product is maintained by an Open Source Steward</span>
                </c-layout.select-row>
                {# Conformity Assessment Procedure (CRA Art 32) #}
                <div class="px-4 py-3 bg-surface-hover rounded-lg space-y-3">
                    {# A panel caption, not a field label: smaller and letter-spaced the other way. #}
                    <span class="block text-xs font-medium text-text mb-2 uppercase tracking-wider">Conformity Assessment Procedure</span>
                    <p class="text-xs text-text-muted">
                        Select the conformity assessment procedure for this product category
                        (<a href="https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
   target="_blank"
   rel="noopener noreferrer"
   class="text-primary hover:underline">CRA Art 32</a>)
                    </p>
                    <div id="conformity-procedure" tabindex="-1" class="space-y-2">
                        <template x-for="proc in availableProcedures" :key="proc.value">
                            <c-layout.select-row>
                            <c-forms.radio name="conformity_procedure" x_value="proc.value" x-model="conformityAssessmentProcedure" />
                            <div>
                                <span class="text-text font-medium text-sm" x-text="proc.label"></span>
                                <span x-show="proc.note"
                                      class="block text-xs text-text-muted"
                                      x-text="proc.note"></span>
                            </div>
                            </c-layout.select-row>
                        </template>
                    </div>
                    {# Harmonised standard confirmation for Class I + Module A (CRA Art 32(2)) #}
                    <c-feedback.callout variant="warning" class="mt-2" x-show="category === 'class_i' && conformityAssessmentProcedure === 'module_a'" x-cloak role="status" aria-live="polite">
                    {% include "compliance/components/_callout_regulatory_header.html.j2" with icon="fa-shield-halved" title="Harmonised standard required" pill_label="CRA Art 32(2)" pill_href=cra_oj_url description="Class I products may only use Module A (self-assessment) when a harmonised standard covering all relevant requirements has been applied." %}
                    <c-feedback.callout-body>
                    <label class="flex items-start gap-3 cursor-pointer">
                        <c-forms.checkbox-input id="harmonised-standard" x-model="harmonisedStandardApplied" class="mt-0.5" />
                        <span class="text-sm text-text">I confirm a harmonised standard has been applied to this product.</span>
                    </label>
                    </c-feedback.callout-body>
                    </c-feedback.callout>
                </div>
            </div>
            </c-layout.form-section>
            {# Harmonised Standards Applicability (EN 18031 opt-in — issue #905) #}
            <c-layout.form-section stacked title="Harmonised Standards Applicability" description="Optional. Tick the boxes that apply to claim presumption of conformity under the EN 18031 harmonised standards on the Declaration of Conformity.">
            <div class="flex flex-col gap-4">
                <c-layout.select-row>
                <c-forms.checkbox-input x-model="isRadioEquipment" class="mt-0.5" />
                <span class="flex-1">
                    <span class="text-text font-medium block">Radio equipment under the RED</span>
                    <span class="text-xs text-text-muted">Triggers EN 18031-1 (RED Article 3(3)(d)): access control, authentication, secure update, cryptography.</span>
                </span>
                </c-layout.select-row>
                <c-layout.select-row ::class="!isRadioEquipment ? 'opacity-50' : ''">
                <c-forms.checkbox-input x-model="processesPersonalData" ::disabled="!isRadioEquipment" class="mt-0.5" />
                <span class="flex-1">
                    <span class="text-text font-medium block">Processes personal data</span>
                    <span class="text-xs text-text-muted">Triggers EN 18031-2 (RED Article 3(3)(e)): data minimisation, GDPR alignment. Requires RED.</span>
                </span>
                </c-layout.select-row>
                <c-layout.select-row ::class="!isRadioEquipment ? 'opacity-50' : ''">
                <c-forms.checkbox-input x-model="handlesFinancialValue" ::disabled="!isRadioEquipment" class="mt-0.5" />
                <span class="flex-1">
                    <span class="text-text font-medium block">Handles monetary value or virtual currency</span>
                    <span class="text-xs text-text-muted">Triggers EN 18031-3 (RED Article 3(3)(f)): protection from fraud. Requires RED.</span>
                </span>
                </c-layout.select-row>
                <c-feedback.alert variant="info" icon="fas fa-circle-info" x-show="isRadioEquipment" x-cloak>
                <span class="opacity-80">
                    The DoC will carry the OJ L_202500138 restriction notes. Review them before export. Products that allow the user not to set any password cannot claim presumption of conformity for EN 18031-1, EN 18031-2, and EN 18031-3 in respect of clauses 6.2.5.1 and 6.2.5.2.
                </span>
                </c-feedback.alert>
            </div>
            </c-layout.form-section>
            {# EU Market Selection #}
            <c-layout.form-section stacked title="EU markets" description="Select the EU member states where this product will be placed on the market">
            <div class="flex flex-col gap-4">
                {# Select all toggle #}
                <div class="flex items-center gap-3 pb-3 border-b border-border">
                    <c-forms.checkbox-input id="all-markets" ::checked="allMarketsSelected" @click="toggleAllMarkets()" />
                    <label for="all-markets"
                           class="text-text font-medium cursor-pointer select-none">All EU markets</label>
                    <span class="text-xs text-text-muted ml-auto"
                          x-text="euMarkets.length + ' of 27 selected'"></span>
                </div>
                {# Country grid #}
                <div id="eu-markets"
                     tabindex="-1"
                     class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-2">
                    <template x-for="code in euCountries" :key="code">
                        <label class="flex items-center gap-2 cursor-pointer text-sm py-1 select-none">
                            <c-forms.checkbox-input ::checked="isMarketSelected(code)" @change="toggleMarket(code)" />
                            <span class="text-text" x-text="euCountryNames[code]"></span>
                        </label>
                    </template>
                </div>
            </div>
            </c-layout.form-section>
            {# Support Period #}
            <c-layout.form-section stacked title="Support period">
            <div class="flex flex-col gap-4">
                <div>
                    <c-forms.label for="support-period-end" required>End Date</c-forms.label>
                    <p class="text-xs text-text-muted mb-2">
                        Date when active security support ends for this product.
                        CRA Art 13(8) requires a minimum of 5 years.
                    </p>
                    <c-forms.input type="date" id="support-period-end" x-model="supportPeriodEnd" class="max-w-xs" />
                </div>
                {# Warning when support period < 5 years (CRA Art 13(8), FAQ 4.5.2) #}
                <c-feedback.callout variant="warning" x-show="supportPeriodShort" x-cloak role="status" aria-live="polite">
                {% include "compliance/components/_callout_regulatory_header.html.j2" with icon="fa-clock-rotate-left" title="Support period below 5-year minimum" pill_label="CRA Art 13(8)" pill_href=cra_oj_url description="CRA Art 13(8) requires at least 5 years unless the product's expected use time is shorter (e.g., pandemic contact tracing apps, time-limited subscription software)." %}
                <c-feedback.callout-body>
                <c-forms.label for="support-short-justification">Justification (required)</c-forms.label>
                <c-forms.textarea id="support-short-justification" x-model="supportPeriodShortJustification" rows="3" placeholder="Explain why the expected product lifetime is less than 5 years..." />
                <div class="mt-1.5 flex items-center justify-between gap-3 text-[11px]">
                    <span x-show="!supportPeriodShortJustification?.trim()"
                          class="flex items-center gap-1 text-warning font-medium">
                        <i class="fas fa-exclamation-circle"></i>
                        A non-empty justification is required.
                    </span>
                    <span x-show="supportPeriodShortJustification?.trim()"
                          x-cloak
                          class="flex items-center gap-1 text-success font-medium">
                        <i class="fas fa-circle-check"></i>
                        Saved on next update
                    </span>
                    <span class="text-text-muted tabular-nums"
                          x-text="`${(supportPeriodShortJustification || '').length} chars`"></span>
                </div>
                </c-feedback.callout-body>
                </c-feedback.callout>
            </div>
            </c-layout.form-section>
            {# Intended Use #}
            <c-layout.form-section stacked title="Intended use">
            <div class="flex flex-col gap-4">
                <c-forms.field label="Description" for="intended-use" hint="How the product is intended to be used by end users">
                <c-forms.textarea id="intended-use" x-model="intendedUse" rows="4" placeholder="e.g., Enterprise web application for managing supply chain security..." />
                </c-forms.field>
            </div>
            </c-layout.form-section>
            {% comment %}
                EU establishment and the Authorised Representative. Three
                answers, not two: leaving it unanswered is a real state the
                assessment starts in, and it is recorded rather than guessed.
                The declaration cannot be exported while it is unanswered.
            {% endcomment %}
            <c-layout.form-section stacked title="EU establishment" description="CRA Art. 22. A manufacturer without an establishment in the Union must appoint an Authorised Representative before placing the product on the market.">
            <div class="flex flex-col gap-4">
                <fieldset>
                    <c-forms.label>Is the manufacturer established in the EU?</c-forms.label>
                    <div class="flex flex-wrap gap-4 mt-2">
                        <c-forms.radio name="eu-established" value="yes" x-model="euEstablished" data-testid="eu-established-yes" class="cursor-pointer">Yes</c-forms.radio>
                        <c-forms.radio name="eu-established" value="no" x-model="euEstablished" data-testid="eu-established-no" class="cursor-pointer">No</c-forms.radio>
                        <c-forms.radio name="eu-established" value="" x-model="euEstablished" data-testid="eu-established-unknown" class="cursor-pointer">
                        <span class="text-text-muted">Not determined yet</span>
                        </c-forms.radio>
                    </div>
                    <p class="text-xs text-text-muted mt-2 mb-0"
                       x-show="euEstablished === ''"
                       x-cloak>The declaration cannot be exported until this is answered.</p>
                </fieldset>
                <div x-show="euEstablished === 'no'"
                     x-cloak
                     class="pt-2 border-t border-border space-y-4">
                    <c-feedback.alert variant="warning" icon="fas fa-triangle-exclamation">
                    An Authorised Representative is required. Name, address, contact email
                    and mandate date must all be recorded before this step will save.
                    </c-feedback.alert>
                    <div class="flex flex-col gap-4">
                        <div>
                            <c-forms.label for="ar-name">Name</c-forms.label>
                            <c-forms.input id="ar-name" type="text" x-model="authorizedRepName" data-testid="ar-name" placeholder="Legal name of the representative" />
                        </div>
                        <div>
                            <c-forms.label for="ar-email">Contact email</c-forms.label>
                            <c-forms.input id="ar-email" type="email" x-model="authorizedRepEmail" data-testid="ar-email" placeholder="representative@example.eu" />
                        </div>
                    </div>
                    <div>
                        <c-forms.label for="ar-address">Address</c-forms.label>
                        {% comment %}
                        A textarea wearing the input recipe, as it always has:
                        the address is two lines, not a paragraph, so it keeps
                        the field height rather than the textarea's.
                        {% endcomment %}
                        <textarea id="ar-address"
                                  x-model="authorizedRepAddress"
                                  rows="2"
                                  data-testid="ar-address"
                                  class="tw-form-input w-full"
                                  placeholder="Registered address within the Union"></textarea>
                    </div>
                    <div class="flex flex-col gap-4">
                        <div>
                            <c-forms.label for="ar-mandate-date">Mandate dated</c-forms.label>
                            <c-forms.input id="ar-mandate-date" type="date" x-model="authorizedRepMandateDate" data-testid="ar-mandate-date" />
                        </div>
                        <div>
                            <c-forms.label for="ar-mandate-reference">Mandate reference</c-forms.label>
                            <c-forms.input id="ar-mandate-reference" type="text" x-model="authorizedRepMandateReference" data-testid="ar-mandate-reference" placeholder="Contract id, DMS link or file name" />
                            <c-forms.hint>Optional. Where the signed mandate is filed.</c-forms.hint>
                        </div>
                    </div>
                </div>
            </div>
            </c-layout.form-section>
        </div>
        {% include "compliance/components/cra_required_fields.html.j2" %}
        {# Footer navigation #}
        <div class="flex flex-wrap justify-between items-center gap-3">
            {% if step > 1 %}
                <c-buttons.secondary href="{% url 'compliance:cra_step' assessment_id=assessment_id step=step|add:'-1' %}">
                <i class="fas fa-arrow-left mr-2"></i> Back
                </c-buttons.secondary>
            {% else %}
                <div>{# spacer #}</div>
            {% endif %}
            <c-buttons.primary @click="save()" ::disabled="isSaving" data-testid="step-1-save-continue">
            <span x-show="!isSaving">Save and continue <i class="fas fa-arrow-right ml-2"></i></span>
            <span x-show="isSaving" x-cloak>
                {% include "core/components/brand/loader.html.j2" with class="tw-loader-inline mr-2" %}
            Saving...</span>
            </c-buttons.primary>
        </div>
    </div>
{% endblock step_wrapper %}
