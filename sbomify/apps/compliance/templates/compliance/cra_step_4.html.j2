{% extends "compliance/cra_wizard_base.html.j2" %}
{% block step_wrapper %}
    <div x-data="craStep4()">
        {{ step_data_json|json_script:"step-data" }}
        {{ assessment_meta|json_script:"assessment-meta" }}
        {{ step_urls|json_script:"step-urls" }}
        {# Step content #}
        <div class="space-y-6">
            {# Product Type Template Selector #}
            <c-cards.card>
            <c-slot name="header">
            <div class="px-6 py-4 border-b border-border">
                <h2 class="text-lg font-semibold text-text flex items-center gap-2 m-0">
                    <i class="fas fa-shapes text-primary"></i>
                    Product Type
                </h2>
                <p class="text-sm text-text-muted mt-1">Select a product type to pre-fill defaults (you can override any value)</p>
            </div>
            </c-slot>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2">
                <template x-for="t in [ {key: 'web_app', label: 'Web App', icon: 'fa-globe'}, {key: 'mobile', label: 'Mobile', icon: 'fa-mobile-screen'}, {key: 'iot', label: 'IoT', icon: 'fa-microchip'}, {key: 'desktop', label: 'Desktop', icon: 'fa-desktop'}, {key: 'library', label: 'Library/SDK', icon: 'fa-cube'}, {key: 'network', label: 'Network', icon: 'fa-network-wired'}, {key: 'embedded', label: 'Embedded', icon: 'fa-memory'}, {key: 'cloud', label: 'Cloud', icon: 'fa-cloud'}, {key: 'os', label: 'OS', icon: 'fa-server'}, {key: 'api', label: 'API', icon: 'fa-code'} ]"
                          :key="t.key">
                    <button type="button"
                            @click="applyTemplate(t.key)"
                            :class="productType === t.key ? 'border-primary bg-primary/5 ring-1 ring-primary' : 'border-border hover:border-primary/50'"
                            class="p-3 rounded-lg border text-center transition-all cursor-pointer">
                        <i class="fas text-lg mb-1"
                           :class="t.icon + (productType === t.key ? ' text-primary' : ' text-text-muted')"></i>
                        <span class="block text-xs font-medium text-text" x-text="t.label"></span>
                    </button>
                </template>
            </div>
            </c-cards.card>
            {# Update & Distribution #}
            <c-cards.card body_class="space-y-4">
            <c-slot name="header">
            <div class="px-6 py-4 border-b border-border">
                <h2 class="text-lg font-semibold text-text flex items-center gap-2 m-0">
                    <i class="fas fa-rotate text-primary"></i>
                    Update &amp; Distribution
                </h2>
                <p class="text-sm text-text-muted mt-1">
                    Define how security updates are delivered to users throughout the product support period
                </p>
            </div>
            </c-slot>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <c-forms.label for="update-freq">Update Frequency</c-forms.label>
                    <p class="text-xs text-text-muted mb-2">How often updates are released</p>
                    <c-forms.select id="update-freq" x-model="updateFrequency">
                    <option value="">Select...</option>
                    <option value="regular">Regular</option>
                    <option value="as-needed">As Needed</option>
                    <option value="none">None</option>
                    </c-forms.select>
                </div>
                <div>
                    <c-forms.label for="update-method">Update Method</c-forms.label>
                    <p class="text-xs text-text-muted mb-2">How updates reach end users</p>
                    <c-forms.input type="text" id="update-method" x-model="updateMethod" maxlength="30" placeholder="e.g., automatic OTA, manual download" class="max-w-md" />
                </div>
            </div>
            <div>
                <c-forms.label for="update-url">Update Channel URL</c-forms.label>
                <p class="text-xs text-text-muted mb-2">Where users can find and download updates</p>
                <c-forms.input type="url" id="update-url" x-model="updateChannelUrl" placeholder="https://" />
            </div>
            </c-cards.card>
            {# Support Contact #}
            <c-cards.card>
            <c-slot name="header">
            <div class="px-6 py-4 border-b border-border">
                <h2 class="text-lg font-semibold text-text flex items-center gap-2 m-0">
                    <i class="fas fa-headset text-primary"></i>
                    Support Contact
                </h2>
                <p class="text-sm text-text-muted mt-1 m-0">How users can reach your support team for product issues</p>
            </div>
            </c-slot>
            {# Contact profile selector #}
            <c-cards.inset class="mb-4">
            {# The label keeps its own bottom margin, so the row only adds the rest. #}
            <div class="flex items-center justify-between gap-4 mb-1">
                <c-forms.label for="support-contact">
                <i class="fas fa-address-book text-primary mr-1.5"></i>Select from contact profiles
                </c-forms.label>
                <a href="{% if current_team and current_team.key %}{% url 'teams:team_settings' team_key=current_team.key %}#contact-profiles{% else %}#{% endif %}"
                   class="text-xs text-primary hover:underline flex-shrink-0">
                    <i class="fas fa-plus mr-1"></i>Add Contact
                </a>
            </div>
            <c-forms.select id="support-contact" x-model="supportContactId" @change="const c = (stepData.contacts || []).find(ct => String(ct.id) === $el.value); if (c) { supportEmail = c.email || ''; supportPhone = c.phone || ''; }">
            <option value="">Choose a contact to auto-fill details...</option>
            <template x-for="contact in (stepData.contacts || [])" :key="contact.id">
                <option :value="String(contact.id)"
                        :selected="String(contact.id) === String(supportContactId)"
                        x-text="contact.name + ' (' + contact.email + '), ' + contact.profile_name"></option>
            </template>
            </c-forms.select>
            </c-cards.inset>
            {# Details grid #}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <c-forms.label for="support-email">Email</c-forms.label>
                    <c-forms.input type="email" id="support-email" x-model="supportEmail" placeholder="support@example.com" />
                </div>
                <div>
                    <c-forms.label for="support-phone">Phone</c-forms.label>
                    <c-forms.input type="tel" id="support-phone" x-model="supportPhone" placeholder="+49 30 123456" />
                </div>
                <div>
                    <c-forms.label for="support-url">Support Portal</c-forms.label>
                    <c-forms.input type="url" id="support-url" x-model="supportUrl" placeholder="https://example.com/support" />
                </div>
                <div>
                    <c-forms.label for="support-hours">Availability</c-forms.label>
                    <div class="flex gap-2">
                        <c-forms.input type="text" id="support-hours" x-model="supportHours" placeholder="Mon-Fri 9:00-17:00 UTC" />
                        <c-actions-menu label="Quick presets" icon="fas fa-clock" stretch width="w-56">
                        <c-dropdowns.item @click="supportHours = 'Mon-Fri 09:00-17:00 UTC'">Mon-Fri 09:00-17:00 UTC</c-dropdowns.item>
                        <c-dropdowns.item @click="supportHours = 'Mon-Fri 09:00-17:00 CET'">Mon-Fri 09:00-17:00 CET</c-dropdowns.item>
                        <c-dropdowns.item @click="supportHours = '24/7'">24/7</c-dropdowns.item>
                        <c-dropdowns.item @click="supportHours = '24/7 via support portal'">24/7 via support portal</c-dropdowns.item>
                        <c-dropdowns.item @click="supportHours = 'Business hours (local time)'">Business hours (local time)</c-dropdowns.item>
                        </c-actions-menu>
                    </div>
                </div>
            </div>
            </c-cards.card>
        </div>
        {# Data & Decommissioning #}
        <c-cards.card>
        <c-slot name="header">
        <div class="px-6 py-4 border-b border-border">
            <h2 class="text-lg font-semibold text-text flex items-center gap-2 m-0">
                <i class="fas fa-trash-can text-primary"></i>
                Data &amp; Decommissioning
            </h2>
            <p class="text-sm text-text-muted mt-1">Describe how users can securely remove the product and delete their data</p>
        </div>
        </c-slot>
        <c-forms.label for="data-deletion">Data Deletion Instructions</c-forms.label>
        <p class="text-xs text-text-muted mb-2">
            Step-by-step instructions for users to delete their data when decommissioning the product
        </p>
        <c-forms.textarea id="data-deletion" x-model="dataDeletionInstructions" rows="4" placeholder="Describe how users can delete their data..." />
        </c-cards.card>
        {# Footer navigation #}
        <div class="flex justify-between items-center mt-8 pt-6 border-t border-border">
            {% if step > 1 %}
                <c-buttons.secondary href="{% url 'compliance:cra_step' assessment_id=assessment_id step=step|add:'-1' %}">
                <i class="fas fa-arrow-left mr-2"></i> Back
                </c-buttons.secondary>
            {% else %}
                <div>{# spacer #}</div>
            {% endif %}
            <c-buttons.primary @click="save()" ::disabled="!canContinue || isSaving">
            <span x-show="!isSaving">Save &amp; Continue <i class="fas fa-arrow-right ml-2"></i></span>
            <span x-show="isSaving" x-cloak>
                {% include "core/components/brand/loader.html.j2" with class="tw-loader-inline mr-2" %}
            Saving...</span>
            </c-buttons.primary>
        </div>
    </div>
{% endblock step_wrapper %}
