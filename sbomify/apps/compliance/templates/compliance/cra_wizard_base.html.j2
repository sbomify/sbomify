{% extends "core/dashboard_base.html.j2" %}
{% block title %}CRA Compliance - {{ step_name }} - sbomify{% endblock %}
{% block dashboard_content %}
    <c-layout.frame class="w-full max-w-5xl mx-auto">
    <c-layout.page-header title="CRA compliance" subtitle="{{ assessment.product.name }} · {{ step_name }}">
    <c-buttons.ghost size="sm" href="{% url 'compliance:cra_product_list' %}">
    <i class="fas fa-arrow-left" aria-hidden="true"></i>Back to assessments
    </c-buttons.ghost>
    </c-layout.page-header>
    {# Stepper #}
    {% include "compliance/components/cra_stepper.html.j2" %}
    {% comment %}
        Stale banner (issue #921). Only rendered when the linked scope
        screening has flipped CRA out of scope while the assessment row
        still exists. Every mutation API returns 409 in this state; the
        operator either re-runs scope screening (which auto-unstales)
        or deletes the assessment.
    {% endcomment %}
    {% if assessment and assessment.status == "stale" %}
        {% include "compliance/components/_assessment_stale_banner.html.j2" with product_id=assessment.product_id %}
    {% endif %}
    {# Each step template overrides this block with x-data wrapping both content and footer #}
    {% block step_wrapper %}
    {% endblock step_wrapper %}
    </c-layout.frame>
{% endblock dashboard_content %}
