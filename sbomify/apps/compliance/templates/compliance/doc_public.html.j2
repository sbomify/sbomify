{% extends "core/public_base.htmx.j2" %}
{% block title %}EU Declaration of Conformity - {{ product.name }}{% endblock %}
{% block page_header %}
    <c-branded.masthead>
    {% comment %}
    Two whole tags rather than an {% if %} in the href: the formatter breaks a
    template tag inside an attribute across lines, and the newline would land
    inside the URL.
    {% endcomment %}
    {% if is_custom_domain %}
        <c-branded.back-link href="/product/{{ product.slug }}/">{{ product.name }}</c-branded.back-link>
    {% else %}
        <c-branded.back-link href="/public/product/{{ product.id }}/">{{ product.name }}</c-branded.back-link>
    {% endif %}
    <c-branded.page-header title="EU Declaration of Conformity" lede="{{ product.name }}">
    <c-slot name="eyebrow">
    <c-branded.badge brand>
    <i class="fas fa-file-signature" aria-hidden="true"></i>Compliance
    </c-branded.badge>
    </c-slot>
    </c-branded.page-header>
    </c-branded.masthead>
{% endblock %}
{% block content %}
    <c-branded.surface flush>
    <div class="px-8 py-8 max-sm:px-5 max-sm:py-6 prose prose-sm max-w-[72ch] dark:prose-invert prose-headings:text-text prose-p:text-text-secondary prose-strong:text-text prose-a:text-primary prose-li:text-text-secondary prose-code:text-text prose-code:before:content-none prose-code:after:content-none">
        {{ doc_html }}
    </div>
    </c-branded.surface>
{% endblock %}
