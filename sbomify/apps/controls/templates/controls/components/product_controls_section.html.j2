<c-layout.frame>
<c-feedback.alert>
Controls use workspace defaults unless a product override is set.
{% if can_manage_controls %}
    <c-buttons.ghost size="sm" href="{{ controls_settings_url }}">Manage workspace controls</c-buttons.ghost>
{% endif %}
</c-feedback.alert>
{% for controls in active_controls_tables %}
    {% include 'controls/controls_table.html.j2' %}
{% empty %}
    <c-feedback.empty-state title="No active compliance frameworks" icon="fas fa-list-check" message="Activate a framework in workspace settings to track compliance controls." />
{% endfor %}
</c-layout.frame>
