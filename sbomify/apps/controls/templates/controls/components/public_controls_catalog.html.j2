{# Per-catalog controls content inside the public controls card #}
{# Expects: controls_summary (dict with catalog, percentage, total, addressed, by_status, categories) #}
{% if controls_summary %}
    <div class="{% if not forloop.first %}mt-6 pt-6 border-t border-border/30{% endif %}">
        {# Catalog badge + summary #}
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 mb-4">
            <c-badges.primary class="flex-shrink-0">{{ controls_summary.catalog.name }} {{ controls_summary.catalog.version }}</c-badges.primary>
            <div class="flex items-center gap-3 flex-1">
                <span class="text-lg font-bold {% if controls_summary.percentage >= 80 %}text-success{% elif controls_summary.percentage >= 50 %}text-warning{% else %}text-danger{% endif %}">
                    {{ controls_summary.percentage|floatformat:0 }}%
                </span>
                {# djlint:off #}
                <c-progress :value="controls_summary.percentage" variant="{% if controls_summary.percentage >= 80 %}success{% elif controls_summary.percentage >= 50 %}warning{% else %}danger{% endif %}" class="flex-1 max-w-[200px]" />
                {# djlint:on #}
                <span class="text-sm text-text-muted">
                    {{ controls_summary.addressed|floatformat:1 }} of {{ controls_summary.total }} addressed
                </span>
            </div>
        </div>
        {# Status badges #}
        <div class="flex flex-wrap gap-2 mb-4">
            {% if controls_summary.by_status.compliant %}
                <c-badges.success>{{ controls_summary.by_status.compliant }} Compliant</c-badges.success>
            {% endif %}
            {% if controls_summary.by_status.partial %}
                <c-badges.warning>{{ controls_summary.by_status.partial }} Partial</c-badges.warning>
            {% endif %}
            {% if controls_summary.by_status.not_implemented %}
                <c-badges.secondary>{{ controls_summary.by_status.not_implemented }} Not Met</c-badges.secondary>
            {% endif %}
        </div>
        {# Category accordions #}
        {% if controls_summary.categories %}
            {% comment %}
                One open flag per category, held by the rail rather than by each
                section: the trigger and the panel are siblings inside the item,
                so the state they share has to live above them.
            {% endcomment %}
            <c-navigation.accordion density="sm" x-data="{ open: {} }">
            {% for category in controls_summary.categories %}
                <c-navigation.accordion-item state="open['{{ category.name|escapejs }}']" label_class="flex flex-1 items-center gap-3 mr-3" @click="open['{{ category.name|escapejs }}'] = !open['{{ category.name|escapejs }}']">
                <c-slot name="label">
                <c-chips.icon-chip size="sm">
                <i class="fas {{ category.icon }} text-xs" aria-hidden="true"></i>
                </c-chips.icon-chip>
                <span class="font-medium text-text text-sm flex-1">{{ category.name }}</span>
                <span class="hidden sm:flex items-center gap-2 flex-shrink-0 w-28">
                    {# djlint:off #}
                    <c-progress :value="category.percentage" size="sm" variant="{% if category.percentage >= 80 %}success{% elif category.percentage >= 50 %}warning{% else %}danger{% endif %}" class="flex-1" />
                    {# djlint:on #}
                    <span class="text-xs text-text-muted w-8 text-right">{{ category.percentage|floatformat:0 }}%</span>
                </span>
                </c-slot>
                {% for control in category.controls %}
                    <div class="flex items-center gap-3 py-2.5 {% if not forloop.last %}border-b border-border/30{% endif %} hover:bg-background/50">
                        <c-code-inline accent="primary" class="flex-shrink-0">{{ control.control_id }}</c-code-inline>
                        <span class="text-sm text-text flex-1">{{ control.title }}</span>
                        {% if control.status == "compliant" %}
                            <c-badges.success size="sm" class="flex-shrink-0">
                            <i class="fas fa-check mr-1" aria-hidden="true"></i>Compliant
                            </c-badges.success>
                        {% elif control.status == "partial" %}
                            <c-badges.warning size="sm" class="flex-shrink-0">
                            <i class="fas fa-minus mr-1" aria-hidden="true"></i>Partial
                            </c-badges.warning>
                        {% elif control.status == "not_applicable" %}
                            <c-badges.secondary size="sm" class="flex-shrink-0">N/A</c-badges.secondary>
                        {% else %}
                            <c-badges.secondary size="sm" class="flex-shrink-0">Not Met</c-badges.secondary>
                        {% endif %}
                    </div>
                {% endfor %}
                </c-navigation.accordion-item>
            {% endfor %}
            </c-navigation.accordion>
        {% endif %}
    </div>
{% endif %}
