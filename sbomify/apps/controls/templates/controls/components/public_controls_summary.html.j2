{# Public Compliance Controls Summary - server-rendered #}
{% if controls_summary %}
    <div class="public-section" x-data="{ openCategories: {} }">
        <c-cards.card>
        <c-slot name="header">
        <div class="px-6 py-4 border-b border-border">
            <div class="flex items-center justify-between flex-wrap gap-2">
                <h4 class="text-lg font-semibold text-text flex items-center gap-2 m-0">
                    <i class="fas fa-list-check text-primary"></i>Compliance Controls
                </h4>
                <c-badges.primary>{{ controls_summary.catalog.name }} {{ controls_summary.catalog.version }}</c-badges.primary>
            </div>
        </div>
        </c-slot>
        {# Overall Score Section #}
        <div class="flex flex-col sm:flex-row items-center gap-6 mb-6 pb-6 border-b border-border">
            {# Circular Progress Indicator #}
            <div class="relative w-24 h-24 flex-shrink-0">
                <svg class="w-full h-full -rotate-90" viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="15.5" fill="none" stroke="currentColor" stroke-width="3" class="text-border" />
                    <circle cx="18" cy="18" r="15.5" fill="none" stroke-width="3" stroke-linecap="round" stroke-dasharray="{{ controls_summary.percentage }}, 100" class="
                    {% if controls_summary.percentage >= 80 %}
                        text-success
                    {% elif controls_summary.percentage >= 50 %}
                        text-warning
                    {% else %}
                        text-danger
                    {% endif %}
                    " />
                </svg>
                <div class="absolute inset-0 flex items-center justify-center">
                    <span class="text-lg font-bold text-text">{{ controls_summary.percentage|floatformat:0 }}%</span>
                </div>
            </div>
            {# Score Details #}
            <div class="text-center sm:text-left">
                <div class="text-xl font-bold text-text mb-1">
                    {{ controls_summary.addressed|floatformat:1 }} of {{ controls_summary.total }} controls addressed
                </div>
                <p class="text-sm text-text-muted m-0">Compliance score based on active framework controls</p>
            </div>
        </div>
        {# Status Badges Row #}
        <div class="flex flex-wrap gap-3 mb-6">
            {% if controls_summary.by_status.compliant %}
                <c-chips.metric-chip accent="success">
                <c-chips.metric.value>{{ controls_summary.by_status.compliant }}</c-chips.metric.value>
                <c-chips.metric.label>Compliant</c-chips.metric.label>
                </c-chips.metric-chip>
            {% endif %}
            {% if controls_summary.by_status.partial %}
                <c-chips.metric-chip accent="warning">
                <c-chips.metric.value>{{ controls_summary.by_status.partial }}</c-chips.metric.value>
                <c-chips.metric.label>Partial</c-chips.metric.label>
                </c-chips.metric-chip>
            {% endif %}
            {% if controls_summary.by_status.not_implemented %}
                <c-chips.metric-chip>
                <c-chips.metric.value>{{ controls_summary.by_status.not_implemented }}</c-chips.metric.value>
                <c-chips.metric.label>Not Met</c-chips.metric.label>
                </c-chips.metric-chip>
            {% endif %}
            {% if controls_summary.by_status.not_applicable %}
                <c-chips.metric-chip>
                <c-chips.metric.value>{{ controls_summary.by_status.not_applicable }}</c-chips.metric.value>
                <c-chips.metric.label>N/A</c-chips.metric.label>
                </c-chips.metric-chip>
            {% endif %}
        </div>
        {# Category Accordion #}
        {% if controls_summary.categories %}
            <c-navigation.accordion density="sm">
            {% for category in controls_summary.categories %}
                <c-navigation.accordion-item state="openCategories['{{ category.name|escapejs }}']" label_class="flex flex-1 items-center gap-3 mr-3" @click="openCategories['{{ category.name|escapejs }}'] = !openCategories['{{ category.name|escapejs }}']">
                <c-slot name="label">
                <c-chips.icon-chip size="sm">
                <i class="fas {{ category.icon }}" aria-hidden="true"></i>
                </c-chips.icon-chip>
                <span class="font-medium text-text flex-1">{{ category.name }}</span>
                {# Progress Bar #}
                <span class="hidden sm:flex items-center gap-2 flex-shrink-0 w-32">
                    {# djlint:off #}
                    <c-progress :value="category.percentage" variant="{% if category.percentage >= 80 %}success{% elif category.percentage >= 50 %}warning{% else %}danger{% endif %}" class="flex-1" />
                    {# djlint:on #}
                    <span class="text-xs font-medium text-text-muted w-10 text-right">{{ category.percentage|floatformat:0 }}%</span>
                </span>
                </c-slot>
                {# Expanded Controls List #}
                {% for control in category.controls %}
                    <div class="flex items-center gap-3 py-2.5 {% if not forloop.last %}border-b border-border/50{% endif %} hover:bg-border/10">
                        <c-code-inline accent="primary" class="flex-shrink-0">{{ control.control_id }}</c-code-inline>
                        <span class="text-sm text-text flex-1">{{ control.title }}</span>
                        {% if control.status == "compliant" %}
                            <c-badges.success size="sm" class="flex-shrink-0">
                            <i class="fas fa-check mr-1" aria-hidden="true"></i>Compliant
                            </c-badges.success>
                        {% elif control.status == "partial" %}
                            <c-badges.warning size="sm" class="flex-shrink-0">
                            <i class="fas fa-minus mr-1" aria-hidden="true"></i>Partial
                            </c-badges.warning>
                        {% elif control.status == "not_applicable" %}
                            <c-badges.secondary size="sm" class="flex-shrink-0">N/A</c-badges.secondary>
                        {% else %}
                            <c-badges.secondary size="sm" class="flex-shrink-0">Not Met</c-badges.secondary>
                        {% endif %}
                    </div>
                {% endfor %}
                </c-navigation.accordion-item>
            {% endfor %}
            </c-navigation.accordion>
        {% endif %}
        </c-cards.card>
    </div>
{% endif %}
