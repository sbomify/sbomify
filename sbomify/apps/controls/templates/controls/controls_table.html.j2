<c-cards.dashboard class="mb-6" id="controls-table-{{ controls_catalog.id }}" x-data="{ statusFilter: 'all', expandedGroups: {} }">
<c-slot name="header">
<div class="px-6 py-4 border-b border-border">
    <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0 flex-1 overflow-hidden">
            <c-chips.icon-chip>
            <i class="fas {{ catalog_icon|default:'fa-list-check' }}"
               aria-hidden="true"></i>
            </c-chips.icon-chip>
            <div class="min-w-0">
                <h5 class="text-base font-semibold text-text m-0 truncate"
                    title="{{ controls_catalog.name }}">
                    {{ controls_catalog.name|truncatechars:50 }}
                    {% if controls_catalog.source == 'custom' %}
                        <span class="text-xs font-normal text-primary ml-1">Imported</span>
                    {% endif %}
                </h5>
                <p class="text-text-muted text-sm m-0">
                    {{ controls_total_count }} controls · {{ controls_categories|length }} categories
                </p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <div class="hidden sm:flex items-center gap-1 mr-2 relative"
                 x-data="{ showExport: false }"
                 @click.outside="showExport = false">
                <c-buttons.outline-primary size="sm" @click="showExport = !showExport">
                <i class="fas fa-download mr-1"></i>Export
                </c-buttons.outline-primary>
                <c-dropdowns.dropdown class="right-0 top-full mt-1" aria-label="Export" x-show="showExport" x-cloak x-transition>
                <c-dropdowns.item href="/api/v1/controls/catalogs/{{ controls_catalog.id }}/export/csv" icon="fas fa-file-csv">Controls CSV</c-dropdowns.item>
                <c-dropdowns.item href="/api/v1/controls/catalogs/{{ controls_catalog.id }}/export/summary-csv" icon="fas fa-chart-bar">Summary CSV</c-dropdowns.item>
                </c-dropdowns.dropdown>
            </div>
            <label for="status-filter-{{ controls_catalog.id }}"
                   class="text-sm text-text-muted whitespace-nowrap">Filter:</label>
            <c-forms.select id="status-filter-{{ controls_catalog.id }}" size="sm" x-model="statusFilter">
            <option value="all">All statuses</option>
            <option value="compliant">Compliant</option>
            <option value="partial">Partial</option>
            <option value="not_implemented">Not Implemented</option>
            <option value="not_applicable">Not Applicable</option>
            </c-forms.select>
        </div>
    </div>
</div>
</c-slot>
{% comment %}
    expandedGroups is the card's own state, declared on the root above: the
    trigger and the panel are siblings inside an accordion item, so the flag
    they share has to live over the whole rail.
{% endcomment %}
<c-navigation.accordion density="sm">
{% for category in controls_categories %}
    <c-navigation.accordion-item state="expandedGroups['{{ category.name|escapejs }}']" label_class="flex flex-1 items-center justify-between gap-4 mr-4" @click="expandedGroups['{{ category.name|escapejs }}'] = !expandedGroups['{{ category.name|escapejs }}']">
    {# Category Header #}
    <c-slot name="label">
    <span class="flex items-center gap-3 min-w-0">
        <c-chips.icon-chip size="sm">
        <i class="fas {{ category.icon }}" aria-hidden="true"></i>
        </c-chips.icon-chip>
        <span class="font-medium text-text truncate">{{ category.name }}</span>
        <span class="text-text-muted text-sm flex-shrink-0">({{ category.controls|length }})</span>
    </span>
    <span class="flex items-center gap-4 flex-shrink-0">
        {# The rail owns the width; the bar fills it, so no two width utilities land on the track. #}
        <span class="w-24 hidden sm:block">
            {# djlint:off #}
                <c-progress :value="category.percentage" variant="{% if category.percentage >= 80 %}success{% elif category.percentage >= 50 %}warning{% else %}danger{% endif %}" />
            {# djlint:on #}
        </span>
        <span class="text-sm text-text-muted w-10 text-right">{{ category.percentage|floatformat:0 }}%</span>
    </span>
    </c-slot>
    {# Bulk Actions Bar #}
    <div class="flex flex-wrap items-center gap-2 py-2 text-xs">
        <span class="text-text-muted mr-1">Set all to:</span>
        {% for bulk_status, bulk_label in bulk_statuses %}
            <form method="post"
                  action="{% url 'controls:bulk_category_update' team.key %}"
                  onclick="return confirm('Set all {{ category.name|escapejs }} controls to {{ bulk_label|escapejs }}?')"
                  class="inline">
                {% csrf_token %}
                <input type="hidden" name="category" value="{{ category.name }}">
                <input type="hidden" name="catalog_id" value="{{ controls_catalog.id }}">
                <input type="hidden" name="status" value="{{ bulk_status }}">
                {% comment %}
                        Compliant reads green, which the old markup got by
                        overriding --btn-accent on the primary outline. The
                        variant carries it now, so the page states no colour.
                {% endcomment %}
                {% if bulk_status == 'compliant' %}
                    <c-buttons.outline-success type="submit" size="sm">{{ bulk_label }}</c-buttons.outline-success>
                {% elif bulk_status == 'partial' %}
                    <c-buttons.outline-warning type="submit" size="sm">{{ bulk_label }}</c-buttons.outline-warning>
                {% else %}
                    <c-buttons.outline type="submit" size="sm">{{ bulk_label }}</c-buttons.outline>
                {% endif %}
            </form>
        {% endfor %}
    </div>
    <div class="border-t border-border/50">
        {% for control in category.controls %}
            <div class="py-3 flex items-center gap-4 hover:bg-background/50 transition-colors border-b border-border/30 last:border-b-0"
                 x-show="statusFilter === 'all' || statusFilter === '{{ control.status }}'">
                <c-code-inline accent="primary" class="flex-shrink-0">{{ control.control_id }}</c-code-inline>
                <span class="text-sm text-text flex-1 min-w-0 truncate"
                      title="{{ control.title }}">{{ control.title }}</span>
                <form method="post"
                      action="{% url 'controls:status_update' team.key %}"
                      class="flex-shrink-0">
                    {% csrf_token %}
                    <input type="hidden" name="control_id" value="{{ control.id }}">
                    <input type="hidden" name="active_tab" value="controls">
                    {# djlint:off #}
                        <c-forms.select name="status" size="sm" accent="{% if control.status == 'compliant' %}success{% elif control.status == 'partial' %}warning{% elif control.status == 'not_implemented' %}danger{% endif %}" @change="$el.form.requestSubmit()">
                    {# djlint:on #}
                    <option value="compliant"
                            {% if control.status == "compliant" %}selected{% endif %}>Compliant</option>
                    <option value="partial"
                            {% if control.status == "partial" %}selected{% endif %}>Partial</option>
                    <option value="not_implemented"
                            {% if control.status == "not_implemented" %}selected{% endif %}>Not Implemented</option>
                    <option value="not_applicable"
                            {% if control.status == "not_applicable" %}selected{% endif %}>Not Applicable</option>
                    </c-forms.select>
                </form>
            </div>
        {% endfor %}
    </div>
    </c-navigation.accordion-item>
{% endfor %}
</c-navigation.accordion>
</c-cards.dashboard>
