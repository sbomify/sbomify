{% comment %}One control table for workspace defaults and product overrides. The caller supplies its context and the parent owns spacing.{% endcomment %}
<c-cards.card flush id="controls-table-{{ controls.catalog.id }}" x-data="{ statusFilter: 'all', expandedGroups: {} }">
<c-tables.toolbar>
<c-layout.section-header title="{{ controls.catalog.name }}" subtitle="{{ controls.total }} control{{ controls.total|pluralize }}" level="3" />
<c-slot name="right">
{% if not controls.product %}
    <c-actions-menu label="Export {{ controls.catalog.name }}" caption="Export" icon="fas fa-download">
    <c-dropdowns.item href="{% url 'api-1:export_csv' controls.catalog.id %}" icon="fas fa-file-csv">Controls CSV</c-dropdowns.item>
    <c-dropdowns.item href="{% url 'api-1:export_summary_csv' controls.catalog.id %}" icon="fas fa-chart-bar">Summary CSV</c-dropdowns.item>
    </c-actions-menu>
{% endif %}
<c-forms.select size="sm" id="status-filter-{{ controls.catalog.id }}" aria-label="Filter {{ controls.catalog.name }} by status" x-model="statusFilter">
<option value="all">All statuses</option>
{% for value, label in controls.statuses %}<option value="{{ value }}">{{ label }}</option>{% endfor %}
</c-forms.select>
</c-slot>
</c-tables.toolbar>
<c-navigation.accordion density="sm">
{% for category in controls.categories %}
    <c-navigation.accordion-item state="expandedGroups['{{ category.name|escapejs }}']" label="{{ category.name }} ({{ category.controls|length }})" @click="expandedGroups['{{ category.name|escapejs }}'] = !expandedGroups['{{ category.name|escapejs }}']">
    <div class="flex flex-col gap-3">
        <c-progress :value="category.percentage" />
        {% if controls.can_edit and not controls.product %}
            <div class="flex flex-wrap items-center gap-2">
                <c-forms.hint>Set this category to:</c-forms.hint>
                {% for value, label in controls.statuses %}
                    <form hx-post="{{ controls.bulk_url }}"
                          hx-target="#controls-table-{{ controls.catalog.id }}"
                          hx-swap="morph"
                          hx-confirm="Set every control in {{ category.name }} to {{ label }}?"
                          hx-disabled-elt="find button">
                        {% csrf_token %}
                        <input type="hidden" name="category" value="{{ category.name }}">
                        <input type="hidden" name="catalog_id" value="{{ controls.catalog.id }}">
                        <input type="hidden" name="status" value="{{ value }}">
                        <c-buttons.secondary size="sm" type="submit">{{ label }}</c-buttons.secondary>
                    </form>
                {% endfor %}
            </div>
        {% endif %}
        <c-tables.shell nested>
        <c-tables.table>
        <c-tables.head>
        <c-tables.header-cell>Control</c-tables.header-cell>
        <c-tables.header-cell>Description</c-tables.header-cell>
        {% if controls.product %}<c-tables.header-cell>Source</c-tables.header-cell>{% endif %}
        <c-tables.header-cell>Status</c-tables.header-cell>
        </c-tables.head>
        <tbody>
            {% for control in category.controls %}
                <c-tables.row x-show="statusFilter === 'all' || statusFilter === '{{ control.status }}'">
                <c-tables.cell nowrap><c-code-inline>{{ control.control_id }}</c-code-inline></c-tables.cell>
                <c-tables.cell>{{ control.title }}</c-tables.cell>
                {% if controls.product %}
                    <c-tables.cell nowrap>
                    {% if control.is_product_specific %}
                        <c-badges.primary>Product override</c-badges.primary>
                    {% else %}
                        <c-badges.secondary>Workspace default</c-badges.secondary>
                    {% endif %}
                    </c-tables.cell>
                {% endif %}
                <c-tables.cell nowrap>
                {% if controls.can_edit %}
                    <form hx-post="{{ controls.status_url }}"
                          hx-target="#controls-table-{{ controls.catalog.id }}"
                          hx-swap="morph"
                          hx-disabled-elt="find select">
                        {% csrf_token %}
                        <input type="hidden" name="control_id" value="{{ control.id }}">
                        <c-forms.select name="status" size="sm" aria-label="Status for {{ control.control_id }}" @change="$el.form.requestSubmit()">
                        {% for value, label in controls.statuses %}
                            <option value="{{ value }}"
                                    {% if control.status == value %}selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                        </c-forms.select>
                    </form>
                {% else %}
                    {% for value, label in controls.statuses %}
                        {% if control.status == value %}<c-badges.secondary>{{ label }}</c-badges.secondary>{% endif %}
                    {% endfor %}
                {% endif %}
                </c-tables.cell>
                </c-tables.row>
            {% endfor %}
        </tbody>
        </c-tables.table>
        </c-tables.shell>
    </div>
    </c-navigation.accordion-item>
{% endfor %}
</c-navigation.accordion>
</c-cards.card>
