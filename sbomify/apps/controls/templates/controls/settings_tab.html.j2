{# Catalog Activation Card #}
<c-cards.dashboard class="mb-6">
<c-slot name="header">
<div class="px-6 py-4 border-b border-border">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            {# djlint:off #}
            <c-chips.icon-chip accent="{% if not active_catalogs %}neutral{% endif %}">
            {# djlint:on #}
            <i class="fas fa-list-check" aria-hidden="true"></i>
            </c-chips.icon-chip>
            <div>
                <h5 class="text-lg font-semibold text-text m-0">Compliance Frameworks</h5>
                <p class="text-text-muted text-sm m-0">Select frameworks to track on your Trust Center</p>
            </div>
        </div>
        {% if active_catalogs %}<c-badges.primary>{{ active_catalogs|length }} active</c-badges.primary>{% endif %}
    </div>
</div>
</c-slot>
{% if not active_catalogs %}
    <c-feedback.alert class="mb-4">Activate one or more frameworks to track compliance controls and display status on your Trust Center.</c-feedback.alert>
{% endif %}
{% comment %}
        The framework tiles stay hand-rolled: a submit button that reads as a
        card, whose whole face flips to "Deactivate" on hover, is this page's
        own pattern and nothing in the library is shaped like it.
{% endcomment %}
<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5">
    {% for catalog_key, catalog_name, catalog_label, catalog_icon in available_catalogs %}
        {% if catalog_name in active_catalog_names %}
            <form method="post" action="{% url 'controls:catalog_action' team.key %}">
                {% csrf_token %}
                <input type="hidden" name="controls_catalog_action" value="deactivate">
                {% for ac in active_catalogs %}
                    {% if ac.catalog.name == catalog_name %}<input type="hidden" name="catalog_id" value="{{ ac.catalog.id }}">{% endif %}
                {% endfor %}
                <input type="hidden" name="active_tab" value="controls">
                <button type="submit"
                        class="w-full flex flex-col items-center gap-1.5 px-3 py-3 rounded-xl border border-success/40 bg-success/5 hover:bg-danger/5 hover:border-danger/40 transition-all cursor-pointer shadow-sm group">
                    <div class="w-9 h-9 rounded-full bg-success/15 flex items-center justify-center">
                        <i class="fas {{ catalog_icon }} text-success text-sm"></i>
                    </div>
                    <span class="text-xs font-semibold text-text text-center leading-tight">{{ catalog_label }}</span>
                    <span class="text-[10px] font-medium text-success group-hover:hidden">Active</span>
                    <span class="text-[10px] font-medium text-danger hidden group-hover:block">Deactivate</span>
                </button>
            </form>
        {% else %}
            <form method="post" action="{% url 'controls:catalog_action' team.key %}">
                {% csrf_token %}
                <input type="hidden" name="controls_catalog_action" value="activate">
                <input type="hidden" name="catalog_name" value="{{ catalog_key }}">
                <input type="hidden" name="active_tab" value="controls">
                <button type="submit"
                        class="w-full flex flex-col items-center gap-1.5 px-3 py-3 rounded-xl border border-border/60 hover:border-primary hover:bg-primary/5 transition-all cursor-pointer">
                    <div class="w-9 h-9 rounded-full bg-border/30 flex items-center justify-center group-hover:bg-primary/10 transition-colors">
                        <i class="fas {{ catalog_icon }} text-text-muted text-sm"></i>
                    </div>
                    <span class="text-xs font-semibold text-text text-center leading-tight">{{ catalog_label }}</span>
                    <span class="text-[10px] text-text-muted">Activate</span>
                </button>
            </form>
        {% endif %}
    {% endfor %}
    {# Imported (custom) catalogs #}
    {% for ic in imported_catalogs %}
        {% if ic.name not in active_catalog_names %}
            <div x-data="{ showActions: false }"
                 @click.outside="showActions = false"
                 class="relative">
                <button type="button"
                        @click="showActions = !showActions"
                        class="w-full flex flex-col items-center gap-1.5 px-3 py-3 rounded-xl border border-border/60 hover:border-primary hover:bg-primary/5 transition-all cursor-pointer">
                    <div class="w-9 h-9 rounded-full bg-border/30 flex items-center justify-center">
                        <i class="fas fa-file-import text-text-muted text-sm"></i>
                    </div>
                    <span class="text-xs font-semibold text-text text-center leading-tight truncate w-full"
                          title="{{ ic.name }}">{{ ic.name|truncatechars:20 }}</span>
                    <span class="text-[10px] text-primary">Imported</span>
                </button>
                <c-dropdowns.dropdown class="top-full left-0 mt-1" aria-label="Catalog actions" x-show="showActions" x-cloak x-transition>
                {% if not ic.is_active %}
                    <form method="post" action="{% url 'controls:catalog_action' team.key %}">
                        {% csrf_token %}
                        <input type="hidden" name="controls_catalog_action" value="activate">
                        <input type="hidden" name="catalog_name" value="__custom__">
                        <input type="hidden" name="catalog_id" value="{{ ic.id }}">
                        <input type="hidden" name="active_tab" value="controls">
                        <c-dropdowns.item type="submit" icon="fas fa-check">Activate</c-dropdowns.item>
                    </form>
                {% endif %}
                <c-dropdowns.item-danger icon="fas fa-trash" @click="showActions = false; $dispatch('open-delete-catalog-modal', { displayName: '{{ ic.name|escapejs }}', formData: { controls_catalog_action: 'delete', catalog_id: '{{ ic.id }}', active_tab: 'controls' } })">
                Delete
                </c-dropdowns.item-danger>
                </c-dropdowns.dropdown>
            </div>
        {% else %}
            {# Active imported catalog — show with imported badge #}
            <form method="post"
                  action="{% url 'controls:catalog_action' team.key %}"
                  x-data
                  class="relative group">
                {% csrf_token %}
                <input type="hidden" name="controls_catalog_action" value="deactivate">
                <input type="hidden" name="catalog_id" value="{{ ic.id }}">
                <input type="hidden" name="active_tab" value="controls">
                <button type="submit"
                        class="w-full flex flex-col items-center gap-1.5 px-3 py-3 rounded-xl border border-success/40 bg-success/5 hover:bg-danger/5 hover:border-danger/40 transition-all cursor-pointer shadow-sm">
                    <div class="w-9 h-9 rounded-full bg-success/15 flex items-center justify-center">
                        <i class="fas fa-file-import text-success text-sm"></i>
                    </div>
                    <span class="text-xs font-semibold text-text text-center leading-tight truncate w-full"
                          title="{{ ic.name }}">{{ ic.name|truncatechars:20 }}</span>
                    <span class="text-[10px] font-medium text-success group-hover:hidden">Imported</span>
                    <span class="text-[10px] font-medium text-danger hidden group-hover:block">Deactivate</span>
                </button>
            </form>
        {% endif %}
    {% endfor %}
    {# OSCAL Import Card #}
    <div x-data="{ showImport: false, importing: false, error: '', fileName: '', importMode: 'file', oscalUrl: '' }">
        <button type="button"
                @click="showImport = true"
                class="w-full flex flex-col items-center gap-1.5 px-3 py-3 rounded-xl border border-dashed border-border/60 hover:border-primary hover:bg-primary/5 transition-all cursor-pointer">
            <div class="w-9 h-9 rounded-full bg-border/30 flex items-center justify-center">
                <i class="fas fa-file-import text-text-muted text-sm"></i>
            </div>
            <span class="text-xs font-semibold text-text text-center leading-tight">Import</span>
            <span class="text-[10px] text-primary">OSCAL JSON</span>
        </button>
        {# Import Modal #}
        <c-modal id="oscal-import" show="showImport" title="Import OSCAL Catalog" icon="fas fa-file-import">
        <p class="text-sm text-text-muted mb-4">
            Import a compliance catalog in <a href="https://pages.nist.gov/OSCAL/"
    target="_blank"
    rel="noopener noreferrer"
    class="text-primary hover:underline">OSCAL</a> JSON format via file upload or URL.
        </p>
        {# Tab toggle #}
        <div class="flex gap-1 mb-4 p-0.5 rounded-lg bg-border/30">
            <button type="button"
                    class="flex-1 text-sm py-2 rounded-md transition-colors"
                    :class="importMode === 'file' ? 'bg-card shadow-sm text-text font-medium' : 'text-text-muted hover:text-text'"
                    @click="importMode = 'file'">
                <i class="fas fa-upload mr-1.5"></i>Upload File
            </button>
            <button type="button"
                    class="flex-1 text-sm py-2 rounded-md transition-colors"
                    :class="importMode === 'url' ? 'bg-card shadow-sm text-text font-medium' : 'text-text-muted hover:text-text'"
                    @click="importMode = 'url'">
                <i class="fas fa-link mr-1.5"></i>From URL
            </button>
        </div>
        {# File input #}
        <div x-show="importMode === 'file'">
            <c-forms.label>OSCAL JSON File</c-forms.label>
            <c-forms.input type="file" accept=".json" @change="fileName = $el.files[0]?.name || ''" x-ref="oscalFile" />
            <c-forms.hint>Accepts .json files in OSCAL catalog format.</c-forms.hint>
        </div>
        {# URL input #}
        <div x-show="importMode === 'url'">
            <c-forms.label>Catalog URL</c-forms.label>
            <c-forms.input type="url" placeholder="https://raw.githubusercontent.com/.../catalog.json" x-model="oscalUrl" />
            <c-forms.hint>Direct link to an OSCAL catalog JSON file (e.g., from NIST GitHub).</c-forms.hint>
        </div>
        <template x-if="error">
            <c-feedback.alert variant="danger" icon="fas fa-circle-exclamation" class="mt-3">
            <c-slot name="body">
            <p class="text-sm m-0" x-text="error"></p>
            </c-slot>
            </c-feedback.alert>
        </template>
        <c-slot name="footer">
        <c-buttons.outline-primary @click="showImport = false; error = ''; oscalUrl = ''">Cancel</c-buttons.outline-primary>
        <c-buttons.primary ::disabled="importing || (importMode === 'file' && !fileName) || (importMode === 'url' && !oscalUrl)" @click=" importing = true; error = ''; const csrfToken = document.querySelector('[name=csrfmiddlewaretoken]').value; const doImport = (body) => { return fetch('/api/v1/controls/catalogs/import-oscal/', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrfToken }, body: body }).then(r => r.json().then(d => ({ok: r.ok, data: d}))).then(({ok, data}) => { importing = false; if (ok) { window.location.reload(); } else { error = data.detail || 'Import failed'; } }); }; if (importMode === 'file') { const file = $refs.oscalFile.files[0]; if (!file) { error = 'Select a file'; importing = false; return; } file.text().then(text => doImport(text)).catch(e => { importing = false; error = e.message; }); } else { fetch(oscalUrl).then(r => { if (!r.ok) throw new Error('Failed to fetch URL: ' + r.status); return r.text(); }).then(text => doImport(text)).catch(e => { importing = false; error = e.message; }); } ">
        <span x-show="!importing">Import Catalog</span>
        <span x-show="importing">
            {% include "core/components/brand/loader.html.j2" with class="tw-loader-inline mr-1.5" %}
        Importing...</span>
        </c-buttons.primary>
        </c-slot>
        </c-modal>
    </div>
</div>
</c-cards.dashboard>
{# Delete Catalog Confirmation Modal — inline because the include template breaks Alpine event attributes #}
<div id="delete-catalog-modal"
     x-data="{ open: false, displayName: '', formData: {}, openModal(event) { this.open = true; if (event.detail) { this.displayName = event.detail.displayName || ''; this.formData = event.detail.formData || {}; } }, close() { this.open = false; this.displayName = ''; this.formData = {}; } }"
     @open-delete-catalog-modal.window="openModal($event)">
    <c-modal show="open" close="close()" size="sm" role="alertdialog" aria-labelledby="deleteCatalogModalLabel">
    <div class="relative text-center">
        <c-buttons.icon label="Close" class="absolute -top-2 -right-2" @click="close()">
        <i class="fas fa-times" aria-hidden="true"></i>
        </c-buttons.icon>
        <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-danger/10 flex items-center justify-center">
            <i class="fas fa-exclamation-triangle text-danger text-xl"
               aria-hidden="true"></i>
        </div>
        <h4 id="deleteCatalogModalLabel"
            class="text-lg font-semibold text-text tracking-[-0.01em] mb-2">Delete Catalog</h4>
        <p class="text-sm text-text mb-2">
            Are you sure you want to delete <span class="font-semibold text-danger" x-text="displayName"></span>?
        </p>
        <p class="text-xs text-text-muted">
            This will permanently remove the catalog and all its controls, statuses, and evidence. This action cannot be undone.
        </p>
    </div>
    <c-slot name="footer">
    {# The footer band ends its row; this fills it so the two actions sit centred, as they did. #}
    <div class="flex flex-1 items-center justify-center gap-3">
        <c-buttons.ghost @click="close()">Cancel</c-buttons.ghost>
        <form method="post"
              action="{% url 'controls:catalog_action' team.key %}"
              class="inline">
            {% csrf_token %}
            <template x-for="(value, key) in formData" :key="key">
                <input type="hidden" :name="key" :value="value">
            </template>
            <c-buttons.danger type="submit">
            <i class="fas fa-trash mr-2"></i>Delete Catalog
            </c-buttons.danger>
        </form>
    </div>
    </c-slot>
    </c-modal>
</div>
{# Controls Tables — one per active catalog #}
{% for catalog_data in active_catalogs %}
    {% with controls_catalog=catalog_data.catalog controls_categories=catalog_data.categories controls_total_count=catalog_data.total_count catalog_icon=catalog_data.icon %}
        {% include "controls/controls_table.html.j2" %}
    {% endwith %}
{% endfor %}
