<c-layout.frame>
<c-layout.section-header title="Compliance controls" subtitle="Choose frameworks and set the defaults your products inherit." />
<c-tables.shell x-data="{ deleteCatalog: null }">
<c-tables.toolbar>
<c-forms.hint>Active frameworks appear on your Trust Center.</c-forms.hint>
<c-slot name="right">
<c-buttons.secondary size="sm" @click="$dispatch('open-catalog-import')"><i class="fas fa-file-import" aria-hidden="true"></i>Import catalog</c-buttons.secondary>
</c-slot>
</c-tables.toolbar>
<c-tables.table>
<c-tables.head>
<c-tables.header-cell>Framework</c-tables.header-cell>
<c-tables.header-cell>Status</c-tables.header-cell>
<c-tables.actions-cell as="th" label="Actions" />
</c-tables.head>
<tbody>
    {% for framework in frameworks %}
        <c-tables.row>
        <c-tables.cell>
        {{ framework.name }}
        {% if framework.catalog.source == 'custom' %}<c-badges.secondary>Imported</c-badges.secondary>{% endif %}
        </c-tables.cell>
        <c-tables.cell>
        {% if framework.catalog.is_active %}
            <c-badges.success>Active</c-badges.success>
        {% else %}
            <c-badges.secondary>Inactive</c-badges.secondary>
        {% endif %}
        </c-tables.cell>
        <c-tables.actions-cell>
        <div class="flex items-center justify-end gap-2">
            <form method="post" action="{% url 'controls:catalog_action' team.key %}">
                {% csrf_token %}
                <input type="hidden" name="catalog_name" value="{{ framework.key }}">
                <input type="hidden" name="catalog_id" value="{{ framework.catalog.id }}">
                {% if framework.catalog.is_active %}
                    <input type="hidden" name="controls_catalog_action" value="deactivate">
                    <c-buttons.secondary size="sm" type="submit" aria-label="Deactivate {{ framework.name }}">Deactivate</c-buttons.secondary>
                {% else %}
                    <input type="hidden" name="controls_catalog_action" value="activate">
                    <c-buttons.secondary size="sm" type="submit" aria-label="Activate {{ framework.name }}">Activate</c-buttons.secondary>
                {% endif %}
            </form>
            {% if framework.catalog.source == 'custom' %}
                <c-buttons.icon label="Delete {{ framework.name }}" @click="deleteCatalog = { id: '{{ framework.catalog.id|escapejs }}', name: '{{ framework.name|escapejs }}' }"><i class="fas fa-trash" aria-hidden="true"></i></c-buttons.icon>
            {% endif %}
        </div>
        </c-tables.actions-cell>
        </c-tables.row>
    {% endfor %}
</tbody>
</c-tables.table>
<c-modal teleport="false" id="delete-catalog" title="Delete catalog" show="deleteCatalog !== null" close="deleteCatalog = null" role="alertdialog">
<c-feedback.alert variant="warning">Delete <span x-text="deleteCatalog?.name"></span> and its controls, statuses and evidence? This cannot be undone.</c-feedback.alert>
<c-slot name="footer">
<c-buttons.ghost @click="deleteCatalog = null">Cancel</c-buttons.ghost>
<form method="post" action="{% url 'controls:catalog_action' team.key %}">
    {% csrf_token %}
    <input type="hidden" name="controls_catalog_action" value="delete">
    <input type="hidden" name="catalog_id" :value="deleteCatalog?.id">
    <c-buttons.danger type="submit">Delete catalog</c-buttons.danger>
</form>
</c-slot>
</c-modal>
</c-tables.shell>
{% include 'controls/components/catalog_import.html.j2' %}
{% for controls in active_controls_tables %}
    {% include 'controls/controls_table.html.j2' %}
{% endfor %}
</c-layout.frame>
