{% load static %}
<div x-cloak x-data="dangerZone()">
    <c-cards.dangerzone-collapsible>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-start gap-3">
            <c-chips.icon-chip accent="danger">
            <i class="fas fa-trash-alt" aria-hidden="true"></i>
            </c-chips.icon-chip>
            <div>
                <h6 class="font-semibold text-text m-0">Delete Release</h6>
                <p class="text-text-muted text-sm m-0 mt-1">Permanently remove this release and all associated data</p>
            </div>
        </div>
        <c-buttons.danger id="del_{{ release_id }}" @click="showDeleteModal = true" aria-label="Delete release {{ release_name }}">
        <i class="fas fa-trash-alt" aria-hidden="true"></i>
        Delete Release
        </c-buttons.danger>
    </div>
    </c-cards.dangerzone-collapsible>
    {% include 'components/delete_confirmation_modal.html.j2' with modal_id='showDeleteModal' title='Delete Release' message='Are you sure you want to delete the release' item_name=release_name warning_message='This action cannot be undone and will permanently remove the release from the system.' confirm_text='Delete Release' hx_url='/api/v1/releases/'|add:release_id hx_method='delete' success_message='Release deleted successfully!' redirect_url='/releases/' %}
</div>
