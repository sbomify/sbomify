{% extends "core/public_base.htmx.j2" %}
{% load static %}
{% block title %}Access Denied{% endblock %}
{% block content %}
    <div class="public-section">
        <c-cards.card>
        {% comment %} The card body pads by 6; the extra 6 here is the deeper top and bottom
        the panel has always had. {% endcomment %}
        <div class="text-center py-6">
            <div class="mb-6">
                <i class="fas fa-lock text-5xl text-warning mb-[1rem]"></i>
                {% comment %}
                    mb-[0.75rem]! and not mb-3: .mb-3 in the legacy
                    static/css/utilities.css is !important at 1rem, so the plain
                    utility would not be the measurement that lands here. The !
                    is for a second rule in the same stack: static/css/base.css
                    styles h1..h6 unlayered, and an unlayered declaration beats
                    every layered Tailwind utility, so without it this heading
                    takes base.css's 0.5rem rather than the app's 0.75rem.
                {% endcomment %}
                <h2 class="text-2xl font-bold text-text mb-[0.75rem]!">Access Denied</h2>
                <p class="text-text-muted mb-6">{{ error_message }}</p>
            </div>
            <div class="flex flex-col sm:flex-row justify-center gap-3">
                {% comment %}
                Not every denial is "go and ask": a request already under review
                has no action to offer, and an unsigned NDA is a different one.
                Callers that pass neither label nor icon keep the request-access
                button this page has always shown.

                Secondary, not primary: this page renders on a workspace's own
                Trust Center, and a filled library button hardcodes white text
                over whatever accent the workspace picked. Neutral is the only
                variant that stays readable on a pale one.
                {% endcomment %}
                {% if request_access_url %}
                    <c-buttons.secondary href="{{ request_access_url }}">
                    <i class="fas {{ action_icon|default:"fa-key" }} mr-2"></i>{{ action_label|default:"Request Access" }}
                    </c-buttons.secondary>
                {% endif %}
                {% if back_url %}
                    <c-buttons.secondary href="{{ back_url }}" onclick="if (window.history.length > 1) { window.history.back(); return false; }">
                    <i class="fas fa-arrow-left mr-2"></i>Go Back
                    </c-buttons.secondary>
                {% endif %}
            </div>
        </div>
        </c-cards.card>
    </div>
{% endblock %}
