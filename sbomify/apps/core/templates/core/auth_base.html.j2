{% extends "core/base.html.j2" %}
{% load static %}
{% block main %}
    <!-- Login layout -->
    <div class="bg-background min-h-screen flex items-center">
        <div class="container mx-auto px-4">
            <div class="flex justify-center">
                <div class="w-full max-w-sm">
                    <div class="flex items-center justify-center mb-6">
                        {% include "core/components/brand/logo.html.j2" with class="h-8 w-auto text-text" animate=True label="sbomify" %}
                    </div>
                    <div class="messages-container">{% include "core/components/messages.html.j2" %}</div>
                    <c-cards.card>
                    {% block login_content %}{% endblock %}
                    </c-cards.card>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
