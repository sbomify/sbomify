{% extends "core/dashboard_base.htmx.j2" %}
{% load humanize %}
{% load widget_tweaks %}
{% load static %}
{% load django_vite %}
{% load public_url_tags %}
{% block title %}sbomify Component: {{ component.name }}{% endblock %}
{% block content %}
    {% url 'core:component_details_public' component.id as component_public_url %}
    {% url 'core:components_dashboard' as components_url %}
    {% comment %}The header follows edits made elsewhere, and leaves for the component list once the component is deleted.{% endcomment %}
    {% comment %}The visibility state lives on the header because only its menu items read it. The freshness badge goes in the header's meta slot, beside the title.{% endcomment %}
    <c-layout.page-header title="{{ component.name }}" subtitle="{{ component.component_type_display }} Component" editable_item_type="{{ component.has_crud_permissions|yesno:'component,' }}" editable_item_id="{{ component.id }}" :copy_values="header_copy_values" id="component-header" x-data="{ ...publicSharing('{{ component_public_url|escapejs }}'), ...liveRegion({ refresh: ['component_updated', 'sbom_uploaded'], remove: ['component_deleted'], key: 'component_id', id: '{{ component.id|escapejs }}', leaveTo: '{{ components_url|escapejs }}' }), visibility: '{{ component.visibility|escapejs }}' }" hx-get="{{ request.get_full_path }}" hx-select="#component-header" hx-trigger="live-refresh" hx-swap="morph" hx-disinherit="*" @public-status-changed.window="if ($event.detail.itemId === '{{ component.id|escapejs }}') visibility = $event.detail.visibility">
    {% comment %}Absent unless the workspace configures a window and the component has an SBOM, so an unconfigured workspace sees no badge.{% endcomment %}
    {% if component.freshness.is_stale %}
        <c-slot name="meta">
        <c-badges.danger title="SBOM is {{ component.freshness.expires_in_days|stringformat:'d'|cut:'-' }} days past the {{ component.freshness.window_days }}-day freshness window">
        <i class="fas fa-hourglass-end mr-1" aria-hidden="true"></i>Stale
        </c-badges.danger>
        </c-slot>
    {% endif %}
    {# Visibility Toggle + meatball menu. The menu renders for every member (metadata is a read surface); write actions inside stay CRUD-gated. #}
    {% if component.has_crud_permissions or component.component_type == 'bom' %}
        <div class="flex items-stretch gap-2">
            {% comment %}ADMINISTER, not MANAGE: a member maintains a component but does
            not decide the world can see it, so do not offer the control.{% endcomment %}
            {% if can_administer %}
                <c-forms.visibility-selector item_id="{{ component.id }}" visibility="{{ component.visibility }}" :gated_allowed="gated_visibility_allowed" />
            {% endif %}
            {# Meatball menu — moves secondary surfaces off the page body (design review p8/p9): upload, metadata, CI/CD integration, trusted publishers all open from here. #}
            <c-actions-menu label="Component actions" stretch>
            {% if component.has_crud_permissions %}
                {% block meatball_artifacts %}
                    <c-dropdowns.header>Artifacts</c-dropdowns.header>
                    {% comment %}One item per type the uploader takes, each opening it with that type selected. A document component takes documents only.{% endcomment %}
                    {% if component.component_type == 'bom' %}
                        <c-dropdowns.item icon="fas fa-file-code" @click="$dispatch('open-upload', { bomType: 'sbom' })">Upload SBOM…</c-dropdowns.item>
                        <c-dropdowns.item icon="fas fa-key" @click="$dispatch('open-upload', { bomType: 'cbom' })">Upload CBOM…</c-dropdowns.item>
                        <c-dropdowns.item icon="fas fa-file-shield" @click="$dispatch('open-upload', { bomType: 'vex' })">Upload VEX…</c-dropdowns.item>
                    {% else %}
                        <c-dropdowns.item icon="fas fa-upload" @click="$dispatch('open-upload')">Upload document…</c-dropdowns.item>
                    {% endif %}
                    <c-dropdowns.divider />
                {% endblock %}
            {% endif %}
            <c-dropdowns.header>Component</c-dropdowns.header>
            {% if component.component_type == 'bom' %}
                <c-dropdowns.item icon="fas fa-address-card" @click="$dispatch('open-metadata')">Metadata…</c-dropdowns.item>
            {% endif %}
            {% if component.has_crud_permissions %}
                {% if component.component_type == 'bom' %}
                    <c-dropdowns.item icon="fas fa-gears" @click="$dispatch('open-cicd')">CI/CD integration…</c-dropdowns.item>
                {% endif %}
                {% comment %}ADMINISTER: a trusted-publisher binding is a standing publish
                grant to an external repo, so members must not be offered it.{% endcomment %}
                {% if can_administer %}
                    <c-dropdowns.item icon="fas fa-shield-halved" @click="$dispatch('open-trusted-publishers')">Trusted publishers…</c-dropdowns.item>
                {% endif %}
                {# Public-only actions; visibility is reactive so these appear/disappear the moment it changes, no reload. #}
                <c-dropdowns.item icon="fas fa-link" x-show="visibility === 'public' || visibility === 'gated'" @click="copyToClipboard()">Copy public URL</c-dropdowns.item>
                <c-dropdowns.item icon="fas fa-certificate" x-show="visibility === 'public' || visibility === 'gated'" @click="copyBadgeToClipboard()">Copy badge</c-dropdowns.item>
            {% endif %}
            </c-actions-menu>
        </div>
    {% endif %}
    </c-layout.page-header>
    <c-layout.frame>
    {# Stats Badges #}
    <div class="flex flex-wrap gap-2">
        <c-chips.metric-chip>
        <i class="fas fa-{% if component.component_type == 'bom' %}file-code{% elif component.component_type == 'tea_subscription' %}satellite-dish{% else %}file-alt{% endif %} text-primary text-xs"
           aria-hidden="true"></i>
        <c-chips.metric.value>
        {% if component.component_type == 'bom' %}
            {{ component.sbom_count|default:0|intcomma }}
        {% elif component.component_type == 'tea_subscription' %}
            {{ subscription.releases|length|intcomma }}
        {% else %}
            {{ component.document_count|default:0|intcomma }}
        {% endif %}
        </c-chips.metric.value>
        <c-chips.metric.label>
        {% if component.component_type == 'bom' %}
            BOMs
        {% elif component.component_type == 'tea_subscription' %}
            Upstream releases
        {% else %}
            Documents
        {% endif %}
        </c-chips.metric.label>
        </c-chips.metric-chip>
        <c-chips.metric-chip>
        <span class="inline-flex items-center gap-1 {% if component.is_global %}text-primary{% else %}text-text-muted{% endif %}">
            <i class="fas fa-{% if component.is_global %}building{% else %}cube{% endif %} text-xs"></i>
            <span>
                {% if component.is_global %}
                    Workspace-wide
                {% else %}
                    Product-scoped
                {% endif %}
            </span>
        </span>
        </c-chips.metric-chip>
        {% comment %}
        Latest-scan vulnerability summary, as two chips. The first says what is
        open, in the severity it carries. What a VEX cleared goes in a neutral
        chip of its own: inside the red one it read as one more alarming figure,
        and "1 Critical · 2 High · 1 suppressed" left the reader asking whether
        the critical was the one suppressed. Counts here exclude what VEX
        cleared, matching the Trust Center posture; the suppressed chip says so
        rather than letting the numbers silently shrink.
        {% endcomment %}
        {% if vuln_summary.critical or vuln_summary.high or vuln_summary.medium or vuln_summary.low %}
            {% comment %}The accent is settled first: a prop written as an inline {% if %} is one djlint reformat away from arriving with newlines in it, and a padded value matches no branch in the component.{% endcomment %}
            {% if vuln_summary.critical or vuln_summary.high %}
                {% firstof "danger" as vuln_chip_accent %}
            {% else %}
                {% firstof "warning" as vuln_chip_accent %}
            {% endif %}
            <c-chips.metric-chip accent="{{ vuln_chip_accent }}" data-testid="vuln-open-chip">
            <i class="fas fa-triangle-exclamation text-xs" aria-hidden="true"></i>
            {% if vuln_summary.critical %}
                <c-chips.metric.value>{{ vuln_summary.critical|intcomma }} Critical</c-chips.metric.value>
            {% endif %}
            {% if vuln_summary.high %}
                {% if vuln_summary.critical %}<span class="text-text-muted">·</span>{% endif %}
                <c-chips.metric.value>{{ vuln_summary.high|intcomma }} High</c-chips.metric.value>
            {% endif %}
            {% if vuln_summary.medium %}
                {% if vuln_summary.critical or vuln_summary.high %}<span class="text-text-muted">·</span>{% endif %}
                <c-chips.metric.value>{{ vuln_summary.medium|intcomma }} Medium</c-chips.metric.value>
            {% endif %}
            {% if vuln_summary.low %}
                {% if vuln_summary.critical or vuln_summary.high or vuln_summary.medium %}
                    <span class="text-text-muted">·</span>
                {% endif %}
                <c-chips.metric.value>{{ vuln_summary.low|intcomma }} Low</c-chips.metric.value>
            {% endif %}
            <c-chips.metric.label>open in latest scan</c-chips.metric.label>
            </c-chips.metric-chip>
        {% elif vuln_summary.suppressed %}
            {# Everything the scan found was cleared by VEX: say that nothing is open, so the strip does not read as unscanned. #}
            <c-chips.metric-chip accent="success" data-testid="vuln-open-chip">
            <i class="fas fa-check text-xs" aria-hidden="true"></i>
            <c-chips.metric.value>None open</c-chips.metric.value>
            <c-chips.metric.label>in latest scan</c-chips.metric.label>
            </c-chips.metric-chip>
        {% endif %}
        {% if vuln_summary.suppressed %}
            {% comment %}"more" when an open chip sits beside it, so the two figures read as separate sets. Settled first for the same djlint reason as the accent.{% endcomment %}
            {% if vuln_summary.critical or vuln_summary.high or vuln_summary.medium or vuln_summary.low %}
                {% firstof "more suppressed by VEX" as vuln_suppressed_label %}
            {% else %}
                {% firstof "suppressed by VEX" as vuln_suppressed_label %}
            {% endif %}
            <c-chips.metric-chip data-testid="vuln-suppressed-chip" title="A VEX statement marks {{ vuln_summary.suppressed|pluralize:'this finding,these findings' }} as not affecting this component. Not included in the open count.">
            <i class="fas fa-shield-halved text-xs text-text-muted"
               aria-hidden="true"></i>
            <c-chips.metric.value>{{ vuln_summary.suppressed|intcomma }}</c-chips.metric.value>
            <c-chips.metric.label>{{ vuln_suppressed_label }}</c-chips.metric.label>
            </c-chips.metric-chip>
        {% endif %}
    </div>
    {% block header_after_meta %}{% endblock %}
    {% block content_after_header %}{% endblock %}
    {% block upload_section %}{% endblock %}
    {% block table_section %}{% endblock %}
    {# Danger Zone #}
    {% if can_delete_component %}
        <div>
            {% include 'components/component_danger_zone.html.j2' with component_id=component.id component_name=component.name can_delete=can_delete_component %}
        </div>
    {% endif %}
    </c-layout.frame>
{% endblock %}
{% block scripts %}
    {% block scripts_additional %}{% endblock %}
{% endblock %}
