{% extends "core/dashboard_base.htmx.j2" %}
{% load widget_tweaks %}
{% load static %}
{% load django_vite %}
{% load public_url_tags %}
{% block title %}sbomify Component: {{ component.name }}{% endblock %}
{% block content %}
    {% comment %}The visibility state lives on the header because only its menu items read it. The freshness badge goes in the header's meta slot, beside the title.{% endcomment %}
    <c-layout.page-header title="{{ component.name }}" subtitle="{{ component.component_type_display }} Component" icon="fas fa-puzzle-piece" mark="avatar" editable_item_type="{{ component.has_crud_permissions|yesno:'component,' }}" editable_item_id="{{ component.id }}" :copy_values="header_copy_values" x-data="{ visibility: '{{ component.visibility|escapejs }}' }" @public-status-changed.window="if ($event.detail.itemId === '{{ component.id|escapejs }}') visibility = $event.detail.visibility">
    {% comment %}Absent unless the workspace configures a window and the component has an SBOM, so an unconfigured workspace sees no badge.{% endcomment %}
    {% if component.freshness.is_stale %}
        <c-slot name="meta">
        <c-badges.danger title="SBOM is {{ component.freshness.expires_in_days|stringformat:'d'|cut:'-' }} days past the {{ component.freshness.window_days }}-day freshness window">
        <i class="fas fa-hourglass-end mr-1" aria-hidden="true"></i>Stale
        </c-badges.danger>
        </c-slot>
    {% endif %}
    {# Visibility Toggle + meatball menu. The menu renders for every member (metadata is a read surface); write actions inside stay CRUD-gated. #}
    {% if component.has_crud_permissions or component.component_type == 'bom' %}
        <div class="flex items-stretch gap-2">
            {% if component.has_crud_permissions %}
                {% url 'core:component_details_public' component.id as component_public_url %}
                {% include 'core/components/component_visibility_selector.html.j2' with component=component component_public_url=component_public_url company_nda_id=company_nda_id gated_visibility_allowed=gated_visibility_allowed team_key=team_key APP_BASE_URL=APP_BASE_URL %}
            {% endif %}
            {# Meatball menu — moves secondary surfaces off the page body (design review p8/p9): upload, metadata, CI/CD integration, trusted publishers all open from here. #}
            <c-actions-menu label="Component actions" stretch>
            {% if component.has_crud_permissions %}
                {% block meatball_artifacts %}
                    <c-dropdowns.header>Artifacts</c-dropdowns.header>
                    <c-dropdowns.item icon="fas fa-upload" @click="$dispatch('open-upload')">Upload artifact…</c-dropdowns.item>
                    <c-dropdowns.divider />
                {% endblock %}
            {% endif %}
            <c-dropdowns.header>Component</c-dropdowns.header>
            {% if component.component_type == 'bom' %}
                <c-dropdowns.item icon="fas fa-address-card" @click="$dispatch('open-metadata')">Metadata…</c-dropdowns.item>
            {% endif %}
            {% if component.has_crud_permissions %}
                {% if component.component_type == 'bom' %}
                    <c-dropdowns.item icon="fas fa-gears" @click="$dispatch('open-cicd')">CI/CD integration…</c-dropdowns.item>
                {% endif %}
                <c-dropdowns.item icon="fas fa-shield-halved" @click="$dispatch('open-trusted-publishers')">Trusted publishers…</c-dropdowns.item>
                {# Public-only actions; visibility is reactive so these appear/disappear the moment it changes, no reload. #}
                <c-dropdowns.item icon="fas fa-link" x-show="visibility === 'public' || visibility === 'gated'" @click="$dispatch('copy-url')">Copy public URL</c-dropdowns.item>
                <c-dropdowns.item icon="fas fa-certificate" x-show="visibility === 'public' || visibility === 'gated'" @click="$dispatch('copy-badge')">Copy badge</c-dropdowns.item>
            {% endif %}
            </c-actions-menu>
        </div>
    {% endif %}
    </c-layout.page-header>
    <div class="space-y-6">
        {# Stats Badges #}
        <div class="flex flex-wrap gap-2">
            <c-chips.metric-chip>
            <i class="fas fa-{% if component.component_type == 'bom' %}file-code{% else %}file-alt{% endif %} text-primary text-xs"
               aria-hidden="true"></i>
            <c-chips.metric.value>
            {% if component.component_type == 'bom' %}
                {{ component.sbom_count|default:0 }}
            {% else %}
                {{ component.document_count|default:0 }}
            {% endif %}
            </c-chips.metric.value>
            <c-chips.metric.label>
            {% if component.component_type == 'bom' %}
                BOMs
            {% else %}
                Documents
            {% endif %}
            </c-chips.metric.label>
            </c-chips.metric-chip>
            <c-chips.metric-chip>
            <span class="inline-flex items-center gap-1 {% if component.is_global %}text-primary{% else %}text-text-muted{% endif %}">
                <i class="fas fa-{% if component.is_global %}building{% else %}cube{% endif %} text-xs"></i>
                <span>
                    {% if component.is_global %}
                        Workspace-wide
                    {% else %}
                        Product-scoped
                    {% endif %}
                </span>
            </span>
            </c-chips.metric-chip>
            {# Latest-scan vulnerability summary (design review / mock). #}
            {% if vuln_summary.critical or vuln_summary.high or vuln_summary.medium or vuln_summary.low or vuln_summary.suppressed %}
                {% comment %}The accent is settled first: a prop written as an inline {% if %} is one djlint reformat away from arriving with newlines in it, and a padded value matches no branch in the component.{% endcomment %}
                {% if vuln_summary.critical or vuln_summary.high %}
                    {% firstof "danger" as vuln_chip_accent %}
                {% else %}
                    {% firstof "warning" as vuln_chip_accent %}
                {% endif %}
                <c-chips.metric-chip accent="{{ vuln_chip_accent }}">
                <i class="fas fa-triangle-exclamation text-xs" aria-hidden="true"></i>
                {% if vuln_summary.critical %}
                    <c-chips.metric.value>{{ vuln_summary.critical }} Critical</c-chips.metric.value>
                {% endif %}
                {% if vuln_summary.high %}
                    {% if vuln_summary.critical %}<span class="text-text-muted">·</span>{% endif %}
                    <c-chips.metric.value>{{ vuln_summary.high }} High</c-chips.metric.value>
                {% endif %}
                {% if vuln_summary.medium %}
                    {% if vuln_summary.critical or vuln_summary.high %}<span class="text-text-muted">·</span>{% endif %}
                    <c-chips.metric.value>{{ vuln_summary.medium }} Medium</c-chips.metric.value>
                {% endif %}
                {% if vuln_summary.low %}
                    {% if vuln_summary.critical or vuln_summary.high or vuln_summary.medium %}
                        <span class="text-text-muted">·</span>
                    {% endif %}
                    <c-chips.metric.value>{{ vuln_summary.low }} Low</c-chips.metric.value>
                {% endif %}
                {% comment %}Counts above exclude what VEX cleared, matching the Trust Center posture; the suppressed tally says so rather than letting the numbers silently shrink.{% endcomment %}
                {% if vuln_summary.suppressed %}
                    <c-chips.metric.label>· {{ vuln_summary.suppressed }} suppressed</c-chips.metric.label>
                {% endif %}
                <c-chips.metric.label>· latest scan</c-chips.metric.label>
                </c-chips.metric-chip>
            {% endif %}
        </div>
        {% block header_after_meta %}{% endblock %}
        {% block content_after_header %}{% endblock %}
        {% block upload_section %}{% endblock %}
        {% block table_section %}{% endblock %}
        {# Danger Zone #}
        {% if component.has_crud_permissions %}
            <div>
                {% include 'components/component_danger_zone.html.j2' with component_id=component.id component_name=component.name can_delete=can_delete %}
            </div>
        {% endif %}
    </div>
{% endblock %}
{% block scripts %}
    {% vite_asset 'sbomify/apps/core/js/main.ts' %}
    {% block scripts_additional %}{% endblock %}
{% endblock %}
