{% extends "core/dashboard_base.htmx.j2" %}
{% load widget_tweaks %}
{% load static %}
{% load design_system %}
{% load django_vite %}
{% load public_url_tags %}
{% block title %}sbomify Component: {{ component.name }}{% endblock %}
{% block content %}
    {% comment %}Page header, composed from the tw-page-header classes rather than the page_header tag: the freshness badge sits beside the title and the tag has no slot for it. The visibility state lives here because only the header's menu items read it.{% endcomment %}
    <div class="tw-page-header"
         x-data="{ visibility: '{{ component.visibility|escapejs }}' }"
         @public-status-changed.window="if ($event.detail.itemId === '{{ component.id|escapejs }}') visibility = $event.detail.visibility">
        <div class="tw-page-header-lead">
            <span class="tw-avatar tw-avatar-lg" aria-hidden="true">
                <i class="fas fa-puzzle-piece"></i>
            </span>
            <div>
                <div class="flex items-center gap-3 flex-wrap">
                    <h1 class="tw-page-header-title">
                        {% if component.has_crud_permissions %}
                            {% include 'core/components/editable_single_field.html.j2' with item_type='component' item_id=component.id item_value=component.name %}
                        {% else %}
                            {{ component.name }}
                        {% endif %}
                    </h1>
                    <div class="flex items-center gap-2">
                        {% include 'core/components/copyable_value.html.j2' with value=component.id title="Component ID: "|add:component.id|add:" (click to copy)" %}
                    </div>
                    {% comment %}Absent unless the workspace configures a window and the component has an SBOM, so an unconfigured workspace sees no badge.{% endcomment %}
                    {% if component.freshness.is_stale %}
                        <span class="tw-badge-danger"
                              title="SBOM is {{ component.freshness.expires_in_days|stringformat:'d'|cut:'-' }} days past the {{ component.freshness.window_days }}-day freshness window">
                            <i class="fas fa-hourglass-end mr-1" aria-hidden="true"></i>Stale
                        </span>
                    {% endif %}
                </div>
                {# Component Type Label #}
                <p class="tw-page-header-subtitle">{{ component.component_type_display }} Component</p>
            </div>
        </div>
        {# Visibility Toggle + meatball menu. The menu renders for every member (metadata is a read surface); write actions inside stay CRUD-gated. #}
        {% if component.has_crud_permissions or component.component_type == 'bom' %}
            <div class="tw-page-header-actions">
                <div class="flex items-stretch gap-2">
                    {% if component.has_crud_permissions %}
                        {% url 'core:component_details_public' component.id as component_public_url %}
                        {% include 'core/components/component_visibility_selector.html.j2' with component=component component_public_url=component_public_url company_nda_id=company_nda_id gated_visibility_allowed=gated_visibility_allowed team_key=team_key APP_BASE_URL=APP_BASE_URL %}
                    {% endif %}
                    {# Meatball menu — moves secondary surfaces off the page body (design review p8/p9): upload, metadata, CI/CD integration, trusted publishers all open from here. #}
                    {% actions_menu label="Component actions" trigger_class="tw-icon-btn tw-icon-btn-stretch" %}
                    {% if component.has_crud_permissions %}
                        {% block meatball_artifacts %}
                            <div class="tw-dropdown-header">Artifacts</div>
                            <button type="button"
                                    role="menuitem"
                                    class="tw-dropdown-item"
                                    @click="$dispatch('open-upload')">
                                <i class="fas fa-upload tw-dropdown-item-icon" aria-hidden="true"></i>Upload artifact…
                            </button>
                            <div class="tw-dropdown-divider"></div>
                        {% endblock %}
                    {% endif %}
                    <div class="tw-dropdown-header">Component</div>
                    {% if component.component_type == 'bom' %}
                        <button type="button"
                                role="menuitem"
                                class="tw-dropdown-item"
                                @click="$dispatch('open-metadata')">
                            <i class="fas fa-address-card tw-dropdown-item-icon" aria-hidden="true"></i>Metadata…
                        </button>
                    {% endif %}
                    {% if component.has_crud_permissions %}
                        {% if component.component_type == 'bom' %}
                            <button type="button"
                                    role="menuitem"
                                    class="tw-dropdown-item"
                                    @click="$dispatch('open-cicd')">
                                <i class="fas fa-gears tw-dropdown-item-icon" aria-hidden="true"></i>CI/CD integration…
                            </button>
                        {% endif %}
                        <button type="button"
                                role="menuitem"
                                class="tw-dropdown-item"
                                @click="$dispatch('open-trusted-publishers')">
                            <i class="fas fa-shield-halved tw-dropdown-item-icon" aria-hidden="true"></i>Trusted publishers…
                        </button>
                        {# Public-only actions; visibility is reactive so these appear/disappear the moment it changes, no reload. #}
                        <button type="button"
                                role="menuitem"
                                x-show="visibility === 'public' || visibility === 'gated'"
                                class="tw-dropdown-item"
                                @click="$dispatch('copy-url')">
                            <i class="fas fa-link tw-dropdown-item-icon" aria-hidden="true"></i>Copy public URL
                        </button>
                        <button type="button"
                                role="menuitem"
                                x-show="visibility === 'public' || visibility === 'gated'"
                                class="tw-dropdown-item"
                                @click="$dispatch('copy-badge')">
                            <i class="fas fa-certificate tw-dropdown-item-icon" aria-hidden="true"></i>Copy badge
                        </button>
                    {% endif %}
                {% endactions_menu %}
            </div>
        </div>
    {% endif %}
</div>
<div class="space-y-6">
    {# Stats Badges #}
    <div class="flex flex-wrap gap-2">
        <div class="tw-metric-chip">
            <i class="fas fa-{% if component.component_type == 'bom' %}file-code{% else %}file-alt{% endif %} text-primary text-xs"
               aria-hidden="true"></i>
            <span class="tw-metric-chip-value">
                {% if component.component_type == 'bom' %}
                    {{ component.sbom_count|default:0 }}
                {% else %}
                    {{ component.document_count|default:0 }}
                {% endif %}
            </span>
            <span class="tw-metric-chip-label">
                {% if component.component_type == 'bom' %}
                    BOMs
                {% else %}
                    Documents
                {% endif %}
            </span>
        </div>
        <div class="tw-metric-chip">
            <span class="inline-flex items-center gap-1 {% if component.is_global %}text-primary{% else %}text-text-muted{% endif %}">
                <i class="fas fa-{% if component.is_global %}building{% else %}cube{% endif %} text-xs"></i>
                <span>
                    {% if component.is_global %}
                        Workspace-wide
                    {% else %}
                        Product-scoped
                    {% endif %}
                </span>
            </span>
        </div>
        {# Latest-scan vulnerability summary (design review / mock). #}
        {% if vuln_summary.critical or vuln_summary.high or vuln_summary.medium or vuln_summary.low or vuln_summary.suppressed %}
            <div class="tw-metric-chip {% if vuln_summary.critical or vuln_summary.high %}tw-metric-chip-danger{% else %}tw-metric-chip-warning{% endif %}">
                <i class="fas fa-triangle-exclamation text-xs" aria-hidden="true"></i>
                {% if vuln_summary.critical %}
                    <span class="tw-metric-chip-value">{{ vuln_summary.critical }} Critical</span>
                {% endif %}
                {% if vuln_summary.high %}
                    {% if vuln_summary.critical %}<span class="text-text-muted">·</span>{% endif %}
                    <span class="tw-metric-chip-value">{{ vuln_summary.high }} High</span>
                {% endif %}
                {% if vuln_summary.medium %}
                    {% if vuln_summary.critical or vuln_summary.high %}<span class="text-text-muted">·</span>{% endif %}
                    <span class="tw-metric-chip-value">{{ vuln_summary.medium }} Medium</span>
                {% endif %}
                {% if vuln_summary.low %}
                    {% if vuln_summary.critical or vuln_summary.high or vuln_summary.medium %}
                        <span class="text-text-muted">·</span>
                    {% endif %}
                    <span class="tw-metric-chip-value">{{ vuln_summary.low }} Low</span>
                {% endif %}
                {% comment %}Counts above exclude what VEX cleared, matching the Trust Center posture; the suppressed tally says so rather than letting the numbers silently shrink.{% endcomment %}
                {% if vuln_summary.suppressed %}
                    <span class="tw-metric-chip-label">· {{ vuln_summary.suppressed }} suppressed</span>
                {% endif %}
                <span class="tw-metric-chip-label">· latest scan</span>
            </div>
        {% endif %}
    </div>
    {% block header_after_meta %}{% endblock %}
    {% block content_after_header %}{% endblock %}
    {% block upload_section %}{% endblock %}
    {% block table_section %}{% endblock %}
    {# Danger Zone #}
    {% if component.has_crud_permissions %}
        <div>
            {% include 'components/component_danger_zone.html.j2' with component_id=component.id component_name=component.name is_owner=is_owner %}
        </div>
    {% endif %}
</div>
{% endblock %}
{% block scripts %}
    {% vite_asset 'sbomify/apps/core/js/main.ts' %}
    {% block scripts_additional %}{% endblock %}
{% endblock %}
