{% extends "core/component_details_private_base.html.j2" %}
{% load django_vite %}
{% block content_after_header %}{% endblock %}
{% block header_after_meta %}
    <div class="mt-3">
        <c-cards.card flush class="p-3">
        <div>
            <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium {% if component.is_global %}bg-primary/10 text-primary{% else %}bg-border/50 text-text-muted{% endif %}">
                {% if component.is_global %}
                    <i class="fas fa-building"></i>Workspace-wide
                {% else %}
                    <i class="fas fa-cube"></i>Product-scoped
                {% endif %}
            </span>
            <p class="text-text-muted text-sm mb-0 mt-2">
                {% if component.is_global %}
                    Visible on the workspace Trust Center and not attached to any product.
                {% else %}
                    Restricted to the products this component is assigned to. A certification
                    only earns a Trust Center badge once it is workspace-wide.
                {% endif %}
            </p>
            {% comment %}
                The switch itself, which nothing rendered until now: the endpoint
                and its permission check already existed, so a document could
                only be made workspace-wide through the API, and a certification
                uploaded through the UI could never earn its badge.
            {% endcomment %}
            {% if component.has_crud_permissions %}
                <form method="post"
                      action="{% url 'core:component_scope' component.id %}"
                      class="mt-3">
                    {% csrf_token %}
                    <input type="hidden"
                           name="target_scope"
                           value="{% if component.is_global %}product{% else %}workspace{% endif %}">
                    <c-buttons.secondary size="sm" type="submit">
                    {% if component.is_global %}
                        Make product-scoped
                    {% else %}
                        Make workspace-wide
                    {% endif %}
                    </c-buttons.secondary>
                    {% if not component.is_global %}
                        <p class="text-text-muted text-xs mb-0 mt-2">This also takes it off any product it is assigned to.</p>
                    {% endif %}
                </form>
            {% endif %}
        </div>
        </c-cards.card>
    </div>
{% endblock %}
{% block upload_section %}
    {% if component.has_crud_permissions %}
        <div>
            {% include "documents/components/document_upload.html.j2" with component_id=component.id document_type_subcategories=document_type_subcategories max_upload_size_mb=max_upload_size_mb %}
        </div>
        {# Trusted publishers modal — opened from the header ⋮ menu. #}
        {% include "core/components/trusted_publishers_modal.html.j2" %}
    {% endif %}
{% endblock %}
{% block table_section %}
    <div id="documents-table-container"
         hx-get="{% url 'documents:documents_table' component.id %}"
         hx-trigger="load, refreshDocumentsTable from:body"
         hx-swap="innerHTML">
        <c-feedback.loading message="Loading documents..." compact />
    </div>
{% endblock %}
{% block scripts_additional %}
    {% vite_asset 'sbomify/apps/documents/js/main.ts' %}
{% endblock %}
