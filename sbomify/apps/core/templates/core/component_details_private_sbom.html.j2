{% extends "core/component_details_private_base.html.j2" %}
{% load static %}
{% load django_vite %}
{% block content_after_header %}
    {# Artifacts & security — the SBOM versions list leads the page, with vulnerabilities shown per version (design review p9: "one wholistic view at the top"). #}
    <div id="sboms-table-region"
         hx-get="{% url 'sboms:sboms_table' component.id %}"
         hx-trigger="load, refreshSbomsTable from:body, refreshVexDocuments from:body"
         hx-swap="innerHTML">
        <c-feedback.loading-table message="Loading SBOMs..." />
    </div>
    {# Vulnerabilities: the workspace list scoped to this component, at the version the reader picks #}
    {% include "core/components/component_vulnerabilities.html.j2" %}
    {# CBOM issues drill-down for the latest CBOM — hidden when crypto assessments are clean #}
    {% include "core/components/component_cbom_issues.html.j2" %}
    {% comment %}Outside the panel, which HTMX swaps on its own: a dialog inside
    that region would be torn out from under the reader on the next filter
    keystroke. A row's Triage loads its dialog into the host; one fix prompt
    dialog serves every row.{% endcomment %}
    {% if can_triage %}<c-vulnerabilities.triage-host />{% endif %}
    <c-vulnerabilities.fix-prompt-dialog />
{% endblock %}
{% block upload_section %}
    {% if component.has_crud_permissions %}
        {# Modals opened from the header ⋮ menu — nothing here renders in the page flow. #}
        {% include "sboms/components/ci_cd_info.html.j2" %}
        <div id="upload-section" class="contents">
            {% include 'sboms/components/sbom_upload.html.j2' with component_id=component.id %}
        </div>
        {% include "core/components/trusted_publishers_modal.html.j2" %}
    {% endif %}
{% endblock %}
{% block table_section %}
    {# Component metadata modal — opened from the header ⋮ menu; available to every member (editing is gated inside). #}
    {% include "core/components/component_meta_info.html.j2" %}
{% endblock %}
{% block scripts_additional %}
    {% vite_asset 'sbomify/apps/sboms/js/main.ts' %}
{% endblock %}
