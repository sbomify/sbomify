{% extends "core/dashboard_base.htmx.j2" %}
{% load static %}
{% load django_vite %}
{% load advisory_tags %}
{% block title %}{{ component.get_component_type_display }}: {{ item.name }}{% endblock %}
{% block extra_styles %}
    <link rel="stylesheet"
          href="{% static 'css/component-detailed-private.css' %}">
    <link rel="stylesheet"
          href="{% static 'css/components/vulnerability-trends.css' %}">
{% endblock %}
{% block content %}
    {% comment %}The download title names the format and the kind of document. Both are settled here rather than inline in the attribute, which djlint is free to break across lines.{% endcomment %}
    {% if item.format == 'cyclonedx' %}
        {% firstof "CycloneDX" as item_format_label %}
    {% elif item.format == 'spdx' %}
        {% firstof "SPDX" as item_format_label %}
    {% else %}
        {% firstof item.format as item_format_label %}
    {% endif %}
    {% if is_vex %}
        {% firstof "VEX" as item_kind_label %}
    {% elif is_cbom %}
        {% firstof "CBOM" as item_kind_label %}
    {% elif is_hbom %}
        {% firstof "HBOM" as item_kind_label %}
    {% else %}
        {% firstof "SBOM" as item_kind_label %}
    {% endif %}
    <c-layout.page-header title="{{ item.name }}" icon="{{ header_icon }}" mark="avatar" :copy_values="header_copy_values" :breadcrumbs="breadcrumb_items">
    {% if is_sbom_backed %}
        <c-buttons.secondary href="{% url 'sboms:sbom_download' item.id %}" title="Download {{ item_format_label }} {{ item_kind_label }}">
        {% if item.format == 'cyclonedx' %}
            <img src="{% static 'img/cyclonedx-logo.svg' %}"
                 alt="CycloneDX"
                 class="h-4 w-auto dark:brightness-0 dark:invert"
                 width="16"
                 height="16">
        {% elif item.format == 'spdx' %}
            <img src="{% static 'img/spdx-logo.svg' %}"
                 alt="SPDX"
                 class="h-4 w-auto dark:brightness-0 dark:invert"
                 width="16"
                 height="16">
        {% endif %}
        <i class="fas fa-download"></i>
        </c-buttons.secondary>
    {% elif item_type == 'documents' %}
        <c-buttons.primary href="{% url 'documents:document_download' item.id %}">
        <i class="fas fa-download"></i>Download
        </c-buttons.primary>
    {% endif %}
    </c-layout.page-header>
    <div class="space-y-6">
        {# Stats Badges #}
        <div class="flex flex-wrap gap-2">
            {% if is_sbom_backed %}
                {# A format the app does not know keeps the SPDX tint, as it always did. #}
                {% if item.format == 'cyclonedx' %}
                    {% firstof "cyclonedx" as item_format_key %}
                {% else %}
                    {% firstof "spdx" as item_format_key %}
                {% endif %}
                <c-badges.format format="{{ item_format_key }}">
                {% if item.format == 'cyclonedx' %}
                    CYCLONEDX
                {% elif item.format == 'spdx' %}
                    SPDX
                {% else %}
                    {{ item.format|upper }}
                {% endif %}
                {{ item.format_version }}
                </c-badges.format>
                {% if item.version %}
                    <c-chips.metric-chip>
                    <i class="fas fa-code-branch text-primary text-xs" aria-hidden="true"></i>
                    <c-chips.metric.label>Version:</c-chips.metric.label>
                    <c-chips.metric.value title="{{ item.version }}">{{ item.version|truncatechars:30 }}</c-chips.metric.value>
                    </c-chips.metric-chip>
                {% endif %}
                <c-chips.metric-chip>
                <i class="fas fa-calendar text-primary text-xs" aria-hidden="true"></i>
                <c-chips.metric.label>Uploaded:</c-chips.metric.label>
                <c-chips.metric.value>
                {% include 'core/components/relative_time.html.j2' with timestamp=item.created_at %}
                </c-chips.metric.value>
                </c-chips.metric-chip>
                <c-chips.metric-chip accent="info">
                <i class="fas fa-upload text-xs" aria-hidden="true"></i>
                <c-chips.metric.label>Source:</c-chips.metric.label>
                <c-chips.metric.value>{{ item.source_display }}</c-chips.metric.value>
                </c-chips.metric-chip>
                {% if item.signature_blob_key %}
                    <c-chips.metric-chip accent="success">
                    <i class="fas fa-lock text-xs" aria-hidden="true"></i>
                    <c-chips.metric.value>Signed</c-chips.metric.value>
                    </c-chips.metric-chip>
                {% endif %}
                {% if item.provenance_blob_key %}
                    <c-chips.metric-chip accent="info">
                    <i class="fas fa-shield-alt text-xs" aria-hidden="true"></i>
                    <c-chips.metric.value>Provenance</c-chips.metric.value>
                    </c-chips.metric-chip>
                {% endif %}
            {% elif item_type == 'documents' %}
                <c-chips.metric-chip accent="info">
                <i class="fas fa-file text-xs" aria-hidden="true"></i>
                <c-chips.metric.value>{{ item.document_type|default:"Document" }}</c-chips.metric.value>
                </c-chips.metric-chip>
                {% if item.version %}
                    <c-chips.metric-chip>
                    <i class="fas fa-code-branch text-primary text-xs" aria-hidden="true"></i>
                    <c-chips.metric.label>Version:</c-chips.metric.label>
                    <c-chips.metric.value title="{{ item.version }}">{{ item.version|truncatechars:30 }}</c-chips.metric.value>
                    </c-chips.metric-chip>
                {% endif %}
                <c-chips.metric-chip>
                <i class="fas fa-calendar text-primary text-xs" aria-hidden="true"></i>
                <c-chips.metric.label>Uploaded:</c-chips.metric.label>
                <c-chips.metric.value>
                {% include 'core/components/relative_time.html.j2' with timestamp=item.created_at %}
                </c-chips.metric.value>
                </c-chips.metric-chip>
                <c-chips.metric-chip>
                <i class="fas fa-upload text-primary text-xs" aria-hidden="true"></i>
                <c-chips.metric.label>Source:</c-chips.metric.label>
                <c-chips.metric.value>{{ item.source_display }}</c-chips.metric.value>
                </c-chips.metric-chip>
                {% if item.content_type %}
                    <c-chips.metric-chip>
                    <i class="fas fa-file-alt text-primary text-xs" aria-hidden="true"></i>
                    <c-chips.metric.label>Format:</c-chips.metric.label>
                    <c-chips.metric.value>{{ item.content_type }}</c-chips.metric.value>
                    </c-chips.metric-chip>
                {% endif %}
                {% if item.file_size %}
                    <c-chips.metric-chip>
                    <i class="fas fa-weight text-primary text-xs" aria-hidden="true"></i>
                    <c-chips.metric.label>Size:</c-chips.metric.label>
                    <c-chips.metric.value>{{ item.file_size|filesizeformat }}</c-chips.metric.value>
                    </c-chips.metric-chip>
                {% endif %}
            {% endif %}
        </div>
        {% if is_sbom_backed %}
            {# Vulnerability Summary Section #}
            {% if vulnerability_summary %}
                <c-cards.card flush>
                <div class="px-6 py-4 border-b border-border flex items-center justify-between gap-3">
                    <h4 class="text-lg font-semibold text-text flex items-center gap-2 m-0">
                        <i class="fas fa-shield-alt text-primary"></i>
                        Vulnerability Scan
                        <span class="text-sm font-normal text-text-muted ml-2">{{ vulnerability_summary.scan_date|date:"j M Y" }}</span>
                        <c-badges.secondary size="sm">{{ vulnerability_summary.provider|upper }}</c-badges.secondary>
                    </h4>
                    <c-buttons.secondary href="{% url 'sboms:sbom_vulnerabilities' item.id %}">
                    <i class="fas fa-shield-alt"></i>Vulnerabilities
                    <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
                    </c-buttons.secondary>
                </div>
                <div class="p-6">
                    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                        <div class="flex items-baseline gap-2">
                            <span class="text-3xl font-bold text-text leading-none">{{ vulnerability_summary.total }}</span>
                            <span class="text-sm text-text-muted">total findings</span>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 sm:ml-auto">
                            <c-badges.severity level="critical">{{ vulnerability_summary.critical }} Critical</c-badges.severity>
                            <c-badges.severity level="high">{{ vulnerability_summary.high }} High</c-badges.severity>
                            <c-badges.severity level="medium">{{ vulnerability_summary.medium }} Medium</c-badges.severity>
                            <c-badges.severity level="low">{{ vulnerability_summary.low }} Low</c-badges.severity>
                        </div>
                    </div>
                </div>
                </c-cards.card>
            {% endif %}
            {# VEX suppressions — the vulnerabilities this VEX artifact clears #}
            {% if vex_suppressions is not None %}
                {{ vex_suppression_terms|json_script:"vex-suppression-terms" }}
                {{ vex_suppression_states|json_script:"vex-suppression-states" }}
                <div x-data="{ search: '', statusFilter: 'all', currentPage: 1, perPage: 10, terms: (window.parseJsonScript('vex-suppression-terms') || []), states: (window.parseJsonScript('vex-suppression-states') || []), get statusOptions() { return [...new Set(this.states)].filter(Boolean).sort(); }, get filteredIdx() { const q = this.search.trim().toLowerCase(); return this.terms.map((t, i) => i).filter(i => (!q || this.terms[i].includes(q)) && (this.statusFilter === 'all' || this.states[i] === this.statusFilter)); }, get total() { return this.filteredIdx.length; }, get totalPages() { return Math.max(1, Math.ceil(this.total / this.perPage)); }, get pageSet() { return new Set(this.filteredIdx.slice((this.currentPage - 1) * this.perPage, this.currentPage * this.perPage)); }, get startIdx() { return this.total ? (this.currentPage - 1) * this.perPage + 1 : 0; }, get endIdx() { return Math.min(this.currentPage * this.perPage, this.total); } }"
                     x-init="$watch('search', () => { currentPage = 1 }); $watch('statusFilter', () => { currentPage = 1 })">
                    <c-cards.card flush>
                    <c-cards.header>
                    <h4 class="text-lg font-semibold text-text flex items-center gap-2 m-0">
                        Suppressed vulnerabilities
                        <c-badges.secondary size="sm">{{ vex_suppressions|length }}</c-badges.secondary>
                    </h4>
                    </c-cards.header>
                    {% if vex_suppressions %}
                        {# The card already draws the frame, so the shell nests inside it. #}
                        <c-tables.shell nested>
                        <c-tables.toolbar>
                        <c-tables.search id="vex-suppression-search" label="Search suppressed vulnerabilities" placeholder="Search advisories..." class="max-w-xs" x-model="search" />
                        <c-tables.select id="vex-status-filter" label="Filter by status" x-model="statusFilter">
                        <option value="all">All Statuses</option>
                        <template x-for="st in statusOptions" :key="st">
                            <option :value="st"
                                    x-text="st.replace(/_/g, ' ').replace(/^./, c => c.toUpperCase())"></option>
                        </template>
                        </c-tables.select>
                        </c-tables.toolbar>
                        <c-tables.table fixed x-cloak>
                        <c-tables.head>
                        <c-tables.header-cell nowrap class="w-1/4">Advisory</c-tables.header-cell>
                        <c-tables.header-cell class="w-1/4">Package</c-tables.header-cell>
                        <c-tables.header-cell class="w-1/4">Status</c-tables.header-cell>
                        <c-tables.header-cell class="w-1/4">Justification</c-tables.header-cell>
                        </c-tables.head>
                        <tbody>
                            {% for s in vex_suppressions %}
                                <c-tables.row x-show="pageSet.has({{ forloop.counter0 }})">
                                <c-tables.cell nowrap>
                                {% with suppression_url=s.id|advisory_url %}
                                    {% if suppression_url %}
                                        <a href="{{ suppression_url }}"
                                           target="_blank"
                                           rel="noopener"
                                           class="font-medium text-primary hover:underline inline-flex items-center gap-1">
                                            {{ s.id }}<i class="fas fa-external-link-alt text-[0.65rem]"></i>
                                        </a>
                                    {% else %}
                                        <span class="font-medium text-text-muted">{{ s.id }}</span>
                                    {% endif %}
                                {% endwith %}
                                {% if s.aliases %}<div class="text-xs text-text-muted mt-1">Aliases: {{ s.aliases|join:", " }}</div>{% endif %}
                                </c-tables.cell>
                                <c-tables.cell>{{ s.package }}</c-tables.cell>
                                <c-tables.cell>
                                <span class="text-info">
                                    {% if s.state == 'not_affected' %}
                                        Not affected
                                    {% elif s.state == 'false_positive' %}
                                        False positive
                                    {% else %}
                                        {{ s.state|cut:"_"|title }}
                                    {% endif %}
                                </span>
                                </c-tables.cell>
                                {% comment %}The muted ink sits on the value rather than the cell: the cell already states the table's own text colour, and two colour utilities on one element resolve by stylesheet order, not by the order they are written.{% endcomment %}
                                <c-tables.cell>
                                {% if s.justification %}
                                    <span class="text-text-muted"
                                          {% if s.detail %}title="{{ s.detail }}"{% endif %}>{{ s.justification }}</span>
                                {% elif s.detail %}
                                    <span class="text-text-muted">{{ s.detail|truncatechars:60 }}</span>
                                {% else %}
                                    <span class="text-text-muted">—</span>
                                {% endif %}
                                </c-tables.cell>
                                </c-tables.row>
                            {% endfor %}
                            <tr x-show="total === 0">
                                <td colspan="4" class="px-6 py-8 text-center text-text-muted">No vulnerabilities match your search.</td>
                            </tr>
                        </tbody>
                        </c-tables.table>
                        <c-tables.footer>
                        <c-tables.info>
                        Showing <span x-text="startIdx"></span> to <span x-text="endIdx"></span> of <span x-text="total"></span>
                        </c-tables.info>
                        <c-tables.pager />
                        </c-tables.footer>
                        </c-tables.shell>
                    {% else %}
                        <div class="p-6 text-sm text-text-muted">
                            This VEX document doesn't suppress any vulnerabilities (no <code>not_affected</code> or <code>false_positive</code> statements).
                        </div>
                    {% endif %}
                    </c-cards.card>
                </div>
            {% endif %}
            {# Cryptographic Assets (CBOM) — lazy-loaded; collapses when there are none #}
            <div hx-get="{% url 'sboms:sbom_crypto_inventory' sbom_id=item.id %}"
                 hx-trigger="load"
                 hx-swap="outerHTML"></div>
            {# Assessment Results Section — not shown for VEX (a VEX isn't an SBOM to verify) #}
            {% if assessment_runs and not is_vex %}
                <div>
                    {% include 'plugins/components/assessment_results_card.html.j2' with sbom_id=item.id assessment_runs=assessment_runs %}
                    {% if can_triage %}
                        {% include 'plugins/components/triage_modal.html.j2' %}
                    {% endif %}
                </div>
            {% endif %}
            {# Danger Zone #}
            <div>
                {% include 'components/sbom_danger_zone.html.j2' with sbom_id=item.id sbom_name=item.name component_id=component_id %}
            </div>
        {% elif item_type == 'documents' %}
            {# Document Info Card #}
            <c-cards.card flush>
            <div class="px-6 py-4 border-b border-border">
                <h4 class="text-lg font-semibold text-text flex items-center gap-2 m-0">
                    <i class="fas fa-file-alt text-primary"></i>
                    Document Information
                </h4>
            </div>
            <div class="p-6 text-center py-12">
                <div class="w-16 h-16 rounded-full bg-info/10 flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-file-alt text-3xl text-info"></i>
                </div>
                <p class="text-text mb-2 font-medium">Document stored successfully</p>
                <p class="text-text-muted text-sm mb-0">Use the Download button above to access the file.</p>
            </div>
            </c-cards.card>
        {% endif %}
    </div>
{% endblock %}
{% block scripts %}
    {% vite_asset 'sbomify/apps/core/js/main.ts' %}
    {% if is_sbom_backed %}
        {% vite_asset 'sbomify/apps/sboms/js/main.ts' %}
        {% vite_asset 'sbomify/apps/plugins/js/main.ts' %}
    {% elif item_type == 'documents' %}
        {% vite_asset 'sbomify/apps/documents/js/main.ts' %}
    {% endif %}
{% endblock %}
