{# CBOM issues drill-down for the latest CBOM. Rendered only when a crypto assessment reported fail/warning findings. #}
{% if latest_cbom_issues %}
    {{ latest_cbom_issue_terms|json_script:"latest-cbom-issue-terms" }}
    {{ latest_cbom_issue_severities|json_script:"latest-cbom-issue-severities" }}
    <div x-data="{ open: true, search: '', sevFilter: 'all', currentPage: 1, perPage: 5, terms: (window.parseJsonScript('latest-cbom-issue-terms') || []), severities: (window.parseJsonScript('latest-cbom-issue-severities') || []), get sevOptions() { const order = ['critical', 'high', 'medium', 'low', 'info']; const present = new Set(this.severities); return order.filter(v => present.has(v)).concat([...present].filter(v => !order.includes(v)).sort()); }, get filteredIdx() { const q = this.search.trim().toLowerCase(); return this.terms.map((t, i) => i).filter(i => (!q || this.terms[i].includes(q)) && (this.sevFilter === 'all' || this.severities[i] === this.sevFilter)); }, get total() { return this.filteredIdx.length; }, get totalPages() { return Math.max(1, Math.ceil(this.total / this.perPage)); }, get pageSet() { return new Set(this.filteredIdx.slice((this.currentPage - 1) * this.perPage, this.currentPage * this.perPage)); }, get startIdx() { return this.total ? (this.currentPage - 1) * this.perPage + 1 : 0; }, get endIdx() { return Math.min(this.currentPage * this.perPage, this.total); }, }"
         x-init="$watch('search', () => { currentPage = 1 }); $watch('sevFilter', () => { currentPage = 1 })"
         class="tw-collapsible-card">
        <button type="button"
                class="tw-collapsible-header w-full text-left"
                @click="open = !open"
                :aria-expanded="open">
            <span class="tw-collapsible-title text-lg">
                CBOM issues
                {% if latest_cbom_version %}
                    <span class="font-normal text-text-muted text-sm">· {{ latest_cbom_version|truncatechars:24 }} (latest)</span>
                {% endif %}
            </span>
            <i class="fas fa-chevron-down tw-collapsible-icon"
               :class="{ 'tw-collapsible-icon-open': open }"
               aria-hidden="true"></i>
        </button>
        <div class="tw-collapsible-content" x-show="open" x-collapse>
            {# Search + severity filter toolbar #}
            <div class="tw-data-table-toolbar">
                <div class="tw-data-table-toolbar-left flex-wrap">
                    <div class="tw-data-table-search max-w-xs">
                        <i class="fas fa-search tw-data-table-search-icon"></i>
                        <label for="cbom-issue-search" class="sr-only">Search CBOM issues</label>
                        <input type="search"
                               id="cbom-issue-search"
                               x-model="search"
                               placeholder="Search CBOM issues..."
                               class="tw-data-table-search-input" />
                    </div>
                    <label for="cbom-issue-sev-filter" class="sr-only">Filter by severity</label>
                    <select id="cbom-issue-sev-filter"
                            x-model="sevFilter"
                            class="tw-data-table-page-size-select">
                        <option value="all">All Severities</option>
                        <template x-for="v in sevOptions" :key="v">
                            <option :value="v" x-text="v.charAt(0).toUpperCase() + v.slice(1)"></option>
                        </template>
                    </select>
                </div>
            </div>
            <div class="tw-data-table-container" x-cloak>
                <table class="tw-table">
                    <thead>
                        <tr>
                            <th>Severity</th>
                            <th>Issue</th>
                            <th>Check</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for issue in latest_cbom_issues %}
                            <tr x-show="pageSet.has({{ forloop.counter0 }})">
                                <td>
                                    {% if issue.severity == 'critical' or issue.severity == 'high' or issue.severity == 'medium' or issue.severity == 'low' %}
                                        <span class="tw-badge-severity-{{ issue.severity|lower }}">{{ issue.severity|capfirst }}</span>
                                    {% else %}
                                        <span class="tw-badge-severity-unknown">{{ issue.severity|title }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="font-medium text-text">{{ issue.title }}</span>
                                    {% if issue.description %}
                                        <div class="text-xs text-text-muted mt-1 max-w-xl">{{ issue.description|truncatechars:140 }}</div>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="text-sm text-text-muted">{{ issue.check }}</span>
                                </td>
                                <td>
                                    {% if issue.status == 'fail' %}
                                        <span class="tw-badge-danger">Fail</span>
                                    {% else %}
                                        <span class="tw-badge-warning">Warning</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        <tr x-show="total === 0">
                            <td colspan="4" class="text-center">
                                <span class="text-text-muted">No CBOM issues match your search.</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            {# Footer: row count + CBOM detail link on the left, pagination on the right #}
            <div class="tw-data-table-footer">
                <div class="flex flex-wrap items-center gap-4">
                    <span class="tw-data-table-info">
                        Showing <span x-text="startIdx"></span> to <span x-text="endIdx"></span> of <span x-text="total"></span>
                    </span>
                    {% if latest_cbom_id %}
                        <a href="{% url 'core:component_item' component_id=component.id item_type=latest_cbom_item_type|default:'cbom' item_id=latest_cbom_id %}"
                           class="text-sm text-primary hover:underline no-underline inline-flex items-center gap-1">
                            View CBOM details<i class="fas fa-arrow-right text-xs"></i>
                        </a>
                    {% endif %}
                </div>
                <div x-show="totalPages > 1">{% include "components/tw/table_pager.html.j2" %}</div>
            </div>
        </div>
    </div>
{% endif %}
