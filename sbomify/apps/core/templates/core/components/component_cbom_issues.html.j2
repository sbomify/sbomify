{# CBOM issues drill-down for the latest CBOM. Rendered only when a crypto assessment reported fail/warning findings. #}
{% if latest_cbom_issues %}
    {{ latest_cbom_issue_terms|json_script:"latest-cbom-issue-terms" }}
    {{ latest_cbom_issue_severities|json_script:"latest-cbom-issue-severities" }}
    <c-cards.collapsible x-data="{ open: true, search: '', sevFilter: 'all', currentPage: 1, perPage: 5, terms: (window.parseJsonScript('latest-cbom-issue-terms') || []), severities: (window.parseJsonScript('latest-cbom-issue-severities') || []), get sevOptions() { const order = ['critical', 'high', 'medium', 'low', 'info']; const present = new Set(this.severities); return order.filter(v => present.has(v)).concat([...present].filter(v => !order.includes(v)).sort()); }, get filteredIdx() { const q = this.search.trim().toLowerCase(); return this.terms.map((t, i) => i).filter(i => (!q || this.terms[i].includes(q)) && (this.sevFilter === 'all' || this.severities[i] === this.sevFilter)); }, get total() { return this.filteredIdx.length; }, get totalPages() { return Math.max(1, Math.ceil(this.total / this.perPage)); }, get pageSet() { return new Set(this.filteredIdx.slice((this.currentPage - 1) * this.perPage, this.currentPage * this.perPage)); }, get startIdx() { return this.total ? (this.currentPage - 1) * this.perPage + 1 : 0; }, get endIdx() { return Math.min(this.currentPage * this.perPage, this.total); }, }" x-init="$watch('search', () => { currentPage = 1 }); $watch('sevFilter', () => { currentPage = 1 })">
    {% comment %}
        The panel is a full-bleed table, so it takes the clipped wrapper the
        card's body would have given it and none of the padding.
    {% endcomment %}
    <c-cards.collapsible-trigger state="open" @click="open = !open">
    <span class="text-lg">
        CBOM issues
        {% if latest_cbom_version %}
            <span class="font-normal text-text-muted text-sm">· {{ latest_cbom_version|truncatechars:24 }} (latest)</span>
        {% endif %}
    </span>
    </c-cards.collapsible-trigger>
    <div class="overflow-hidden" x-show="open" x-collapse>
        <c-tables.shell nested>
        {# Search + severity filter toolbar #}
        <c-tables.toolbar>
        <c-tables.search id="cbom-issue-search" label="Search CBOM issues" placeholder="Search CBOM issues..." class="max-w-xs" x-model="search" />
        <c-tables.select id="cbom-issue-sev-filter" label="Filter by severity" x-model="sevFilter">
        <option value="all">All Severities</option>
        <template x-for="v in sevOptions" :key="v">
            <option :value="v" x-text="v.charAt(0).toUpperCase() + v.slice(1)"></option>
        </template>
        </c-tables.select>
        </c-tables.toolbar>
        <c-tables.table x-cloak>
        <c-tables.head>
        <c-tables.header-cell>Severity</c-tables.header-cell>
        <c-tables.header-cell>Issue</c-tables.header-cell>
        <c-tables.header-cell>Check</c-tables.header-cell>
        <c-tables.header-cell>Status</c-tables.header-cell>
        </c-tables.head>
        <tbody>
            {% for issue in latest_cbom_issues %}
                <c-tables.row x-show="pageSet.has({{ forloop.counter0 }})">
                <c-tables.cell nowrap>
                {% if issue.severity == 'critical' or issue.severity == 'high' or issue.severity == 'medium' or issue.severity == 'low' %}
                    <c-badges.severity level="{{ issue.severity|lower }}">{{ issue.severity|capfirst }}</c-badges.severity>
                {% else %}
                    <c-badges.severity level="unknown">{{ issue.severity|title }}</c-badges.severity>
                {% endif %}
                </c-tables.cell>
                <c-tables.cell>
                <span class="font-medium text-text">{{ issue.title }}</span>
                {% if issue.description %}
                    <div class="text-xs text-text-muted mt-1 max-w-xl">{{ issue.description|truncatechars:140 }}</div>
                {% endif %}
                </c-tables.cell>
                <c-tables.cell>
                <span class="text-sm text-text-muted">{{ issue.check }}</span>
                </c-tables.cell>
                <c-tables.cell>
                {% if issue.status == 'fail' %}
                    <c-badges.danger>Fail</c-badges.danger>
                {% else %}
                    <c-badges.warning>Warning</c-badges.warning>
                {% endif %}
                </c-tables.cell>
                </c-tables.row>
            {% endfor %}
            <tr x-show="total === 0">
                <td colspan="4" class="text-center">
                    <span class="text-text-muted">No CBOM issues match your search.</span>
                </td>
            </tr>
        </tbody>
        </c-tables.table>
        {# Footer: row count + CBOM detail link on the left, pagination on the right #}
        <c-tables.footer>
        <div class="flex flex-wrap items-center gap-4">
            <c-tables.info>
            Showing <span x-text="startIdx"></span> to <span x-text="endIdx"></span> of <span x-text="total"></span>
            </c-tables.info>
            {% if latest_cbom_id %}
                <a href="{% url 'core:component_item' component_id=component.id item_type=latest_cbom_item_type|default:'cbom' item_id=latest_cbom_id %}"
                   class="text-sm text-primary hover:underline no-underline inline-flex items-center gap-1">
                    View CBOM details<i class="fas fa-arrow-right text-xs"></i>
                </a>
            {% endif %}
        </div>
        <div x-show="totalPages > 1">
            <c-tables.pager />
        </div>
        </c-tables.footer>
        </c-tables.shell>
    </div>
    </c-cards.collapsible>
{% endif %}
