{% comment %}
The workspace Vulnerabilities list scoped to this component. Rendered once the
component has an SBOM. The header names no version or count: the version select
and the results below are swapped on their own, so anything here would go stale.

The card and its collapse state live here; the toolbar, table and footer live in
component_vulnerabilities_table.html.j2 and are swapped on their own when a
filter or a page changes, so searching never closes the panel.
{% endcomment %}
{% if vuln_data and vuln_data.versions %}
    <c-cards.collapsible id="component-vulnerabilities" x-data="{ open: true }">
    <c-cards.collapsible-header>
    <c-cards.collapsible-trigger state="open" @click="open = !open">
    <span class="text-lg">Vulnerabilities</span>
    </c-cards.collapsible-trigger>
    <c-slot name="actions">
    <c-buttons.ghost href="{{ vuln_data.workspace_url }}" size="sm">Open in Vulnerabilities<i class="fas fa-arrow-right" aria-hidden="true"></i></c-buttons.ghost>
    </c-slot>
    </c-cards.collapsible-header>
    <div class="overflow-hidden" x-show="open" x-collapse>
        {% include "core/components/component_vulnerabilities_table.html.j2" %}
    </div>
    </c-cards.collapsible>
{% endif %}
