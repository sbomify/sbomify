{% comment %}
Vulnerabilities drill-down for the latest SBOM. Rendered only when the latest
scan has findings.

The card and its collapse state live here; the toolbar, table and footer live in
component_vulnerabilities_table.html.j2 and are swapped on their own when a
filter or a page changes, so searching never closes the panel.
{% endcomment %}
{% if vuln_panel and vuln_panel.unfiltered_total %}
    <c-cards.collapsible id="component-vulnerabilities" x-data="{ open: true }">
    {% comment %}
        The panel is a full-bleed table, so it takes the clipped wrapper the
        card's body would have given it and none of the padding.
    {% endcomment %}
    <c-cards.collapsible-trigger state="open" @click="open = !open">
    <span class="text-lg">
        Vulnerabilities
        {% if latest_vuln_version %}
            <span class="font-normal text-text-muted text-sm">· {{ latest_vuln_version|truncatechars:24 }} (latest)</span>
        {% endif %}
    </span>
    </c-cards.collapsible-trigger>
    <div class="overflow-hidden" x-show="open" x-collapse>
        {% include "core/components/component_vulnerabilities_table.html.j2" %}
    </div>
    </c-cards.collapsible>
{% endif %}
