{# Tailwind Copy Token Component #}
{# Usage: include this partial with token=token_value #}
{# Optional: show_alert=True for the warning banner, allow_toggle=True for the reveal control #}
{% if show_alert %}
    <c-feedback.alert variant="warning" title="Copy your token now!" class="mb-4">
    You won't be able to see this token again after leaving this page.
    </c-feedback.alert>
{% endif %}
{% comment %}
    The reveal control is the display's own: allow_toggle asks for it, and the
    component draws both the blur and the eye that lifts it.
{% endcomment %}
<c-token-display label="{{ label }}" token="{{ token }}" :masked="allow_toggle" />
