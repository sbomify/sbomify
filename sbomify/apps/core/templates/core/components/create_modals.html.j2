{# Create Modals - Alpine.js + Tailwind Implementation #}
{# Shared modal state - listens for custom events from header #}
<div x-data="{ productModal: false, componentModal: false, componentType: 'bom' }"
     @open-product-modal.window="productModal = true"
     @open-component-modal.window="componentModal = true">
    {# New Product Modal #}
    <c-modal id="newProductModal" show="productModal" title="New product" icon="fas fa-cube">
    <form id="newProductForm"
          method="post"
          action="{% url 'core:products_dashboard' %}">
        {% csrf_token %}
        <p class="text-sm text-text-muted mb-4">
            A product represents a deliverable you ship to customers, such as an application or service.
        </p>
        <div class="space-y-4">
            <div>
                <c-forms.label for="newProductName" required>Name</c-forms.label>
                <c-forms.input id="newProductName" name="name" placeholder="Enter product name" required />
            </div>
            <div>
                <c-forms.label for="newProductDescription">Description</c-forms.label>
                <c-forms.textarea id="newProductDescription" name="description" rows="3" placeholder="Describe your product..." />
                <c-forms.hint>Optional. A brief description of your product.</c-forms.hint>
            </div>
        </div>
    </form>
    <c-slot name="footer">
    <c-buttons.ghost @click="productModal = false">Cancel</c-buttons.ghost>
    <c-buttons.primary type="submit" form="newProductForm">
    <i class="fas fa-plus mr-2" aria-hidden="true"></i>Create product
    </c-buttons.primary>
    </c-slot>
    </c-modal>
    {# New Component Modal #}
    <c-modal id="newComponentModal" show="componentModal" title="New component" icon="fas fa-puzzle-piece">
    <form id="newComponentForm"
          method="post"
          action="{% url 'core:components_dashboard' %}">
        {% csrf_token %}
        <p class="text-sm text-text-muted mb-4">
            A component holds an SBOM or document artifact that you want to track and assess.
        </p>
        <div class="space-y-4">
            <div>
                <c-forms.label for="newComponentName" required>Name</c-forms.label>
                <c-forms.input id="newComponentName" name="name" required />
            </div>
            <div>
                <c-forms.label for="newComponentType" required>Type</c-forms.label>
                <c-forms.select id="newComponentType" name="component_type" required x-model="componentType">
                <option value="bom">BOM</option>
                <option value="document">Document</option>
                </c-forms.select>
                <c-forms.hint>Choose the type of component you're creating</c-forms.hint>
            </div>
            <div x-show="componentType === 'document'" x-cloak>
                <c-forms.checkbox id="newComponentIsGlobal" name="is_global">
                <span class="font-medium">Workspace-wide component</span>
                </c-forms.checkbox>
                <c-forms.hint class="ml-8">
                Global components live at the workspace level and are not attached to any product. Use for documents and attestations.
                </c-forms.hint>
            </div>
        </div>
    </form>
    <c-slot name="footer">
    <c-buttons.ghost @click="componentModal = false">Cancel</c-buttons.ghost>
    <c-buttons.primary type="submit" form="newComponentForm">
    <i class="fas fa-plus mr-2" aria-hidden="true"></i>Create component
    </c-buttons.primary>
    </c-slot>
    </c-modal>
</div>
