<div x-data="fileDragAndDrop({ accept: '{{ accept|escapejs }}', existingUrl: '{{ existing_url|default:""|escapejs }}', fieldName: '{{ field_name|default:""|escapejs }}' })">
    <c-forms.file-upload size="sm" name="{{ field_name }}" accept="{{ accept }}" input_ref="fileInput" active="dragover" preview="previewUrl || existingUrl" on_change="handleFileSelect" @dragover.prevent="dragover = true" @dragleave.prevent="dragover = false" @drop.prevent="handleDrop">
    <span x-text="file?.name || (existingUrl ? 'Choose a replacement' : 'Drop a file or choose one')"></span>
    </c-forms.file-upload>
    <template x-if="file">
        <c-forms.file-preview>
        <c-slot name="name"><span x-text="file.name"></span></c-slot>
        <c-slot name="action"><c-buttons.icon-quiet size="sm" label="Remove file" @click.prevent="removeFile"><i class="fas fa-trash" aria-hidden="true"></i></c-buttons.icon-quiet></c-slot>
        </c-forms.file-preview>
    </template>
    <template x-if="showExisting">
        <c-forms.file-preview>
        <c-slot name="name">Current file</c-slot>
        <c-slot name="action"><c-buttons.icon-quiet size="sm" label="Remove existing file" @click.prevent="removeExistingFile"><i class="fas fa-trash" aria-hidden="true"></i></c-buttons.icon-quiet></c-slot>
        </c-forms.file-preview>
    </template>
</div>
