{% load static teams %}
{# Premium Enterprise Header with Tailwind CSS #}
<header class="fixed top-0 right-0 left-0 lg:left-64 h-16 bg-surface/95 backdrop-blur-sm border-b border-border flex items-center px-4 gap-4 z-30 transition-all duration-300"
        :class="{ 'lg:!left-16': sidebarCollapsed }"
        x-data="{ sidebarOpen: false, searchOpen: false }"
        role="banner">
    {# Mobile Sidebar Toggle #}
    {% comment %}
        The wrapper owns the responsive display: the icon button sets display
        itself, so lg:hidden on the button would lose to it.
    {% endcomment %}
    <div class="lg:hidden">
        <c-buttons.icon label="Toggle sidebar navigation" aria-controls="sidebar" @click="sidebarOpen = !sidebarOpen; $dispatch('toggle-sidebar')" ::aria-expanded="sidebarOpen">
        <i class="fas fa-bars text-lg" aria-hidden="true"></i>
        </c-buttons.icon>
    </div>
    {# Search Bar #}
    <div class="flex-1 max-w-xl">
        {% comment %}
            The field colours its own magnifier from the input's focus, so the
            shortcut hint and the results panel are all this has to add.
        {% endcomment %}
        <c-forms.search-input id="navbar-search-input" placeholder="Search products, components..." hint autocomplete="off" role="searchbox" aria-describedby="search-hint" aria-label="Search products and components">
        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
            <kbd id="search-hint"
                 class="hidden sm:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-normal opacity-45 text-text-muted rounded border border-current">
                <span aria-hidden="true">⌘</span><span class="sr-only">Command</span>K
            </kbd>
        </div>
        {# Search Results Dropdown #}
        {% comment %}
            The flush panel owns overflow, so the scroll cap lives on the inner
            list element that the spotlight script renders into.
        {% endcomment %}
        <c-dropdowns.dropdown flush role="listbox" id="search-results-dropdown" class="top-full left-0 right-0 mt-2 hidden" aria-label="Search results">
        <div id="search-results-list" class="max-h-96 overflow-y-auto py-2"></div>
        </c-dropdowns.dropdown>
        </c-forms.search-input>
    </div>
    {# Action Buttons #}
    <div class="flex items-center gap-2 ml-auto"
         role="toolbar"
         aria-label="Quick actions">
        {# New Button Dropdown #}
        {% with current_team=request.session.current_team %}
            {% if current_team %}
                {% if can_manage %}
                    <div x-data="{ open: false }"
                         class="relative"
                         @keydown.escape.window="if(open) open = false">
                        <c-buttons.primary size="sm" aria-label="Create new item" aria-haspopup="true" @click="open = !open" ::aria-expanded="open">
                        <i class="fas fa-plus" aria-hidden="true"></i>
                        <span class="hidden sm:inline">New</span>
                        </c-buttons.primary>
                        <c-dropdowns.dropdown class="right-0 mt-2 w-48" aria-label="Create options" x-show="open" x-cloak x-transition:enter="transition ease-out duration-150" x-transition:enter-start="opacity-0 translate-y-1" x-transition:enter-end="opacity-100 translate-y-0" x-transition:leave="transition ease-in duration-100" x-transition:leave-start="opacity-100 translate-y-0" x-transition:leave-end="opacity-0 translate-y-1" @click.away="open = false">
                        <c-dropdowns.item icon="fas fa-cube" href="{% url 'core:product_new' %}" @click="open = false">
                        Product
                        </c-dropdowns.item>
                        <c-dropdowns.item icon="fas fa-puzzle-piece" href="{% url 'core:component_new' %}" @click="open = false">
                        Component
                        </c-dropdowns.item>
                        <c-dropdowns.item icon="fas fa-shield-halved" href="{% url 'core:security_advisory_new' %}" @click="open = false">
                        Advisory
                        </c-dropdowns.item>
                        </c-dropdowns.dropdown>
                    </div>
                {% endif %}
            {% endif %}
        {% endwith %}
        {# Notifications Dropdown #}
        <div x-data="{ open: false }"
             class="relative"
             @keydown.escape.window="if(open) open = false"
             id="notifications-dropdown-container">
            <c-buttons.icon label="View notifications" class="relative" aria-haspopup="true" @click="open = !open; if(open) $dispatch('notifications-open')" ::aria-expanded="open">
            <i class="fas fa-bell text-lg" aria-hidden="true"></i>
            <span id="notifications-badge"
                  class="absolute -top-0.5 -right-0.5 min-w-5 h-5 px-1.5 bg-danger text-white text-[10px] font-bold rounded-full hidden flex items-center justify-center shadow-sm"
                  aria-label="New notifications"></span>
            </c-buttons.icon>
            <c-dropdowns.dropdown flush class="right-0 mt-2 w-80" aria-label="Notifications" id="notifications-dropdown" x-show="open" x-cloak x-transition:enter="transition ease-out duration-150" x-transition:enter-start="opacity-0 translate-y-1" x-transition:enter-end="opacity-100 translate-y-0" x-transition:leave="transition ease-in duration-100" x-transition:leave-start="opacity-100 translate-y-0" x-transition:leave-end="opacity-0 translate-y-1" @click.away="open = false">
            {# Header #}
            <div class="flex items-center justify-between px-4 py-3 border-b border-border">
                <div class="flex items-center gap-2">
                    <i class="fas fa-bell text-primary"></i>
                    <span class="text-sm font-semibold text-text">Notifications</span>
                </div>
                {% comment %}
                    Starts hidden inline: the notifications script shows it via
                    style.display, because a `hidden` utility loses to the
                    display the button sets itself.
                {% endcomment %}
                <c-buttons.ghost size="sm" id="clearAllNotifications" style="display: none">Clear all</c-buttons.ghost>
            </div>
            {# Body #}
            <div class="max-h-96 overflow-y-auto">
                {# Loading State #}
                <div id="notifications-loading"
                     class="flex flex-col items-center justify-center py-12 px-4">
                    <c-feedback.spinner size="lg" class="mb-3" />
                    <p class="text-sm text-text-muted">Loading notifications...</p>
                </div>
                {# Notifications List #}
                <div id="notifications-list"></div>
                {# Empty State #}
                <div id="notifications-empty" class="hidden">
                    <div class="flex flex-col items-center justify-center py-12 px-6">
                        <div class="w-16 h-16 rounded-full bg-gradient-to-br from-success/20 to-success/5 flex items-center justify-center mb-4">
                            <i class="fas fa-check text-2xl text-success"></i>
                        </div>
                        <p class="text-sm font-semibold text-text mb-1">You're all caught up!</p>
                        <p class="text-xs text-text-muted text-center">No new notifications at the moment.</p>
                    </div>
                </div>
            </div>
            </c-dropdowns.dropdown>
        </div>
        {# User Dropdown #}
        <div x-data="{ open: false }"
             class="relative"
             @keydown.escape.window="if(open) open = false">
            <c-buttons.ghost aria-label="User menu" aria-haspopup="true" @click="open = !open" ::aria-expanded="open">
            <c-avatar initials="{{ request.user|user_initials }}" size="sm" ::class="open && 'ring-2 ring-[color-mix(in_oklab,var(--color-primary)_30%,transparent)]'" />
            <span class="hidden md:block text-sm font-medium text-text">
                {{ request.user.first_name|default:request.user.email }}
            </span>
            <i class="fas fa-chevron-down text-xs text-text-muted hidden md:block transition-transform duration-200"
               :class="open ? 'rotate-180' : ''"
               aria-hidden="true"></i>
            </c-buttons.ghost>
            <c-dropdowns.dropdown class="right-0 mt-2 w-64" aria-label="User options" x-show="open" x-cloak x-transition:enter="transition ease-out duration-150" x-transition:enter-start="opacity-0 translate-y-1" x-transition:enter-end="opacity-100 translate-y-0" x-transition:leave="transition ease-in duration-100" x-transition:leave-start="opacity-100 translate-y-0" x-transition:leave-end="opacity-0 translate-y-1" @click.away="open = false">
            {% comment %}
                The panel opens with the account it belongs to, repeating the
                avatar the trigger shows. Someone signed in to two accounts
                opens this menu to check which one they are on, so the address
                is the point of the block, not decoration under the name.

                It shares the rows' padding, so the name starts on the same
                line as the item labels below it.

                An account with no name falls back to its address on the first
                line, and then the second line is dropped rather than printing
                the same address twice.
            {% endcomment %}
            <div class="flex items-center gap-3 px-2.5 py-2">
                <c-avatar initials="{{ request.user|user_initials }}" />
                <div class="min-w-0">
                    <p class="truncate text-sm font-semibold text-text">{{ request.user.get_full_name|default:request.user.email }}</p>
                    {% if request.user.get_full_name %}<p class="truncate text-xs text-text-muted">{{ request.user.email }}</p>{% endif %}
                </div>
            </div>
            <c-dropdowns.divider />
            {# Link straight to the account tab: a redirect would drop the fragment. #}
            {% if request.session.current_team and request.session.current_team.key %}
                <c-dropdowns.item icon="fas fa-user-gear" href="{% url 'teams:team_settings' team_key=request.session.current_team.key %}#account">
                Profile settings
                </c-dropdowns.item>
            {% else %}
                <c-dropdowns.item icon="fas fa-user-gear" href="{% url 'core:settings' %}">
                Profile settings
                </c-dropdowns.item>
            {% endif %}
            {% comment %}
                The theme picker is a row of the menu, not a panel inside it: it
                borrows the item's padding, gutter and label so it sits in the
                same rhythm as the links, and the options collapse to their
                icons on the right. Three suns, moons and screens need no words
                next to a row already labelled Theme, and the labels ride along
                on aria-label and title.

                They are menu items too, not a radiogroup dropped inside a menu,
                so the panel's arrow keys walk onto them instead of stepping
                over the only setting in the menu.

                The options are one recipe over a list rather than three copies
                of it, and the selected look is derived from the state.
            {% endcomment %}
            <div class="flex items-center gap-3 px-2.5 py-2"
                 x-data="{ theme: window.themeManager?.getTheme() || 'dark', options: [{ value: 'light', icon: 'fa-sun', label: 'Light' }, { value: 'dark', icon: 'fa-moon', label: 'Dark' }, { value: 'system', icon: 'fa-desktop', label: 'Auto' }], setTheme(t) { this.theme = t; window.themeManager?.setTheme(t); } }">
                <i class="fas fa-circle-half-stroke shrink-0 w-4 text-center text-text-muted"
                   aria-hidden="true"></i>
                <span id="theme-label" class="text-sm font-semibold text-text">Theme</span>
                <div class="ml-auto flex gap-0.5 rounded-lg bg-[color-mix(in_oklab,var(--color-border)_35%,transparent)] p-0.5"
                     role="group"
                     aria-labelledby="theme-label">
                    <template x-for="option in options" :key="option.value">
                        <button type="button"
                                @click="setTheme(option.value)"
                                :class="theme === option.value ? 'bg-primary text-white shadow-sm' : 'text-text-muted hover:bg-[color-mix(in_oklab,var(--color-primary)_10%,transparent)] hover:text-text'"
                                class="w-7 h-7 rounded-md text-xs transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset"
                                role="menuitemradio"
                                :aria-checked="theme === option.value"
                                :aria-label="option.label"
                                :title="option.label">
                            <i class="fas" :class="option.icon" aria-hidden="true"></i>
                        </button>
                    </template>
                </div>
            </div>
            <c-dropdowns.divider />
            {% comment %}
                Not danger: signing out is reversible, and the red ink is
                reserved for actions that destroy something.
            {% endcomment %}
            <c-dropdowns.item icon="fas fa-arrow-right-from-bracket" href="{% url 'core:logout' %}">
            Sign out
            </c-dropdowns.item>
            </c-dropdowns.dropdown>
        </div>
    </div>
</header>
