{% if messages or pending_invitations_count or pending_access_requests_count %}
    <div hidden
         data-django-messages
         data-pending-invitations="{{ pending_invitations_count|default:0 }}"
         data-pending-access-requests="{{ pending_access_requests_count|default:0 }}">
        {% for message in messages %}<span data-level="{{ message.level_tag }}">{{ message }}</span>{% endfor %}
    </div>
{% endif %}
