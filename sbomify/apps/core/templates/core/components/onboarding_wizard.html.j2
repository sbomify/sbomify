{% extends "core/base.html.j2" %}
{% load django_vite %}
{% block title %}Set up your workspace · sbomify{% endblock %}
{% block main %}
    <main id="main-content" class="min-h-screen px-4 py-8 sm:px-7 sm:py-10">
        <c-layout.frame class="mx-auto w-full max-w-6xl">
        <div class="flex justify-center py-2">
            {% include "core/components/brand/logo.html.j2" with class="h-6 w-auto" label="sbomify" %}
        </div>
        {% if current_step == 'setup' %}{{ wizard_config|json_script:"onboarding-config" }}{% endif %}
        <c-layout.frame x-data="
        {% if current_step == 'setup' %}
            onboardingWizard(window.parseJsonScript('onboarding-config'))
        {% else %}
            { step: '{{ current_step }}' }
        {% endif %}
        ">
        <c-navigation.stepper class="mx-auto w-full max-w-2xl" role="list" aria-label="Setup progress">
        <c-navigation.stepper-step compact label="Why" label_class="hidden sm:inline" role="listitem" ::data-state="step === 'welcome' ? 'active' : 'completed'" ::aria-current="step === 'welcome' ? 'step' : null" />
        <c-navigation.stepper-connector compact />
        <c-navigation.stepper-step compact label="Your organisation" label_class="hidden sm:inline" role="listitem" ::data-state="step === 'organisation' ? 'active' : step === 'welcome' ? '' : 'completed'" ::aria-current="step === 'organisation' ? 'step' : null" />
        <c-navigation.stepper-connector compact />
        <c-navigation.stepper-step compact label="Security promises" label_class="hidden sm:inline" role="listitem" ::data-state="step === 'security' ? 'active' : step === 'complete' || step === 'plan' ? 'completed' : ''" ::aria-current="step === 'security' ? 'step' : null" />
        {% if billing_enabled %}
            <c-navigation.stepper-connector compact />
            <c-navigation.stepper-step compact label="Your plan" label_class="hidden sm:inline" role="listitem" ::data-state="step === 'plan' ? 'active' : ''" ::aria-current="step === 'plan' ? 'step' : null" />
        {% endif %}
        </c-navigation.stepper>
        {% if current_step == 'plan' %}
            <c-layout.page-header title="Choose your plan" subtitle="Start with Community or try Business. You can change your plan later." />
            {{ plan_selection_data|json_script:"onboarding-plan-data" }}
            <c-layout.frame x-data="planSelection(window.parseJsonScript('onboarding-plan-data'))">
            <div class="flex justify-center">
                <c-navigation.segmented aria-label="Billing period">
                <c-navigation.segment ::data-active="billingPeriod === 'monthly'" ::aria-pressed="billingPeriod === 'monthly'" @click="billingPeriod = 'monthly'">Monthly</c-navigation.segment>
                <c-navigation.segment ::data-active="billingPeriod === 'annual'" ::aria-pressed="billingPeriod === 'annual'" @click="billingPeriod = 'annual'">Annual</c-navigation.segment>
                </c-navigation.segmented>
            </div>
            <div class="grid gap-5 lg:grid-cols-3">
                {% for plan in plan_cards %}
                    <c-billing.plan-card :plan="plan">
                    <c-slot name="action">
                    {% if plan.key == plan_hint %}<c-badges.secondary>Your selected plan</c-badges.secondary>{% endif %}
                    <form method="post" action="{% url 'teams:onboarding_wizard' %}">
                        {% csrf_token %}
                        <input type="hidden" name="plan" value="{{ plan.key }}">
                        <input type="hidden" name="billing_period" :value="billingPeriod">
                        {% if plan.key == 'business' %}
                            <c-buttons.primary type="submit" class="w-full">Start {{ trial_days }}-day free trial</c-buttons.primary>
                        {% elif plan.key == 'enterprise' %}
                            <c-buttons.secondary type="submit" class="w-full">Contact sales</c-buttons.secondary>
                        {% else %}
                            <c-buttons.secondary type="submit" class="w-full">Continue with Community</c-buttons.secondary>
                        {% endif %}
                    </form>
                    </c-slot>
                    </c-billing.plan-card>
                {% endfor %}
            </div>
            <c-forms.hint>Business continues to checkout. No subscription starts until you confirm it there.</c-forms.hint>
            </c-layout.frame>
        {% else %}
            <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_19rem]">
                <c-cards.card>
                <c-layout.frame>
                {% if current_step == 'welcome' %}
                    <c-forms.hint>
                    {% if first_name %}
                        Welcome, {{ first_name }}
                    {% else %}
                        Welcome
                    {% endif %}
                    </c-forms.hint>
                    <c-layout.page-header title="Set up your security workspace" subtitle="Add your organisation and security commitments once. Use them when generating artifacts and preparing product assessments." />
                    <c-onboarding.reason number="01" title="Who you are" description="Record your organisation and the person responsible for your artifacts. These details form your default contact profile." />
                    <c-onboarding.reason number="02" title="Where to report a vulnerability" description="Give security researchers a contact email. You can publish it through your Trust Center's security.txt." />
                    <c-onboarding.reason number="03" title="How you support your software" description="Choose a default support period and patch targets so you can track progress against your commitments." />
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <c-buttons.primary href="{% url 'teams:onboarding_wizard' %}?step=setup">Start <i class="fas fa-arrow-right" aria-hidden="true"></i></c-buttons.primary>
                        <c-forms.hint>Takes about two minutes.</c-forms.hint>
                    </div>
                {% elif current_step == 'setup' %}
                    <form method="post"
                          action="{% url 'teams:onboarding_wizard' %}"
                          novalidate
                          @submit="submit($event)"
                          class="flex flex-col gap-6">
                        {% csrf_token %}
                        {% if form.non_field_errors %}
                            <c-feedback.alert variant="danger">{{ form.non_field_errors }}</c-feedback.alert>
                        {% endif %}
                        <div x-ref="organisation"
                             x-show="step === 'organisation'"
                             class="flex flex-col gap-6">
                            <c-layout.page-header title="Who are you?" subtitle="These details identify your organisation. You can change them later. Uploaded artifacts always keep their original content." tabindex="-1" x-ref="organisationTitle" />
                            <c-forms.field label="Organisation name" for="id_company_name" required hint="Names your workspace and identifies your organisation." :error="form.company_name.errors">
                            <c-forms.input id="id_company_name" name="company_name" required maxlength="255" autocomplete="organization" value="{{ form.company_name.value|default:'' }}" />
                            </c-forms.field>
                            <c-forms.field label="Your name" for="id_contact_name" required hint="The person responsible for your artifacts." :error="form.contact_name.errors">
                            <c-forms.input id="id_contact_name" name="contact_name" required maxlength="255" autocomplete="name" value="{{ form.contact_name.value|default:'' }}" />
                            </c-forms.field>
                            <div class="grid gap-5 sm:grid-cols-2">
                                <c-forms.field label="Website" for="id_website" hint="Optional. Your organisation's website." :error="form.website.errors">
                                <c-forms.input id="id_website" name="website" type="url" autocomplete="url" maxlength="200" value="{{ form.website.value|default:'' }}" placeholder="https://example.com" />
                                </c-forms.field>
                                <c-forms.field label="Contact email" for="id_email" hint="We suggest this as your security contact next." :error="form.email.errors">
                                <c-forms.input id="id_email" name="email" type="email" x-ref="email" autocomplete="email" value="{{ form.email.value|default:'' }}" />
                                </c-forms.field>
                            </div>
                            <div class="flex flex-col items-start gap-3">
                                <c-buttons.secondary size="sm" @click="addressExpanded = !addressExpanded" ::aria-expanded="addressExpanded" aria-controls="registered-address"><i class="fas fa-plus" aria-hidden="true"></i>Registered address</c-buttons.secondary>
                                <c-forms.field id="registered-address" class="w-full" x-show="addressExpanded" x-cloak label="Registered address" for="id_address" hint="Optional. The organisation's postal address." :error="form.address.errors">
                                <c-forms.textarea id="id_address" name="address" autocomplete="street-address" maxlength="2000" rows="3" value="{{ form.address.value|default:'' }}" />
                                </c-forms.field>
                            </div>
                            <c-forms.field label="What are you trying to accomplish?" for="id_goal" hint="Optional. Helps us understand what you need." :error="form.goal.errors">
                            <c-forms.textarea id="id_goal" name="goal" maxlength="1000" rows="2" value="{{ form.goal.value|default:'' }}" />
                            </c-forms.field>
                            <div class="flex flex-wrap justify-between gap-3">
                                <c-buttons.secondary href="{% url 'teams:onboarding_wizard' %}">Back</c-buttons.secondary>
                                <c-buttons.primary @click="next()">Continue <i class="fas fa-arrow-right" aria-hidden="true"></i></c-buttons.primary>
                            </div>
                        </div>
                        <div x-ref="security"
                             x-show="step === 'security'"
                             x-cloak
                             class="flex flex-col gap-6">
                            <c-layout.page-header title="Your security promises" subtitle="Set defaults for future assessments and track how quickly vulnerabilities are fixed. These settings do not certify compliance." tabindex="-1" x-ref="securityTitle" />
                            <c-forms.field label="Vulnerability reports go to" for="id_security_email" :error="form.security_email.errors">
                            <c-forms.input id="id_security_email" name="security_email" type="email" x-ref="securityEmail" value="{{ form.security_email.value|default:'' }}" placeholder="security@example.com" />
                            </c-forms.field>
                            <c-forms.checkbox name="publish_security_txt" value="on" :checked="form.publish_security_txt.value">Publish this email in my Trust Center's security.txt</c-forms.checkbox>
                            <c-forms.field label="Default support period (years)" for="id_default_support_period_years" hint="Used for new product assessments, from the release date or assessment date. A product's support date takes precedence." :error="form.default_support_period_years.errors">
                            <c-forms.input id="id_default_support_period_years" name="default_support_period_years" type="number" min="5" max="100" step="1" value="{{ form.default_support_period_years.value|default_if_none:'' }}" />
                            </c-forms.field>
                            <div class="flex flex-col gap-4"
                                 x-data="{ mode: '{{ form.mode.value|default:'recommended'|escapejs }}' }">
                                <c-forms.field label="Maximum time to fix" for="id_mode" hint="Recommended: critical 7, high 30 and medium 90 days. Low is best effort." :error="form.mode.errors">
                                <c-forms.select id="id_mode" name="mode" x-model="mode">
                                <option value="recommended">Use recommended patch targets</option>
                                <option value="custom">Set my own</option>
                                </c-forms.select>
                                </c-forms.field>
                                <div class="grid gap-4 sm:grid-cols-2" x-show="mode === 'custom'" x-cloak>
                                    {% for field in form %}
                                        {% if field.name == 'critical' or field.name == 'high' or field.name == 'medium' or field.name == 'low' %}
                                            <c-forms.field label="{{ field.label }} (days)" for="{{ field.id_for_label }}" :error="field.errors">
                                            <c-forms.input id="{{ field.id_for_label }}" name="{{ field.name }}" type="number" min="0" max="3650" step="1" value="{{ field.value|default_if_none:'' }}" placeholder="Best effort" ::disabled="mode !== 'custom'" />
                                            </c-forms.field>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                <c-forms.hint>Leave a target empty for best effort. That severity is excluded from the patch SLA percentage.</c-forms.hint>
                            </div>
                            <div class="flex flex-wrap justify-between gap-3">
                                <c-buttons.secondary @click="back()" ::disabled="isSubmitting">Back</c-buttons.secondary>
                                <c-buttons.primary type="submit" ::disabled="isSubmitting"><c-feedback.spinner size="sm" x-show="isSubmitting" x-cloak /><span x-text="isSubmitting ? 'Saving...' : 'Save and continue'">Save and continue</span></c-buttons.primary>
                            </div>
                        </div>
                    </form>
                {% elif current_step == 'complete' %}
                    <c-feedback.status tone="success" label="Workspace ready" />
                    <c-layout.page-header title="Your workspace is set up" subtitle="Your settings are saved. Create a product and component, then connect a repository or upload your first artifact." />
                    <c-forms.hint>{{ company_name }}</c-forms.hint>
                    <div class="flex justify-end">
                        <c-buttons.primary href="{{ next_url }}">
                        {% if billing_enabled %}
                            Choose your plan
                        {% else %}
                            Go to dashboard
                        {% endif %}
                        <i class="fas fa-arrow-right" aria-hidden="true"></i></c-buttons.primary>
                        </div>
                    {% endif %}
                    </c-layout.frame>
                    </c-cards.card>
                    <aside aria-label="What this gives you">
                        <c-cards.card flush>
                        <c-cards.header compact title="What this gives you" hint="A reusable starting point for your workspace." />
                        <c-onboarding.checklist-item title="Organisation identity" description="Your default manufacturer and supplier profile." :complete="setup_saved" ::data-active="step === 'organisation'" />
                        <c-onboarding.checklist-item title="An artifact contact" description="The person responsible for SBOM inquiries." :complete="setup_saved" ::data-active="step === 'organisation'" />
                        <c-onboarding.checklist-item title="A security contact" description="Where researchers can report vulnerabilities." :complete="security_contact_saved" ::data-active="step === 'security'" />
                        <c-onboarding.checklist-item title="A support default" description="A starting point for future product assessments." :complete="support_default_saved" ::data-active="step === 'security'" />
                        <c-onboarding.checklist-item title="Measurable patch targets" description="Track time to fix against your chosen targets." :complete="setup_saved" ::data-active="step === 'security'" />
                        </c-cards.card>
                    </aside>
                </div>
            {% endif %}
            </c-layout.frame>
            </c-layout.frame>
        </main>
    {% endblock %}
    {% block scripts %}
        {% vite_asset 'sbomify/apps/teams/js/main.ts' %}
    {% endblock %}
