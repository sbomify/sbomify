<div x-show="totalPages > 1"
     x-cloak
     class="mt-4 pt-4 border-t border-border">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex items-center gap-4">
            <span class="text-sm text-text-muted">
                Showing <span x-text="startItem"></span>-<span x-text="endItem"></span> of <span x-text="totalItems"></span> items
            </span>
            <div x-show="pageSizeOptions && pageSizeOptions.length > 0"
                 x-cloak
                 class="flex items-center gap-2">
                <label for="{{ pagination_id|default:'pagination' }}-page-size"
                       class="text-sm text-text-muted">Items per page:</label>
                <c-forms.select id="{{ pagination_id|default:'pagination' }}-page-size" size="sm" x-model="pageSize" @change="handlePageSizeChange($event)">
                <template x-for="size in pageSizeOptions" :key="size">
                    <option :value="size" x-text="size"></option>
                </template>
                </c-forms.select>
            </div>
        </div>
        {# Paging is client state here, so the buttons bind it rather than link to it. #}
        <nav aria-label="Pagination" class="flex items-center gap-1">
            <c-navigation.page-button nav label="First page" ::disabled="currentPage === 1" @click="goToPage(1)">First</c-navigation.page-button>
            <c-navigation.page-button nav label="Previous page" ::disabled="currentPage === 1" @click="goToPage(currentPage - 1)">Previous</c-navigation.page-button>
            <template x-for="page in visiblePages" :key="page">
                <template x-if="page === '...'">
                    <span class="flex items-center">
                        <c-navigation.page-ellipsis x-text="ellipsis" />
                        <span class="sr-only">Pages skipped</span>
                    </span>
                </template>
                <template x-if="page !== '...'">
                    <c-navigation.page-button ::data-active="page === currentPage" @click="goToPage(page)" ::aria-label="`Go to page ${page}`" ::aria-current="page === currentPage ? 'page' : null" x-text="page" />
                </template>
            </template>
            <c-navigation.page-button nav label="Next page" ::disabled="currentPage === totalPages" @click="goToPage(currentPage + 1)">Next</c-navigation.page-button>
            <c-navigation.page-button nav label="Last page" ::disabled="currentPage === totalPages" @click="goToPage(totalPages)">Last</c-navigation.page-button>
        </nav>
    </div>
</div>
