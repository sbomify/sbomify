<c-cards.card>
<c-slot name="header">
<c-cards.header>
<h4 class="text-lg font-semibold text-text flex items-center gap-2 m-0">
    <i class="fas fa-envelope-open-text text-primary"></i>
    Workspace Invitations
</h4>
</c-cards.header>
</c-slot>
{% if pending_invitations %}
    <div class="space-y-3">
        {% for inv in pending_invitations %}
            <c-cards.inset>
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h5 class="font-semibold text-text flex items-center gap-2 mb-2">
                        <i class="fas fa-building text-primary"></i>
                        {{ inv.team_name }}
                    </h5>
                    <div class="flex items-center gap-3 text-sm">
                        <c-chips.neutral>{{ inv.role|title }}</c-chips.neutral>
                        <span class="text-text-muted flex items-center gap-1">
                            <i class="fas fa-clock"></i>
                            Expires {{ inv.expires_at|date:"j M Y" }}
                        </span>
                    </div>
                </div>
                <div class="flex gap-2">
                    <form method="post"
                          action="{% url 'core:accept_user_invitation' inv.id %}"
                          class="inline"
                          hx-boost="false">
                        {% csrf_token %}
                        <c-buttons.primary type="submit">
                        <i class="fas fa-check mr-1"></i> Accept
                        </c-buttons.primary>
                    </form>
                    <form method="post"
                          action="{% url 'core:reject_user_invitation' inv.id %}"
                          class="inline"
                          hx-boost="false">
                        {% csrf_token %}
                        <c-buttons.outline-danger type="submit" size="sm">
                        <i class="fas fa-times mr-1"></i> Decline
                        </c-buttons.outline-danger>
                    </form>
                </div>
            </div>
            </c-cards.inset>
        {% endfor %}
    </div>
{% else %}
    <p class="text-text-muted flex items-center gap-2 m-0">
        <i class="fas fa-inbox"></i>
        No pending workspace invitations.
    </p>
{% endif %}
</c-cards.card>
