{# Tab loads queue here rather than inherit #product-content's replace, which cancelled one tab's load when another started. #}
<section class="flex flex-col gap-4"
         aria-labelledby="product-details-heading"
         hx-sync="this:queue all"
         x-data="{ selectDetailTab(tab) { this.$refs.panels.style.minHeight = this.$refs.panels.offsetHeight + 'px'; this.detailTab = tab; }, init() { if (this.detailTab !== 'lifecycle') document.body.addEventListener('htmx:afterSettle', () => this.$root.querySelector(`[data-detail-tab='${this.detailTab}']`)?.click(), { once: true }); } }">
    <c-layout.section-header id="product-details-heading" title="Product details" level="2" />
    <c-navigation.tabs aria-label="Product details">
    <c-navigation.tab panel="product-lifecycle" active_binding="detailTab === 'lifecycle'" data-detail-tab="lifecycle" @click="selectDetailTab('lifecycle')">Lifecycle</c-navigation.tab>
    <c-navigation.tab panel="product-links" active_binding="detailTab === 'links'" data-detail-tab="links" @click="selectDetailTab('links')" hx-get="{% url 'core:product_links' product.id %}" hx-trigger="click once" hx-target="#product-links-panel" hx-swap="innerHTML show:none focus-scroll:false">Links</c-navigation.tab>
    <c-navigation.tab panel="product-identifiers" active_binding="detailTab === 'identifiers'" data-detail-tab="identifiers" @click="selectDetailTab('identifiers')" hx-get="{% url 'core:product_identifiers' product.id %}" hx-trigger="click once" hx-target="#product-identifiers-panel" hx-swap="innerHTML show:none focus-scroll:false">Identifiers</c-navigation.tab>
    <c-navigation.tab panel="product-custom-metadata" active_binding="detailTab === 'metadata'" data-detail-tab="metadata" @click="selectDetailTab('metadata')" hx-get="{% url 'core:product_custom_metadata' product.id %}" hx-trigger="click once" hx-target="#product-custom-metadata-panel" hx-swap="innerHTML show:none focus-scroll:false">Metadata</c-navigation.tab>
    <c-navigation.tab panel="product-compliance" active_binding="detailTab === 'compliance'" data-detail-tab="compliance" @click="selectDetailTab('compliance')" hx-get="{% url 'controls:product_controls' current_team.key product.id %}" hx-trigger="click once" hx-target="#product-controls-panel" hx-swap="innerHTML show:none focus-scroll:false">Compliance</c-navigation.tab>
    </c-navigation.tabs>
    <div x-ref="panels">
        <div id="panel-product-lifecycle"
             role="tabpanel"
             aria-labelledby="tab-product-lifecycle"
             tabindex="0"
             x-show="detailTab === 'lifecycle'">
            <div id="product-lifecycle-panel"
                 hx-get="{% url 'core:product_lifecycle' product.id %}"
                 hx-trigger="load"
                 hx-target="this"
                 hx-swap="innerHTML show:none focus-scroll:false">
                <c-feedback.loading message="Loading lifecycle" />
            </div>
        </div>
        <div id="panel-product-links"
             role="tabpanel"
             aria-labelledby="tab-product-links"
             tabindex="0"
             x-show="detailTab === 'links'"
             x-cloak>
            <div id="product-links-panel">
                <c-feedback.loading message="Loading product links" />
            </div>
        </div>
        <div id="panel-product-identifiers"
             role="tabpanel"
             aria-labelledby="tab-product-identifiers"
             tabindex="0"
             x-show="detailTab === 'identifiers'"
             x-cloak>
            <div id="product-identifiers-panel">
                <c-feedback.loading message="Loading product identifiers" />
            </div>
        </div>
        <div id="panel-product-custom-metadata"
             role="tabpanel"
             aria-labelledby="tab-product-custom-metadata"
             tabindex="0"
             x-show="detailTab === 'metadata'"
             x-cloak>
            <div id="product-custom-metadata-panel">
                <c-feedback.loading message="Loading custom metadata" />
            </div>
        </div>
        <div id="panel-product-compliance"
             role="tabpanel"
             aria-labelledby="tab-product-compliance"
             tabindex="0"
             x-show="detailTab === 'compliance'"
             x-cloak
             class="flex flex-col gap-4">
            {% include 'compliance/components/cra_product_card.html.j2' %}
            <div id="product-controls-panel">
                <c-feedback.loading message="Loading compliance controls" />
            </div>
        </div>
    </div>
</section>
