{% load static utils %}
{% comment %}
    The shell draws the panel's frame itself, so the links table needs no card
    around it; the title and the add control ride the toolbar band.
{% endcomment %}
<c-tables.shell id="product-links-card" x-data="{ showAddModal: false, showEditModal: false, showDeleteModal: false, editId: '', editType: '', editTitle: '', editUrl: '', editDescription: '', deleteId: '', deleteName: '' }">
<c-tables.toolbar>
<h4 class="text-lg font-semibold text-text flex items-center gap-2 m-0">
    <i class="fas fa-link text-primary" aria-hidden="true"></i>Product links
</h4>
<c-slot name="right">
{% comment %}
    Only when the table below gives it something to sit above. In the product
    page's collapsible section the panel title is suppressed, so an always-on
    button floated alone over the empty state; the empty state carries its own
    action instead.
{% endcomment %}
{% if can_manage_links and links %}
    <c-buttons.primary size="sm" @click="showAddModal = true">
    <i class="fas fa-plus mr-1" aria-hidden="true"></i>Add link
    </c-buttons.primary>
{% endif %}
</c-slot>
</c-tables.toolbar>
{% if links %}
    <c-tables.table>
    <c-tables.head>
    <c-tables.header-cell class="w-[15%]">Type</c-tables.header-cell>
    <c-tables.header-cell class="w-[25%]">Title</c-tables.header-cell>
    <c-tables.header-cell class="w-[45%]">URL</c-tables.header-cell>
    {% if can_manage_links %}<c-tables.actions-cell as="th" label="Actions" />{% endif %}
    </c-tables.head>
    <tbody>
        {% for link in links %}
            <c-tables.row>
            <c-tables.cell>
            <c-badges.secondary>{{ link_types|get_item:link.link_type|default:link.link_type }}</c-badges.secondary>
            </c-tables.cell>
            <c-tables.cell>
            <div class="font-medium text-text">{{ link.title }}</div>
            {% if link.description %}<div class="text-text-muted text-xs mt-1">{{ link.description }}</div>{% endif %}
            </c-tables.cell>
            <c-tables.cell>
            <a href="{{ link.url }}"
               target="_blank"
               rel="noopener noreferrer"
               class="text-primary hover:underline inline-flex items-center gap-1">
                {% if link.url|length > 50 %}
                    {{ link.url|truncatechars:50 }}
                {% else %}
                    {{ link.url }}
                {% endif %}
                <i class="fas fa-external-link-alt text-xs" aria-hidden="true"></i>
            </a>
            </c-tables.cell>
            {% if can_manage_links %}
                <c-tables.actions-cell>
                <c-actions-menu label="Link actions">
                <c-dropdowns.item icon="fas fa-edit" @click="editId = '{{ link.id|escapejs }}'; editType = '{{ link.link_type|escapejs }}'; editTitle = '{{ link.title|escapejs }}'; editUrl = '{{ link.url|escapejs }}'; editDescription = '{{ link.description|default:''|escapejs }}'; showEditModal = true">
                Edit
                </c-dropdowns.item>
                <c-dropdowns.item-danger icon="fas fa-trash" @click="deleteId = '{{ link.id|escapejs }}'; deleteName = '{{ link.title|escapejs }}'; showDeleteModal = true">
                Delete
                </c-dropdowns.item-danger>
                </c-actions-menu>
                </c-tables.actions-cell>
            {% endif %}
            </c-tables.row>
        {% endfor %}
    </tbody>
    </c-tables.table>
{% else %}
    {% comment %}
        Two branches, not three: build_links_context sets can_manage_links to
        has_crud_permissions verbatim, so there is no reader who can crud but
        not manage.
    {% endcomment %}
    {% if can_manage_links %}
        <c-feedback.empty-state icon="fas fa-link" icon_variant="neutral" title="No product links added" message="Add links like website, support, documentation, etc. to provide additional information about this product">
        <c-buttons.primary size="sm" @click="showAddModal = true">
        <i class="fas fa-plus mr-1" aria-hidden="true"></i>Add link
        </c-buttons.primary>
        </c-feedback.empty-state>
    {% else %}
        <c-feedback.empty-state icon="fas fa-link" icon_variant="neutral" title="No product links available" message="This product does not have any links defined" />
    {% endif %}
{% endif %}
{% if can_manage_links %}
    {# Add Link Modal #}
    <c-modal id="addLinkModal" show="showAddModal" title="Add link">
    <form id="add-link-form"
          @submit.prevent=" fetch('{% url 'core:product_links' product.id %}', { method: 'POST', body: new FormData($el), }).then(response => response.text()).then(html => { document.getElementById('product-links-card').outerHTML = html; showAddModal = false; }); ">
        {% csrf_token %}
        <input type="hidden" name="action" value="create">
        <div class="space-y-4">
            <div>
                <c-forms.label for="add-link-type" required>Link Type</c-forms.label>
                <c-forms.select id="add-link-type" name="link_type" required>
                <option value="">Select type...</option>
                {% for value, label in link_types.items %}<option value="{{ value }}">{{ label }}</option>{% endfor %}
                </c-forms.select>
            </div>
            <div>
                <c-forms.label for="add-link-title" required>Title</c-forms.label>
                <c-forms.input id="add-link-title" name="title" placeholder="Enter link title" required />
            </div>
            <div>
                <c-forms.label for="add-link-url" required>URL</c-forms.label>
                <c-forms.input id="add-link-url" name="url" type="url" placeholder="https://example.com" required />
            </div>
            <div>
                <c-forms.label for="add-link-description">Description</c-forms.label>
                <c-forms.textarea id="add-link-description" name="description" rows="3" placeholder="Optional description of this link" />
            </div>
        </div>
    </form>
    <c-slot name="footer">
    <c-buttons.ghost @click="showAddModal = false">Cancel</c-buttons.ghost>
    <c-buttons.primary type="submit" form="add-link-form">
    <i class="fas fa-plus mr-2" aria-hidden="true"></i>Add
    </c-buttons.primary>
    </c-slot>
    </c-modal>
    {# Edit Link Modal #}
    <c-modal id="editLinkModal" show="showEditModal" title="Edit Link" icon="fas fa-edit">
    <form id="edit-link-form"
          @submit.prevent=" const formData = new FormData($el); formData.set('link_id', editId); fetch('{% url 'core:product_links' product.id %}', { method: 'POST', body: formData, }).then(response => response.text()).then(html => { document.getElementById('product-links-card').outerHTML = html; showEditModal = false; }); ">
        {% csrf_token %}
        <input type="hidden" name="action" value="update">
        <input type="hidden" name="link_id" :value="editId">
        <div class="space-y-4">
            <div>
                <c-forms.label for="edit-link-type" required>Link Type</c-forms.label>
                <c-forms.select id="edit-link-type" name="link_type" required x-model="editType">
                <option value="">Select type...</option>
                {% for value, label in link_types.items %}<option value="{{ value }}">{{ label }}</option>{% endfor %}
                </c-forms.select>
            </div>
            <div>
                <c-forms.label for="edit-link-title" required>Title</c-forms.label>
                <c-forms.input id="edit-link-title" name="title" placeholder="Enter link title" required x-model="editTitle" />
            </div>
            <div>
                <c-forms.label for="edit-link-url" required>URL</c-forms.label>
                <c-forms.input id="edit-link-url" name="url" type="url" placeholder="https://example.com" required x-model="editUrl" />
            </div>
            <div>
                <c-forms.label for="edit-link-description">Description</c-forms.label>
                <c-forms.textarea id="edit-link-description" name="description" rows="3" placeholder="Optional description of this link" x-model="editDescription" />
            </div>
        </div>
    </form>
    <c-slot name="footer">
    <c-buttons.ghost @click="showEditModal = false">Cancel</c-buttons.ghost>
    <c-buttons.primary type="submit" form="edit-link-form">
    <i class="fas fa-save mr-2" aria-hidden="true"></i>Update
    </c-buttons.primary>
    </c-slot>
    </c-modal>
    {# Delete Link Modal #}
    <c-modal show="showDeleteModal" size="sm" role="alertdialog" aria-labelledby="deleteLinkModalLabel">
    <div class="relative text-center">
        <c-buttons.icon label="Close" class="absolute -top-2 -right-2" @click="showDeleteModal = false">
        <i class="fas fa-times" aria-hidden="true"></i>
        </c-buttons.icon>
        <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-danger/10 flex items-center justify-center">
            <i class="fas fa-exclamation-triangle text-danger text-xl"
               aria-hidden="true"></i>
        </div>
        <h4 id="deleteLinkModalLabel"
            class="text-lg font-semibold text-text tracking-[-0.01em] mb-2">Delete Link</h4>
        <p class="text-text mb-2">
            Are you sure you want to delete <span class="font-semibold text-danger" x-text="deleteName"></span>?
        </p>
        <p class="text-text-muted text-sm">This action cannot be undone and will permanently remove this link.</p>
    </div>
    <c-slot name="footer">
    <c-buttons.ghost @click="showDeleteModal = false">Cancel</c-buttons.ghost>
    <c-buttons.danger @click=" const formData = new FormData(); formData.append('csrfmiddlewaretoken', '{{ csrf_token }}'); formData.append('action', 'delete'); formData.append('link_id', deleteId); fetch('{% url 'core:product_links' product.id %}', { method: 'POST', body: formData, }).then(response => response.text()).then(html => { document.getElementById('product-links-card').outerHTML = html; showDeleteModal = false; }); ">
    <i class="fas fa-trash mr-2" aria-hidden="true"></i>Delete
    </c-buttons.danger>
    </c-slot>
    </c-modal>
{% endif %}
</c-tables.shell>
