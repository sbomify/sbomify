{% comment %}The existing release editor reads server-rendered records. A save refreshes the owning page through HTMX; it never fetches a second client-side inventory.{% endcomment %}
{{ release_editor_data|json_script:"product-release-data" }}
<div class="contents"
     x-data="releaseEditor({ productId: '{{ product.id }}', initialReleases: window.parseJsonScript('product-release-data') || [], refreshEvent: '{{ refresh_event }}', canDelete: {{ can_delete|yesno:'true,false' }} })"
     {% if open_from_hash %}x-init="if (window.location.hash === '#new-release') { openCreateModal(); history.replaceState(null, '', window.location.pathname + window.location.search) }"{% endif %}
     @open-create-release.window="openCreateModal()"
     @edit-product-release.window="const release = releases.find(row => row.id === $event.detail.id); if (release && !release.is_latest) openEditModal(release)"
     @delete-product-release.window="const release = releases.find(row => row.id === $event.detail.id); if (release && !release.is_latest && canDelete) openDeleteModal(release)"
     @ws:message.window="if (['release_created', 'release_updated', 'release_deleted'].includes($event.detail.type) && $event.detail.product_id === '{{ product.id }}' && !showModal && !showDeleteModal) $dispatch('{{ refresh_event }}')">
    {% include 'core/components/release_form_modal.html.j2' %}
    {% if can_delete %}
        {% include 'components/delete_confirmation_modal.html.j2' with modal_id='showDeleteModal' dialog_id='release-delete' title='Delete release' message='Delete release' item_name_expression='deleteTarget?.name' warning_message='Its artifacts stay in your workspace. The release and its artifact associations cannot be recovered.' confirm_text='Delete release' confirm_callback='confirmDeleteRelease()' %}
    {% endif %}
</div>
