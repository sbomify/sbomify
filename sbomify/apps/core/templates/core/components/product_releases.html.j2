{% load static %}
{# WebSocket listener for real-time updates #}
<div x-data="productReleases({ productId: '{{ product_id }}', initialReleases: [], totalCount: 0, isPublicView: {{ is_public_view|yesno:'true,false' }}, canCreate: {{ can_create|yesno:'true,false' }}, canEdit: {{ can_edit|yesno:'true,false' }}, canDelete: {{ can_delete|yesno:'true,false' }} })"
     x-init="loadReleases()"
     @ws:message.window=" if (['release_created', 'release_updated', 'release_deleted'].includes($event.detail.type) && $event.detail.product_id === '{{ product_id }}') { loadReleases(); } ">
    {# The shell draws the frame itself, so the table needs no card around it. #}
    <c-tables.shell>
    <c-tables.toolbar>
    <h4 class="text-lg font-semibold text-text flex items-center gap-2 m-0">
        <i class="fas fa-tag"></i>Releases
    </h4>
    <c-slot name="right">
    {% if can_create %}
        <c-buttons.primary size="sm" @click="openCreateModal()">
        <i class="fas fa-plus mr-1"></i>Create Release
        </c-buttons.primary>
    {% endif %}
    </c-slot>
    </c-tables.toolbar>
    {# Toolbar with Search and Page Size #}
    <c-tables.toolbar x-show="!isLoading && releases.length > 0">
    <c-tables.search id="product-releases-search" label="Search releases" placeholder="Search releases..." x-model="search" />
    <c-slot name="right">
    <c-tables.page-size id="product-releases-per-page" x-model.number="pageSize">
    <template x-for="size in pageSizeOptions" :key="size">
        <option :value="size" x-text="size"></option>
    </template>
    </c-tables.page-size>
    </c-slot>
    </c-tables.toolbar>
    {# Loading State #}
    <c-feedback.loading message="Loading releases..." x-show="isLoading" />
    {# Empty State #}
    <div x-show="!isLoading && releases.length === 0">
        {% if can_create %}
            <c-feedback.empty-state icon="fas fa-tag" icon_variant="neutral" title="No releases yet" message="Create your first release to get started" />
        {% else %}
            <c-feedback.empty-state icon="fas fa-tag" icon_variant="neutral" title="No releases yet" />
        {% endif %}
    </div>
    {# Releases Table #}
    <div x-show="!isLoading && releases.length > 0">
        <c-tables.table>
        <c-tables.head>
        <c-tables.header-cell sort="name" nowrap>Name</c-tables.header-cell>
        <c-tables.header-cell sort="status">Status</c-tables.header-cell>
        <c-tables.header-cell class="text-center">Visibility</c-tables.header-cell>
        <c-tables.header-cell sort="artifacts">Artifacts</c-tables.header-cell>
        <c-tables.header-cell sort="created_at" date>Created</c-tables.header-cell>
        {% if can_edit or can_delete %}<c-tables.actions-cell as="th" label="Actions" />{% endif %}
        </c-tables.head>
        <tbody>
            <template x-for="release in sortedReleases" :key="release.id">
                <c-tables.row>
                <c-tables.cell nowrap>
                <div class="flex items-center gap-2">
                    <a :href="getReleaseUrl(release)"
                       class="text-primary font-medium hover:underline"
                       x-text="release.name"></a>
                    <c-badges.success x-show="release.is_latest">Latest</c-badges.success>
                    <c-badges.secondary x-show="release.version" x-text="release.version" />
                </div>
                </c-tables.cell>
                <c-tables.cell>
                <c-badges.warning x-show="release.is_prerelease">Pre-release</c-badges.warning>
                <c-badges.info x-show="!release.is_prerelease">Stable</c-badges.info>
                </c-tables.cell>
                <c-tables.cell class="text-center">
                <c-badges.success x-show="release.is_public">Public</c-badges.success>
                <c-badges.secondary x-show="!release.is_public">Private</c-badges.secondary>
                </c-tables.cell>
                <c-tables.cell>
                <span class="text-text-muted"
                      x-text="(release.artifacts_count || 0) + ' artifacts'"></span>
                </c-tables.cell>
                <c-tables.cell date>
                <span class="text-text-muted text-sm"
                      x-text="formatDate(release.created_at)"></span>
                </c-tables.cell>
                {% if can_edit or can_delete %}
                    <c-tables.actions-cell>
                    <c-actions-menu label="Release actions">
                    {% if can_edit %}
                        <c-dropdowns.item icon="fas fa-edit" @click="openEditModal(release)">Edit</c-dropdowns.item>
                    {% endif %}
                    {% if can_delete %}
                        <c-dropdowns.item-danger icon="fas fa-trash" @click="openDeleteModal(release)">
                        Delete
                        </c-dropdowns.item-danger>
                    {% endif %}
                    </c-actions-menu>
                    </c-tables.actions-cell>
                {% endif %}
                </c-tables.row>
            </template>
            <template x-if="sortedReleases.length === 0 && search">
                <tr>
                    <td colspan="{% if can_edit or can_delete %}6{% else %}5{% endif %}"
                        class="text-center py-8 text-text-muted">
                        <i class="fas fa-search text-2xl mb-2 opacity-50"></i>
                        <p class="m-0">
                            No results found for "<span x-text="search"></span>"
                        </p>
                    </td>
                </tr>
            </template>
        </tbody>
        </c-tables.table>
    </div>
    {# Footer with Info and Pagination #}
    <c-tables.footer x-show="!isLoading && releases.length > 0">
    <c-tables.info>
    Showing <strong x-text="sortedReleases.length > 0 ? 1 : 0"></strong> to <strong x-text="sortedReleases.length"></strong> of <strong x-text="filteredReleases.length"></strong> entries
    <template x-if="search">
        <span>(filtered from <strong x-text="releases.length"></strong> total)</span>
    </template>
    </c-tables.info>
    {# Paging is client state here, so the buttons bind it rather than link to it. #}
    <nav aria-label="Pagination"
         class="flex items-center gap-1"
         x-show="totalPages > 1">
        <c-navigation.page-button nav label="Previous page" ::disabled="currentPage === 1" @click="goToPage(currentPage - 1)">
        <i class="fas fa-chevron-left"></i>
        </c-navigation.page-button>
        <template x-for="page in visiblePages" :key="'page-' + page">
            <template x-if="page === '...'">
                <c-navigation.page-ellipsis />
            </template>
            <template x-if="page !== '...'">
                <c-navigation.page-button ::data-active="currentPage === page" @click="goToPage(page)" x-text="page" />
            </template>
        </template>
        <c-navigation.page-button nav label="Next page" ::disabled="currentPage === totalPages" @click="goToPage(currentPage + 1)">
        <i class="fas fa-chevron-right"></i>
        </c-navigation.page-button>
    </nav>
    </c-tables.footer>
    </c-tables.shell>
    {% if can_create or can_edit %}
        {% include 'core/components/release_form_modal.html.j2' %}
    {% endif %}
    {% if can_delete %}
        {% include 'components/delete_confirmation_modal.html.j2' with modal_id='showDeleteModal' title='Delete Release' message='Are you sure you want to delete release' item_name_expression="deleteTarget?.name" warning_message='This action cannot be undone. The release and all its artifact associations will be permanently removed.' confirm_text='Delete Release' confirm_callback='confirmDeleteRelease()' %}
    {% endif %}
</div>
