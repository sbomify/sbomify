{% comment %}
PublicCard Component - A wrapper around the library card for public-facing pages

Usage:
{% include 'core/components/public_card.html.j2' with {
    title: 'Card Title',
    subtitle: 'Optional subtitle',
    icon: 'fas fa-info-circle',
    variant: 'primary',
    size: 'md',
    hoverable: true,
    padded: true
} %}

Parameters:
- title: Card title (optional)
- subtitle: Subtitle text shown as info notice (optional)
- icon: Icon class (default: 'fas fa-info-circle')
- variant: 'default' | 'primary' | 'secondary' | 'success' | 'warning' | 'error' | 'info'
- size: 'sm' | 'md' | 'lg'
- hoverable: Enable hover effect (default: false)
- padded: Add body padding (default: true)
{% endcomment %}
<div class="mt-4 {% if hoverable %}hover:shadow-md transition-shadow{% endif %}">
    <c-cards.card class="shadow-sm">
    {% if title or header_content %}
        <c-slot name="header">
        <c-cards.header>
        <div class="flex items-center justify-between gap-4">
            {% if title %}<h4 class="text-lg font-semibold text-text m-0">{{ title }}</h4>{% endif %}
            {% if header_content %}<div class="flex items-center gap-2">{{ header_content }}</div>{% endif %}
        </div>
        </c-cards.header>
        </c-slot>
    {% endif %}
    {% if subtitle %}
        <c-feedback.alert icon="{{ icon|default:'fas fa-info-circle' }}" class="mb-4">{{ subtitle }}</c-feedback.alert>
    {% endif %}
    {{ content }}
    {% if footer_content %}<c-slot name="footer">{{ footer_content }}</c-slot>{% endif %}
    </c-cards.card>
</div>
