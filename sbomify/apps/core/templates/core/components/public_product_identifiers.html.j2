{% comment %}
Public Product Identifiers — a sidebar tc-panel.

One fact per identifier: type label, copyable value, and (for GTIN types)
the rendered barcode beneath. There's only one <svg data-barcode-id="...">
per identifier, so renderBarcode runs exactly once and the
document.querySelector lookup is unambiguous.
{% endcomment %}
{% load static %}
{% if product_identifiers %}
    <div class="tc-panel" x-data="productIdentifiersBarcodes()">
        <h2 class="tc-panel-title">Identifiers</h2>
        <div class="tc-facts">
            {% for identifier in product_identifiers %}
                <div>
                    <p class="tc-fact-label">{{ identifier.identifier_type_display }}</p>
                    <div class="tc-fact-value min-w-0">
                        {% include 'core/components/copyable_value.html.j2' with value=identifier.value title="Copy "|add:identifier.value %}
                    </div>
                    {% if identifier.identifier_type in barcode_types %}
                        <div class="barcode-wrapper mt-2"
                             x-init="renderBarcode('{{ identifier.id }}', '{{ identifier.value|escapejs }}', '{{ identifier.identifier_type }}')">
                            <svg data-barcode-id="{{ identifier.id }}"
                                 class="barcode-svg max-w-full"
                                 x-show="barcodeRendered['{{ identifier.id }}'] && !barcodeErrors['{{ identifier.id }}']"
                                 aria-hidden="true">
                            </svg>
                            <span x-show="!barcodeRendered['{{ identifier.id }}'] && !barcodeErrors['{{ identifier.id }}']"
                                  class="text-text-muted text-xs">
                                <c-feedback.spinner size="inline" />
                            </span>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}
