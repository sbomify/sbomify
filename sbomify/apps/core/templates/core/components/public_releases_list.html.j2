{# Public releases — a tc-panel table matching the advisory detail page. #}
{% load humanize %}
{% if public_releases %}
    <div class="tc-panel tc-panel-flush">
        <div class="tc-timeline-header px-6 pt-5">
            <h2 class="tc-panel-title tc-panel-title-flush !p-0">Releases</h2>
            {% if view_all_releases_url %}
                <a class="tc-section-link" href="{{ view_all_releases_url }}">
                    All releases <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            {% endif %}
        </div>
        <c-tables.table>
        <c-tables.head>
        <c-tables.header-cell>Release</c-tables.header-cell>
        <c-tables.header-cell>Status</c-tables.header-cell>
        <c-tables.header-cell date class="hidden md:table-cell">Released</c-tables.header-cell>
        </c-tables.head>
        <tbody>
            {% for release in public_releases %}
                <c-tables.row>
                <c-tables.cell>
                <a class="font-medium text-text hover:text-primary no-underline"
                   href="{{ release.public_url }}">{{ release.name }}</a>
                {% if release.description %}
                    <div class="text-xs opacity-75 mt-1" title="{{ release.description }}">{{ release.description|truncatechars:60 }}</div>
                {% endif %}
                <div class="md:hidden text-xs opacity-75 mt-1">
                    {{ release.released_at|default_if_none:release.created_at|naturaltime }}
                </div>
                </c-tables.cell>
                <c-tables.cell>
                {% if release.is_latest %}
                    <c-badges.success>Latest</c-badges.success>
                {% elif release.is_prerelease %}
                    <c-badges.warning>Pre-release</c-badges.warning>
                {% else %}
                    <span class="text-xs opacity-75">Stable</span>
                {% endif %}
                </c-tables.cell>
                <c-tables.cell date class="hidden md:table-cell">
                <span title="{{ release.released_at|default_if_none:release.created_at }}">
                    {{ release.released_at|default_if_none:release.created_at|naturaltime }}
                </span>
                </c-tables.cell>
                </c-tables.row>
            {% endfor %}
        </tbody>
        </c-tables.table>
    </div>
{% endif %}
