{# Public releases: a section heading over a flush table, as the rest of the trust center lists records. #}
{% load humanize %}
{% if public_releases %}
    <section class="flex flex-col gap-4">
        <c-branded.section-header title="Releases" subtitle="Published releases of this product, newest first.">
        {% if view_all_releases_url %}
            <c-slot name="action">
            <c-buttons.secondary size="sm" href="{{ view_all_releases_url }}">All releases</c-buttons.secondary>
            </c-slot>
        {% endif %}
        </c-branded.section-header>
        <c-branded.surface flush>
        <c-tables.table>
        <c-tables.head>
        <c-tables.header-cell nowrap>Release</c-tables.header-cell>
        <c-tables.header-cell>Status</c-tables.header-cell>
        <c-tables.header-cell date class="hidden md:table-cell">Released</c-tables.header-cell>
        </c-tables.head>
        <tbody>
            {% for release in public_releases %}
                <c-tables.row>
                <c-tables.cell nowrap>
                <a class="font-medium text-text hover:text-text no-underline"
                   data-button
                   href="{{ release.public_url }}">{{ release.name }}</a>
                {% if release.description %}
                    <div class="text-xs text-text-muted mt-1"
                         title="{{ release.description }}">{{ release.description|truncatechars:60 }}</div>
                {% endif %}
                <div class="md:hidden text-xs text-text-muted mt-1">
                    {{ release.released_at|default_if_none:release.created_at|naturaltime }}
                </div>
                </c-tables.cell>
                <c-tables.cell>
                {% if release.is_latest %}
                    <c-branded.badge tone="success">Latest</c-branded.badge>
                {% elif release.is_prerelease %}
                    <c-branded.badge tone="medium">Pre-release</c-branded.badge>
                {% else %}
                    <c-branded.badge>Stable</c-branded.badge>
                {% endif %}
                </c-tables.cell>
                <c-tables.cell date muted class="hidden md:table-cell">
                <span title="{{ release.released_at|default_if_none:release.created_at }}">
                    {{ release.released_at|default_if_none:release.created_at|naturaltime }}
                </span>
                </c-tables.cell>
                </c-tables.row>
            {% endfor %}
        </tbody>
        </c-tables.table>
        </c-branded.surface>
    </section>
{% endif %}
