{% comment %}
Quick Actions Component
Provides quick action buttons for common dashboard operations.

Parameters:
- has_crud_permissions: Boolean - whether user can create/edit items
- upload_sbom_url: URL to upload SBOM page
- vulnerability_scans_url: URL to vulnerability scans page
{% endcomment %}
{# djlint:off H037 #}
{# body_class is a cotton prop, not a second class attribute. #}
<c-cards.card class="h-full flex flex-col" body_class="flex-1">
{# djlint:on #}
<c-slot name="header">
<c-cards.header>
<h3 class="text-lg font-semibold text-text flex items-center gap-2 m-0">
    <i class="fas fa-bolt text-warning"></i>
    Quick Actions
</h3>
</c-cards.header>
</c-slot>
<div class="space-y-3">
    {# The URL is settled before the tag: an inline {% if %} inside an attribute is one djlint reformat away from arriving with newlines in it. #}
    {% url 'core:components_dashboard' as components_url %}
    <c-layout.action-tile href="{{ upload_sbom_url|default:components_url }}" accent="success" icon="fas fa-cloud-upload-alt" title="Upload SBOM" description="Add a new software bill of materials" />
    {% if has_crud_permissions %}
        <c-layout.action-tile href="{% url 'core:product_new' %}" icon="fas fa-cube" title="Create product" description="Add a new product to your workspace" />
        <c-layout.action-tile href="{% url 'core:component_new' %}" accent="info" icon="fas fa-puzzle-piece" title="Add Component" description="Create a new SBOM or document component" />
    {% endif %}
    {% url 'vulnerability_scanning:vulnerability_scans' current_team.key as scans_url %}
    <c-layout.action-tile href="{{ vulnerability_scans_url|default:scans_url }}" accent="orange" icon="fas fa-shield-alt" title="Run Vulnerability Scan" description="Scan your SBOMs for vulnerabilities" />
    <c-layout.action-tile href="{% url 'sboms:workspace_crypto' current_team.key %}" accent="violet" icon="fas fa-lock" title="Crypto Readiness" description="Quantum readiness across all components" />
    {# Generate Report - placeholder for future feature #}
    <c-layout.action-tile disabled icon="fas fa-file-alt" title="Generate Report" description="Coming soon">
    <c-slot name="trailing">
    <c-badges.secondary size="sm">Soon</c-badges.secondary>
    </c-slot>
    </c-layout.action-tile>
</div>
</c-cards.card>
