{% comment %}
Recent Activity Feed Component
Displays chronological list of recent workspace events.

Parameters:
- activities: List of activity dicts with keys:
  - type: 'upload', 'scan', 'create', 'update', 'delete'
  - title: Activity title
  - description: Short description
  - user: Username who performed action
  - timestamp: Datetime of activity
  - url: Optional link to related item
- view_all_url: Optional URL to view all activities
{% endcomment %}
{# djlint:off H037 #}
{# body_class is a cotton prop, not a second class attribute. #}
<c-cards.card class="h-full flex flex-col" body_class="flex-1 overflow-hidden">
{# djlint:on #}
<c-slot name="header">
<c-cards.header>
<h3 class="text-lg font-semibold text-text flex items-center gap-2 m-0">
    <i class="fas fa-history text-primary"></i>
    Recent Activity
</h3>
</c-cards.header>
</c-slot>
{% if view_all_url %}
    <c-slot name="footer">
    <a href="{{ view_all_url }}"
       class="text-sm text-primary hover:text-primary-dark flex items-center gap-1">
        View all activity
        <i class="fas fa-arrow-right text-xs"></i>
    </a>
    </c-slot>
{% endif %}
{% if activities %}
    <div class="space-y-4 max-h-[320px] overflow-y-auto pr-2">
        {% for activity in activities %}
            <div class="flex items-start gap-3 group">
                {# Activity icon chip, accent by type #}
                {% if activity.type == 'upload' %}
                    <c-chips.icon-chip size="sm" circle accent="success" class="mt-0.5">
                    <i class="fas fa-cloud-upload-alt text-sm" aria-hidden="true"></i>
                    </c-chips.icon-chip>
                {% elif activity.type == 'scan' %}
                    <c-chips.icon-chip size="sm" circle class="mt-0.5" style="--chip-accent: var(--color-accent-orange)">
                    <i class="fas fa-shield-alt text-sm" aria-hidden="true"></i>
                    </c-chips.icon-chip>
                {% elif activity.type == 'create' %}
                    <c-chips.icon-chip size="sm" circle accent="success" class="mt-0.5">
                    <i class="fas fa-plus-circle text-sm" aria-hidden="true"></i>
                    </c-chips.icon-chip>
                {% elif activity.type == 'update' %}
                    <c-chips.icon-chip size="sm" circle class="mt-0.5">
                    <i class="fas fa-edit text-sm" aria-hidden="true"></i>
                    </c-chips.icon-chip>
                {% elif activity.type == 'delete' %}
                    <c-chips.icon-chip size="sm" circle accent="danger" class="mt-0.5">
                    <i class="fas fa-trash-alt text-sm" aria-hidden="true"></i>
                    </c-chips.icon-chip>
                {% else %}
                    <c-chips.icon-chip size="sm" circle accent="neutral" class="mt-0.5">
                    <i class="fas fa-circle text-sm" aria-hidden="true"></i>
                    </c-chips.icon-chip>
                {% endif %}
                <div class="flex-1 min-w-0">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            {% if activity.url %}
                                <a href="{{ activity.url }}"
                                   class="text-sm font-medium text-text hover:text-primary truncate block">
                                    {{ activity.title }}
                                </a>
                            {% else %}
                                <span class="text-sm font-medium text-text truncate block">{{ activity.title }}</span>
                            {% endif %}
                            {% if activity.type == 'scan' and activity.scan_details %}
                                {# Enhanced scan display with severity badges #}
                                <div class="flex flex-wrap items-center gap-1 mt-1">
                                    <span class="text-xs text-text-muted">{{ activity.scan_details.total }} vulns:</span>
                                    {% if activity.scan_details.critical > 0 %}
                                        <c-badges.severity level="critical">{{ activity.scan_details.critical }}C</c-badges.severity>
                                    {% endif %}
                                    {% if activity.scan_details.high > 0 %}
                                        <c-badges.severity level="high">{{ activity.scan_details.high }}H</c-badges.severity>
                                    {% endif %}
                                    {% if activity.scan_details.medium > 0 %}
                                        <c-badges.severity level="medium">{{ activity.scan_details.medium }}M</c-badges.severity>
                                    {% endif %}
                                    {% if activity.scan_details.low > 0 %}
                                        <c-badges.severity level="low">{{ activity.scan_details.low }}L</c-badges.severity>
                                    {% endif %}
                                    {% if activity.scan_details.total == 0 %}<c-badges.success size="sm">Clean</c-badges.success>{% endif %}
                                </div>
                                <p class="text-xs text-text-muted mt-0.5 truncate">{{ activity.scan_details.component_name }}</p>
                            {% elif activity.description %}
                                <p class="text-xs text-text-muted mt-0.5 truncate">{{ activity.description }}</p>
                            {% endif %}
                        </div>
                    </div>
                    <div class="flex items-center gap-2 mt-1 text-xs text-text-muted">
                        {% if activity.user %}
                            <span class="flex items-center gap-1">
                                <i class="fas fa-user"></i>
                                {{ activity.user }}
                            </span>
                            <span>·</span>
                        {% endif %}
                        <span class="flex items-center gap-1">
                            <i class="fas fa-clock"></i>
                            {% if activity.timestamp %}
                                {{ activity.timestamp|timesince }} ago
                            {% else %}
                                Just now
                            {% endif %}
                        </span>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="flex flex-col items-center justify-center py-8 text-center">
        <div class="w-12 h-12 rounded-full bg-border/50 flex items-center justify-center mb-3">
            <i class="fas fa-inbox text-text-muted text-xl"></i>
        </div>
        <p class="text-text-muted text-sm">No recent activity</p>
        <p class="text-text-muted text-xs mt-1">Activity will appear here as you use the workspace</p>
    </div>
{% endif %}
</c-cards.card>
