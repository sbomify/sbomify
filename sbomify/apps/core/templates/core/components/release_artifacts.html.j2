{% load static %}
<div x-data="releaseArtifacts({ releaseId: '{{ release_id }}', productId: '{{ product_id }}', initialArtifacts: [], totalCount: 0, canEdit: {{ can_edit|yesno:'true,false' }}, isLatest: {{ is_latest|default:False|yesno:'true,false' }} })"
     x-init="loadArtifacts()">
    {# The shell draws the frame itself, so the table needs no card around it. #}
    <c-tables.shell>
    <c-tables.toolbar>
    <h4 class="text-lg font-semibold text-text flex items-center gap-2 m-0">
        <i class="fas fa-puzzle-piece text-primary"></i>
        Artifacts
    </h4>
    <c-slot name="right">
    {% if can_edit and not is_latest %}
        <c-buttons.primary @click="openAddModal()">
        <i class="fas fa-plus mr-2"></i>Add Artifact
        </c-buttons.primary>
    {% elif is_latest and can_edit %}
        <div class="px-3 py-2 bg-info/10 text-info rounded-lg text-sm flex items-center gap-2">
            <i class="fas fa-info-circle"></i>
            <span>The "Latest" release is automatically managed and cannot be modified manually.</span>
        </div>
    {% endif %}
    </c-slot>
    </c-tables.toolbar>
    {# Loading State #}
    <c-feedback.loading message="Loading artifacts..." x-show="isLoading" />
    {# Empty State #}
    <div x-show="!isLoading && artifacts.length === 0">
        <c-feedback.empty-state icon="fas fa-puzzle-piece" icon_variant="neutral" icon_size="sm" title="No artifacts yet" message="Add artifacts to this release to get started">
        {% if can_edit and not is_latest %}
            <c-buttons.primary @click="openAddModal()">
            <i class="fas fa-plus mr-2"></i>Add Artifact
            </c-buttons.primary>
        {% elif is_latest and can_edit %}
            <p class="text-text-muted text-sm m-0">
                <i class="fas fa-info-circle mr-1"></i>Latest release is automatically managed
            </p>
        {% endif %}
        </c-feedback.empty-state>
    </div>
    {# Artifacts Table Container #}
    <div x-show="!isLoading && artifacts.length > 0">
        <c-tables.shell nested>
        {# Search and Filter Controls #}
        <c-tables.toolbar>
        <c-tables.search id="artifact-search" label="Search artifacts" placeholder="Search artifacts by name, component, or format..." x-model="search" @input.debounce="handleSearch()" />
        <c-tables.select id="artifact-type-filter" label="Filter by type" x-model="typeFilter" @change="handleTypeFilter()">
        <option value="">All Types</option>
        <option value="sbom">SBOMs Only</option>
        <option value="vex">VEX Only</option>
        <option value="document">Documents Only</option>
        </c-tables.select>
        <c-tables.select id="artifact-component-filter" label="Filter by component" x-model="componentFilter" @change="handleComponentFilter()">
        <option value="">All Components</option>
        <template x-for="comp in uniqueComponents" :key="comp">
            <option :value="comp" x-text="comp"></option>
        </template>
        </c-tables.select>
        <c-slot name="right">
        <c-tables.page-size id="artifact-page-size" x-model="pageSize" @change="currentPage = 1">
        <option value="10">10</option>
        <option value="25">25</option>
        <option value="50">50</option>
        <option value="100">100</option>
        </c-tables.page-size>
        </c-slot>
        </c-tables.toolbar>
        {# Artifacts Table #}
        <c-tables.table>
        <c-tables.head>
        <c-tables.header-cell sort="type" class="w-10">Type</c-tables.header-cell>
        <c-tables.header-cell sort="name" nowrap>Name</c-tables.header-cell>
        <c-tables.header-cell sort="component">Component</c-tables.header-cell>
        <c-tables.header-cell sort="format">Format</c-tables.header-cell>
        <c-tables.header-cell sort="version">Version</c-tables.header-cell>
        <c-tables.header-cell sort="created_at" date class="w-28">Created</c-tables.header-cell>
        {% if can_edit and not is_latest %}<c-tables.actions-cell as="th" label="Actions" />{% endif %}
        </c-tables.head>
        <tbody>
            <template x-for="artifact in paginatedArtifacts" :key="artifact.id">
                <c-tables.row>
                <c-tables.cell nowrap>
                <div class="w-8 h-8 rounded-lg flex items-center justify-center"
                     :class="getArtifactIconClass(artifact)">
                    <i :class="getTypeIcon(getArtifactType(artifact))" class="text-sm"></i>
                </div>
                </c-tables.cell>
                <c-tables.cell nowrap>
                <div class="flex items-center gap-2">
                    <a :href="getArtifactUrl(artifact)"
                       class="text-primary font-medium hover:underline"
                       x-text="getArtifactName(artifact)"></a>
                    <span class="px-2 py-0.5 text-xs font-medium rounded-full"
                          :class="getArtifactBadgeClass(artifact)"
                          x-text="getArtifactType(artifact).toUpperCase()"></span>
                </div>
                </c-tables.cell>
                <c-tables.cell>
                <a :href="getComponentUrl(artifact)"
                   class="text-text hover:text-primary transition-colors"
                   x-text="getArtifactComponent(artifact)"></a>
                </c-tables.cell>
                <c-tables.cell>
                {% comment %}
                    The format recipe is picked in the browser by the release
                    artifacts Alpine component, so this one keeps its binding.
                {% endcomment %}
                <span x-show="isArtifactTypeSbom(artifact)"
                      :class="getArtifactFormatClass(artifact)"
                      x-text="getArtifactFormat(artifact)"></span>
                <c-badges.format class="text-text-muted bg-border/20 border" style="border-color: color-mix(in srgb, var(--color-border) 60%, transparent)" x-show="!isArtifactTypeSbom(artifact)" x-text="getArtifactFormat(artifact)" />
                </c-tables.cell>
                <c-tables.cell>
                <span x-show="getArtifactVersion(artifact)"
                      class="text-text"
                      :title="getArtifactVersion(artifact)"
                      x-text="truncateText(getArtifactVersion(artifact) || '', 20)"></span>
                <span x-show="!getArtifactVersion(artifact)" class="text-text-muted">—</span>
                </c-tables.cell>
                <c-tables.cell date>
                <span class="text-text-muted text-sm" x-text="getArtifactDate(artifact)"></span>
                </c-tables.cell>
                {% if can_edit and not is_latest %}
                    <c-tables.actions-cell>
                    <c-actions-menu label="Artifact actions">
                    <c-dropdowns.item-danger icon="fas fa-trash" @click="openDeleteModal(artifact)">
                    Remove from release
                    </c-dropdowns.item-danger>
                    </c-actions-menu>
                    </c-tables.actions-cell>
                {% endif %}
                </c-tables.row>
            </template>
        </tbody>
        </c-tables.table>
        {# Pagination #}
        <c-tables.footer>
        <c-tables.info>
        Showing <strong x-text="filteredArtifacts.length"></strong> of <strong x-text="artifacts.length"></strong> artifacts
        </c-tables.info>
        <div x-show="totalPages > 1">
            <c-tables.pager />
        </div>
        </c-tables.footer>
        </c-tables.shell>
    </div>
    </c-tables.shell>
    {% if can_edit and not is_latest %}
        {# Add Artifact Modal #}
        <c-modal show="showAddModal" size="xl" title="Add Artifact to Release" icon="fas fa-plus" @keydown.escape="if(showAddModal) closeAddModal()">
        <div class="space-y-5">
            {# Search and Filter Controls #}
            <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
                <div class="md:col-span-6">
                    <label for="modal-artifact-search" class="sr-only">Search available artifacts</label>
                    <c-forms.search-input id="modal-artifact-search" placeholder="Search by name, component, or format..." x-model="availableSearch" />
                </div>
                <div class="md:col-span-3">
                    <label for="modal-artifact-type-filter" class="sr-only">Filter by type</label>
                    <c-forms.select id="modal-artifact-type-filter" x-model="availableTypeFilter">
                    <option value="">All Types</option>
                    <option value="sbom">SBOMs Only</option>
                    <option value="vex">VEX Only</option>
                    <option value="document">Documents Only</option>
                    </c-forms.select>
                </div>
                <div class="md:col-span-3">
                    <label for="modal-artifact-component-filter" class="sr-only">Filter by component</label>
                    <c-forms.select id="modal-artifact-component-filter" x-model="availableComponentFilter">
                    <option value="">All Components</option>
                    <template x-for="comp in availableUniqueComponents" :key="comp">
                        <option :value="comp" x-text="comp"></option>
                    </template>
                    </c-forms.select>
                </div>
            </div>
            {# Loading State #}
            <c-feedback.loading message="Loading artifacts..." x-show="isLoadingAvailable" />
            {# No Results #}
            <div x-show="!isLoadingAvailable && availableArtifacts.length === 0">
                <c-feedback.empty-state icon="fas fa-inbox" icon_variant="neutral" icon_size="sm" title="No artifacts available" message="All artifacts have already been added to this release" />
            </div>
            {# No Filtered Results #}
            <div x-show="!isLoadingAvailable && availableArtifacts.length > 0 && filteredAvailableArtifacts.length === 0">
                <c-feedback.empty-state icon="fas fa-search" icon_variant="neutral" icon_size="sm" title="No matches found" message="No artifacts match your search criteria">
                <c-buttons.ghost @click="clearAvailableFilters()">
                <i class="fas fa-times mr-2"></i>Clear filters
                </c-buttons.ghost>
                </c-feedback.empty-state>
            </div>
            {# Artifacts Table #}
            <div x-show="!isLoadingAvailable && filteredAvailableArtifacts.length > 0">
                <c-tables.shell class="flex-1 min-h-0">
                {# Results Summary Bar #}
                <c-tables.toolbar>
                <span class="text-text-muted text-sm flex items-center gap-2">
                    <i class="fas fa-list" aria-hidden="true"></i>
                    <span class="font-semibold text-text"
                          x-text="filteredAvailableArtifacts.length"></span>
                    of <span x-text="availableArtifacts.length"></span> artifacts
                </span>
                <c-badges.primary class="gap-1.5" x-show="selectedArtifacts.size > 0">
                <i class="fas fa-check-circle" aria-hidden="true"></i>
                <span class="font-semibold" x-text="selectedArtifacts.size"></span>
                <span>selected</span>
                </c-badges.primary>
                <c-slot name="right">
                <button type="button"
                        class="text-sm font-medium text-primary hover:text-primary/80 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                        :disabled="filteredAvailableArtifacts.length === 0"
                        @click="allFilteredSelected ? clearSelection() : selectAllFiltered()"
                        x-text="allFilteredSelected ? 'Deselect All' : 'Select All Visible'"></button>
                </c-slot>
                </c-tables.toolbar>
                <c-tables.table class="max-h-[50vh] overflow-y-auto">
                <c-tables.head>
                <c-tables.header-cell class="w-12">
                <c-forms.checkbox aria-label="Select all artifacts" ::checked="allFilteredSelected" @change="toggleAllFiltered($event)" />
                </c-tables.header-cell>
                <c-tables.header-cell sort="type" class="w-16">Type</c-tables.header-cell>
                <c-tables.header-cell sort="name" nowrap>Name</c-tables.header-cell>
                <c-tables.header-cell sort="component">Component</c-tables.header-cell>
                <c-tables.header-cell sort="format">Format</c-tables.header-cell>
                <c-tables.header-cell sort="version">Version</c-tables.header-cell>
                <c-tables.header-cell sort="created" date class="w-28">Created</c-tables.header-cell>
                </c-tables.head>
                <tbody>
                    <template x-for="artifact in filteredAvailableArtifacts" :key="artifact.id">
                        <c-tables.row class="cursor-pointer focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset" ::class="isSelected(artifact.id) ? 'bg-primary/5 hover:bg-primary/10 border-l-2 border-l-primary' : 'border-l-2 border-l-transparent'" tabindex="0" @click="toggleArtifactSelection(artifact.id)" @keydown.enter.prevent="toggleArtifactSelection(artifact.id)" @keydown.space.prevent="toggleArtifactSelection(artifact.id)">
                        <c-tables.cell nowrap>
                        <c-forms.checkbox ::checked="isSelected(artifact.id)" @click.stop="toggleArtifactSelection(artifact.id)" ::aria-label="'Select ' + artifact.name" />
                        </c-tables.cell>
                        <c-tables.cell>
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center"
                             :class="getAvailableArtifactIconClass(artifact)">
                            <i :class="getAvailableTypeIcon(artifact)" class="text-sm"></i>
                        </div>
                        </c-tables.cell>
                        <c-tables.cell nowrap>
                        <a :href="getAvailableArtifactUrl(artifact)"
                           class="font-semibold text-primary hover:underline"
                           @click.stop
                           x-text="artifact.name"></a>
                        </c-tables.cell>
                        <c-tables.cell>
                        <span class="text-text-muted" x-text="artifact.component?.name || '-'"></span>
                        </c-tables.cell>
                        <c-tables.cell>
                        {% comment %}
                            As above: the recipe is chosen in the browser, so the
                            binding stays.
                        {% endcomment %}
                        <span x-show="isArtifactSbom(artifact)"
                              :class="getAvailableArtifactFormatClass(artifact)"
                              x-text="getAvailableArtifactFormat(artifact)"></span>
                        <c-badges.format class="text-text-muted bg-border/20 border" style="border-color: color-mix(in srgb, var(--color-border) 60%, transparent)" x-show="!isArtifactSbom(artifact)" x-text="getAvailableArtifactFormat(artifact)" />
                        </c-tables.cell>
                        <c-tables.cell>
                        <span x-show="artifact.version"
                              class="text-text font-mono text-sm"
                              :title="artifact.version"
                              x-text="truncateText(artifact.version || '', 20)"></span>
                        <span x-show="!artifact.version" class="text-text-muted">—</span>
                        </c-tables.cell>
                        <c-tables.cell date>
                        <span class="text-text-muted text-sm"
                              x-text="formatDate(artifact.created_at)"></span>
                        </c-tables.cell>
                        </c-tables.row>
                    </template>
                </tbody>
                </c-tables.table>
                </c-tables.shell>
            </div>
        </div>
        <c-slot name="footer">
        <div class="text-sm text-text-muted flex items-center gap-2 mr-auto">
            <i class="fas fa-info-circle" aria-hidden="true"></i>
            <span x-show="selectedArtifacts.size > 0">
                <span class="font-bold text-text" x-text="selectedArtifacts.size"></span> artifact<span x-show="selectedArtifacts.size !== 1">s</span> ready to add
            </span>
            <span x-show="selectedArtifacts.size === 0">Select artifacts to add to this release</span>
        </div>
        <c-buttons.ghost @click="closeAddModal()">Cancel</c-buttons.ghost>
        <c-buttons.primary @click="addSelectedArtifacts()" ::disabled="selectedArtifacts.size === 0 || isSubmitting">
        <span x-show="isSubmitting">{% include "core/components/brand/loader.html.j2" with class="tw-loader-inline" %}</span>
        <i x-show="!isSubmitting" class="fas fa-plus"></i>
        <span>Add to Release</span>
        </c-buttons.primary>
        </c-slot>
        </c-modal>
        {% include 'components/delete_confirmation_modal.html.j2' with modal_id='showDeleteModal' title='Remove Artifact' message='Are you sure you want to remove' item_name_expression="deleteTarget ? getArtifactName(deleteTarget) : ''" warning_message='This will only remove the artifact from this release. The original SBOM or document will not be deleted.' confirm_text='Remove' confirm_callback='confirmRemoveArtifact()' %}
    {% endif %}
</div>
