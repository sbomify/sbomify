{% comment %}One release editor for product detail and release history pages. State belongs to releaseEditor; every control comes from the shared library.{% endcomment %}
<c-modal id="release-editor" title="Edit release" show="showModal" close="closeModal()">
<form id="release-editor-form"
      @submit.prevent="submitRelease()"
      class="flex flex-col gap-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <c-forms.field label="Release name" for="release-name" required>
        <c-forms.input id="release-name" placeholder="e.g. January release" required maxlength="255" x-model="form.name" />
        </c-forms.field>
        <c-forms.field label="Version" for="release-version">
        <c-forms.input id="release-version" placeholder="e.g. v1.0.0" maxlength="255" x-model="form.version" />
        </c-forms.field>
    </div>
    <c-forms.field label="Description" for="release-description">
    <c-forms.textarea id="release-description" rows="3" maxlength="1000" x-model="form.description" />
    </c-forms.field>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
            {% include 'components/date_picker.html.j2' with value_binding='form.created_at' label='Created at' include_time='true' placeholder='Choose date and time' compact='true' %}
        </div>
        <div>
            {% include 'components/date_picker.html.j2' with value_binding='form.released_at' label='Released at' include_time='true' placeholder='Choose date and time' compact='true' %}
        </div>
    </div>
    <c-forms.checkbox x-model="form.is_prerelease">Mark as prerelease</c-forms.checkbox>
</form>
<c-slot name="footer">
<c-buttons.secondary @click="closeModal()">Cancel</c-buttons.secondary>
<c-buttons.primary type="submit" form="release-editor-form" ::disabled="saving"><span x-text="saving ? 'Saving…' : 'Save release'"></span></c-buttons.primary>
</c-slot>
</c-modal>
