<!-- Site-wide notifications/alerts that require urgent user action -->
{% with team=request.session.current_team %}
    {% if team and team.billing_plan_limits and team.billing_plan_limits.subscription_status == 'past_due' and is_owner %}
        {% if team.is_in_grace_period %}
            <div class="tw-alert tw-alert-warning mb-6" role="alert">
                <i class="fas fa-exclamation-triangle tw-alert-icon" aria-hidden="true"></i>
                <div class="tw-alert-content">
                    <p class="tw-alert-title">Payment Failed</p>
                    <p class="text-sm m-0">
                        Your grace period is active. Update your payment method within {{ grace_period_days }} days to avoid service interruption.
                    </p>
                </div>
                <a href="{% url 'billing:create_portal_session' team.key %}"
                   class="tw-btn-warning tw-btn-sm no-underline self-center">Fix Payment</a>
            </div>
        {% else %}
            <div class="tw-alert tw-alert-danger mb-6" role="alert">
                <i class="fas fa-ban tw-alert-icon" aria-hidden="true"></i>
                <div class="tw-alert-content">
                    <p class="tw-alert-title">Account Suspended</p>
                    <p class="text-sm m-0">Your account is restricted due to payment failure. Creation of new resources is blocked.</p>
                </div>
                <a href="{% url 'billing:create_portal_session' team.key %}"
                   class="tw-btn-danger tw-btn-sm no-underline self-center">Reactivate Subscription</a>
            </div>
        {% endif %}
    {% endif %}
{% endwith %}
<div x-data="siteNotifications()"></div>
