<!-- Site-wide notifications/alerts that require urgent user action -->
{% with team=request.session.current_team %}
    {% if team and team.billing_plan_limits and team.billing_plan_limits.subscription_status == 'past_due' and can_administer %}
        {% comment %}
            The action sits in the alert's message, which is the only region the
            alert component gives a caller: the notice and the way out of it read
            as one sentence.
        {% endcomment %}
        {% if team.is_in_grace_period %}
            <c-feedback.alert variant="warning" title="Payment Failed" class="mb-6">
            Your grace period is active. Update your payment method within {{ grace_period_days }} days to avoid service interruption.
            <c-buttons.warning size="sm" href="{% url 'billing:create_portal_session' team.key %}" class="ml-2 align-middle no-underline">Fix Payment</c-buttons.warning>
            </c-feedback.alert>
        {% else %}
            <c-feedback.alert variant="danger" title="Account Suspended" icon="fas fa-ban" class="mb-6">
            Your account is restricted due to payment failure. Creation of new resources is blocked.
            <c-buttons.danger size="sm" href="{% url 'billing:create_portal_session' team.key %}" class="ml-2 align-middle no-underline">Reactivate Subscription</c-buttons.danger>
            </c-feedback.alert>
        {% endif %}
    {% endif %}
{% endwith %}
<div x-data="siteNotifications()"></div>
