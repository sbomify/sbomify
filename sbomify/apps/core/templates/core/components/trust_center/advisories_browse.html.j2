{% load humanize %}
{% load public_url_tags %}
{% comment %}
The advisory index: filter sidebar beside the results table.

Rendered whole on a normal request and swapped on its own for an HTMX one, so
ticking a facet updates the list and the counts beside it without a page flash.
The facet counts live in this region too, which is why the swap covers the
sidebar rather than only the table.

Everything is a plain GET form underneath: with JavaScript off the noscript
submit button applies the same filters, and the URL is the same either way.

The narrow-screen disclosure is driven by #tcFiltersOpen, the checkbox in the
page shell just before this region. The selectors that read it are arbitrary
variants naming that id, so they keep working across a swap and need no script.
{% endcomment %}
{% public_url 'core:workspace_advisories_public' workspace_key=workspace.key as advisories_url %}
<div id="advisoryBrowse"
     class="grid items-start gap-8 min-[900px]:grid-cols-[15rem_minmax(0,1fr)] max-[900px]:gap-5">
    <form method="get"
          id="advisoryFilters"
          class="flex flex-col gap-4 min-[900px]:sticky min-[900px]:top-[4.5rem]"
          role="search"
          hx-get="{{ advisories_url }}"
          hx-include="#advisorySort"
          hx-target="#advisoryBrowse"
          hx-swap="outerHTML"
          hx-push-url="true"
          hx-trigger="change, input changed delay:350ms from:#advisorySearch">
        {% comment %}
        Search first, on both breakpoints. On a phone, typing a CVE is the fast
        path and should never sit behind a tap; on desktop it reads as the top
        of the panel either way.

        hx-preserve keeps the live input node across the swap, so a search that
        fires mid-word does not steal the cursor back to the start.
        {% endcomment %}
        <div id="advisorySearchWrap" hx-preserve="true">
            <c-forms.search-input id="advisorySearch" name="search" label="Search advisories" placeholder="Search advisories..." value="{{ query.search }}" />
        </div>
        {% comment %}
        Narrow screens get a disclosure instead of a wall of checkboxes: five
        severities plus a product per line plus a date range pushed the first
        result most of a screen down.

        It sits directly under the search box, and the source order matches the
        rendered order at both breakpoints, so tabbing through the panel follows
        what is on screen rather than a CSS reordering of it. Hidden on desktop,
        where the panel is always open and there is nothing to toggle.

        Keyboard focus lands on the hidden checkbox, not on this label, so the
        focus ring is drawn here from the checkbox's state.

        The count is the only sign, while collapsed, that the list is narrowed.
        {% endcomment %}
        <label class="min-[900px]:hidden flex items-center gap-2 min-h-11 px-3.5 py-2 rounded-[var(--radius-lg)] border border-solid border-border bg-surface text-sm font-semibold text-text cursor-pointer [#tcFiltersOpen:focus-visible~#advisoryBrowse_&]:ring-2 [#tcFiltersOpen:focus-visible~#advisoryBrowse_&]:ring-primary/40"
               for="tcFiltersOpen">
            <i class="fas fa-sliders text-xs text-text-muted" aria-hidden="true"></i>
            <span class="flex-1">Filters</span>
            {% if query.active_count %}<c-branded.badge brand>{{ query.active_count|intcomma }}</c-branded.badge>{% endif %}
            <i class="fas fa-chevron-down text-xs text-text-muted transition-transform duration-200 [#tcFiltersOpen:checked~#advisoryBrowse_&]:rotate-180"
               aria-hidden="true"></i>
        </label>
        <div id="advisoryFilterBody"
             class="max-[900px]:hidden max-[900px]:[#tcFiltersOpen:checked~#advisoryBrowse_&]:block">
            <c-branded.surface class="flex flex-col gap-5">
            <div class="flex items-baseline justify-between gap-2">
                <h2 class="text-sm font-semibold text-text my-0! leading-5">Filters</h2>
                {% if query.is_filtered %}
                    {% comment %}
                A quiet link rather than a button: the filters apply the moment
                they are ticked, so the only action left is undo, and giving
                undo button weight would imply the filters need confirming.
                    {% endcomment %}
                    <a class="text-xs font-medium text-text-muted hover:text-text no-underline hover:underline underline-offset-4"
                       data-button
                       href="{{ advisories_url }}"
                       hx-get="{{ advisories_url }}"
                       hx-target="#advisoryBrowse"
                       hx-swap="outerHTML"
                       hx-push-url="true">Clear all</a>
                {% endif %}
            </div>
            <fieldset class="flex flex-col gap-0.5 border-0 my-0 mx-0 px-0 py-0 min-w-0 max-[900px]:grid max-[900px]:grid-cols-2">
                <legend class="text-xs font-semibold text-text mb-[0.5rem] max-[900px]:col-span-2">Severity</legend>
                {% for facet in facets.severity %}
                    {% if not facet.count and not facet.checked %}
                        <c-forms.facet name="severity" value="{{ facet.value }}" :checked="facet.checked" empty tone="{{ facet.value }}" count="{{ facet.count|intcomma }}">{{ facet.label }}</c-forms.facet>
                    {% else %}
                        <c-forms.facet name="severity" value="{{ facet.value }}" :checked="facet.checked" tone="{{ facet.value }}" count="{{ facet.count|intcomma }}">{{ facet.label }}</c-forms.facet>
                    {% endif %}
                {% endfor %}
            </fieldset>
            {% if facets.product %}
                <fieldset class="flex flex-col gap-0.5 border-0 my-0 mx-0 px-0 py-0 min-w-0">
                    <legend class="text-xs font-semibold text-text mb-[0.5rem]">Product</legend>
                    {% for facet in facets.product %}
                        {% if not facet.count and not facet.checked %}
                            <c-forms.facet name="product" value="{{ facet.value }}" :checked="facet.checked" empty count="{{ facet.count|intcomma }}">{{ facet.label }}</c-forms.facet>
                        {% else %}
                            <c-forms.facet name="product" value="{{ facet.value }}" :checked="facet.checked" count="{{ facet.count|intcomma }}">{{ facet.label }}</c-forms.facet>
                        {% endif %}
                    {% endfor %}
                </fieldset>
            {% endif %}
            <div class="flex flex-col gap-3">
                <p class="text-xs font-semibold text-text my-0">Published</p>
                {% comment %}
                A date range is a plain control, not something the
                workspace's colour has any say over, so it uses the app's
                own picker rather than a branded one. See the note in
                AGENTS.md on which library a trust centre control belongs to.

                The picker is reached with {% include %} because it is the
                one component still written as a .html.j2 partial rather
                than a cotton tag; a c-date-picker tag would resolve to
                components/date_picker.html and does not exist.

                value_binding names an Alpine property the picker reads and
                writes, so the wrapper below owns that scope. The picker
                carries no name of its own, so the hidden inputs are what
                the form actually sends, and their names are the contract
                the view reads.

                Setting an input's value from Alpine does not emit a change
                event, and the form filters on hx-trigger="change", so a
                watcher dispatches one. $watch rather than x-effect, which
                also runs on init and would fire a request on every load.
                {% endcomment %}
                <div class="flex flex-col gap-3"
                     x-data="{ from: '{{ query.published_from|date:'Y-m-d' }}', to: '{{ query.published_to|date:'Y-m-d' }}' }"
                     x-init="$watch('from', () => $refs.fromField.dispatchEvent(new Event('change', { bubbles: true }))); $watch('to', () => $refs.toField.dispatchEvent(new Event('change', { bubbles: true })))">
                    {% include 'components/date_picker.html.j2' with value_binding='from' label='From' placeholder='Any date' compact='true' %}
                    <input type="hidden" name="from" x-ref="fromField" :value="from">
                    {% include 'components/date_picker.html.j2' with value_binding='to' label='To' placeholder='Any date' compact='true' %}
                    <input type="hidden" name="to" x-ref="toField" :value="to">
                </div>
            </div>
            <noscript>
                <c-buttons.secondary size="sm" type="submit">Apply filters</c-buttons.secondary>
            </noscript>
            </c-branded.surface>
        </div>
    </form>
    {# HTMX in flight: dim the results so a slow filter reads as working, not stuck. #}
    <div class="min-w-0 flex flex-col gap-4 transition-opacity duration-150 [.htmx-request_&]:opacity-55 [.htmx-request_&]:pointer-events-none">
        <div class="flex items-center justify-end gap-3 [flex-wrap:wrap]">
            <span class="mr-auto text-sm text-text-secondary tabular-nums">
                {% if total %}
                    {{ start_index|intcomma }}–{{ end_index|intcomma }} of {{ total|intcomma }}
                {% else %}
                    No advisories
                {% endif %}
            </span>
            {% comment %}
            Boosted, so a page link is a swap of this region like a facet is,
            and still a plain link with scripting off.
            {% endcomment %}
            <nav class="flex items-center gap-1"
                 aria-label="Advisories pagination"
                 hx-boost="true"
                 hx-target="#advisoryBrowse"
                 hx-swap="outerHTML">
                {% if has_prev %}
                    <c-navigation.page-link nav label="Previous page" href="?{{ querystrings.without_page }}page={{ prev_page }}"><i class="fas fa-chevron-left" aria-hidden="true"></i></c-navigation.page-link>
                {% else %}
                    <c-navigation.page-link nav label="Previous page" href="#" disabled><i class="fas fa-chevron-left" aria-hidden="true"></i></c-navigation.page-link>
                {% endif %}
                {% if has_next %}
                    <c-navigation.page-link nav label="Next page" href="?{{ querystrings.without_page }}page={{ next_page }}"><i class="fas fa-chevron-right" aria-hidden="true"></i></c-navigation.page-link>
                {% else %}
                    <c-navigation.page-link nav label="Next page" href="#" disabled><i class="fas fa-chevron-right" aria-hidden="true"></i></c-navigation.page-link>
                {% endif %}
            </nav>
            {% comment %}
            The select is only form-associated (it sits in the results column,
            not inside the form), so its change event never bubbles to the form
            and cannot ride the form's hx-trigger. It carries its own HTMX
            attributes and pulls the active filters in with hx-include. The
            form= attribute is what makes the no-JS path work, where it is
            submitted by the noscript button.
            {% endcomment %}
            <c-forms.select size="md" id="advisorySort" name="sort" label="Sort advisories" form="advisoryFilters" hx-get="{{ advisories_url }}" hx-include="#advisoryFilters" hx-target="#advisoryBrowse" hx-swap="outerHTML" hx-push-url="true" hx-trigger="change">
            {% for option in sort_options %}
                <option value="{{ option.value }}"
                        {% if option.selected %}selected{% endif %}>{{ option.label }}</option>
            {% endfor %}
            </c-forms.select>
        </div>
        {% if advisories %}
            <c-branded.surface flush>
            {% comment %}
            One <tbody> per advisory: the CVSS, summary and date cells rowspan the
            product rows beneath them, which is what makes a multi-product
            advisory read as one entry rather than several unrelated ones. Rows
            are plain <tr>s rather than c-tables.row, whose last-row rule would
            drop the line between one advisory and the next; the table drops
            only the line along the panel's own bottom edge, and a hovered
            advisory tints as one.

            Auto layout, not fixed: each version range is nowrap, and a fixed
            grid would let a long range run under its neighbour instead of
            widening the column. Ranges stack one per line and a long list folds
            behind a count, so only a single very long range can make the
            viewport scroll sideways.
            {% endcomment %}
            <c-tables.table stack="false" variant_class="min-w-[52rem] [&_td]:align-top [&_tbody:last-child_tr:last-child_td]:border-b-0 [&_tbody:last-child_td[rowspan]]:border-b-0 [&_tbody:hover_td]:bg-[color-mix(in_oklab,var(--color-primary)_4%,transparent)]" aria-label="Security advisories">
            <c-tables.head>
            <c-tables.header-cell compact scope="col" class="w-[6%]">CVSS</c-tables.header-cell>
            <c-tables.header-cell compact scope="col" class="w-[26%] min-w-[18rem]">Summary</c-tables.header-cell>
            <c-tables.header-cell compact scope="col">Versions</c-tables.header-cell>
            <c-tables.header-cell compact scope="col">Affected</c-tables.header-cell>
            <c-tables.header-cell compact scope="col">Unaffected</c-tables.header-cell>
            <c-tables.header-cell compact date scope="col">Published</c-tables.header-cell>
            <c-tables.header-cell compact date scope="col">Updated</c-tables.header-cell>
            </c-tables.head>
            {% for advisory in advisories %}
                {% public_url 'core:advisory_details_public' workspace_key=workspace.key advisory_id=advisory.pk as advisory_url %}
                <tbody>
                    {% for row in advisory.affected_rows %}
                        <tr>
                            {% if forloop.first %}
                                <c-tables.cell compact rowspan="{{ advisory.affected_rows|length }}">
                                <c-branded.badge tone="{{ advisory.severity|default:'none' }}" class="tabular-nums">{{ advisory.cvss_score|default_if_none:"—" }}</c-branded.badge>
                                </c-tables.cell>
                                <c-tables.cell compact rowspan="{{ advisory.affected_rows|length }}">
                                {% include "core/components/trust_center/advisory_summary_cell.html.j2" %}
                                </c-tables.cell>
                            {% endif %}
                            <c-tables.cell compact class="whitespace-nowrap">{{ row.product }}</c-tables.cell>
                            <c-tables.cell compact muted>
                            <c-tables.value-list mono :values="row.affected_versions" />
                            </c-tables.cell>
                            <c-tables.cell compact muted>
                            <c-tables.value-list mono :values="row.unaffected_versions" />
                            </c-tables.cell>
                            {% if forloop.first %}
                                <c-tables.cell compact date muted class="text-xs tabular-nums" rowspan="{{ advisory.affected_rows|length }}">{{ advisory.published_display|default:"—" }}</c-tables.cell>
                                <c-tables.cell compact date muted class="text-xs tabular-nums" rowspan="{{ advisory.affected_rows|length }}">{{ advisory.updated_display|default:"—" }}</c-tables.cell>
                            {% endif %}
                        </tr>
                    {% empty %}
                        {% comment %}
                        A workspace notice names no products, so it has no
                        version rows. It still belongs in the index, as one
                        row with the version columns empty.
                        {% endcomment %}
                        <tr>
                            <c-tables.cell compact>
                            <c-branded.badge tone="{{ advisory.severity|default:'none' }}" class="tabular-nums">{{ advisory.cvss_score|default_if_none:"—" }}</c-branded.badge>
                            </c-tables.cell>
                            <c-tables.cell compact>
                            {% include "core/components/trust_center/advisory_summary_cell.html.j2" %}
                            </c-tables.cell>
                            <c-tables.cell compact muted>—</c-tables.cell>
                            <c-tables.cell compact muted>—</c-tables.cell>
                            <c-tables.cell compact muted>—</c-tables.cell>
                            <c-tables.cell compact date muted class="text-xs tabular-nums">{{ advisory.published_display|default:"—" }}</c-tables.cell>
                            <c-tables.cell compact date muted class="text-xs tabular-nums">{{ advisory.updated_display|default:"—" }}</c-tables.cell>
                        </tr>
                    {% endfor %}
                </tbody>
            {% endfor %}
            </c-tables.table>
            </c-branded.surface>
        {% else %}
            <c-branded.surface flush>
            {% if query.is_filtered %}
                <c-feedback.empty-state icon="fas fa-shield-halved" icon_variant="neutral" title="No advisories match these filters" message="Try widening the severity or date range, or clear the filters." />
            {% else %}
                <c-feedback.empty-state icon="fas fa-shield-halved" icon_variant="neutral" title="No published advisories" message="New disclosures appear here as they are released." />
            {% endif %}
            </c-branded.surface>
        {% endif %}
        {% include "core/components/trust_center/restricted_notice.html.j2" %}
    </div>
</div>
