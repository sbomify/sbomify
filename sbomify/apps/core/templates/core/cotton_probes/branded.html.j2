{% comment %}
Probe template for the branded component set. Every component appears once,
with the props the render tests read back. It is not a gallery: the gallery
lives in core/design_system.html.j2 and is for looking at.
{% endcomment %}
<c-branded.theme brand="#25293F" data-probe="theme-dark">
<c-branded.surface data-probe="surface">
<c-branded.buttons.primary>Primary action</c-branded.buttons.primary>
<c-branded.buttons.secondary>Secondary action</c-branded.buttons.secondary>
<c-branded.buttons.primary href="/somewhere">Link action</c-branded.buttons.primary>
<c-branded.badge tone="critical" data-probe="badge-critical">Critical</c-branded.badge>
<c-branded.badge brand data-probe="badge-brand">Verified</c-branded.badge>
<c-branded.badge data-probe="badge-neutral">Draft</c-branded.badge>
<c-branded.nav>
<c-branded.nav-item href="/a" icon="fas fa-house" current data-probe="nav-current">Overview</c-branded.nav-item>
<c-branded.nav-item href="/b" icon="fas fa-shield-halved" data-probe="nav-other">Advisories</c-branded.nav-item>
</c-branded.nav>
<c-branded.notice title="Sign in to view this document" data-probe="notice">
This artifact is shared with named recipients.
<c-slot name="action">
<c-branded.buttons.secondary size="sm" href="/login">Sign in</c-branded.buttons.secondary>
</c-slot>
</c-branded.notice>
</c-branded.surface>
</c-branded.theme>
<c-branded.theme brand="#FDE68A" data-probe="theme-light">
<c-branded.buttons.primary>Pale brand</c-branded.buttons.primary>
</c-branded.theme>
<c-branded.theme data-probe="theme-none">
<c-branded.buttons.primary>Unbranded</c-branded.buttons.primary>
</c-branded.theme>
<c-branded.theme brand="#000; }</style><script>alert(1)</script>" data-probe="theme-evil">
<c-branded.buttons.primary>Hostile brand</c-branded.buttons.primary>
</c-branded.theme>
