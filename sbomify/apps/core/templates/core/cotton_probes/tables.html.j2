{% comment %}
Render probe for the cotton tables set. Unit tests render this file and assert
on the output; it is not routed anywhere.
{% endcomment %}
<c-tables.shell class="mb-8" data-probe="shell">
<c-tables.toolbar>
<c-forms.search-input size="sm" id="probe-search" label="Search components" placeholder="Search components" x-model="search" />
<c-slot name="right">
<c-tables.page-size id="probe-per-page" x-model.number="perPage">
<option value="10">Ten</option>
</c-tables.page-size>
</c-slot>
</c-tables.toolbar>
<c-tables.table fixed data-probe="table">
<c-tables.head>
<c-tables.header-cell sort="name">Name column</c-tables.header-cell>
<c-tables.header-cell nowrap>Nowrap column</c-tables.header-cell>
<c-tables.header-cell date class="hidden md:table-cell">Created column</c-tables.header-cell>
<c-tables.header-cell sort="is_public" end>Visibility column</c-tables.header-cell>
<c-tables.actions-cell as="th" label="Row actions" />
</c-tables.head>
<tbody>
    <c-tables.row tabindex="0" @click="open()">
    <c-tables.cell class="font-medium">Plain body cell</c-tables.cell>
    <c-tables.cell nowrap>Nowrap body cell</c-tables.cell>
    <c-tables.cell date>10 Aug 2026</c-tables.cell>
    <c-tables.cell end hx-get="/probe">Right cell</c-tables.cell>
    <c-tables.cell muted>Muted cell</c-tables.cell>
    <c-tables.actions-cell @click.stop><c-buttons.icon label="Component actions"><i class="fas fa-ellipsis-vertical" aria-hidden="true"></i></c-buttons.icon></c-tables.actions-cell>
    </c-tables.row>
</tbody>
</c-tables.table>
<c-tables.footer>
<c-tables.info>Showing <strong>1</strong> to <strong>2</strong> of <strong>2</strong> entries</c-tables.info>
<c-tables.pager />
</c-tables.footer>
</c-tables.shell>
<c-tables.shell data-probe="pinned-shell">
<c-tables.table sized data-probe="table-pinned">
<c-tables.head>
<c-tables.header-cell sort="name">Pinned name column</c-tables.header-cell>
<c-tables.actions-cell as="th" pinned label="Pinned row actions" />
</c-tables.head>
<tbody>
    <c-tables.row class="group">
    <c-tables.cell>Pinned body cell</c-tables.cell>
    <c-tables.actions-cell pinned><c-buttons.icon label="Pinned component actions"><i class="fas fa-ellipsis-vertical" aria-hidden="true"></i></c-buttons.icon></c-tables.actions-cell>
    </c-tables.row>
</tbody>
</c-tables.table>
</c-tables.shell>
<c-tables.shell nested data-probe="nested-shell">
<c-tables.toolbar>
<span>Toolbar without a right group</span>
</c-tables.toolbar>
<c-tables.table>
<c-tables.head class="align-bottom">
<c-tables.header-cell>Unsorted head</c-tables.header-cell>
</c-tables.head>
<tbody>
    <c-tables.row>
    <c-tables.cell>Unfixed body cell</c-tables.cell>
    </c-tables.row>
</tbody>
</c-tables.table>
<c-tables.table sized data-probe="table-sized">
<c-tables.head>
<c-tables.header-cell class="w-1/4">Sized head</c-tables.header-cell>
</c-tables.head>
<tbody>
    <c-tables.row>
    <c-tables.cell>Sized body cell</c-tables.cell>
    </c-tables.row>
</tbody>
</c-tables.table>
</c-tables.shell>
<c-tables.table sized data-probe="server-sorting">
<c-tables.head>
<c-tables.header-cell href="/probe?direction=desc" sort="name" order="ascending">Server ascending</c-tables.header-cell>
<c-tables.header-cell href="/probe?direction=asc" sort="name" order="descending">Server descending</c-tables.header-cell>
<c-tables.header-cell href="/probe?sort=name" sort="name">Server unsorted</c-tables.header-cell>
</c-tables.head>
</c-tables.table>
<c-tables.table stack="false" aria-label="Side-by-side probe">
<c-tables.head>
<c-tables.header-cell>Matrix column</c-tables.header-cell>
</c-tables.head>
</c-tables.table>
<c-tables.shell x-data="tableSelection" data-probe="bulk-shell">
<c-tables.bulk-bar noun="component" plural="components" data-probe="bulk-bar">
<c-buttons.danger size="sm" @click="confirmDelete()">Delete</c-buttons.danger>
</c-tables.bulk-bar>
<c-tables.table sized>
<c-tables.head>
<c-tables.select-cell as="th" label_all="Select all components" />
<c-tables.header-cell>Bulk name column</c-tables.header-cell>
</c-tables.head>
<tbody>
    <c-tables.row>
    <c-tables.select-cell value="cmp-1" label="acme-gateway-core" />
    <c-tables.cell>acme-gateway-core</c-tables.cell>
    </c-tables.row>
    <c-tables.row>
    <c-tables.select-cell value="cmp-2" label="acme-audit-log" disabled />
    <c-tables.cell>acme-audit-log</c-tables.cell>
    </c-tables.row>
    <template x-for="item in items" :key="item.id">
        <c-tables.row>
        <c-tables.select-cell x_value="item.id" x_label="item.name" x_disabled="item.locked" />
        <c-tables.cell x-text="item.name"></c-tables.cell>
        </c-tables.row>
    </template>
</tbody>
</c-tables.table>
<c-tables.bulk-delete action="/probe/bulk-delete" noun="component" plural="components" data-probe="bulk-delete" />
<c-tables.bulk-delete id="probe-bulk-delete-htmx" action="/probe/bulk-delete" noun="component" plural="components" htmx hx_target="#probe-target" />
<c-tables.bulk-delete action="/probe/bulk-delete" noun="component" plural="components" htmx data-probe="bulk-delete-toast" />
</c-tables.shell>
