{% extends 'core/dashboard_base.htmx.j2' %}
{% load humanize %}
{% block title %}
    {% if show_repository_setup %}
        Repository setup
    {% else %}
        Overview
    {% endif %}
    · sbomify
{% endblock %}
{% block dashboard_content %}
    {% if show_repository_setup %}
        <c-layout.page-header title="{{ onboarding.title|default:'Set up your first repository' }}" subtitle="Choose a coding agent or the terminal wizard. Find your lockfiles, create components and add a workflow." />
        <c-overview.onboarding :can_manage="can_manage" :can_administer="can_administer" :first_component="onboarding.first_component" :setup_config="onboarding.setup_config" />
    {% else %}
        {% comment %}
        The overview repaints itself when the socket says something it counts has
        changed: a scan settled, VEX was re-applied or decided, an artifact or an
        inventory item came or went. The view rebuilds the snapshot for that
        request rather than serving the cached copy. The wait is longer than on
        other pages because an upload settles several scans in a burst, and
        the overview should repaint once after it, not once per scan.
        {% endcomment %}
        <c-layout.frame id="overview-content" hx-get="{{ request.get_full_path }}" hx-trigger="refresh-overview from:body" hx-select="#overview-content" hx-swap="morph" hx-disinherit="hx-select hx-swap" @ws:message.window="if (['assessment_complete', 'vex_reapplied', 'vex_submission_updated', 'sbom_uploaded', 'sbom_deleted', 'product_created', 'product_updated', 'product_deleted', 'component_created', 'component_updated', 'component_deleted', 'resync'].includes($event.detail.type)) { clearTimeout($el._wsDebounce); $el._wsDebounce = setTimeout(() => document.body.dispatchEvent(new CustomEvent('refresh-overview')), 2000); }">
        <c-overview.header subtitle="{{ page_subtitle }}" />
        <div role="group"
             class="grid grid-cols-2 xl:grid-cols-4 gap-3"
             aria-label="Key metrics">
            {# djlint:off #}
            <c-layout.stat-card :value="dashboard.metrics.open" :unmeasured="dashboard.metrics.unmeasured_open" unmeasured_label="Not scanned yet" label="Open vulnerability occurrences" icon="fas fa-bullseye" />
            <c-layout.stat-card :value="dashboard.metrics.past_sla" :unmeasured="dashboard.metrics.unmeasured_past_sla" unmeasured_label="Not scanned yet" label="Past patch SLA" icon="fas fa-clock" accent="danger" />
            <c-layout.stat-card :value="dashboard.metrics.known_exploited" :unmeasured="dashboard.metrics.unmeasured_known_exploited" unmeasured_label="Not scanned yet" label="Known exploited occurrences" icon="fas fa-triangle-exclamation" accent="danger" />
            {% if vex_review %}
                <c-layout.stat-card :value="vex_review.pending" label="VEX submissions awaiting review" icon="fas fa-clipboard-check" accent="warning" href="{{ vex_review.url }}" />
            {% endif %}
            {# djlint:on #}
        </div>
        {% if can_manage %}
            <c-overview.quick-actions>
            <c-layout.action-tile flush trailing_icon="fa-plus" accent="info" href="{% url 'core:product_new' %}" icon="fas fa-cube" title="Add product" description="Organize components and artifacts" />
            <c-layout.action-tile flush trailing_icon="fa-plus" accent="info" icon="fas fa-tag" title="Add release" description="Bring a version's artifacts together" href="{% url 'core:release_new' %}" />
            <c-layout.action-tile flush trailing_icon="fa-plus" accent="info" href="{% url 'core:component_new' %}" icon="fas fa-puzzle-piece" title="Add component" description="Store SBOMs and documents" />
            <c-layout.action-tile flush trailing_icon="fa-plus" accent="info" href="{% url 'core:security_advisory_new' %}" icon="fas fa-shield-halved" title="Add advisory" description="Create a draft security advisory" />
            </c-overview.quick-actions>
        {% endif %}
        {% if dashboard.unassessed or dashboard.metrics.sla_unknown %}
            <c-feedback.alert variant="info">
            {% if dashboard.unassessed %}
                {{ dashboard.unassessed|intcomma }} component{{ dashboard.unassessed|pluralize }} still need{{ dashboard.unassessed|pluralize:'s,' }} a completed security assessment.
            {% endif %}
            {% if dashboard.metrics.sla_unknown %}
                Patch SLA is unavailable for {{ dashboard.metrics.sla_unknown|intcomma }} occurrence{{ dashboard.metrics.sla_unknown|pluralize }} without scan history.
            {% endif %}
            </c-feedback.alert>
        {% endif %}
        <c-overview.priority :dashboard="dashboard" workspace_key="{{ current_team.key }}" />
        <c-overview.products :products="dashboard.products" :product_count="dashboard.product_count" :shares_components="dashboard.shares_components" :omits_components="dashboard.omits_components" />
        </c-layout.frame>
        {# Outside the frame, so a refresh never closes a triage dialog that is open. #}
        {% if can_triage_vulnerabilities %}<div id="priority-triage-host" class="contents"></div>{% endif %}
    {% endif %}
{% endblock %}
