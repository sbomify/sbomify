{% extends "core/dashboard_base.htmx.j2" %}
{% load static %}
{% load django_vite %}
{% load advisory_tags %}
{% block title %}sbomify Dashboard{% endblock %}
{% block dashboard_content %}
    <div class="space-y-6">
        {# Greeting header — the security picture, not a page label #}
        <div class="mb-2">
            <h1 class="text-2xl font-bold text-text">{{ greeting }}</h1>
            {% if dashboard.is_first_visit %}
                <p class="text-text-muted text-sm m-0 mt-1">Let's get your first component reporting.</p>
            {% else %}
                <p class="text-text-muted text-sm m-0 mt-1">Here's the security picture across {{ current_team.name }}.</p>
            {% endif %}
        </div>
        {% if dashboard.is_first_visit %}
            {# First visit — a flowing onboarding hero: soft surface, illustration bleeds in. #}
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-primary/5 dark:from-primary/20 via-transparent to-transparent">
                {# Illustration — SVG used as a mask so it takes the primary (light blue) colour. #}
                <div aria-hidden="true"
                     class="hidden md:block absolute right-[6%] top-1/2 -translate-y-1/2 w-[38%] max-w-[380px] opacity-40 bg-primary pointer-events-none select-none"
                     style="aspect-ratio: 1210 / 680;
                            -webkit-mask: url('{% static 'img/onboarding.svg' %}') center / contain no-repeat;
                            mask: url('{% static 'img/onboarding.svg' %}') center / contain no-repeat"></div>
                <div class="relative p-6 sm:p-8 md:pr-[44%]">
                    {% comment %}
                    One action, not a checklist. The wizard command sets a
                    repository up end to end, so walking someone through
                    creating a product and a component by hand duplicated work
                    the command does — and stranded anyone who ran it first.
                    {% endcomment %}
                    <h4 class="text-xl font-semibold text-text m-0">Get started</h4>
                    <p class="text-sm text-text-muted m-0 mt-1 max-w-md">
                        Run one command in your repository and push — your first SBOM
                        lands here and this page starts reporting.
                    </p>
                    <div class="mt-5 flex items-center gap-4 flex-wrap">
                        <button type="button"
                                @click="$dispatch('open-cicd')"
                                class="tw-btn-primary flex-shrink-0">
                            <i class="fas fa-rocket mr-2" aria-hidden="true"></i>Get started
                        </button>
                        {% if onboarding.first_component %}
                            <span class="text-sm text-text-muted">
                                Already have an SBOM file?
                                <button type="button"
                                        @click="$dispatch('open-upload')"
                                        class="text-primary hover:underline font-medium">Upload it</button>
                            </span>
                        {% endif %}
                    </div>
                </div>
            </div>
            {# Reuse the component-page modals — the command dialog works without a component. #}
            {% if onboarding.first_component %}
                {% with component=onboarding.first_component %}
                    {% include "sboms/components/ci_cd_info.html.j2" %}
                    {% include "sboms/components/sbom_upload.html.j2" with component_id=component.id %}
                {% endwith %}
            {% else %}
                {% include "sboms/components/ci_cd_info.html.j2" %}
            {% endif %}
        {% else %}
            {# Needs attention — the worst non-suppressed findings across the workspace #}
            {% if dashboard.needs_attention %}
                <div class="tw-card">
                    <div class="px-6 py-4 border-b border-border">
                        <h4 class="text-lg font-semibold text-text m-0 flex items-center gap-2">
                            Needs attention
                            <span class="px-2 py-0.5 text-xs font-bold rounded-full bg-danger/10 text-danger">{{ dashboard.needs_attention|length }}</span>
                        </h4>
                    </div>
                    <div class="divide-y divide-border">
                        {% for finding in dashboard.needs_attention %}
                            <div class="px-6 py-3 flex flex-wrap items-center gap-x-3 gap-y-1">
                                {% if finding.severity == 'critical' %}
                                    <span class="px-2 py-1 text-xs font-semibold uppercase tracking-wide rounded bg-danger/10 text-danger border border-danger/30">Critical</span>
                                {% elif finding.severity == 'high' %}
                                    <span class="px-2 py-1 text-xs font-semibold uppercase tracking-wide rounded bg-severity-high-soft text-severity-high border border-severity-high-soft">High</span>
                                {% elif finding.severity == 'medium' %}
                                    <span class="px-2 py-1 text-xs font-semibold uppercase tracking-wide rounded bg-info/10 text-info border border-info/30">Medium</span>
                                {% else %}
                                    <span class="px-2 py-1 text-xs font-semibold uppercase tracking-wide rounded bg-border/40 text-text-muted border border-border">{{ finding.severity|capfirst }}</span>
                                {% endif %}
                                {% with finding_url=finding.id|advisory_url %}
                                    {% if finding_url %}
                                        <a href="{{ finding_url }}"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="font-mono text-sm text-primary hover:underline">{{ finding.id }}</a>
                                    {% else %}
                                        <span class="font-mono text-sm text-text-muted">{{ finding.id }}</span>
                                    {% endif %}
                                {% endwith %}
                                <span class="text-sm text-text font-medium">{{ finding.package }}</span>
                                {% if finding.version %}<span class="text-sm text-text-muted">· {{ finding.version }}</span>{% endif %}
                                <span class="text-sm text-text-muted">
                                    in <span class="font-medium text-text">{{ finding.component_name }}</span>
                                    {% if finding.scanned_at %}· scanned {{ finding.scanned_at|timesince }} ago{% endif %}
                                </span>
                                <a href="{% url 'core:component_details' finding.component_id %}"
                                   class="ml-auto text-sm text-primary hover:underline no-underline inline-flex items-center gap-1">
                                    Review<i class="fas fa-arrow-right text-xs"></i>
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        {% endif %}
        {# Vulnerability Trends #}
        <div class="tw-card">
            <div hx-get="{% url 'vulnerability_scanning:vulnerability_trends' %}?show_product_filter=true"
                 hx-trigger="load"
                 hx-swap="innerHTML">
                <div class="flex flex-col items-center justify-center py-12">
                    {% include "core/components/brand/loader.html.j2" with class="tw-loader-lg text-primary" %}
                    <p class="mt-3 text-text-muted">Loading vulnerability trends...</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% block scripts %}
    {{ block.super }}
    {# The CI/CD + upload modals use Alpine components registered in the sboms bundle. #}
    {% if dashboard.is_first_visit and onboarding.first_component %}
        {% vite_asset 'sbomify/apps/sboms/js/main.ts' %}
    {% endif %}
{% endblock %}
