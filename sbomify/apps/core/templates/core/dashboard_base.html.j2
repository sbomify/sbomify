{% extends './base.html.j2' %}
{% block title %}sbomify{% endblock %}
{% block main %}
    {% if request.session.current_team.key %}
        <div x-data
             x-init="$store.ws.connect('{{ request.session.current_team.key }}')"
             class="hidden"></div>
    {% endif %}
    <c-chrome.shell>
    <c-slot name="sidebar_content">
    {% block sidebar_content %}{% endblock %}
    </c-slot>
    {% block dashboard_messages %}
        {% include 'core/components/messages.html.j2' %}
    {% endblock %}
    {% include 'core/components/site_notifications.html.j2' %}
    {% block dashboard_content %}{% endblock %}
    {% block content %}{% endblock %}
    </c-chrome.shell>
{% endblock %}
