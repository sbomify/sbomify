{% extends "core/public_base.htmx.j2" %}
{% load django_vite %}
{% load static %}
{% load public_url_tags %}
{% load humanize %}
{% block title %}{{ product.name }} - SBOM & Security{% endblock %}
{% block meta_description %}
    {{ product.name }} - Software Bill of Materials (SBOM) for this product. View components and download SBOMs.
{% endblock %}
{% block og_title %}{{ product.name }} - Software Bill of Materials{% endblock %}
{% block og_description %}
    {{ product.name }} - View components and download Software Bill of Materials (SBOM) for this product.
{% endblock %}
{% block page_header %}
    {% comment %}
    The same masthead the advisory pages use, so a product reads as a page of
    this trust center rather than a card dropped onto it: the way back, what
    kind of page this is, the name, the description, then the facts a reader
    checks before scrolling.
    {% endcomment %}
    <header class="tc-masthead">
        <div class="tc-masthead-inner tc-masthead-detail">
            {% if workspace_public_url %}
                <a class="tc-backlink" href="{{ workspace_public_url }}">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    Trust Center
                </a>
            {% endif %}
            <div class="tc-detail-eyebrow">
                <p class="tc-eyebrow">
                    <span class="tc-eyebrow-dot" aria-hidden="true"></span>
                    Product
                </p>
            </div>
            <h1 class="tc-detail-title">{{ product.name }}</h1>
            {% if product.description %}<p class="tc-detail-summary">{{ product.description }}</p>{% endif %}
            <div class="tc-detail-meta">
                <span class="tc-detail-meta-item">
                    <i class="fas fa-puzzle-piece" aria-hidden="true"></i>
                    {{ public_components|length }} component{{ public_components|length|pluralize }}
                </span>
                {% for assessment in passing_assessments %}
                    {% include 'plugins/components/public_assessment_badge.html.j2' with assessment=assessment %}
                {% endfor %}
            </div>
        </div>
    </header>
{% endblock %}
{% block content %}
    <div class="tc-detail-grid">
        {# ---- Main column --------------------------------------------------- #}
        <div class="min-w-0">
            {% if has_downloadable_content or has_cbom %}
                <div class="tc-panel">
                    <h2 class="tc-panel-title">Download latest release</h2>
                    <p class="tc-prose mb-4">Combined artifacts from the latest release of this product.</p>
                    {% comment %}
                    secondary, not a primary or accent-tinted button: on a public page
                    the accent is the workspace's own colour, and a neutral button is
                    the only one readable on every accent a workspace might pick.
                    {% endcomment %}
                    <div class="flex gap-3 flex-wrap">
                        {% if has_downloadable_content %}
                            <c-buttons.secondary href="{% url 'core:sbom_download_product' product.id %}" title="Download combined SBOM as CycloneDX" class="no-underline">
                            <img src="{% static 'img/cyclonedx-logo.svg' %}"
                                 alt="CycloneDX"
                                 class="h-5 w-auto dark:brightness-0 dark:invert"
                                 height="20"
                                 width="20">
                            <i class="fas fa-download text-xs" aria-hidden="true"></i>
                            </c-buttons.secondary>
                            <c-buttons.secondary href="{% url 'core:sbom_download_product' product.id %}?format=spdx" title="Download combined SBOM as SPDX" class="no-underline">
                            <img src="{% static 'img/spdx-logo.svg' %}"
                                 alt="SPDX"
                                 class="h-5 w-auto dark:brightness-0 dark:invert"
                                 height="20"
                                 width="20">
                            <i class="fas fa-download text-xs" aria-hidden="true"></i>
                            </c-buttons.secondary>
                        {% endif %}
                        {% if has_cbom %}
                            <c-buttons.secondary href="{% url 'api-1:download_product_cbom' product.id %}" title="Download CBOM (Cryptography BOM, CycloneDX)" class="no-underline">
                            <i class="fas fa-key" aria-hidden="true"></i>
                            <span>CBOM</span>
                            <i class="fas fa-download text-xs" aria-hidden="true"></i>
                            </c-buttons.secondary>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
            {% include 'core/components/public_releases_list.html.j2' %}
            {% if public_components %}
                <div class="tc-panel">
                    <h2 class="tc-panel-title">Components</h2>
                    <ul class="divide-y divide-border/40 list-none p-0 m-0">
                        {% for component in public_components %}
                            <li class="py-3 flex items-start justify-between gap-4 {% if forloop.first %}pt-0{% endif %} {% if forloop.last %}pb-0{% endif %}">
                                <div class="min-w-0">
                                    <a class="text-text font-medium hover:text-primary no-underline"
                                       href="{{ component.public_url }}">{{ component.name }}</a>
                                    <div class="text-text-muted text-xs mt-1">{{ component.component_type_display }}</div>
                                </div>
                                {% if component.passing_assessments %}
                                    <div class="flex flex-wrap gap-1 shrink-0 justify-end">
                                        {% for assessment in component.passing_assessments %}
                                            {% include 'plugins/components/public_assessment_icon.html.j2' with assessment=assessment %}
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
        {# ---- Sidebar ------------------------------------------------------- #}
        <aside>
            <div class="tc-panel">
                <h2 class="tc-panel-title">Details</h2>
                <div class="tc-facts">
                    <div>
                        <p class="tc-fact-label">Components</p>
                        <p class="tc-fact-value">{{ public_components|length }}</p>
                    </div>
                    {% if product.release_date %}
                        <div>
                            <p class="tc-fact-label">Release date</p>
                            <p class="tc-fact-value">{{ product.release_date }}</p>
                        </div>
                    {% endif %}
                    {% if product.end_of_support %}
                        <div>
                            <p class="tc-fact-label">End of support</p>
                            <p class="tc-fact-value">{{ product.end_of_support }}</p>
                        </div>
                    {% endif %}
                    {% if product.end_of_life %}
                        <div>
                            <p class="tc-fact-label">End of life</p>
                            <p class="tc-fact-value">{{ product.end_of_life }}</p>
                        </div>
                    {% endif %}
                    {% if product_tei %}
                        <div>
                            <p class="tc-fact-label">TEI</p>
                            <div class="tc-fact-value">
                                {% include 'core/components/copyable_value.html.j2' with value=product_tei title="TEI: "|add:product_tei|add:" (click to copy)" %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
            {% include 'core/components/public_product_identifiers.html.j2' %}
            {% include 'core/components/public_product_links.html.j2' %}
            {% include 'compliance/components/public_vdp_link.html.j2' %}
            {% include 'compliance/components/public_doc_link.html.j2' %}
        </aside>
    </div>
{% endblock %}
{% block scripts %}
    {% vite_asset 'sbomify/apps/core/js/main.ts' %}
    {% vite_asset 'sbomify/apps/sboms/js/main.ts' %}
{% endblock %}
