{% extends "core/public_base.htmx.j2" %}
{% load django_vite %}
{% load static %}
{% load public_url_tags %}
{% load humanize %}
{% block title %}{{ product.name }} - SBOM & Security{% endblock %}
{% block meta_description %}
    {{ product.name }} - Software Bill of Materials (SBOM) for this product. View components and download SBOMs.
{% endblock %}
{% block og_title %}{{ product.name }} - Software Bill of Materials{% endblock %}
{% block og_description %}
    {{ product.name }} - View components and download Software Bill of Materials (SBOM) for this product.
{% endblock %}
{% block page_header %}
    {% comment %}
    The same masthead every trust center page uses, so a product reads as a
    page of this trust center rather than a card dropped onto it: the way back,
    what kind of page this is, the name, the description, then the facts a
    reader checks before scrolling.
    {% endcomment %}
    <c-branded.masthead>
    {% if workspace_public_url %}
        <c-branded.back-link href="{{ workspace_public_url }}">Trust Center</c-branded.back-link>
    {% endif %}
    <c-branded.page-header title="{{ product.name }}" lede="{{ product.description }}">
    <c-slot name="eyebrow">
    <c-branded.badge brand>Product</c-branded.badge>
    </c-slot>
    <div class="flex items-center gap-x-5 gap-y-2 [flex-wrap:wrap]">
        <c-branded.meta-item icon="fas fa-puzzle-piece">
        {{ public_components|length|intcomma }} component{{ public_components|length|pluralize }}
        </c-branded.meta-item>
        {% for assessment in passing_assessments %}
            {% include 'plugins/components/public_assessment_badge.html.j2' with assessment=assessment %}
        {% endfor %}
    </div>
    </c-branded.page-header>
    </c-branded.masthead>
{% endblock %}
{% block content %}
    <div class="grid items-start gap-8 min-[900px]:grid-cols-[minmax(0,1fr)_20rem]">
        {# ---- Main column --------------------------------------------------- #}
        <div class="min-w-0 flex flex-col gap-10">
            {% if has_downloadable_content or has_cbom %}
                <section class="flex flex-col gap-4">
                    <c-branded.section-header title="Download latest release" subtitle="Combined artifacts from the latest release of this product." />
                    <c-branded.surface>
                    {% comment %}
                    secondary, not a primary or accent-tinted button: on a public page
                    the accent is the workspace's own colour, and a neutral button is
                    the only one readable on every accent a workspace might pick.
                    {% endcomment %}
                    <div class="flex gap-3 [flex-wrap:wrap]">
                        {% if has_downloadable_content %}
                            <c-buttons.secondary href="{% url 'core:sbom_download_product' product.id %}" title="Download combined SBOM as CycloneDX" class="no-underline">
                            <img src="{% static 'img/cyclonedx-logo.svg' %}"
                                 alt="CycloneDX"
                                 class="h-5 w-auto dark:brightness-0 dark:invert"
                                 height="20"
                                 width="20">
                            <i class="fas fa-download text-xs" aria-hidden="true"></i>
                            </c-buttons.secondary>
                            <c-buttons.secondary href="{% url 'core:sbom_download_product' product.id %}?format=spdx" title="Download combined SBOM as SPDX" class="no-underline">
                            <img src="{% static 'img/spdx-logo.svg' %}"
                                 alt="SPDX"
                                 class="h-5 w-auto dark:brightness-0 dark:invert"
                                 height="20"
                                 width="20">
                            <i class="fas fa-download text-xs" aria-hidden="true"></i>
                            </c-buttons.secondary>
                        {% endif %}
                        {% if has_cbom %}
                            <c-buttons.secondary href="{% url 'api-1:download_product_cbom' product.id %}" title="Download CBOM (Cryptography BOM, CycloneDX)" class="no-underline">
                            <i class="fas fa-key" aria-hidden="true"></i>
                            <span>CBOM</span>
                            <i class="fas fa-download text-xs" aria-hidden="true"></i>
                            </c-buttons.secondary>
                        {% endif %}
                    </div>
                    </c-branded.surface>
                </section>
            {% endif %}
            {% include 'core/components/public_releases_list.html.j2' %}
            {% if public_components %}
                <section class="flex flex-col gap-4">
                    <c-branded.section-header title="Components" subtitle="The parts this product is built from, each with its own published artifacts." />
                    <c-branded.surface flush>
                    {% for component in public_components %}
                        <c-branded.list-row href="{{ component.public_url }}">
                        <c-slot name="heading">{{ component.name }}</c-slot>
                        <c-slot name="meta">{{ component.component_type_display }}</c-slot>
                        {% if component.passing_assessments %}
                            <c-slot name="side">
                            <span class="inline-flex items-center gap-1">
                                {% for assessment in component.passing_assessments %}
                                    {% include 'plugins/components/public_assessment_icon.html.j2' with assessment=assessment %}
                                {% endfor %}
                            </span>
                            </c-slot>
                        {% endif %}
                        </c-branded.list-row>
                    {% endfor %}
                    </c-branded.surface>
                </section>
            {% endif %}
        </div>
        {# ---- Sidebar ------------------------------------------------------- #}
        <aside class="flex flex-col gap-4">
            <c-branded.panel title="Details">
            <c-branded.facts>
            <c-branded.fact label="Components">{{ public_components|length|intcomma }}</c-branded.fact>
            {% if product.release_date %}
                <c-branded.fact label="Release date">{{ product.release_date }}</c-branded.fact>
            {% endif %}
            {% if product.end_of_support %}
                <c-branded.fact label="End of support">{{ product.end_of_support }}</c-branded.fact>
            {% endif %}
            {% if product.end_of_life %}<c-branded.fact label="End of life">{{ product.end_of_life }}</c-branded.fact>{% endif %}
            {% if product_tei %}
                <c-branded.fact label="TEI" stacked>
                {% include 'core/components/copyable_value.html.j2' with value=product_tei title="TEI: "|add:product_tei|add:" (click to copy)" %}
                </c-branded.fact>
            {% endif %}
            </c-branded.facts>
            </c-branded.panel>
            {% include 'core/components/public_product_identifiers.html.j2' %}
            {% include 'core/components/public_product_links.html.j2' %}
            {% include 'compliance/components/public_vdp_link.html.j2' %}
            {% include 'compliance/components/public_doc_link.html.j2' %}
        </aside>
    </div>
{% endblock %}
{% block scripts %}
    {% vite_asset 'sbomify/apps/core/js/main.ts' %}
{% endblock %}
