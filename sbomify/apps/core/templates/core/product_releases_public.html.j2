{% extends "core/public_base.htmx.j2" %}
{% load django_vite %}
{% load static %}
{% load public_url_tags %}
{% load humanize %}
{% block title %}{{ product.name }} - Releases{% endblock %}
{% block meta_description %}
    All software releases for {{ product.name }}. Browse release history, download SBOMs, and view release artifacts.
{% endblock %}
{% block og_title %}{{ product.name }} - Release History{% endblock %}
{% block og_description %}
    All software releases for {{ product.name }}. Browse release history, download SBOMs, and view release artifacts.
{% endblock %}
{% block page_header %}
    <header class="tc-masthead">
        <div class="tc-masthead-inner tc-masthead-detail">
            <a class="tc-backlink"
               href="{% public_url 'core:product_details_public' product_id=product.id product_slug=product.slug %}">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                {{ product.name }}
            </a>
            <div class="tc-detail-eyebrow">
                <p class="tc-eyebrow">
                    <span class="tc-eyebrow-dot" aria-hidden="true"></span>
                    Releases
                </p>
            </div>
            <h1 class="tc-detail-title">{{ product.name }} releases</h1>
            <p class="tc-detail-summary">Every release of this product, newest first, with its published artifacts.</p>
            {% if releases %}
                <div class="tc-detail-meta">
                    <span class="tc-detail-meta-item">
                        <i class="fas fa-tags" aria-hidden="true"></i>
                        {{ releases|length }} release{{ releases|length|pluralize }}
                    </span>
                </div>
            {% endif %}
        </div>
    </header>
{% endblock %}
{% block content %}
    {% if releases %}
        <div class="tc-panel tc-panel-flush">
            <div class="tw-data-table-container">
                <table class="tw-table">
                    <thead>
                        <tr>
                            <th scope="col">Release</th>
                            <th scope="col" class="hidden md:table-cell">Version</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="hidden md:table-cell">Released</th>
                            <th scope="col">
                                <span class="sr-only">View</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for release in releases %}
                            <tr>
                                <td>
                                    <a class="font-medium text-text hover:text-primary no-underline"
                                       href="{% public_url 'core:release_details_public' product_id=product.id product_slug=product.slug release_id=release.id release_slug=release.slug %}">{{ release.name }}</a>
                                    {% if release.description %}
                                        <div class="text-xs opacity-75 mt-1" title="{{ release.description }}">{{ release.description|truncatechars:60 }}</div>
                                    {% endif %}
                                    <div class="md:hidden text-xs opacity-75 mt-1">
                                        {{ release.released_at|default_if_none:release.created_at|naturaltime }}
                                    </div>
                                </td>
                                <td class="hidden md:table-cell">
                                    {% if release.version %}
                                        <span class="font-mono text-xs">{{ release.version }}</span>
                                    {% else %}
                                        <span class="opacity-50">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if release.is_latest %}
                                        <span class="tw-badge tw-badge-success">Latest</span>
                                    {% elif release.is_prerelease %}
                                        <span class="tw-badge tw-badge-warning">Pre-release</span>
                                    {% else %}
                                        <span class="text-xs opacity-75">Stable</span>
                                    {% endif %}
                                </td>
                                <td class="hidden md:table-cell whitespace-nowrap">
                                    <span title="{{ release.released_at|default_if_none:release.created_at }}">
                                        {{ release.released_at|default_if_none:release.created_at|naturaltime }}
                                    </span>
                                </td>
                                <td class="text-right">
                                    <a class="tc-section-link whitespace-nowrap"
                                       href="{% public_url 'core:release_details_public' product_id=product.id product_slug=product.slug release_id=release.id release_slug=release.slug %}"
                                       aria-label="View {{ release.name }}">
                                        View <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="tc-empty">
            <i class="fas fa-tags tc-empty-icon" aria-hidden="true"></i>
            <p class="tc-empty-title">No releases yet</p>
            <p class="tc-empty-body">Releases appear here as this product publishes them.</p>
        </div>
    {% endif %}
{% endblock %}
{% block scripts %}
    {% vite_asset 'sbomify/apps/core/js/main.ts' %}
{% endblock %}
