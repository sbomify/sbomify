{% extends "core/public_base.htmx.j2" %}
{% load django_vite %}
{% load static %}
{% load public_url_tags %}
{% load humanize %}
{% block title %}{{ product.name }} - Releases{% endblock %}
{% block meta_description %}
    All software releases for {{ product.name }}. Browse release history, download SBOMs, and view release artifacts.
{% endblock %}
{% block og_title %}{{ product.name }} - Release History{% endblock %}
{% block og_description %}
    All software releases for {{ product.name }}. Browse release history, download SBOMs, and view release artifacts.
{% endblock %}
{% block page_header %}
    <c-branded.masthead>
    <c-branded.back-link href="{% public_url 'core:product_details_public' product_id=product.id product_slug=product.slug %}">{{ product.name }}</c-branded.back-link>
    <c-branded.page-header title="{{ product.name }} releases" lede="Every release of this product, newest first, with its published artifacts.">
    <c-slot name="eyebrow">
    <c-branded.badge brand>Releases</c-branded.badge>
    </c-slot>
    {% if releases %}
        <div class="flex items-center gap-x-5 gap-y-2 [flex-wrap:wrap]">
            <c-branded.meta-item icon="fas fa-tags">
            {{ releases|length|intcomma }} release{{ releases|length|pluralize }}
            </c-branded.meta-item>
        </div>
    {% endif %}
    </c-branded.page-header>
    </c-branded.masthead>
{% endblock %}
{% block content %}
    {% if releases %}
        {# The panel already draws the frame, so the table brings only its own parts. #}
        <c-branded.surface flush>
        <c-tables.table>
        <c-tables.head>
        <c-tables.header-cell scope="col" nowrap>Release</c-tables.header-cell>
        <c-tables.header-cell scope="col" class="hidden md:table-cell">Version</c-tables.header-cell>
        <c-tables.header-cell scope="col">Status</c-tables.header-cell>
        <c-tables.header-cell scope="col" date class="hidden md:table-cell">Released</c-tables.header-cell>
        <c-tables.header-cell scope="col">
        <span class="sr-only">View</span>
        </c-tables.header-cell>
        </c-tables.head>
        <tbody>
            {% for release in releases %}
                {% public_url 'core:release_details_public' product_id=product.id product_slug=product.slug release_id=release.id release_slug=release.slug as release_url %}
                <c-tables.row>
                <c-tables.cell nowrap>
                <a class="font-medium text-text hover:text-text no-underline"
                   data-button
                   href="{{ release_url }}">{{ release.name }}</a>
                {% if release.description %}
                    <div class="text-xs text-text-muted mt-1"
                         title="{{ release.description }}">{{ release.description|truncatechars:60 }}</div>
                {% endif %}
                <div class="md:hidden text-xs text-text-muted mt-1">
                    {{ release.released_at|default_if_none:release.created_at|naturaltime }}
                </div>
                </c-tables.cell>
                <c-tables.cell class="hidden md:table-cell">
                {% if release.version %}
                    <span class="font-mono text-xs">{{ release.version }}</span>
                {% else %}
                    <span class="text-text-muted">—</span>
                {% endif %}
                </c-tables.cell>
                <c-tables.cell>
                {% if release.is_latest %}
                    <c-branded.badge tone="success">Latest</c-branded.badge>
                {% elif release.lifecycle_state != 'active' %}
                    <c-branded.release-state state="{{ release.lifecycle_state }}" />
                {% elif release.is_prerelease %}
                    <c-branded.badge tone="medium">Pre-release</c-branded.badge>
                {% else %}
                    <c-branded.badge>Stable</c-branded.badge>
                {% endif %}
                </c-tables.cell>
                <c-tables.cell date muted class="hidden md:table-cell">
                <span title="{{ release.released_at|default_if_none:release.created_at }}">
                    {{ release.released_at|default_if_none:release.created_at|naturaltime }}
                </span>
                </c-tables.cell>
                <c-tables.cell end>
                <c-buttons.secondary size="sm" href="{{ release_url }}" aria-label="View {{ release.name }}">View</c-buttons.secondary>
                </c-tables.cell>
                </c-tables.row>
            {% endfor %}
        </tbody>
        </c-tables.table>
        </c-branded.surface>
    {% else %}
        <c-branded.surface flush>
        <c-feedback.empty-state icon="fas fa-tags" icon_variant="neutral" title="No releases yet" message="Releases appear here as this product publishes them." />
        </c-branded.surface>
    {% endif %}
{% endblock %}
{% block scripts %}
    {% vite_asset 'sbomify/apps/core/js/main.ts' %}
{% endblock %}
