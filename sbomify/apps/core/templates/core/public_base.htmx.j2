{% load static brand_tags %}
{% load django_vite %}
{% load django_htmx %}
{% load cache %}
{% load schema_tags %}
{% load brand_tags %}
{% load public_url_tags %}
<!DOCTYPE html>
<html lang="en">
    <script data-cfasync="false">
        {% comment %}
            Public pages are light only for now. The workspace's brand is the
            only colour that varies here, and a second axis of light and dark
            doubles what a brand colour has to stay readable against, so the
            dark path and its toggle are off until that is worth the cost.

            Still set inline: the stylesheets below key off data-theme, and the
            critical variables beat selector rules without !important, so the
            page paints its final colours before they resolve. data-cfasync="false"
            keeps Cloudflare Rocket Loader from deferring it past first paint.
{% endcomment %}
        (function(){
            var html=document.documentElement;
            html.setAttribute('data-theme','light');
            html.classList.add('light');
            html.classList.remove('dark');
            var style = html.style;
            style.setProperty('--color-surface','rgb(255 255 255)');
            style.setProperty('--color-surface-elevated','rgb(255 255 255)');
            style.setProperty('--color-border','rgb(226 232 240)');
        })();
    </script>
    <head>
        {% block head %}
            <meta charset="utf-8">
            <meta http-equiv="X-UA-Compatible" content="IE=edge">
            <meta name="viewport"
                  content="width=device-width, initial-scale=1, shrink-to-fit=no">
            <meta name="color-scheme" content="light dark">
            {# SEO Meta Tags #}
            <meta name="description"
                  content="{% block meta_description %}{% if brand.name %}{{ brand.name }} Trust Center - Browse security artifacts, SBOMs, and compliance documents{% else %}sbomify - Your Security Artifact Hub{% endif %}{% endblock %}">
            <meta name="keywords"
                  content="{% block meta_keywords %}SBOM, Software Bill of Materials, security, compliance, vulnerability management{% endblock %}">
            <meta name="author"
                  content="{% if brand.name %}{{ brand.name }}{% else %}sbomify{% endif %}">
            <meta name="robots"
                  content="{% block meta_robots %}index, follow{% endblock %}">
            {# Canonical URL #}
            <link rel="canonical" href="{{ request.build_absolute_uri }}">
            {# Favicon #}
            <link rel="apple-touch-icon"
                  sizes="180x180"
                  href="{% if brand.brand_icon_url %}{{ brand.brand_icon_url }}{% else %}{% static 'img/favicons/apple-touch-icon.png' %}{% endif %}">
            <link rel="icon"
                  type="image/png"
                  sizes="32x32"
                  href="{% if brand.brand_icon_url %}{{ brand.brand_icon_url }}{% else %}{% static 'img/favicons/favicon-32x32.png' %}{% endif %}">
            <link rel="icon"
                  type="image/png"
                  sizes="16x16"
                  href="{% if brand.brand_icon_url %}{{ brand.brand_icon_url }}{% else %}{% static 'img/favicons/favicon-16x16.png' %}{% endif %}">
            <link rel="icon"
                  type="image/svg+xml"
                  href="{% if brand.brand_icon_url %}{{ brand.brand_icon_url }}{% else %}{% static 'img/favicons/favicon.svg' %}{% endif %}">
            <link rel="manifest" href="{% static 'dist/manifest.webmanifest' %}">
            {# Schema.org metadata #}
            {% schema_org_metadata %}
            {# Social media image: always use absolute URL for social crawlers #}
            {# Build the absolute fallback URL for the default social image #}
            {% static 'img/sbomify-social.png' as default_social_image %}
            {% with absolute_fallback=request.scheme|add:"://"|add:request.get_host|add:default_social_image %}
                {% with brand_name=brand.name|default:"sbomify" %}
                    {# Open Graph / Facebook #}
                    <meta property="og:type" content="website">
                    <meta property="og:url" content="{{ request.build_absolute_uri }}">
                    <meta property="og:title"
                          content="{% block og_title %}{% if brand.name %}{{ brand.name }} Trust Center{% else %}sbomify - Your Security Artifact Hub{% endif %}{% endblock %}">
                    <meta property="og:description"
                          content="{% block og_description %}{% if brand.name %}{{ brand.name }} Trust Center - Browse security artifacts, SBOMs, and compliance documents{% else %}sbomify - Your Security Artifact Hub{% endif %}{% endblock %}">
                    {# Use brand.brand_image only if it's an absolute URL (starts with http), otherwise use fallback #}
                    {# This ensures social crawlers always get a full URL they can fetch #}
                    <meta property="og:image"
                          content="{% if brand.brand_image and brand.brand_image|slice:':4' == 'http' %}{{ brand.brand_image }}{% else %}{{ absolute_fallback }}{% endif %}">
                    {% if not brand.brand_image or brand.brand_image|slice:":4" != "http" %}
                        <meta property="og:image:width" content="1200">
                        <meta property="og:image:height" content="630">
                        <meta property="og:image:type" content="image/png">
                    {% endif %}
                    <meta property="og:image:alt" content="{{ brand_name }} Logo">
                    {# Twitter #}
                    <meta property="twitter:card" content="summary_large_image">
                    <meta property="twitter:url" content="{{ request.build_absolute_uri }}">
                    <meta property="twitter:title"
                          content="{% block twitter_title %}{% if brand.name %}{{ brand.name }} Trust Center{% else %}sbomify - Your Security Artifact Hub{% endif %}{% endblock %}">
                    <meta property="twitter:description"
                          content="{% block twitter_description %}{% if brand.name %}{{ brand.name }} Trust Center - Browse security artifacts, SBOMs, and compliance documents{% else %}sbomify - Your Security Artifact Hub{% endif %}{% endblock %}">
                    <meta property="twitter:image"
                          content="{% if brand.brand_image and brand.brand_image|slice:':4' == 'http' %}{{ brand.brand_image }}{% else %}{{ absolute_fallback }}{% endif %}">
                    <meta property="twitter:image:alt" content="{{ brand_name }} Logo">
                {% endwith %}
            {% endwith %}
            {# Fonts #}
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@300..900&display=swap"
                  rel="stylesheet">
            {# CSS #}
            <link href="{% static 'css/fontawesome.min.css' %}" rel="stylesheet">
            <link href="{% static 'css/tokens.css' %}" rel="stylesheet">
            <link href="{% static 'css/base.css' %}" rel="stylesheet">
            <link href="{% static 'css/layout.css' %}" rel="stylesheet">
            <link href="{% static 'css/components.css' %}" rel="stylesheet">
            <link href="{% static 'css/responsive.css' %}" rel="stylesheet">
            <link href="{% static 'css/pages.css' %}" rel="stylesheet">
            <link href="{% static 'css/utilities.css' %}" rel="stylesheet">
            <link href="{% static 'css/components/items-list-table.css' %}"
                  rel="stylesheet">
            <link href="{% static 'css/components/standard-card.css' %}"
                  rel="stylesheet">
            <link href="{% static 'css/public-base.css' %}" rel="stylesheet">
            <link href="{% static 'css/public-pages.css' %}" rel="stylesheet">
            <link rel="stylesheet"
                  href="{% vite_asset_url 'sbomify/assets/css/tailwind.src.css' %}">
            {# Custom CSS Variables for Branding #}
            <style>
            :root {
                /* Brand Colors - Primary for headers/navigation, Accent for buttons/links */
                --brand-color: {{ brand.brand_color|default:'#3b7ddd' }};
                --accent-color: {{ brand.accent_color|default:'#3b7ddd' }};
                --brand-color-rgb: {{ brand.brand_color|default:'#3b7ddd'|hex_to_rgb }};
                --accent-color-rgb: {{ brand.accent_color|default:'#3b7ddd'|hex_to_rgb }};
                --brand-color-light: {{ brand.brand_color|default:'#3b7ddd'|lighten:0.1 }};
                --brand-color-dark: {{ brand.brand_color|default:'#3b7ddd'|darken:0.1 }};
                --accent-color-light: {{ brand.accent_color|default:'#3b7ddd'|lighten:0.1 }};
                --accent-color-dark: {{ brand.accent_color|default:'#3b7ddd'|darken:0.1 }};

                /* What the c-branded.* library reads. It is normally published
                   by c-branded.theme, but a whole page is one brand scope, so
                   it is set once here rather than wrapping every template in a
                   div. Nothing in the app stylesheet defines --brand, so unlike
                   --color-primary below, this is not overridden by load order.
                   brand_ink measures the accent and returns the text colour
                   that is actually readable on it. */
                --brand: {{ brand.accent_color|brand_fill }};
                --brand-ink: {{ brand.accent_color|brand_ink }};

                /* Override Tailwind primary color with accent color for buttons/links.
                   Whole rgb() values: the tokens are whole colors, and a bare
                   triplet invalidates every var() consumer's declaration. */
                --color-primary: rgb({{ brand.accent_color|default:'#3b7ddd'|hex_to_rgb }});
                --color-primary-light: rgb({{ brand.accent_color|default:'#3b7ddd'|lighten:0.1|hex_to_rgb }});
                --color-primary-dark: rgb({{ brand.accent_color|default:'#3b7ddd'|darken:0.1|hex_to_rgb }});
                --text-primary: #1a202c;
                --text-secondary: #64748b;
                --text-muted: #94a3b8;
                --bg-primary: #ffffff;
                --bg-secondary: #f8fafc;
                --bg-tertiary: #f1f5f9;
                --border-color: #e2e8f0;
                --border-color-light: #f1f5f9;
                --shadow-color: rgba(0, 0, 0, 0.1);
                --shadow-color-light: rgba(0, 0, 0, 0.05);
                /* No --radius-* here. This block is the last unlayered :root on
                   the page, so a radius declared here beat the one every
                   rounded-* utility reads and gave the public side a scale one
                   third larger than the app's. The scale lives in
                   sbomify/assets/css/tailwind.src.css, which owns it for both. */
                --font-family-primary: 'Figtree', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

                /* Bootstrap Overrides */
                --bs-primary: var(--accent-color);
                --bs-primary-rgb: var(--accent-color-rgb);
                --bs-link-color: var(--accent-color);
                --bs-link-hover-color: var(--accent-color-dark);
            }

            /* Light theme (default) */
            html[data-theme="light"] {
                --text-primary: #0f172a;
                --text-secondary: #475569;
                --text-muted: #64748b;
                --text-title: #0f172a;
                --bg-primary: #ffffff;
                --bg-secondary: #f8fafc;
                --bg-tertiary: #f1f5f9;
                --border-color: #e2e8f0;
                --border-color-light: #f1f5f9;
                --shadow-color: rgba(0, 0, 0, 0.1);
                --shadow-color-light: rgba(0, 0, 0, 0.05);
                /* Surface variables for cards */
                --surface-card: #ffffff;
                --surface-card-muted: #f8fafc;
                --surface-border: #e2e8f0;
                /* Gray scale */
                --gray-50: #f8fafc;
                --gray-100: #f1f5f9;
                --gray-200: #e2e8f0;
                --gray-400: #94a3b8;
                --gray-500: #64748b;
                --gray-600: #475569;
                --white: #ffffff;
                /* Tailwind color variables (RGB triplets) — public trust center is light-default;
                   this inline style block already comes after tokens.css in source order,
                   so no !important is needed to win the cascade. */
                --color-surface: 255 255 255;
                --color-surface-elevated: 255 255 255;
                --color-surface-hover: 241 245 249;
                --color-border: 226 232 240;
                --color-border-light: 241 245 249;
                --color-text: 15 23 42;
                --color-text-secondary: 51 65 85;
                --color-text-muted: 100 116 139;
                --color-background: 248 250 252;
                color-scheme: light;
            }

            /* Dark theme */
            html[data-theme="dark"] {
                --text-primary: #f8fafc;
                --text-secondary: #cbd5e1;
                --text-muted: #94a3b8;
                --text-title: #f8fafc;
                --bg-primary: #0f172a;
                --bg-secondary: #1e293b;
                --bg-tertiary: #334155;
                --border-color: #334155;
                --border-color-light: #475569;
                --shadow-color: rgba(0, 0, 0, 0.3);
                --shadow-color-light: rgba(0, 0, 0, 0.15);
                /* Surface variables for cards */
                --surface-card: #1e293b;
                --surface-card-muted: #334155;
                --surface-border: #475569;
                /* Gray scale (inverted for dark) */
                --gray-50: #334155;
                --gray-100: #475569;
                --gray-200: #64748b;
                --gray-400: #94a3b8;
                --gray-500: #cbd5e1;
                --gray-600: #e2e8f0;
                --white: #f8fafc;
                /* Tailwind color variables — trust center dark uses a slate palette
                   (intentionally distinct from the app's navy dark; see ADR/brand notes). */
                --color-surface: 30 41 59;
                --color-surface-elevated: 51 65 85;
                --color-surface-hover: 71 85 105;
                --color-border: 51 65 85;
                --color-border-light: 71 85 105;
                --color-text: 248 250 252;
                --color-text-secondary: 203 213 225;
                --color-text-muted: 148 163 184;
                --color-background: 15 23 42;
                color-scheme: dark;
            }

            /* Tailwind's `prose` typography plugin gives inline `<code>` a
               light slate background that turns into white-on-near-white in
               dark mode. The `dark:prose-invert` class on doc_public /
               vdp_public templates fixes this — but only when Tailwind's
               `dark:` variant fires. Trust-center pages drive theme via
               `data-theme="dark"` (their own state machine), so the variant
               doesn't pick this up. Apply the dark-code background by hand
               using the same dark-theme CSS variables defined just above
               (re-use ``--color-surface-elevated`` and ``--color-text`` so
               future palette tweaks flow through to <code> automatically). */
            html[data-theme="dark"] .prose code {
                background-color: var(--color-surface-elevated);
                color: var(--color-text);
            }

            /* System theme - light preference */
            html:not([data-theme]) {
                --text-primary: #0f172a;
                --text-secondary: #475569;
                --text-muted: #64748b;
                --text-title: #0f172a;
                --bg-primary: #ffffff;
                --bg-secondary: #f8fafc;
                --bg-tertiary: #f1f5f9;
                --border-color: #e2e8f0;
                --border-color-light: #f1f5f9;
                --shadow-color: rgba(0, 0, 0, 0.1);
                --shadow-color-light: rgba(0, 0, 0, 0.05);
                /* Surface variables for cards */
                --surface-card: #ffffff;
                --surface-card-muted: #f8fafc;
                --surface-border: #e2e8f0;
                /* Gray scale */
                --gray-50: #f8fafc;
                --gray-100: #f1f5f9;
                --gray-200: #e2e8f0;
                --gray-400: #94a3b8;
                --gray-500: #64748b;
                --gray-600: #475569;
                --white: #ffffff;
                /* Tailwind color variables — system-light defaults match the canonical light theme. */
                --color-surface: 255 255 255;
                --color-surface-elevated: 255 255 255;
                --color-surface-hover: 241 245 249;
                --color-border: 226 232 240;
                --color-border-light: 241 245 249;
                --color-text: 15 23 42;
                --color-text-secondary: 51 65 85;
                --color-text-muted: 100 116 139;
                --color-background: 248 250 252;
                color-scheme: light;
            }

            /* System theme - dark preference */
            @media (prefers-color-scheme: dark) {
                html:not([data-theme]) {
                    --text-primary: #f8fafc;
                    --text-secondary: #cbd5e1;
                    --text-muted: #94a3b8;
                    --text-title: #f8fafc;
                    --bg-primary: #0f172a;
                    --bg-secondary: #1e293b;
                    --bg-tertiary: #334155;
                    --border-color: #334155;
                    --border-color-light: #475569;
                    --shadow-color: rgba(0, 0, 0, 0.3);
                    --shadow-color-light: rgba(0, 0, 0, 0.15);
                    /* Surface variables for cards */
                    --surface-card: #1e293b;
                    --surface-card-muted: #334155;
                    --surface-border: #475569;
                    /* Gray scale (inverted for dark) */
                    --gray-50: #334155;
                    --gray-100: #475569;
                    --gray-200: #64748b;
                    --gray-400: #94a3b8;
                    --gray-500: #cbd5e1;
                    --gray-600: #e2e8f0;
                    --white: #f8fafc;
                    /* Tailwind color variables — slate dark, mirrors html[data-theme="dark"]. */
                    --color-surface: 30 41 59;
                    --color-surface-elevated: 51 65 85;
                    --color-surface-hover: 71 85 105;
                    --color-border: 51 65 85;
                    --color-border-light: 71 85 105;
                    --color-text: 248 250 252;
                    --color-text-secondary: 203 213 225;
                    --color-text-muted: 148 163 184;
                    --color-background: 15 23 42;
                    color-scheme: dark;
                }
            }

            /* ===========================================
               PUBLIC PAGE BRANDING STYLES
               Primary Color: Headers, navigation, primary elements
               Accent Color: Buttons, links, highlights
               =========================================== */

            /* Links use accent color.
               [data-button] is a library button rendered as an anchor: it carries
               its own recipe, and the tw-btn-* names in this list are the same
               exclusion for the buttons that have not been migrated yet. */
            .public-page a:not([data-button]):not(.tw-btn-primary):not(.tw-btn-secondary):not(.tw-btn-outline):not([role^="menuitem"]) {
                color: var(--accent-color);
                text-decoration: none;
                transition: color 0.15s ease;
            }

            .public-page a:not([data-button]):not(.tw-btn-primary):not(.tw-btn-secondary):not(.tw-btn-outline):not([role^="menuitem"]):hover {
                color: var(--accent-color-dark);
            }

            /* Library buttons build their whole recipe from --color-primary, which
               the app stylesheet owns and loads after this block. Handing them the
               workspace accent as that token is the same substitution the tw-btn-*
               rules below make by hand, done once and only on the button, so the
               recipe itself stays in the component. */
            .public-page [data-button] {
                --color-primary: var(--accent-color);
                --color-primary-light: var(--accent-color-light);
                --color-primary-dark: var(--accent-color-dark);
            }

            /* Primary buttons use accent color */
            .public-page .tw-btn-primary {
                background: linear-gradient(135deg, var(--accent-color) 0%, var(--accent-color-dark) 100%) !important;
                border-color: var(--accent-color) !important;
                color: #ffffff !important;
                box-shadow: 0 1px 3px rgba(var(--accent-color-rgb), 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;
            }

            .public-page .tw-btn-primary:hover {
                background: linear-gradient(135deg, var(--accent-color-light) 0%, var(--accent-color) 100%) !important;
                border-color: var(--accent-color-dark) !important;
                box-shadow: 0 4px 12px rgba(var(--accent-color-rgb), 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;
            }

            .public-page .tw-btn-primary:focus {
                box-shadow: 0 0 0 3px rgba(var(--accent-color-rgb), 0.25) !important;
            }

            /* Outline buttons use accent color */
            .public-page .tw-btn-outline {
                color: var(--accent-color) !important;
                border-color: var(--accent-color) !important;
            }

            .public-page .tw-btn-outline:hover {
                background-color: var(--accent-color) !important;
                color: #ffffff !important;
            }

            /* Text with primary color class uses accent (for highlights) */
            .public-page .text-primary {
                color: var(--accent-color) !important;
            }

            /* Background primary uses accent */
            .public-page .bg-primary {
                background-color: var(--accent-color) !important;
            }

            .public-page .bg-primary\/10,
            .public-page [class*="bg-primary/10"] {
                background-color: rgba(var(--accent-color-rgb), 0.1) !important;
            }

            .public-page .bg-primary\/15,
            .public-page [class*="bg-primary/15"] {
                background-color: rgba(var(--accent-color-rgb), 0.15) !important;
            }

            .public-page .bg-primary\/5,
            .public-page [class*="bg-primary/5"] {
                background-color: rgba(var(--accent-color-rgb), 0.05) !important;
            }

            /* Border primary uses accent */
            .public-page .border-primary {
                border-color: var(--accent-color) !important;
            }

            .public-page [class*="border-primary/30"] {
                border-color: rgba(var(--accent-color-rgb), 0.3) !important;
            }

            .public-page [class*="hover:border-primary"]:hover {
                border-color: var(--accent-color) !important;
            }

            /* Focus states use accent color */
            .public-page *:focus-visible {
                outline-color: var(--accent-color);
            }

            /* One flat colour from below the header all the way to the footer.
               The page used to fade from --bg-secondary to --bg-tertiary, which
               put a second, softer edge under every section and made the
               content area read as a gradient panel rather than as the page. */
            body.public-page {
                background: var(--bg-secondary);
                color: var(--text-primary);
                min-height: 100vh;
            }

            /* Public Page Layout Styles */
            .public-page {
                font-family: var(--font-family-primary);
                color: var(--text-primary);
                background-color: var(--bg-secondary);
                line-height: 1.6;
                margin: 0;
                padding: 0;
            }


            </style>
            {% block extra_css %}{% endblock %}
            <title>
                {% block title %}{% endblock %}
                -
                {% if brand.name %}
                    {{ brand.name }}
                {% else %}
                    sbomify
                {% endif %}
            </title>
        {% endblock %}
        {% vite_hmr_client %}
    </head>
    <body class="public-page" data-theme="public">
        {# The visitor's own channel: the workspace socket refuses anyone outside it, and an access request's verdict is addressed to the requester. #}
        {% if request.user.is_authenticated and team and team.key %}
            <div x-data x-init="$store.ws.connectUser()" class="tw:hidden"></div>
        {% endif %}
        {# Public Page Layout #}
        {% include "core/components/messages.html.j2" %}
        {% comment %}
        The chrome is the platform's, like the app's: a plain header with the
        workspace's logo on the left and the account control on the right, the
        trust-center nav under it, and a quiet footer. The brand reaches it
        through the logo and the nav's current marker, nothing else, so the
        frame reads the same on every workspace's trust center.

        The header, content and footer tracks share one width and gutter with
        the nav and c-branded.masthead, so every edge on the page lines up.
        {% endcomment %}
        <div class="flex min-h-screen flex-col">
            <header class="relative z-[70] border-b border-solid border-border bg-surface">
                <div class="mx-auto flex max-w-[1200px] items-center justify-between gap-4 px-4 py-3.5">
                    {% workspace_public_url as trust_center_url %}
                    {% if brand.brand_image %}
                        {% firstof brand.brand_image as logo_src %}
                    {% else %}
                        {% static 'img/sbomify.svg' as logo_src %}
                    {% endif %}
                    {% if trust_center_url %}
                        <a href="{{ trust_center_url }}"
                           data-button
                           class="inline-flex shrink-0 rounded-[var(--radius-sm)] no-underline transition-opacity duration-150 hover:opacity-85"
                           title="Trust Center Home">
                            <img src="{{ logo_src }}"
                                 alt="{% if brand.name %}{{ brand.name }}{% else %}sbomify{% endif %} Logo"
                                 class="h-9 w-auto max-w-[12rem] object-contain max-sm:h-8 max-sm:max-w-[9rem]"
                                 width="32"
                                 height="32">
                        </a>
                    {% else %}
                        <img src="{{ logo_src }}"
                             alt="{% if brand.name %}{{ brand.name }}{% else %}sbomify{% endif %} Logo"
                             class="h-9 w-auto max-w-[12rem] object-contain max-sm:h-8 max-sm:max-w-[9rem]"
                             width="32"
                             height="32">
                    {% endif %}
                    <div class="flex items-center gap-2">
                        {% if user.is_authenticated %}
                            {% load teams %}
                            {% user_workspaces as available_workspaces %}
                            {% if available_workspaces|length > 1 %}
                                <div class="relative"
                                     x-data="{ open: false }"
                                     @click.outside="open = false"
                                     @keydown.escape.window="open = false">
                                    <c-buttons.secondary size="sm" type="button" @click="open = !open" ::aria-expanded="open" aria-haspopup="menu" title="Switch workspace">
                                    <i class="fas fa-briefcase" aria-hidden="true"></i>
                                    {% if request.session.current_workspace %}
                                        <span class="max-sm:hidden">{{ request.session.current_workspace.name|workspace_display }}</span>
                                        <span class="sm:hidden">Workspace</span>
                                    {% else %}
                                        <span>Switch Workspace</span>
                                    {% endif %}
                                    <i class="fas fa-chevron-down text-xs transition-transform duration-150"
                                       :class="open && 'rotate-180'"
                                       aria-hidden="true"></i>
                                    </c-buttons.secondary>
                                    <c-dropdowns.dropdown class="right-0 top-[calc(100%+0.5rem)] w-64" x-show="open" x-cloak>
                                    <c-dropdowns.header>Switch Workspace</c-dropdowns.header>
                                    {% for t_key, t_info in available_workspaces.items %}
                                        {% if request.session.current_workspace.key == t_key %}
                                            <c-dropdowns.item radio checked href="{% url 'workspaces:switch_team' t_key %}">{{ t_info.name|workspace_display }}</c-dropdowns.item>
                                        {% else %}
                                            <c-dropdowns.item radio href="{% url 'workspaces:switch_team' t_key %}">{{ t_info.name|workspace_display }}</c-dropdowns.item>
                                        {% endif %}
                                    {% endfor %}
                                    </c-dropdowns.dropdown>
                                </div>
                            {% endif %}
                        {% else %}
                            <c-buttons.secondary size="sm" href="{% url 'core:keycloak_login' %}?next={{ request.path|urlencode }}">
                            <i class="fas fa-sign-in-alt" aria-hidden="true"></i>
                            <span>Sign in</span>
                            </c-buttons.secondary>
                        {% endif %}
                    </div>
                    {% block header_content %}{% endblock %}
                </div>
            </header>
            {% include "core/components/trust_center/nav.html.j2" %}
            <main class="flex-1">
                {% comment %}
                Full-bleed page header, outside the content track so a masthead
                can span the viewport while its text still lines up with the
                content below. Pages that do not define it lose nothing.
                {% endcomment %}
                {% block page_header %}{% endblock %}
                <div class="mx-auto w-full max-w-[1200px] px-4 py-10 max-sm:py-6">
                    {% block content %}{% endblock %}
                </div>
            </main>
            {% comment %}
            The workspace name is already the page's H1 and the header logo, so
            the footer carries only the copyright and the platform credit.
            {% endcomment %}
            <footer class="border-t border-solid border-border bg-surface">
                <div class="mx-auto flex max-w-[1200px] items-center justify-between gap-3 [flex-wrap:wrap] px-4 py-5 text-xs text-text-muted">
                    <span>
                        © {% now "Y" %}
                        {% if brand.name %}
                            {{ brand.name }}
                        {% else %}
                            sbomify
                        {% endif %}
                    </span>
                    <span>
                        Powered by <a class="font-semibold text-text-secondary hover:text-text no-underline"
    data-button
    href="https://sbomify.com?utm_source=sbomify&utm_medium=trust_center&utm_campaign=powered_by"
    target="_blank"
    rel="noopener noreferrer">sbomify</a>
                    </span>
                </div>
            </footer>
        </div>
        <c-feedback.toast-container />
        {% block scripts %}{% endblock %}
        {% vite_asset 'sbomify/apps/core/js/htmx-bundle.ts' %}
        {% htmx_script %}
    </body>
</html>
