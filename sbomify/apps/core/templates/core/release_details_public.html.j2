{% extends "core/public_base.htmx.j2" %}
{% load django_vite %}
{% load static %}
{% load public_url_tags %}
{% load humanize %}
{% block title %}{{ release.product.name }} - {{ release.name }}{% endblock %}
{% block meta_description %}
    {{ release.name }} release for {{ release.product.name }}.
    {% if release.description %}
        {{ release.description|truncatechars:120 }}
    {% else %}
        Download SBOM and view release artifacts.
    {% endif %}
{% endblock %}
{% block canonical_url %}{{ canonical_url|default:block.super }}{% endblock %}
{% block og_title %}{{ release.product.name }} - {{ release.name }}{% endblock %}
{% block og_description %}
    {{ release.name }} release for {{ release.product.name }}. Download SBOM and view release artifacts.
{% endblock %}
{% block page_header %}
    <c-branded.masthead>
    <c-branded.back-link href="{% public_url 'core:product_details_public' product_id=release.product.id product_slug=release.product.slug %}">{{ release.product.name }}</c-branded.back-link>
    <c-branded.page-header title="{{ release.name }}" lede="{{ release.description }}">
    <c-slot name="eyebrow">
    <c-branded.badge brand>Release</c-branded.badge>
    {% if release.is_latest %}<c-branded.badge tone="success">Latest</c-branded.badge>{% endif %}
    {% if release.is_prerelease %}<c-branded.badge tone="medium">Pre-release</c-branded.badge>{% endif %}
    <c-branded.release-state state="{{ release.lifecycle_state }}" />
    </c-slot>
    <div class="flex items-center gap-x-5 gap-y-2 [flex-wrap:wrap]">
        <c-branded.meta-item icon="far fa-calendar">
        Released {{ release.released_at|default_if_none:release.created_at|naturaltime }}
        </c-branded.meta-item>
        {% if release.version %}<c-branded.meta-item mono>{{ release.version }}</c-branded.meta-item>{% endif %}
        {% if release.artifacts_count %}
            <c-branded.meta-item icon="fas fa-puzzle-piece">
            {{ release.artifacts_count|intcomma }} artifact{{ release.artifacts_count|pluralize }}
            </c-branded.meta-item>
        {% endif %}
    </div>
    </c-branded.page-header>
    </c-branded.masthead>
{% endblock %}
{% block content %}
    <div class="flex flex-col gap-10">
        {% if release.has_sboms or release.has_vex or release.has_cbom %}
            <section class="flex flex-col gap-4">
                <c-branded.section-header title="Download this release" subtitle="Combined artifacts covering everything in this release." />
                <c-branded.surface>
                {% comment %}
                secondary, not a primary or accent-tinted button: on a public page
                the accent is the workspace's own colour, and a neutral button is
                the only one readable on every accent a workspace might pick.
                {% endcomment %}
                <div class="flex gap-3 [flex-wrap:wrap]">
                    {% if release.has_sboms %}
                        <c-buttons.secondary href="{% url 'api-1:download_release' release.id %}" title="Download release as CycloneDX" class="no-underline">
                        <img src="{% static 'img/cyclonedx-logo.svg' %}"
                             alt="CycloneDX"
                             class="h-5 w-auto dark:brightness-0 dark:invert"
                             width="20"
                             height="20">
                        <i class="fas fa-download text-xs" aria-hidden="true"></i>
                        </c-buttons.secondary>
                        <c-buttons.secondary href="{% url 'api-1:download_release' release.id %}?format=spdx" title="Download release as SPDX" class="no-underline">
                        <img src="{% static 'img/spdx-logo.svg' %}"
                             alt="SPDX"
                             class="h-5 w-auto dark:brightness-0 dark:invert"
                             width="20"
                             height="20">
                        <i class="fas fa-download text-xs" aria-hidden="true"></i>
                        </c-buttons.secondary>
                    {% endif %}
                    {% if release.has_vex %}
                        <c-buttons.secondary href="{% url 'api-1:download_release_vex' release.id %}" title="Download latest VEX (CycloneDX)" class="no-underline">
                        <i class="fas fa-file-contract" aria-hidden="true"></i>
                        <span>VEX</span>
                        <i class="fas fa-download text-xs" aria-hidden="true"></i>
                        </c-buttons.secondary>
                    {% endif %}
                    {% if release.has_cbom %}
                        <c-buttons.secondary href="{% url 'api-1:download_release_cbom' release.id %}" title="Download CBOM (Cryptography BOM, CycloneDX)" class="no-underline">
                        <i class="fas fa-key" aria-hidden="true"></i>
                        <span>CBOM</span>
                        <i class="fas fa-download text-xs" aria-hidden="true"></i>
                        </c-buttons.secondary>
                    {% endif %}
                </div>
                </c-branded.surface>
            </section>
        {% endif %}
        {# Vulnerability Posture — the release's VEX-applied posture #}
        {% if vuln_posture.has_data %}
            {{ vuln_posture|json_script:"vuln-posture-data" }}
            <section class="flex flex-col gap-4"
                     x-data="{ data: { counts: {}, findings: [], suppressed_count: 0 }, init() { this.data = window.parseJsonScript ? window.parseJsonScript('vuln-posture-data') : JSON.parse(document.getElementById('vuln-posture-data').textContent); } }"
                     x-init="init()">
                <c-branded.section-header title="Vulnerability posture" subtitle="Known vulnerabilities across this release, with our VEX statements applied." />
                <c-branded.surface class="flex flex-col gap-5">
                {# Severity breakdown (VEX applied) #}
                <div class="grid grid-cols-2 sm:grid-cols-6 gap-3">
                    <c-layout.stat-card compact x_value="data.counts.total" label="Total" />
                    <c-layout.stat-card compact accent="severity-critical" x_value="data.counts.critical" label="Critical" />
                    <c-layout.stat-card compact accent="severity-high" x_value="data.counts.high" label="High" />
                    <c-layout.stat-card compact accent="severity-medium" x_value="data.counts.medium" label="Medium" />
                    <c-layout.stat-card compact accent="severity-low" x_value="data.counts.low" label="Low" />
                    <c-layout.stat-card compact accent="muted" x_value="data.counts.unknown" label="Unknown" />
                </div>
                {# Suppression note #}
                <p class="text-sm text-text-muted m-0 flex items-center gap-2 flex-wrap"
                   x-show="data.suppressed_count > 0"
                   x-cloak>
                    <i class="fas fa-circle-check text-success" aria-hidden="true"></i>
                    <span>
                        <span class="font-semibold text-text"
                              x-text="$number(data.suppressed_count)"></span>
                        finding<span x-show="data.suppressed_count !== 1">s</span>
                        suppressed by VEX (not affected, false positive or fixed).
                    </span>
                </p>
                {# Findings list #}
                <div class="divide-y divide-border" x-show="data.findings.length" x-cloak>
                    <template x-for="f in data.findings" :key="f.idx">
                        <div class="py-2.5 flex items-start gap-3"
                             :class="f.suppressed ? 'opacity-50' : ''">
                            {# The band comes from the row Alpine builds, so it binds data-level. #}
                            <c-badges.severity class="flex-shrink-0" ::data-level="f.severity" x-text="f.severity" />
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <c-code-inline x-text="f.id" />
                                    <span class="text-text-muted text-xs"
                                          x-show="f.component"
                                          x-text="f.component + (f.component_version ? ' ' + f.component_version : '')"></span>
                                    {# state_label, never state: the raw one is the document's enum. #}
                                    <c-badges.secondary x-show="f.suppressed" x-text="f.state_label" />
                                </div>
                                <p class="text-xs text-text-muted mb-0 mt-0.5"
                                   x-show="f.suppressed &amp;&amp; f.justification"
                                   x-text="'VEX: ' + (f.justification_label || f.justification)"></p>
                            </div>
                        </div>
                    </template>
                </div>
                <p class="text-sm text-text-muted m-0"
                   x-show="!data.findings.length"
                   x-cloak>No vulnerabilities found in this release.</p>
                </c-branded.surface>
            </section>
        {% endif %}
        {# Release Artifacts #}
        {% include 'core/components/public_release_artifacts.html.j2' %}
    </div>
{% endblock %}
{% block scripts %}
    {% vite_asset 'sbomify/apps/core/js/main.ts' %}
{% endblock %}
