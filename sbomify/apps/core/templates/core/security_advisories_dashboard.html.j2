{% extends "core/dashboard_base.htmx.j2" %}
{% load design_system %}
{% block title %}sbomify Security Advisories{% endblock %}
{% comment %}
    Creating an advisory is a page rather than a modal: the affected-products
    picker needs room to be usable.
{% endcomment %}
{% block dashboard_content %}
    {% url 'core:security_advisory_new' as new_advisory_url %}
    {% page_header title="Security advisories" subtitle="Publish advisories for your products." icon="fas fa-shield-halved" %}
    {% if has_crud_permissions %}
        {% button_link text="New advisory" url=new_advisory_url variant="primary" icon="fas fa-plus" %}
    {% endif %}
{% endpage_header %}
<div class="space-y-6">{% include 'core/security_advisories_table.html.j2' %}</div>
{% endblock %}
{% block scripts %}{% endblock %}
