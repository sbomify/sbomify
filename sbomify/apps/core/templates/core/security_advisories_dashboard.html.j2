{% extends "core/dashboard_base.htmx.j2" %}
{% block title %}Security advisories · sbomify{% endblock %}
{% comment %}
    Creating an advisory is a page rather than a modal: the affected-products
    picker needs room to be usable.
{% endcomment %}
{% block dashboard_content %}
    <c-layout.page-header title="Security advisories" subtitle="Publish advisories for your products.">
    {% if has_crud_permissions %}
        <c-buttons.primary size="sm" href="{% url 'core:security_advisory_new' %}"><i class="fas fa-plus" aria-hidden="true"></i>Create advisory</c-buttons.primary>
    {% endif %}
    </c-layout.page-header>
    <div class="space-y-6">{% include 'core/security_advisories_table.html.j2' %}</div>
    {% comment %}
        At page level, not inside the table include: the table container is an
        HTMX swap target, and a swap would tear the dialog out mid-confirm.
    {% endcomment %}
    {% if has_crud_permissions %}
        {% include 'core/components/advisory_delete_modal.html.j2' %}
    {% endif %}
{% endblock %}
{% block scripts %}{% endblock %}
