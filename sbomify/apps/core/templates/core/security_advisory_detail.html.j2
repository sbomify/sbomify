{% extends "core/dashboard_base.htmx.j2" %}
{% load humanize %}
{% load static public_url_tags %}
{% block title %}{{ advisory.title }} · sbomify{% endblock %}
{% block dashboard_content %}
    <c-layout.frame>
    <c-layout.page-header title="{{ advisory.title }}" subtitle="{{ advisory.type_label }} advisory" :description="advisory.description" description_markdown>
    <c-buttons.ghost size="sm" href="{% url 'core:security_advisories_dashboard' %}">
    <i class="fas fa-arrow-left" aria-hidden="true"></i>Back to advisories
    </c-buttons.ghost>
    {% comment %}
                    Straight to this advisory on the trust centre, not the trust
                    centre's front page. A draft is not published there at all,
                    so the link is only offered once it is, and the same URL is
                    what the copy action puts on the clipboard.

                    advisory.pk, not advisory.id: id is the display identifier
                    and the view accepts both, but the trust centre's own list
                    links by pk, and one page should have one URL.
    {% endcomment %}
    {% if advisory.publication_status != 'draft' %}
        <c-buttons.secondary size="sm" href="{% public_url 'core:advisory_details_public' workspace_key=current_team.key advisory_id=advisory.pk %}" target="_blank" rel="noopener">
        <i class="fas fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>
        <span class="hidden sm:inline">View in Trust Center</span>
        </c-buttons.secondary>
    {% endif %}
    {% if has_crud_permissions %}
        <c-actions-menu label="Advisory actions">
        {% if advisory.publication_status == 'draft' %}
            {# Publishing is what puts an advisory on the Trust Center — until it runs, an advisory is a draft with private visibility and both are filtered out there. #}
            <c-dropdowns.item icon="fas fa-bullhorn" @click="$dispatch('open-publish-advisory-modal')">
            Publish advisory
            </c-dropdowns.item>
            <c-dropdowns.divider />
        {% endif %}
        <c-dropdowns.item icon="fas fa-pen" @click="$dispatch('open-edit-advisory-modal')">
        Edit advisory
        </c-dropdowns.item>
        {% if advisory.publication_status != 'draft' %}
            {% comment %}
                            The public URL, not this page's. Someone copying a
                            link from an advisory means to send it to a customer,
                            and this page needs a login. new URL resolves the
                            path against the origin, so it works whether the tag
                            returns a path on the app domain or an absolute URL
                            on a custom one.
            {% endcomment %}
            <c-dropdowns.item icon="fas fa-link" @click="navigator.clipboard && navigator.clipboard.writeText(new URL('{% public_url 'core:advisory_details_public' workspace_key=current_team.key advisory_id=advisory.pk %}', window.location.origin).href)">
            Copy public link
            </c-dropdowns.item>
        {% endif %}
        <c-dropdowns.item icon="fas fa-file-shield" @click="$dispatch('open-link-vex-modal')">
        Link a VEX
        </c-dropdowns.item>
        <c-dropdowns.divider />
        <c-dropdowns.item-danger icon="fas fa-trash" @click="$dispatch('open-delete-advisory-modal', { id: '{{ advisory.id|escapejs }}', title: '{{ advisory.title|escapejs }}' })">
        Delete advisory
        </c-dropdowns.item-danger>
        </c-actions-menu>
    {% endif %}
    </c-layout.page-header>
    {% comment %}A draft is invisible outside the workspace, which is not obvious from the page itself, so it is said once at the top. The action opens the same publish modal the actions menu opens, so there is one publish flow and one confirmation, and it is gated on has_crud_permissions because that is what renders that modal.{% endcomment %}
    {% if advisory.publication_status == 'draft' %}
        <c-feedback.alert icon="fas fa-file-pen" title="This advisory is a draft">
        Only your workspace can see it. Publish it to put it on your Trust Center.
        {% if has_crud_permissions %}
            <c-slot name="action">
            <c-buttons.primary size="sm" class="shrink-0" @click="$dispatch('open-publish-advisory-modal')">
            <i class="fas fa-bullhorn" aria-hidden="true"></i>
            Publish advisory
            </c-buttons.primary>
            </c-slot>
        {% endif %}
        </c-feedback.alert>
    {% endif %}
    {# Timeline + info sidebar #}
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-10">
        {# Main: product statuses, then the timeline #}
        <div class="flex-1 min-w-0">
            {% comment %}The rows are the record: the Trust Center's "Am I affected?" table and the CSAF export read them, not the advisory's own status. So they sit above the timeline, where a resolve that they contradict is noticed before it is posted.{% endcomment %}
            {% if advisory.advisory_type != 'workspace_notice' or advisory.statuses %}
                <section class="flex flex-col gap-3 mb-10"
                         aria-labelledby="productStatusesHeading"
                         x-data="{ open: false, rows: [], products: [], row: {}, form: {}, init() { this.rows = window.parseJsonScript('advisory-statuses') || []; this.products = window.parseJsonScript('advisory-product-options') || []; }, releasesFor(productId) { const product = this.products.find(p => p.id === productId); return product ? product.releases : []; }, edit(index) { this.row = this.rows[index]; this.form = { status: this.row.status, justification: this.row.justification, response: this.row.response, fixed_version: this.row.fixed_version, fixed_release_id: this.row.fixed_release_id || '', action_statement: this.row.action_statement, impact_statement: this.row.impact_statement }; this.open = true; }, pickRelease() { const release = this.releasesFor(this.row.product_id).find(r => r.id === this.form.fixed_release_id); if (release) this.form.fixed_version = release.label; }, typeVersion() { const release = this.releasesFor(this.row.product_id).find(r => r.id === this.form.fixed_release_id); if (release && release.label !== this.form.fixed_version.trim()) this.form.fixed_release_id = ''; } }">
                    {{ advisory.statuses|json_script:"advisory-statuses" }}
                    {{ product_options|json_script:"advisory-product-options" }}
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <h2 id="productStatusesHeading" class="text-lg font-semibold text-text">Product statuses</h2>
                            <p class="text-sm text-text-muted m-0">What your Trust Center and CSAF say about each product.</p>
                        </div>
                        {% if can_edit_statuses and advisory.advisory_type != 'workspace_notice' %}
                            <c-buttons.secondary size="sm" @click="$dispatch('open-add-advisory-product-modal')">
                            <i class="fas fa-plus" aria-hidden="true"></i>Add product
                            </c-buttons.secondary>
                        {% endif %}
                    </div>
                    {% if advisory.statuses %}
                        <c-tables.shell>
                        <c-tables.table aria-label="Product statuses">
                        <c-tables.head>
                        <c-tables.header-cell scope="col">Product</c-tables.header-cell>
                        <c-tables.header-cell scope="col">Status</c-tables.header-cell>
                        <c-tables.header-cell scope="col">Fixed in</c-tables.header-cell>
                        <c-tables.header-cell scope="col">What users should do</c-tables.header-cell>
                        {% if can_edit_statuses %}<c-tables.actions-cell as="th" label="Edit" />{% endif %}
                        </c-tables.head>
                        <tbody>
                            {% for row in advisory.statuses %}
                                <c-tables.row class="align-top">
                                <c-tables.cell class="font-medium">{{ row.label }}</c-tables.cell>
                                <c-tables.cell>
                                <c-badges.dynamic variant="{{ row.status_variant }}">{{ row.status_label }}</c-badges.dynamic>
                                {% if row.justification_label %}
                                    <div class="text-xs text-text-muted mt-1">{{ row.justification_label }}</div>
                                {% endif %}
                                </c-tables.cell>
                                <c-tables.cell><span class="font-mono text-xs">{{ row.fixed_version|default:row.recommended_version|default:"—" }}</span></c-tables.cell>
                                <c-tables.cell muted>{{ row.action_statement|default:"—" }}</c-tables.cell>
                                {% if can_edit_statuses %}
                                    <c-tables.actions-cell>
                                    <c-buttons.ghost size="sm" @click="edit({{ forloop.counter0 }})" aria-label="Edit status for {{ row.label }}">
                                    <i class="fas fa-pen" aria-hidden="true"></i>
                                    </c-buttons.ghost>
                                    </c-tables.actions-cell>
                                {% endif %}
                                </c-tables.row>
                            {% endfor %}
                        </tbody>
                        </c-tables.table>
                        </c-tables.shell>
                    {% else %}
                        <p class="text-sm text-text-muted m-0">No products yet. Add the products this advisory covers.</p>
                    {% endif %}
                    {% if can_edit_statuses %}
                        <c-modal id="productStatusModal" title="Edit product status" icon="fas fa-cube">
                        <form id="productStatusForm"
                              method="post"
                              action="{% url 'core:security_advisory_detail' advisory.id %}">
                            {% csrf_token %}
                            <input type="hidden" name="intent" value="product_status" />
                            <input type="hidden" name="status_id" :value="row.id" />
                            <div class="space-y-4">
                                <p class="text-sm font-medium text-text m-0" x-text="row.label"></p>
                                <c-forms.field label="Status" for="productStatusValue">
                                <c-forms.select id="productStatusValue" name="status" :options="product_status_options" x-model="form.status" />
                                </c-forms.field>
                                <div x-show="form.status === 'not_affected'">
                                    <c-forms.field label="Why it is not affected" for="productStatusJustification">
                                    <c-forms.select id="productStatusJustification" name="justification" x-model="form.justification" ::disabled="form.status !== 'not_affected'">
                                    <option value="">Not set</option>
                                    {% for option in justification_options %}<option value="{{ option.value }}">{{ option.label }}</option>{% endfor %}
                                    </c-forms.select>
                                    </c-forms.field>
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    <c-forms.field label="Fixed in version" for="productStatusFixedVersion">
                                    <c-forms.input id="productStatusFixedVersion" name="fixed_version" placeholder="1.4.3" x-model="form.fixed_version" @input="typeVersion()" />
                                    </c-forms.field>
                                    <div x-show="row.product_id">
                                        <c-forms.field label="Fixed in release" for="productStatusFixedRelease">
                                        <c-forms.select id="productStatusFixedRelease" name="fixed_release_id" x-model="form.fixed_release_id" @change="pickRelease()" ::disabled="!row.product_id">
                                        <option value="">No release</option>
                                        <template x-for="release in releasesFor(row.product_id)" :key="release.id">
                                            <option :value="release.id"
                                                    :selected="release.id === form.fixed_release_id"
                                                    x-text="release.label"></option>
                                        </template>
                                        </c-forms.select>
                                        </c-forms.field>
                                    </div>
                                </div>
                                <c-forms.field label="Response" for="productStatusResponse">
                                <c-forms.select id="productStatusResponse" name="response" x-model="form.response">
                                <option value="">Not set</option>
                                {% for option in response_options %}<option value="{{ option.value }}">{{ option.label }}</option>{% endfor %}
                                </c-forms.select>
                                </c-forms.field>
                                <c-forms.field label="What users should do" for="productStatusAction" hint="Shown on your Trust Center.">
                                <c-forms.textarea id="productStatusAction" name="action_statement" rows="2" placeholder="Upgrade to 1.4.3." x-model="form.action_statement" />
                                </c-forms.field>
                                <c-forms.field label="Impact" for="productStatusImpact">
                                <c-forms.textarea id="productStatusImpact" name="impact_statement" rows="2" x-model="form.impact_statement" />
                                </c-forms.field>
                            </div>
                        </form>
                        <c-slot name="footer">
                        <c-buttons.ghost @click="open = false">Cancel</c-buttons.ghost>
                        <c-buttons.primary type="submit" form="productStatusForm">
                        <i class="fas fa-check mr-2"></i>Save status
                        </c-buttons.primary>
                        </c-slot>
                        </c-modal>
                    {% endif %}
                </section>
            {% endif %}
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-lg font-semibold text-text">Timeline</h2>
                <span class="text-xs text-text-muted">{{ advisory.updates_count|intcomma }} update{{ advisory.updates_count|pluralize }}</span>
            </div>
            {# Always-visible composer as the top node — a quick addition. #}
            {% if has_crud_permissions %}
                <div class="flex gap-4">
                    <div class="flex flex-col items-center">
                        <c-chips.icon-chip size="sm" circle>
                        <i class="fas fa-pen text-xs" aria-hidden="true"></i>
                        </c-chips.icon-chip>
                        <span class="w-px flex-1 bg-border/70 my-1"></span>
                    </div>
                    <div class="flex-1 min-w-0 pb-8">
                        <form method="post"
                              action="{% url 'core:security_advisory_detail' advisory.id %}">
                            {% csrf_token %}
                            <div class="rounded-xl border border-border bg-surface overflow-hidden transition-colors focus-within:border-primary/60">
                                <label for="composerNote" class="sr-only">Add an update</label>
                                <textarea id="composerNote"
                                          name="note"
                                          rows="2"
                                          required
                                          aria-describedby="composerNoteHint"
                                          placeholder="Add an update…"
                                          class="w-full bg-transparent border-0 px-4 pt-3 pb-2 text-sm text-text placeholder:text-text-muted resize-none focus:outline-none focus:ring-0"></textarea>
                                <div class="flex flex-wrap items-center justify-between gap-3 px-3 py-2.5 border-t border-border/50 bg-background/30">
                                    <div>
                                        <label for="composerKind" class="sr-only">Update type</label>
                                        {# The field sizes to its content here, so width is the caller's layout. #}
                                        <c-forms.select id="composerKind" name="kind" class="!w-auto min-w-[190px]">
                                        <option value="update">Note only</option>
                                        <option value="investigating">Investigating</option>
                                        <option value="fix_in_progress">Fix in progress</option>
                                        <option value="resolved">Resolved</option>
                                        <option value="wont_fix">Won't fix</option>
                                        </c-forms.select>
                                    </div>
                                    <c-buttons.primary type="submit" size="sm">
                                    <i class="fas fa-paper-plane mr-2"></i>Post update
                                    </c-buttons.primary>
                                </div>
                            </div>
                            <c-forms.hint id="composerNoteHint">Supports Markdown: **bold**, *italic*, `code`, lists, headings and [links](https://example.com).</c-forms.hint>
                        </form>
                    </div>
                </div>
            {% endif %}
            {# Update entries #}
            {% for u in timeline %}
                <div class="flex gap-4 group" x-data="{ editing: false }">
                    <div class="flex flex-col items-center">
                        <c-chips.icon-chip size="sm" circle accent="neutral">
                        <i class="{{ u.icon }} text-xs" aria-hidden="true"></i>
                        </c-chips.icon-chip>
                        {% if not forloop.last %}<span class="w-px flex-1 bg-border/70 my-1"></span>{% endif %}
                    </div>
                    <div class="flex-1 min-w-0 {% if not forloop.last %}pb-8{% endif %}"
                         {% if has_crud_permissions %}@click="if (!editing && !$event.target.closest('a')) editing = true" :class="{ 'cursor-pointer': !editing }"{% endif %}>
                        <div class="flex items-center justify-between gap-3">
                            <span class="flex items-center gap-2 min-w-0">
                                {% if u.from_label %}
                                    <span class="text-xs text-text-muted shrink-0">{{ u.from_label }}</span>
                                    <i class="fas fa-arrow-right text-[10px] text-text-muted shrink-0"
                                       aria-hidden="true"></i>
                                {% endif %}
                                {% comment %}The variant is a value the projection carries, so the badge takes it on the data attribute it keys every recipe from rather than as an interpolated class name.{% endcomment %}
                                <c-badges.dynamic variant="{{ u.variant }}">{{ u.label }}</c-badges.dynamic>
                                {% if u.channel == "agent" %}
                                    <c-badges.violet size="sm" class="gap-1"><i class="fas fa-robot" aria-hidden="true"></i>AI agent</c-badges.violet>
                                {% elif u.channel %}
                                    <c-badges.secondary size="sm">{{ u.channel|upper }}</c-badges.secondary>
                                {% endif %}
                                {% if u.actor %}<span class="text-xs text-text-muted truncate">{{ u.actor }}</span>{% endif %}
                            </span>
                            <div class="flex items-center gap-3 shrink-0">
                                <span class="text-xs text-text-muted">{{ u.date_display }}</span>
                                {% if has_crud_permissions %}
                                    <button type="button"
                                            x-show="!editing"
                                            @click="editing = true"
                                            class="opacity-0 group-hover:opacity-100 focus-visible:opacity-100 text-text-muted hover:text-text transition"
                                            aria-label="Edit update">
                                        <i class="fas fa-pen text-xs" aria-hidden="true"></i>
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                        <c-typography.markdown :text="u.note" class="max-w-3xl mt-2" x-show="!editing" />
                        {% if has_crud_permissions %}
                            <form x-show="editing"
                                  x-cloak
                                  method="post"
                                  action="{% url 'core:security_advisory_detail' advisory.id %}"
                                  class="mt-2 max-w-3xl">
                                {% csrf_token %}
                                <input type="hidden" name="intent" value="edit_update" />
                                <input type="hidden" name="update_id" value="{{ forloop.counter }}" />
                                <label class="sr-only" for="editUpdate{{ forloop.counter }}">Edit update note</label>
                                <c-forms.textarea id="editUpdate{{ forloop.counter }}" name="note" rows="2" value="{{ u.note }}" required aria-describedby="composerNoteHint" />
                                <div class="flex items-center gap-2 mt-2">
                                    <c-buttons.primary type="submit" size="sm">Save</c-buttons.primary>
                                    <c-buttons.ghost size="sm" @click.stop="editing = false">Cancel</c-buttons.ghost>
                                </div>
                            </form>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
        {# Sidebar: more information #}
        <aside class="lg:w-72 lg:shrink-0 space-y-6">
            <div class="space-y-3">
                <h2 class="text-xs uppercase tracking-wide text-text-muted">Details</h2>
                <dl class="space-y-2.5 text-sm">
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-text-muted">Status</dt>
                        <dd>
                            <c-badges.dynamic variant="{{ advisory.status_variant }}">{{ advisory.status_label }}</c-badges.dynamic>
                        </dd>
                    </div>
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-text-muted">Severity</dt>
                        <dd>
                            <c-badges.severity level="{{ advisory.severity }}">{{ advisory.severity|default:"none" }}</c-badges.severity>
                        </dd>
                    </div>
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-text-muted">CVSS</dt>
                        {% if advisory.cvss_score is not None %}
                            <dd class="text-text"
                                {% if advisory.cvss_vector %}title="{{ advisory.cvss_vector }}"{% endif %}>
                                {{ advisory.cvss_score }}
                            </dd>
                        {% else %}
                            <dd class="text-text-muted">
                                Not set
                            </dd>
                        {% endif %}
                    </div>
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-text-muted">Type</dt>
                        <dd class="text-text">
                            {{ advisory.type_label }}
                        </dd>
                    </div>
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-text-muted">Identifier</dt>
                        <dd class="text-text font-mono">
                            {{ advisory.vulnerability_id|default:advisory.id }}
                        </dd>
                    </div>
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-text-muted">Created</dt>
                        <dd class="text-text">
                            {{ advisory.created_display }}
                        </dd>
                    </div>
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-text-muted">Last updated</dt>
                        <dd class="text-text">
                            {{ advisory.updated_display }}
                        </dd>
                    </div>
                </dl>
            </div>
            <div class="space-y-3 border-t border-border/60 pt-6">
                <h2 class="text-xs uppercase tracking-wide text-text-muted">Affected products</h2>
                <div class="flex flex-wrap gap-2">
                    {% comment %}An advisory can name a product this workspace does not track, and keeps naming it after one is deleted. Those have no id, and the url tag would happily build /product/None/ rather than fail, so they render as plain text.{% endcomment %}
                    {% if not advisory.products %}
                        <p class="text-sm text-text-muted m-0">
                            {% if advisory.advisory_type == 'workspace_notice' %}
                                A workspace notice names no products.
                            {% else %}
                                No products recorded yet. Publishing a product advisory requires at least one.
                            {% endif %}
                        </p>
                    {% endif %}
                    {% comment %}The affected releases sit under the chip rather than inside it: the chip never wraps, so a product carrying a dozen releases ran its list off the sidebar. The value list shows three and folds the rest, the same as the Trust Center's "Am I affected?" table.{% endcomment %}
                    {% for product in advisory.products %}
                        <div class="flex flex-col items-start gap-1.5{% if product.affected_ranges %} basis-full{% endif %}">
                            <c-chips.neutral>
                            <i class="fas fa-cube text-[10px] opacity-70" aria-hidden="true"></i>
                            {% if product.id %}
                                <a href="{% url 'core:product_details' product.id %}"
                                   class="transition-colors hover:opacity-80">{{ product.name }}</a>
                            {% else %}
                                {{ product.name }}
                            {% endif %}
                            </c-chips.neutral>
                            {% if product.affected_ranges %}
                                <c-tables.value-list mono class="pl-2 text-text-muted" title="Affected releases" :values="product.affected_ranges" />
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% comment %}Reads the advisory's stored references rather than rebuilding an NVD URL from the CVE: the model records the real url per reference, so GHSA, EUVD, OSV and vendor advisories all appear instead of only CVEs.{% endcomment %}
            {% if advisory.references %}
                <div class="space-y-3 border-t border-border/60 pt-6">
                    <h2 class="text-xs uppercase tracking-wide text-text-muted">References</h2>
                    {% for reference in advisory.references %}
                        {% if reference.url %}
                            <a href="{{ reference.url }}"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="flex items-center gap-2 text-sm text-primary hover:underline">
                                <i class="fas fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>
                                {{ reference.external_id|default:reference.summary|default:reference.url }}
                            </a>
                        {% else %}
                            <span class="flex items-center gap-2 text-sm text-text-muted">
                                <i class="fas fa-link text-xs" aria-hidden="true"></i>
                                {{ reference.external_id|default:reference.summary }}
                            </span>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </aside>
    </div>
    {% comment %}Publish Advisory Modal. Disclosure is irreversible in the sense that matters — the tracking id is allocated here and immutable, and made_public_at records when disclosure happened — so this asks rather than firing from the menu.{% endcomment %}
    {% if has_crud_permissions and advisory.publication_status == 'draft' %}
        <div class="contents"
             x-data="{ open: false }"
             @open-publish-advisory-modal.window="open = true">
            <c-modal id="publishAdvisoryModal" title="Publish advisory" icon="fas fa-bullhorn">
            <form id="publishAdvisoryForm"
                  method="post"
                  action="{% url 'core:security_advisory_detail' advisory.id %}">
                {% csrf_token %}
                <input type="hidden" name="intent" value="publish" />
                <div class="space-y-4">
                    {# Keep long advisory titles within the dialog. #}
                    <p class="text-sm text-text-muted m-0">
                        <strong class="text-text block break-words line-clamp-2"
                                title="{{ advisory.title }}">{{ advisory.title }}</strong>
                        becomes readable outside this workspace and is assigned a permanent
                        tracking id.
                    </p>
                    <fieldset class="pt-1">
                        <c-forms.label as="legend">Who can read it</c-forms.label>
                        <div class="rounded-lg border border-border divide-y divide-border overflow-hidden">
                            {% comment %}Each row is the label for the radio inside it, which is what names the control, so the row stays a label rather than becoming the library's div row.{% endcomment %}
                            {% for value, meta in publish_visibilities.items %}
                                <label class="tw-select-row">
                                    <input type="radio"
                                           name="visibility"
                                           value="{{ value }}"
                                           class="tw-radio mt-0.5"
                                           {% if forloop.first %}checked{% endif %} />
                                    <span class="min-w-0">
                                        <span class="block text-sm font-medium text-text">{{ meta.label }}</span>
                                        <span class="block text-xs text-text-muted">{{ meta.help }}</span>
                                    </span>
                                </label>
                            {% endfor %}
                        </div>
                    </fieldset>
                </div>
            </form>
            <c-slot name="footer">
            <p class="text-xs text-text-muted m-0 mr-auto">The tracking id and the disclosure date are recorded permanently.</p>
            <c-buttons.secondary @click="open = false">Cancel</c-buttons.secondary>
            <c-buttons.primary type="submit" form="publishAdvisoryForm">
            <i class="fas fa-bullhorn" aria-hidden="true"></i>
            Publish
            </c-buttons.primary>
            </c-slot>
            </c-modal>
        </div>
    {% endif %}
    {# Edit Advisory Modal (Alpine.js) #}
    {% if has_crud_permissions %}
        <div class="contents" x-data="{ open: false, showRef:
            {% if advisory.vulnerability_id %}
                true
            {% else %}
                false
            {% endif %}
            }" @open-edit-advisory-modal.window="open = true; showRef = {% if advisory.vulnerability_id %}true{% else %}false{% endif %}">
            <c-modal id="editAdvisoryModal" title="Edit advisory" icon="fas fa-pen">
            <form id="editAdvisoryForm"
                  method="post"
                  action="{% url 'core:security_advisory_detail' advisory.id %}">
                {% csrf_token %}
                <input type="hidden" name="intent" value="edit" />
                <div class="space-y-4">
                    <div>
                        <c-forms.label for="editTitle" required>Title</c-forms.label>
                        <c-forms.input id="editTitle" name="title" type="text" value="{{ advisory.title }}" required />
                    </div>
                    <div>
                        <c-forms.label for="editSeverity">Severity</c-forms.label>
                        {# An advisory may legitimately carry no severity, and without a blank option the select would silently promote it to the first one on any save. #}
                        <c-forms.select id="editSeverity" name="severity">
                        <option value="" {% if not advisory.severity %}selected{% endif %}>Not set</option>
                        <option value="critical"
                                {% if advisory.severity == 'critical' %}selected{% endif %}>Critical</option>
                        <option value="high" {% if advisory.severity == 'high' %}selected{% endif %}>High</option>
                        <option value="medium"
                                {% if advisory.severity == 'medium' %}selected{% endif %}>Medium</option>
                        <option value="low" {% if advisory.severity == 'low' %}selected{% endif %}>Low</option>
                        </c-forms.select>
                    </div>
                    <div class="grid grid-cols-[minmax(0,7rem)_minmax(0,1fr)] gap-3">
                        <div>
                            <c-forms.label for="editCvssScore">CVSS score</c-forms.label>
                            <c-forms.input id="editCvssScore" name="cvss_score" type="number" min="0" max="10" step="0.1" inputmode="decimal" placeholder="0 to 10" value="{{ advisory.cvss_score|default_if_none:'' }}" />
                        </div>
                        <div>
                            <c-forms.label for="editCvssVector">CVSS vector</c-forms.label>
                            <c-forms.input id="editCvssVector" name="cvss_vector" type="text" placeholder="CVSS:3.1/AV:N/…" value="{{ advisory.cvss_vector }}" />
                        </div>
                    </div>
                    {# CVE / reference is optional — hidden until the user chooses to add it. #}
                    <div>
                        <button type="button"
                                x-show="!showRef"
                                @click="showRef = true; $nextTick(() => $refs.editVulnId.focus())"
                                class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary-dark transition-colors">
                            <i class="fas fa-plus text-xs"></i>Link a CVE or reference
                        </button>
                        <div x-show="showRef" x-cloak class="space-y-1.5">
                            <div class="flex items-center justify-between">
                                <c-forms.label for="editVulnId" class="!mb-0">CVE or reference</c-forms.label>
                                <button type="button"
                                        @click="showRef = false; $refs.editVulnId.value = ''"
                                        class="text-xs text-text-muted hover:text-text transition-colors">
                                    Remove
                                </button>
                            </div>
                            <input type="hidden" name="type" value="cve" />
                            <c-forms.input id="editVulnId" name="vulnerability_id" type="text" placeholder="CVE-2026-0000" value="{{ advisory.vulnerability_id }}" x-ref="editVulnId" />
                        </div>
                    </div>
                    <div>
                        <c-forms.label for="editSummary">Summary</c-forms.label>
                        <c-forms.textarea id="editSummary" name="summary" rows="2" value="{{ advisory.summary }}" placeholder="One paragraph your Trust Center leads with." />
                    </div>
                    <div>
                        <c-forms.label for="editDescription">Description</c-forms.label>
                        <c-forms.textarea id="editDescription" name="description" rows="3" value="{{ advisory.description }}" placeholder="Describe the vulnerability..." />
                    </div>
                </div>
            </form>
            <c-slot name="footer">
            <c-buttons.ghost @click="open = false">Cancel</c-buttons.ghost>
            <c-buttons.primary type="submit" form="editAdvisoryForm">
            <i class="fas fa-check mr-2"></i>Save changes
            </c-buttons.primary>
            </c-slot>
            </c-modal>
        </div>
        {% comment %}Add a product the advisory missed, or more of its affected releases. The chosen product's releases arrive over HTMX, so the page does not carry every release in the workspace. A product already on the advisory only gains releases here: its status belongs to its row, so the status choice is switched off for it. Not teleported, because HTMX wires the select when the page loads and a teleported copy would not be.{% endcomment %}
        {% if can_edit_statuses and advisory.advisory_type != 'workspace_notice' %}
            <div class="contents"
                 x-data="{ open: false, productId: '', listed: [], init() { this.listed = window.parseJsonScript('advisory-listed-products') || []; }, get isListed() { return this.listed.includes(this.productId); } }"
                 @open-add-advisory-product-modal.window="open = true">
                {{ advisory_product_ids|json_script:"advisory-listed-products" }}
                <c-modal id="addAdvisoryProductModal" title="Add product" icon="fas fa-cube" teleport="false">
                <form id="addAdvisoryProductForm"
                      method="post"
                      action="{% url 'core:security_advisory_detail' advisory.id %}">
                    {% csrf_token %}
                    <input type="hidden" name="intent" value="add_product" />
                    <div class="space-y-4">
                        <c-forms.field label="Product" for="addProduct" required>
                        <c-forms.select id="addProduct" name="product" x-model="productId" required hx-get="{% url 'core:security_advisory_product_releases' advisory.id %}" hx-trigger="change" hx-target="#addProductReleases" hx-swap="innerHTML">
                        <option value="">Choose a product</option>
                        {% for product in product_choices %}<option value="{{ product.id }}">{{ product.name }}</option>{% endfor %}
                        </c-forms.select>
                        </c-forms.field>
                        <div id="addProductReleases"></div>
                        <div x-show="!isListed">
                            <c-forms.field label="Status" for="addProductStatus" hint="A resolved advisory needs a status that is not open.">
                            <c-forms.select id="addProductStatus" name="status" :options="product_status_options" selected="in_triage" ::disabled="isListed" />
                            </c-forms.field>
                        </div>
                        <c-forms.hint x-show="isListed">Already on this advisory. This adds the releases you tick. Change its status from its row.</c-forms.hint>
                    </div>
                </form>
                <c-slot name="footer">
                <c-buttons.ghost @click="open = false">Cancel</c-buttons.ghost>
                <c-buttons.primary type="submit" form="addAdvisoryProductForm">
                <i class="fas fa-plus mr-2"></i>Add product
                </c-buttons.primary>
                </c-slot>
                </c-modal>
            </div>
        {% endif %}
        {# Link a VEX Modal (Alpine.js) — front-end preview, does not persist yet (#1172) #}
        <div class="contents"
             x-data="{ open: false, sel: [], search: '', candidates: [], init() { this.candidates = window.parseJsonScript('vex-candidates') || []; if (window.location.hash === '#link-vex') this.open = true; }, get filtered() { if (!this.search) return this.candidates; const s = this.search.toLowerCase(); return this.candidates.filter(v => (v.product + ' ' + v.coverage + ' ' + v.format).toLowerCase().includes(s)); } }"
             @open-link-vex-modal.window="open = true; sel = []; search = ''">
            {{ vex_candidates|json_script:"vex-candidates" }}
            <c-modal id="linkVexModal" title="Link a VEX" icon="fas fa-file-shield">
            <form id="linkVexForm"
                  method="post"
                  action="{% url 'core:security_advisory_detail' advisory.id %}">
                {% csrf_token %}
                <input type="hidden" name="intent" value="link_vex" />
                <div class="space-y-4">
                    <p class="text-sm text-text-muted">
                        Associate an existing VEX with this advisory. VEX statements are maintained per component. Linking references the live statement, not a copy.
                    </p>
                    {% if vex_candidates %}
                        <div class="relative">
                            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-text-muted text-xs"
                               aria-hidden="true"></i>
                            <label for="vexSearch" class="sr-only">Search VEX documents</label>
                            <c-forms.input id="vexSearch" type="search" placeholder="Search VEX documents…" x-model="search" />
                        </div>
                        <div class="space-y-2">
                            <div class="rounded-lg border border-border divide-y divide-border overflow-hidden"
                                 x-show="filtered.length > 0">
                                {% comment %}Each row is the label for the checkbox inside it, which is what names the control, so the row stays a label rather than becoming the library's div row.{% endcomment %}
                                <template x-for="v in filtered" :key="v.id">
                                    <label class="tw-select-row">
                                        <input type="checkbox"
                                               name="vex_ids"
                                               :value="v.id"
                                               x-model="sel"
                                               class="tw-checkbox mt-0.5" />
                                        <span class="min-w-0">
                                            <span class="block text-sm font-medium text-text"
                                                  x-text="v.product + ': maintained VEX'"></span>
                                            <span class="block text-xs text-text-muted mt-0.5"
                                                  x-text="v.format + ' · covers ' + v.coverage + ' · updated ' + v.updated"></span>
                                        </span>
                                    </label>
                                </template>
                            </div>
                            <template x-if="filtered.length === 0">
                                <div class="rounded-lg border border-border bg-surface p-4 text-sm text-text-muted text-center">
                                    No VEX matches your search.
                                </div>
                            </template>
                        </div>
                    {% else %}
                        <div class="rounded-lg border border-border bg-surface p-4 text-sm text-text-muted text-center">
                            No VEX found for this advisory's products yet.
                        </div>
                    {% endif %}
                </div>
            </form>
            <c-slot name="footer">
            <c-buttons.ghost @click="open = false">Cancel</c-buttons.ghost>
            <c-buttons.primary type="submit" form="linkVexForm" ::disabled="sel.length === 0" ::class="sel.length === 0 ? 'opacity-50 cursor-not-allowed' : ''">
            <i class="fas fa-file-shield mr-2"></i>
            <span x-text="sel.length > 1 ? ('Link ' + $number(sel.length) + ' VEX documents') : 'Link VEX'"></span>
            </c-buttons.primary>
            </c-slot>
            </c-modal>
        </div>
    {% endif %}
    {% if has_crud_permissions %}
        {% include 'core/components/advisory_delete_modal.html.j2' %}
    {% endif %}
    </c-layout.frame>
{% endblock %}
{% block scripts %}{% endblock %}
