{% extends "core/base.html.j2" %}
{% load widget_tweaks %}
{% block title %}Contact Support - sbomify{% endblock %}
{% block head %}
    {{ block.super }}
    {% if turnstile_site_key and not debug %}
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js"
                async
                defer></script>
    {% endif %}
{% endblock %}
{% block content %}
    <main id="main-content" class="max-w-4xl mx-auto px-4 py-8">
        <c-layout.frame>
        <c-layout.page-header title="Contact support" subtitle="Tell us what you need help with. We usually respond within 1-2 business days." />
        {% include 'core/components/messages.html.j2' %}
        <c-cards.card>
        <form method="post" novalidate>
            {% csrf_token %}
            <c-layout.form-section title="Contact information" icon="fas fa-user">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <c-forms.field label="{{ form.first_name.label }}" for="{{ form.first_name.id_for_label }}" required error="{{ form.first_name.errors.0 }}">
                <c-forms.input id="{{ form.first_name.id_for_label }}" name="{{ form.first_name.html_name }}" value="{{ form.first_name.value|default:'' }}" placeholder="Your first name" maxlength="100" required />
                </c-forms.field>
                <c-forms.field label="{{ form.last_name.label }}" for="{{ form.last_name.id_for_label }}" required error="{{ form.last_name.errors.0 }}">
                <c-forms.input id="{{ form.last_name.id_for_label }}" name="{{ form.last_name.html_name }}" value="{{ form.last_name.value|default:'' }}" placeholder="Your last name" maxlength="100" required />
                </c-forms.field>
                <c-forms.field class="md:col-span-2" label="{{ form.email.label }}" for="{{ form.email.id_for_label }}" required error="{{ form.email.errors.0 }}" hint="We'll use this email to respond to your support request.">
                <c-forms.input type="email" id="{{ form.email.id_for_label }}" name="{{ form.email.html_name }}" value="{{ form.email.value|default:'' }}" placeholder="your.email@example.com" required />
                </c-forms.field>
            </div>
            </c-layout.form-section>
            <c-layout.form-section title="Support request" icon="fas fa-headset">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <c-forms.field label="{{ form.support_type.label }}" for="{{ form.support_type.id_for_label }}" required error="{{ form.support_type.errors.0 }}">
                <c-forms.select id="{{ form.support_type.id_for_label }}" name="{{ form.support_type.html_name }}" required>
                {% for value, label in form.support_type.field.choices %}
                    <option value="{{ value }}"
                            {% if form.support_type.value|stringformat:'s' == value %}selected{% endif %}>
                        {{ label }}
                    </option>
                {% endfor %}
                </c-forms.select>
                </c-forms.field>
                <c-forms.field label="{{ form.browser_info.label }}" for="{{ form.browser_info.id_for_label }}" error="{{ form.browser_info.errors.0 }}" hint="{{ form.browser_info.help_text }}">
                <c-forms.input id="{{ form.browser_info.id_for_label }}" name="{{ form.browser_info.html_name }}" value="{{ form.browser_info.value|default:'' }}" placeholder="e.g., Chrome, Safari" maxlength="500" />
                </c-forms.field>
                <c-forms.field class="md:col-span-2" label="{{ form.subject.label }}" for="{{ form.subject.id_for_label }}" required error="{{ form.subject.errors.0 }}">
                <c-forms.input id="{{ form.subject.id_for_label }}" name="{{ form.subject.html_name }}" value="{{ form.subject.value|default:'' }}" placeholder="Brief description of your issue" maxlength="200" required />
                </c-forms.field>
            </div>
            </c-layout.form-section>
            <c-layout.form-section title="Describe your issue" icon="fas fa-comment-alt">
            <c-forms.field label="{{ form.message.label }}" for="{{ form.message.id_for_label }}" required error="{{ form.message.errors.0 }}" hint="Include any details that will help us understand the issue.">
            <c-forms.textarea id="{{ form.message.id_for_label }}" name="{{ form.message.html_name }}" rows="6" value="{{ form.message.value|default:'' }}" placeholder="Describe your issue or question" required />
            </c-forms.field>
            </c-layout.form-section>
            {% if turnstile_site_key and not debug %}
                <c-layout.form-section title="Security verification" icon="fas fa-shield-alt">
                <div class="cf-turnstile"
                     data-sitekey="{{ turnstile_site_key }}"
                     data-callback="turnstileCallback"
                     data-error-callback="turnstileErrorCallback"></div>
                {% render_field form.cf_turnstile_response %}
                {% if form.cf_turnstile_response.errors %}
                    <c-forms.error>{{ form.cf_turnstile_response.errors.0 }}</c-forms.error>
                {% endif %}
                </c-layout.form-section>
            {% else %}
                {% render_field form.cf_turnstile_response %}
            {% endif %}
            <div class="flex flex-col gap-5">
                <c-feedback.alert>You'll receive a confirmation email once we receive your request.</c-feedback.alert>
                <div class="flex flex-wrap justify-between gap-3">
                    <c-buttons.secondary href="{% url 'core:dashboard' %}">Back to dashboard</c-buttons.secondary>
                    <c-buttons.primary type="submit">Send support request</c-buttons.primary>
                </div>
            </div>
        </form>
        </c-cards.card>
        </c-layout.frame>
    </main>
{% endblock %}
{% block scripts %}
    {% if turnstile_site_key and not debug %}
        <script>
            function turnstileCallback(token) {
                document.getElementById('id_cf_turnstile_response').value = token;
            }
            function turnstileErrorCallback() {
                document.getElementById('id_cf_turnstile_response').value = '';
                console.error('Turnstile error occurred');
            }
        </script>
    {% endif %}
{% endblock %}
