{% extends "core/base.html.j2" %}
{% block title %}Support Request Sent - sbomify{% endblock %}
{% block content %}
    <main id="main-content" class="max-w-4xl mx-auto px-4 py-8">
        <c-layout.frame>
        <c-layout.page-header title="Support request sent" subtitle="Thank you for getting in touch." />
        <c-cards.card>
        <div class="flex flex-col gap-5">
            <c-feedback.alert variant="success">Your support request has been sent successfully.</c-feedback.alert>
            <c-layout.section-header level="2" title="What happens next?" />
            <c-typography.description>You'll receive a confirmation email shortly. Our support team will review your request and usually respond within 1-2 business days.</c-typography.description>
            <div class="flex flex-wrap gap-3">
                <c-buttons.primary href="{% url 'core:dashboard' %}">Back to dashboard</c-buttons.primary>
                <c-buttons.secondary href="{% url 'core:support_contact' %}">Submit another request</c-buttons.secondary>
            </div>
        </div>
        </c-cards.card>
        </c-layout.frame>
    </main>
{% endblock %}
