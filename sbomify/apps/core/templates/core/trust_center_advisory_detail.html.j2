{% extends "core/public_base.htmx.j2" %}
{% load static %}
{% load django_vite %}
{% load public_url_tags %}
{% block title %}{{ advisory.id }} · {{ workspace.name }}{% endblock %}
{% block meta_description %}{{ advisory.summary|default:advisory.title }}{% endblock %}
{% block og_title %}{{ advisory.id }}: {{ advisory.title }}{% endblock %}
{% comment %}
A gated advisory must not end up in a search index: it is readable only
because *this* reader was let in, and a crawler is nobody's NDA holder.
{% endcomment %}
{% block meta_robots %}
    {% if advisory.is_gated %}
        noindex, nofollow
    {% else %}
        index, follow
    {% endif %}
{% endblock %}
{% block page_header %}
    {% comment %}
    The same masthead the trust-center home uses, so an advisory reads as a page
    of this site rather than as a card dropped onto it. Identity first (the id a
    reader quotes), then the title, then the one-line summary, then the facts
    they check before reading further.
    {% endcomment %}
    <header class="tc-masthead">
        <div class="tc-masthead-inner tc-masthead-detail">
            <a class="tc-backlink"
               href="{% public_url 'core:workspace_advisories_public' workspace_key=workspace.key %}">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                Security advisories
            </a>
            <div class="tc-detail-eyebrow">
                <span class="tc-detail-id">{{ advisory.id }}</span>
                {% if advisory.is_gated %}
                    <span class="tc-lock-chip">
                        <i class="fas fa-lock" aria-hidden="true"></i>Restricted
                    </span>
                {% endif %}
                {% if advisory.is_withdrawn %}<span class="tw-badge tw-badge-warning">Withdrawn</span>{% endif %}
            </div>
            <h1 class="tc-detail-title">{{ advisory.title }}</h1>
            {% if advisory.summary %}<p class="tc-detail-summary">{{ advisory.summary }}</p>{% endif %}
            <div class="tc-detail-meta">
                <c-badges.severity level="{{ advisory.severity }}">{{ advisory.severity_label }}</c-badges.severity>
                {% if advisory.status_label %}
                    <span class="tc-detail-meta-item">
                        <i class="{{ advisory.status_icon }}" aria-hidden="true"></i>{{ advisory.status_label }}
                    </span>
                {% endif %}
                {% if advisory.cve_ids %}
                    <span class="tc-detail-meta-item tc-detail-meta-mono">{{ advisory.cve_ids|join:", " }}</span>
                {% endif %}
                <span class="tc-detail-meta-item">
                    <i class="fas fa-bullhorn" aria-hidden="true"></i>Published {{ advisory.published_display|default:"—" }}
                </span>
                <span class="tc-detail-meta-item">
                    <i class="fas fa-clock-rotate-left" aria-hidden="true"></i>Updated {{ advisory.updated_age }}
                </span>
            </div>
        </div>
    </header>
{% endblock %}
{% block content %}
    {% if advisory.is_withdrawn %}
        <div class="tw-alert tw-alert-warning mb-5">
            <i class="fas fa-rotate-left tw-alert-icon" aria-hidden="true"></i>
            <div class="tw-alert-content">
                <p class="text-sm m-0">
                    <strong>This advisory has been withdrawn.</strong>
                    {% if advisory.withdrawal_reason %}{{ advisory.withdrawal_reason }}{% endif %}
                </p>
            </div>
        </div>
    {% endif %}
    <div class="tc-detail-grid">
        {# ---- Main column --------------------------------------------------- #}
        <div class="min-w-0">
            {% if advisory.description %}
                <div class="tc-panel">
                    <h2 class="tc-panel-title">Description</h2>
                    <div class="tc-prose">{{ advisory.description }}</div>
                </div>
            {% endif %}
            {% if advisory.statuses %}
                <div class="tc-panel">
                    <h2 class="tc-panel-title">Am I affected?</h2>
                    <div class="tc-table-wrap">
                        <table class="tc-table">
                            <thead>
                                <tr>
                                    <th scope="col">Product</th>
                                    <th scope="col">Vulnerability</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Affected versions</th>
                                    <th scope="col">What to do</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in advisory.statuses %}
                                    <tr>
                                        <td class="font-medium">{{ row.product }}</td>
                                        <td class="font-mono text-xs">{{ row.vulnerability }}</td>
                                        <td>
                                            <span class="tw-badge tw-badge-{{ row.status_variant }}">{{ row.status_label }}</span>
                                            {% if row.justification %}<div class="text-xs mt-1 opacity-75">{{ row.justification }}</div>{% endif %}
                                        </td>
                                        <td class="font-mono text-xs">
                                            {% for range in row.version_ranges %}
                                                {{ range }}
                                                {% if not forloop.last %}<br>{% endif %}
                                            {% empty %}
                                                —
                                            {% endfor %}
                                        </td>
                                        <td>
                                            {% if row.recommended_version %}Upgrade to <span class="font-mono">{{ row.recommended_version }}</span>.{% endif %}
                                            {{ row.action_statement|default:row.impact_statement }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}
            {% for vulnerability in advisory.vulnerabilities %}
                <div class="tc-panel">
                    <h2 class="tc-panel-title">{{ vulnerability.cve_id|default:vulnerability.title }}</h2>
                    <div class="flex items-center gap-2 flex-wrap mb-3">
                        {% if vulnerability.severity %}
                            <c-badges.severity level="{{ vulnerability.severity }}">{{ vulnerability.severity }}</c-badges.severity>
                        {% endif %}
                        {% for cwe in vulnerability.cwe_ids %}<span class="tc-product-chip">{{ cwe }}</span>{% endfor %}
                        {% for score in vulnerability.cvss_scores %}
                            <span class="tc-meta-item">CVSS {{ score.version }}: {{ score.base_score }}</span>
                        {% endfor %}
                    </div>
                    {% if vulnerability.description %}<div class="tc-prose">{{ vulnerability.description }}</div>{% endif %}
                    {% if vulnerability.recommendation %}
                        <p class="tc-fact-label mt-4">Recommendation</p>
                        <div class="tc-prose">{{ vulnerability.recommendation }}</div>
                    {% endif %}
                </div>
            {% endfor %}
            {% if advisory.timeline %}
                <div class="tc-panel">
                    <div class="tc-timeline-header">
                        <h2 class="tc-panel-title tc-panel-title-flush">Timeline</h2>
                        <span class="tc-timeline-freshness">
                            <i class="fas fa-clock-rotate-left" aria-hidden="true"></i>
                            Last updated {{ advisory.updated_age }}
                        </span>
                    </div>
                    <ol class="tc-timeline">
                        {% for entry in advisory.timeline %}
                            <li class="tc-timeline-item {% if forloop.first %}is-latest{% endif %}">
                                <div class="tc-timeline-rail">
                                    <span class="tc-timeline-dot tc-dot-{{ entry.variant }}">
                                        <i class="{{ entry.icon }}" aria-hidden="true"></i>
                                    </span>
                                    {% if not forloop.last %}<span class="tc-timeline-line"></span>{% endif %}
                                </div>
                                <div class="tc-timeline-body">
                                    <div class="tc-timeline-head">
                                        <span class="tc-timeline-label">{{ entry.label }}</span>
                                        <time class="tc-timeline-when"
                                              datetime="{{ entry.created_at|date:'c' }}"
                                              title="{{ entry.created_at|date:'j F Y, H:i e' }}">
                                            {{ entry.date_display }}
                                            <span class="tc-timeline-clock">{{ entry.time_display }}</span>
                                        </time>
                                    </div>
                                    <p class="tc-timeline-age">
                                        {{ entry.age }}
                                        {% comment %}
                                        The gap to the next older entry. The oldest
                                        has nothing to measure against, so it says
                                        so rather than showing a blank.
                                        {% endcomment %}
                                        {% if entry.gap %}
                                            <span class="tc-timeline-gap">
                                                <i class="fas fa-arrow-turn-up" aria-hidden="true"></i>{{ entry.gap }}
                                            </span>
                                        {% else %}
                                            <span class="tc-timeline-gap">first entry</span>
                                        {% endif %}
                                    </p>
                                    {% if entry.note %}<p class="tc-timeline-note">{{ entry.note }}</p>{% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ol>
                </div>
            {% endif %}
        </div>
        {# ---- Sidebar ------------------------------------------------------- #}
        <aside>
            <div class="tc-panel">
                <h2 class="tc-panel-title">Details</h2>
                <div class="tc-facts">
                    <div>
                        <p class="tc-fact-label">Advisory ID</p>
                        <p class="tc-fact-value font-mono">{{ advisory.id }}</p>
                    </div>
                    <div>
                        <p class="tc-fact-label">Published</p>
                        <p class="tc-fact-value">{{ advisory.published_display|default:"—" }}</p>
                    </div>
                    <div>
                        <p class="tc-fact-label">Last updated</p>
                        <p class="tc-fact-value">{{ advisory.updated_display|default:"—" }}</p>
                    </div>
                    {% if advisory.cve_ids %}
                        <div>
                            <p class="tc-fact-label">Identifiers</p>
                            <p class="tc-fact-value font-mono">{{ advisory.cve_ids|join:", " }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>
            {% if advisory.products or advisory.withheld_product_count %}
                <div class="tc-panel">
                    <h2 class="tc-panel-title">Affected products</h2>
                    <div class="flex flex-col gap-2">
                        {% for product in advisory.products %}
                            {% if product.id %}
                                <a class="text-sm"
                                   href="{% public_url 'core:product_details_public' product_id=product.id product_slug=product.slug %}">
                                    {{ product.name }} <i class="fas fa-arrow-right text-xs ml-1" aria-hidden="true"></i>
                                </a>
                            {% else %}
                                <span class="text-sm">{{ product.name }}</span>
                            {% endif %}
                        {% endfor %}
                        {% if advisory.withheld_product_count %}
                            <span class="tc-fact-value opacity-70 text-xs">
                                {{ advisory.withheld_product_count }} further product{{ advisory.withheld_product_count|pluralize }}
                                {{ advisory.withheld_product_count|pluralize:"is,are" }} not shown — you do not have access to
                                {{ advisory.withheld_product_count|pluralize:"it,them" }}.
                            </span>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
            {% if advisory.references %}
                <div class="tc-panel">
                    <h2 class="tc-panel-title">References</h2>
                    <div class="flex flex-col gap-2">
                        {% for reference in advisory.references %}
                            {% if reference.url %}
                                <a class="text-sm break-words"
                                   href="{{ reference.url }}"
                                   target="_blank"
                                   rel="noopener noreferrer nofollow">
                                    {{ reference.external_id|default:reference.summary|default:reference.url }}
                                    <i class="fas fa-arrow-up-right-from-square text-xs ml-1"
                                       aria-hidden="true"></i>
                                </a>
                            {% else %}
                                <span class="text-sm font-mono">{{ reference.external_id }}</span>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
            {% if advisory.acknowledgments %}
                <div class="tc-panel">
                    <h2 class="tc-panel-title">Acknowledgments</h2>
                    <div class="flex flex-col gap-2">
                        {% for ack in advisory.acknowledgments %}
                            <div>
                                <p class="tc-fact-value">{{ ack.name|default:ack.organization }}</p>
                                {% if ack.summary %}<p class="text-xs opacity-70 m-0">{{ ack.summary }}</p>{% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </aside>
    </div>
{% endblock %}
{% block scripts %}
    {% vite_asset 'sbomify/apps/core/js/main.ts' %}
{% endblock %}
