{% extends "core/public_base.htmx.j2" %}
{% load humanize %}
{% load static %}
{% load django_vite %}
{% load public_url_tags %}
{% load markdown_tags %}
{% block title %}{{ advisory.id }} · {{ workspace.name }}{% endblock %}
{% block meta_description %}{{ advisory.summary|default:advisory.title }}{% endblock %}
{% block og_title %}{{ advisory.id }}: {{ advisory.title }}{% endblock %}
{% comment %}
A gated advisory must not end up in a search index: it is readable only
because *this* reader was let in, and a crawler is nobody's NDA holder.
{% endcomment %}
{% block meta_robots %}
    {% if advisory.is_gated %}
        noindex, nofollow
    {% else %}
        index, follow
    {% endif %}
{% endblock %}
{% block page_header %}
    {% comment %}
    The same masthead every trust center page uses, so an advisory reads as a
    page of this site rather than as a card dropped onto it. Identity first
    (the id a reader quotes), then the title, then the one-line summary, then
    the facts they check before reading further.
    {% endcomment %}
    <c-branded.masthead>
    <c-branded.back-link href="{% public_url 'core:workspace_advisories_public' workspace_key=workspace.key %}">Security advisories</c-branded.back-link>
    <c-branded.page-header title="{{ advisory.title }}" lede="{{ advisory.summary }}">
    <c-slot name="eyebrow">
    <span class="font-mono text-text-muted">{{ advisory.id }}</span>
    {% if advisory.is_gated %}
        <c-branded.badge brand title="Visible to you because you have access to the affected products">
        <i class="fas fa-lock" aria-hidden="true"></i>Restricted
        </c-branded.badge>
    {% endif %}
    {% if advisory.is_withdrawn %}<c-branded.badge tone="medium">Withdrawn</c-branded.badge>{% endif %}
    </c-slot>
    <div class="flex items-center gap-x-5 gap-y-2 [flex-wrap:wrap]">
        <c-branded.badge tone="{{ advisory.severity|default:'none' }}">{{ advisory.severity_label }}</c-branded.badge>
        {% if advisory.status == 'resolved' %}
            <c-branded.badge tone="success">
            <i class="{{ advisory.status_icon }}" aria-hidden="true"></i>{{ advisory.status_label }}
            </c-branded.badge>
        {% elif advisory.status_label %}
            <c-branded.meta-item icon="{{ advisory.status_icon }}">{{ advisory.status_label }}</c-branded.meta-item>
        {% endif %}
        {% if advisory.cve_ids %}<c-branded.meta-item mono>{{ advisory.cve_ids|join:", " }}</c-branded.meta-item>{% endif %}
        <c-branded.meta-item icon="fas fa-bullhorn">Published {{ advisory.published_display|default:"—" }}</c-branded.meta-item>
        <c-branded.meta-item icon="fas fa-clock-rotate-left">Updated {{ advisory.updated_age }}</c-branded.meta-item>
    </div>
    </c-branded.page-header>
    </c-branded.masthead>
{% endblock %}
{% block content %}
    <div class="flex flex-col gap-8">
        {% if advisory.is_withdrawn %}
            <c-feedback.alert variant="warning" icon="fas fa-rotate-left">
            <strong>This advisory has been withdrawn.</strong>
            {% if advisory.withdrawal_reason %}{{ advisory.withdrawal_reason }}{% endif %}
            </c-feedback.alert>
        {% endif %}
        <div class="grid items-start gap-8 min-[900px]:grid-cols-[minmax(0,1fr)_20rem]">
            {# ---- Main column --------------------------------------------------- #}
            <div class="min-w-0 flex flex-col gap-10">
                {% if advisory.description %}
                    <section class="flex flex-col gap-4">
                        <c-branded.section-header title="Description" />
                        <c-branded.surface>
                        <div class="text-sm leading-7 text-text-secondary [white-space:pre-line]">{{ advisory.description }}</div>
                        </c-branded.surface>
                    </section>
                {% endif %}
                {% if advisory.statuses %}
                    <section class="flex flex-col gap-4">
                        <c-branded.section-header title="Am I affected?" subtitle="Each affected product, its status, and what to do about it." />
                        <c-branded.surface flush>
                        <c-tables.table variant_class="min-w-[34rem]" aria-label="Affected products">
                        <c-tables.head>
                        <c-tables.header-cell scope="col">Product</c-tables.header-cell>
                        <c-tables.header-cell scope="col">Vulnerability</c-tables.header-cell>
                        <c-tables.header-cell scope="col">Status</c-tables.header-cell>
                        <c-tables.header-cell scope="col">Affected versions</c-tables.header-cell>
                        <c-tables.header-cell scope="col">What to do</c-tables.header-cell>
                        </c-tables.head>
                        <tbody>
                            {% for row in advisory.statuses %}
                                <c-tables.row class="align-top">
                                <c-tables.cell class="font-medium">{{ row.product }}</c-tables.cell>
                                <c-tables.cell class="font-mono text-xs whitespace-nowrap">{{ row.vulnerability }}</c-tables.cell>
                                <c-tables.cell>
                                <c-badges.dynamic variant="{{ row.status_variant }}">{{ row.status_label }}</c-badges.dynamic>
                                {% if row.justification %}<div class="text-xs text-text-muted mt-1">{{ row.justification }}</div>{% endif %}
                                </c-tables.cell>
                                {% if row.version_labels %}
                                    <c-tables.cell>
                                    <c-lists.folding :items="row.version_labels" label="Affected versions of {{ row.product }} for {{ row.vulnerability }}" class="min-w-[9rem]" />
                                    </c-tables.cell>
                                {% else %}
                                    <c-tables.cell class="font-mono text-xs whitespace-nowrap">—</c-tables.cell>
                                {% endif %}
                                <c-tables.cell muted>
                                {% if row.recommended_version %}
                                    Upgrade to <span class="font-mono text-text">{{ row.recommended_version }}</span>.
                                {% endif %}
                                {{ row.action_statement|default:row.impact_statement }}
                                </c-tables.cell>
                                </c-tables.row>
                            {% endfor %}
                        </tbody>
                        </c-tables.table>
                        </c-branded.surface>
                    </section>
                {% endif %}
                {% for vulnerability in advisory.vulnerabilities %}
                    <section class="flex flex-col gap-4">
                        <c-branded.section-header title="{{ vulnerability.cve_id|default:vulnerability.title }}" />
                        <c-branded.surface class="flex flex-col gap-4">
                        <div class="flex items-center gap-2 [flex-wrap:wrap]">
                            {% if vulnerability.severity %}
                                <c-branded.badge tone="{{ vulnerability.severity|lower }}">{{ vulnerability.severity }}</c-branded.badge>
                            {% endif %}
                            {% for cwe in vulnerability.cwe_ids %}<c-branded.badge>{{ cwe }}</c-branded.badge>{% endfor %}
                            {% for score in vulnerability.cvss_scores %}
                                <c-branded.meta-item>{{ score.label }}: {{ score.base_score }}</c-branded.meta-item>
                            {% endfor %}
                        </div>
                        {% if vulnerability.description %}
                            <div class="text-sm leading-7 text-text-secondary [white-space:pre-line]">{{ vulnerability.description }}</div>
                        {% endif %}
                        {% if vulnerability.recommendation %}
                            <div class="flex flex-col gap-1.5">
                                <p class="text-sm font-semibold text-text my-0">Recommendation</p>
                                <div class="text-sm leading-7 text-text-secondary [white-space:pre-line]">{{ vulnerability.recommendation }}</div>
                            </div>
                        {% endif %}
                        </c-branded.surface>
                    </section>
                {% endfor %}
                {% if advisory.timeline %}
                    <section class="flex flex-col gap-4">
                        <c-branded.section-header title="Timeline" subtitle="Last updated {{ advisory.updated_age }}" />
                        <c-branded.surface>
                        <c-branded.timeline>
                        {% for entry in advisory.timeline %}
                            <c-branded.timeline-item icon="{{ entry.icon }}" tone="{{ entry.variant }}">
                            <c-slot name="heading">{{ entry.label }}</c-slot>
                            <c-slot name="when">
                            <time datetime="{{ entry.created_at|date:'c' }}"
                                  title="{{ entry.created_at|date:'j F Y, H:i e' }}">
                                {{ entry.date_display }} · {{ entry.time_display }}
                            </time>
                            </c-slot>
                            <c-slot name="meta">
                            <span>{{ entry.age }}</span>
                            {% comment %}
                                The gap to the next older entry. The oldest has
                                nothing to measure against, so it says so rather
                                than showing a blank.
                            {% endcomment %}
                            {% if entry.gap %}
                                <span><i class="fas fa-arrow-turn-up" aria-hidden="true"></i> {{ entry.gap }}</span>
                            {% else %}
                                <span>first entry</span>
                            {% endif %}
                            </c-slot>
                            {% if entry.note %}<c-branded.markdown>{{ entry.note|strict_markdown }}</c-branded.markdown>{% endif %}
                            </c-branded.timeline-item>
                        {% endfor %}
                        </c-branded.timeline>
                        </c-branded.surface>
                    </section>
                {% endif %}
            </div>
            {# ---- Sidebar ------------------------------------------------------- #}
            <aside class="flex flex-col gap-4">
                <c-branded.panel title="Details">
                <c-branded.facts>
                <c-branded.fact label="Advisory ID">
                <span class="font-mono text-xs">{{ advisory.id }}</span>
                </c-branded.fact>
                <c-branded.fact label="Severity">
                <c-branded.badge tone="{{ advisory.severity|default:'none' }}">{{ advisory.severity_label }}</c-branded.badge>
                </c-branded.fact>
                {% if advisory.cvss_score %}<c-branded.fact label="CVSS">{{ advisory.cvss_score }}</c-branded.fact>{% endif %}
                <c-branded.fact label="Published">{{ advisory.published_display|default:"—" }}</c-branded.fact>
                <c-branded.fact label="Last updated">{{ advisory.updated_display|default:"—" }}</c-branded.fact>
                {% if advisory.cve_ids %}
                    <c-branded.fact label="Identifiers">
                    <span class="font-mono text-xs">{{ advisory.cve_ids|join:", " }}</span>
                    </c-branded.fact>
                {% endif %}
                </c-branded.facts>
                </c-branded.panel>
                {% if advisory.products or advisory.withheld_product_count %}
                    <c-branded.panel title="Affected products">
                    <div class="flex items-center gap-2 [flex-wrap:wrap]">
                        {% for product in advisory.products %}
                            {% if product.id %}
                                <a class="inline-flex no-underline"
                                   data-button
                                   href="{% public_url 'core:product_details_public' product_id=product.id product_slug=product.slug %}">
                                    <c-branded.badge class="hover:border-text-muted">
                                    <i class="fas fa-cube" aria-hidden="true"></i>{{ product.name }}
                                    </c-branded.badge>
                                </a>
                            {% else %}
                                <c-branded.badge>{{ product.name }}</c-branded.badge>
                            {% endif %}
                        {% endfor %}
                    </div>
                    {% if advisory.withheld_product_count %}
                        <p class="text-xs text-text-muted my-0">
                            {{ advisory.withheld_product_count|intcomma }} further product{{ advisory.withheld_product_count|pluralize }}
                            {{ advisory.withheld_product_count|pluralize:"is,are" }} not shown — you do not have access to
                            {{ advisory.withheld_product_count|pluralize:"it,them" }}.
                        </p>
                    {% endif %}
                    </c-branded.panel>
                {% endif %}
                {% if advisory.references %}
                    <c-branded.panel title="References">
                    <ul class="flex flex-col gap-2 list-none my-0 pl-0">
                        {% for reference in advisory.references %}
                            <li class="text-sm">
                                {% if reference.url %}
                                    <a class="inline-flex items-baseline gap-1.5 font-medium text-text no-underline hover:underline underline-offset-4 [overflow-wrap:anywhere]"
                                       data-button
                                       href="{{ reference.url }}"
                                       target="_blank"
                                       rel="noopener noreferrer nofollow">
                                        {{ reference.external_id|default:reference.summary|default:reference.url }}
                                        <i class="fas fa-arrow-up-right-from-square text-xs text-text-muted"
                                           aria-hidden="true"></i>
                                    </a>
                                {% else %}
                                    <span class="font-mono text-xs text-text">{{ reference.external_id }}</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    </c-branded.panel>
                {% endif %}
                {% if advisory.acknowledgments %}
                    <c-branded.panel title="Acknowledgments">
                    <ul class="flex flex-col gap-2.5 list-none my-0 pl-0">
                        {% for ack in advisory.acknowledgments %}
                            <li class="flex flex-col gap-0.5">
                                <span class="text-sm text-text">{{ ack.name|default:ack.organization }}</span>
                                {% if ack.summary %}<span class="text-xs text-text-muted">{{ ack.summary }}</span>{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    </c-branded.panel>
                {% endif %}
            </aside>
        </div>
    </div>
{% endblock %}
{% block scripts %}
    {% vite_asset 'sbomify/apps/core/js/main.ts' %}
{% endblock %}
