{% extends "core/public_base.htmx.j2" %}
{% load humanize %}
{% load static %}
{% load django_vite %}
{% load public_url_tags %}
{% load markdown_tags %}
{% load advisory_tags %}
{% block title %}{{ advisory.id }} · {{ workspace.name }}{% endblock %}
{% block meta_description %}{{ advisory.summary|default:advisory.title }}{% endblock %}
{% block og_title %}{{ advisory.id }}: {{ advisory.title }}{% endblock %}
{% comment %}
A gated advisory must not end up in a search index: it is readable only
because *this* reader was let in, and a crawler is nobody's NDA holder.
{% endcomment %}
{% block meta_robots %}
    {% if advisory.is_gated %}
        noindex, nofollow
    {% else %}
        index, follow
    {% endif %}
{% endblock %}
{% block page_header %}
    {% comment %}
    The same masthead every trust center page uses, so an advisory reads as a
    page of this site rather than as a card dropped onto it. Identity first
    (the id a reader quotes), then the title, then the one-line summary, then
    the facts they check before reading further.

    Two answers are badges: how bad it is and where it is now. Every status is
    a badge with its icon, and only Resolved takes a colour, so the one a
    reader hopes for stands out without the others reading as metadata. A
    withdrawn advisory has no live status, so Withdrawn takes its place.
    Restricted explains why a colleague cannot see the page; it is not a
    status, so it stays neutral beside the id.

    Everything else is a labelled value, and appears only here: the side column
    used to repeat the id, severity, dates and CVEs.
    {% endcomment %}
    <c-branded.masthead>
    <c-branded.back-link href="{% public_url 'core:workspace_advisories_public' workspace_key=workspace.key %}">Security advisories</c-branded.back-link>
    <c-branded.page-header title="{{ advisory.title }}" lede="{{ advisory.summary }}">
    <c-slot name="eyebrow">
    <span class="font-mono text-text-muted">{{ advisory.id }}</span>
    {% if advisory.is_gated %}
        <c-branded.badge title="Visible to you because you have access to the affected products">
        <i class="fas fa-lock" aria-hidden="true"></i>Restricted
        </c-branded.badge>
    {% endif %}
    </c-slot>
    <div class="flex items-center gap-x-5 gap-y-2 [flex-wrap:wrap]">
        <div class="flex items-center gap-2">
            <c-branded.badge tone="{{ advisory.severity|default:'none' }}">{{ advisory.severity_label }}</c-branded.badge>
            {% if advisory.is_withdrawn %}
                <c-branded.badge dashed>
                <i class="fas fa-rotate-left" aria-hidden="true"></i>Withdrawn
                </c-branded.badge>
            {% elif advisory.status_label %}
                <c-branded.badge tone="{{ advisory.status_tone }}">
                <i class="{{ advisory.status_icon }}" aria-hidden="true"></i>{{ advisory.status_label }}
                </c-branded.badge>
            {% endif %}
        </div>
        {% if advisory.cvss_score is not None %}
            <c-branded.meta-item label="CVSS">{{ advisory.cvss_score }}</c-branded.meta-item>
        {% endif %}
        {% if advisory.cve_ids %}
            <c-branded.meta-item mono label="CVE ID{{ advisory.cve_ids|pluralize }}">
            {% comment %}One line per id, so no whitespace falls between an id and its comma.{% endcomment %}
            {# djlint:off #}
            {% for cve in advisory.cve_ids %}<span class="whitespace-nowrap">{% with cve_url=cve|advisory_url %}{% if cve_url %}<a class="text-text-secondary no-underline hover:underline underline-offset-4" data-button href="{{ cve_url }}" target="_blank" rel="noopener">{{ cve }}</a>{% else %}{{ cve }}{% endif %}{% endwith %}{% if not forloop.last %},{% endif %}</span>{% endfor %}
            {# djlint:on #}
            </c-branded.meta-item>
        {% endif %}
        <c-branded.meta-item label="Published">{{ advisory.published_display|default:"Not yet" }}</c-branded.meta-item>
        <c-branded.meta-item label="Updated">
        <time datetime="{{ advisory.updated_at|date:'c' }}"
              title="{{ advisory.updated_display }}">{{ advisory.updated_age }}</time>
        </c-branded.meta-item>
    </div>
    </c-branded.page-header>
    </c-branded.masthead>
{% endblock %}
{% block content %}
    <div class="flex flex-col gap-8">
        {% if advisory.is_withdrawn %}
            <c-feedback.alert variant="warning" icon="fas fa-rotate-left">
            <strong>This advisory has been withdrawn.</strong>
            {% if advisory.withdrawal_reason %}{{ advisory.withdrawal_reason }}{% endif %}
            </c-feedback.alert>
        {% endif %}
        <div class="grid items-start gap-8 min-[900px]:grid-cols-[minmax(0,1fr)_20rem]">
            {# ---- Main column --------------------------------------------------- #}
            <div class="min-w-0 flex flex-col gap-10">
                {% comment %}
                The answer comes before the explanation. A reader arrives asking
                whether they are affected and what to do, so the per-product
                status leads, with a field that checks the version they run,
                and the description follows, folded to its opening.

                The vulnerability only shows when there is more than one,
                because otherwise it repeats the title on every row.
                {% endcomment %}
                {% if advisory.statuses %}
                    {{ advisory.version_checks|json_script:"advisory-version-checks" }}
                    <c-branded.version-check checks="advisory-version-checks">
                    {% for row in advisory.statuses %}
                        <c-branded.version-row key="{{ row.id }}" heading="{{ row.product }}" status_label="{{ row.status_label }}" status_variant="{{ row.status_variant }}" :versions="row.version_labels" label="Affected versions of {{ row.product }} for {{ row.vulnerability }}">
                        {% if advisory.vulnerability_count > 1 %}<c-slot name="eyebrow">{{ row.vulnerability }}</c-slot>{% endif %}
                        {% if row.justification %}<c-slot name="meta">{{ row.justification }}</c-slot>{% endif %}
                        {% comment %}The fix sets the recommendation, and the instructions usually name it too. Saying "Upgrade to v2. Upgrade to v2." reads as a mistake.{% endcomment %}
                        {% if row.recommended_version and not row.action_names_recommendation %}
                            Upgrade to <span class="font-mono text-text">{{ row.recommended_version }}</span>.
                        {% endif %}
                        {{ row.action_statement|default:row.impact_statement }}
                        </c-branded.version-row>
                    {% endfor %}
                    </c-branded.version-check>
                {% endif %}
                {% if advisory.description %}
                    <section class="flex flex-col gap-4">
                        <c-branded.section-header title="Description" />
                        <c-branded.surface>
                        <c-branded.expandable more="Read the full description" less="Show less">
                        <c-branded.markdown class="text-sm leading-7 text-text-secondary">{{ advisory.description|strict_markdown }}</c-branded.markdown>
                        </c-branded.expandable>
                        </c-branded.surface>
                    </section>
                {% endif %}
                {% for vulnerability in advisory.vulnerabilities %}
                    {% if vulnerability.severity or vulnerability.cwe_ids or vulnerability.cvss_scores or vulnerability.description or vulnerability.recommendation %}
                        <section class="flex flex-col gap-4">
                            <c-branded.section-header title="{{ vulnerability.cve_id|default:vulnerability.title }}" />
                            <c-branded.surface class="flex flex-col gap-4">
                            <div class="flex items-center gap-2 [flex-wrap:wrap]">
                                {% if vulnerability.severity %}
                                    <c-branded.badge tone="{{ vulnerability.severity|lower }}">{{ vulnerability.severity }}</c-branded.badge>
                                {% endif %}
                                {% for cwe in vulnerability.cwe_ids %}<c-branded.badge>{{ cwe }}</c-branded.badge>{% endfor %}
                                {% for score in vulnerability.cvss_scores %}
                                    <c-branded.meta-item>{{ score.label }}: {{ score.base_score }}</c-branded.meta-item>
                                {% endfor %}
                            </div>
                            {% if vulnerability.description %}
                                <c-branded.markdown class="text-sm leading-7 text-text-secondary">{{ vulnerability.description|strict_markdown }}</c-branded.markdown>
                            {% endif %}
                            {% if vulnerability.recommendation %}
                                <div class="flex flex-col gap-1.5">
                                    <p class="text-sm font-semibold text-text my-0">Recommendation</p>
                                    <c-branded.markdown class="text-sm leading-7 text-text-secondary">{{ vulnerability.recommendation|strict_markdown }}</c-branded.markdown>
                                </div>
                            {% endif %}
                            </c-branded.surface>
                        </section>
                    {% endif %}
                {% endfor %}
                {% if advisory.timeline %}
                    <section class="flex flex-col gap-4">
                        <c-branded.section-header title="Timeline" subtitle="Last updated {{ advisory.updated_age }}" />
                        <c-branded.surface>
                        <c-branded.timeline>
                        {% for entry in advisory.timeline %}
                            <c-branded.timeline-item icon="{{ entry.icon }}" tone="{{ entry.variant }}">
                            <c-slot name="heading">{{ entry.label }}</c-slot>
                            <c-slot name="when">
                            <time datetime="{{ entry.created_at|date:'c' }}"
                                  title="{{ entry.created_at|date:'j F Y, H:i e' }}">
                                {{ entry.date_display }} · {{ entry.time_display }}
                            </time>
                            </c-slot>
                            <c-slot name="meta">
                            <span>{{ entry.age }}</span>
                            {% comment %}
                                The gap to the next older entry. The oldest has
                                nothing to measure against, so it says so rather
                                than showing a blank.
                            {% endcomment %}
                            {% if entry.gap %}
                                <span><i class="fas fa-arrow-turn-up" aria-hidden="true"></i> {{ entry.gap }}</span>
                            {% else %}
                                <span>first entry</span>
                            {% endif %}
                            {# A corrected update says so: a reader who quoted the old text can tell it changed. #}
                            {% if entry.edited_display %}<span>edited {{ entry.edited_display }}</span>{% endif %}
                            </c-slot>
                            {% if entry.note %}<c-branded.markdown>{{ entry.note|strict_markdown }}</c-branded.markdown>{% endif %}
                            </c-branded.timeline-item>
                        {% endfor %}
                        </c-branded.timeline>
                        </c-branded.surface>
                    </section>
                {% endif %}
            </div>
            {# ---- Sidebar ------------------------------------------------------- #}
            {% comment %}
            Sticky on a wide screen, the same as the advisory list's filters: a
            long description otherwise scrolls the facts away and leaves an empty
            column beside the text.
            {% endcomment %}
            <aside class="flex flex-col gap-4 min-[900px]:sticky min-[900px]:top-[4.5rem]">
                {% if advisory.products or advisory.withheld_product_count %}
                    <c-branded.panel title="Affected products">
                    <div class="flex items-center gap-2 [flex-wrap:wrap]">
                        {% for product in advisory.products %}
                            {% if product.id %}
                                <a class="inline-flex no-underline"
                                   data-button
                                   href="{% public_url 'core:product_details_public' product_id=product.id product_slug=product.slug %}">
                                    <c-branded.badge class="hover:border-text-muted">
                                    <i class="fas fa-cube" aria-hidden="true"></i>{{ product.name }}
                                    </c-branded.badge>
                                </a>
                            {% else %}
                                <c-branded.badge>{{ product.name }}</c-branded.badge>
                            {% endif %}
                        {% endfor %}
                    </div>
                    {% if advisory.withheld_product_count %}
                        <p class="text-xs text-text-muted my-0">
                            {{ advisory.withheld_product_count|intcomma }} further product{{ advisory.withheld_product_count|pluralize }}
                            {{ advisory.withheld_product_count|pluralize:"is,are" }} not shown — you do not have access to
                            {{ advisory.withheld_product_count|pluralize:"it,them" }}.
                        </p>
                    {% endif %}
                    </c-branded.panel>
                {% endif %}
                {% if advisory.references %}
                    <c-branded.panel title="References">
                    <ul class="flex flex-col gap-2 list-none my-0 pl-0">
                        {% for reference in advisory.references %}
                            <li class="text-sm">
                                {% with reference_url=reference.external_id|insights_url|default:reference.url %}
                                    {% if reference_url %}
                                        <a class="inline-flex items-baseline gap-1.5 font-medium text-text no-underline hover:underline underline-offset-4 [overflow-wrap:anywhere]"
                                           data-button
                                           href="{{ reference_url }}"
                                           target="_blank"
                                           rel="noopener noreferrer nofollow">
                                            {{ reference.external_id|default:reference.summary|default:reference.url }}
                                            <i class="fas fa-arrow-up-right-from-square text-xs text-text-muted"
                                               aria-hidden="true"></i>
                                        </a>
                                    {% else %}
                                        <span class="font-mono text-xs text-text">{{ reference.external_id }}</span>
                                    {% endif %}
                                {% endwith %}
                            </li>
                        {% endfor %}
                    </ul>
                    </c-branded.panel>
                {% endif %}
                {% if advisory.acknowledgments %}
                    <c-branded.panel title="Acknowledgments">
                    <ul class="flex flex-col gap-2.5 list-none my-0 pl-0">
                        {% for ack in advisory.acknowledgments %}
                            <li class="flex flex-col gap-0.5">
                                <span class="text-sm text-text">{{ ack.name|default:ack.organization }}</span>
                                {% if ack.summary %}<span class="text-xs text-text-muted">{{ ack.summary }}</span>{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    </c-branded.panel>
                {% endif %}
            </aside>
        </div>
    </div>
{% endblock %}
{% block scripts %}
    {% vite_asset 'sbomify/apps/core/js/main.ts' %}
{% endblock %}
