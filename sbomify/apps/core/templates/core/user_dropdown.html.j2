{% load teams %}
<div x-data="{ open: false }"
     class="relative"
     @keydown.escape.window="if(open) open = false">
    <c-buttons.ghost @click="open = !open" ::aria-expanded="open" aria-haspopup="true" aria-label="User menu">
    {% if request.session.user_photo %}
        <img src="{{ request.session.user_photo }}"
             class="w-8 h-8 rounded-full object-cover"
             alt="{{ request.user.get_full_name|default:request.user.username }}"
             width="32"
             height="32" />
    {% else %}
        <c-avatar initials="{{ request.user|user_initials }}" size="sm" />
    {% endif %}
    <i class="fas fa-chevron-down text-text-muted text-xs transition-transform duration-200"
       :class="open ? 'rotate-180' : ''"
       aria-hidden="true"></i>
    </c-buttons.ghost>
    {% comment %} The panel names itself and owns its menu semantics, so role and
    aria-orientation come from the component rather than from here. {% endcomment %}
    <c-dropdowns.dropdown class="right-0 mt-2 w-48" aria-label="User options" x-show="open" x-cloak x-transition:enter="transition ease-out duration-150" x-transition:enter-start="opacity-0 translate-y-1" x-transition:enter-end="opacity-100 translate-y-0" x-transition:leave="transition ease-in duration-100" x-transition:leave-start="opacity-100 translate-y-0" x-transition:leave-end="opacity-0 translate-y-1" @click.away="open = false">
    <c-dropdowns.header>{{ request.user.get_full_name|default:request.user.username }}</c-dropdowns.header>
    <c-dropdowns.item icon="fas fa-cog" href="{% url 'core:settings' %}">
    Settings
    {% if pending_invitations_count > 0 %}
        <c-badges.solid-danger size="sm" class="ml-auto">{{ pending_invitations_count }}</c-badges.solid-danger>
    {% endif %}
    </c-dropdowns.item>
    <c-dropdowns.divider />
    <c-dropdowns.item-danger icon="fas fa-sign-out-alt" href="{% url 'core:logout' %}">
    Log out
    </c-dropdowns.item-danger>
    </c-dropdowns.dropdown>
</div>
