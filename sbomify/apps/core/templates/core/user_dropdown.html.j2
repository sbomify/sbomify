{% load design_system %}
{% load teams %}
<div x-data="{ open: false }"
     class="relative"
     @keydown.escape.window="if(open) open = false">
    <button @click="open = !open"
            class="tw-btn-ghost"
            type="button"
            :aria-expanded="open"
            aria-haspopup="true"
            aria-label="User menu">
        {% if request.session.user_photo %}
            <img src="{{ request.session.user_photo }}"
                 class="w-8 h-8 rounded-full object-cover"
                 alt="{{ request.user.get_full_name|default:request.user.username }}"
                 width="32"
                 height="32" />
        {% else %}
            {% avatar initials=request.user|user_initials size="sm" %}
        {% endif %}
        <i class="fas fa-chevron-down text-text-muted text-xs transition-transform duration-200"
           :class="open ? 'rotate-180' : ''"
           aria-hidden="true"></i>
    </button>
    <div x-show="open"
         x-cloak
         x-transition:enter="transition ease-out duration-150"
         x-transition:enter-start="opacity-0 translate-y-1"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-100"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 translate-y-1"
         @click.away="open = false"
         class="tw-dropdown right-0 mt-2 w-48"
         role="menu"
         aria-orientation="vertical"
         aria-label="User options">
        <div class="tw-dropdown-header">{{ request.user.get_full_name|default:request.user.username }}</div>
        <a class="tw-dropdown-item no-underline"
           href="{% url 'core:settings' %}"
           role="menuitem">
            <i class="fas fa-cog tw-dropdown-item-icon" aria-hidden="true"></i>
            Settings
            {% if pending_invitations_count > 0 %}
                <span class="tw-badge-solid-danger tw-badge-sm ml-auto">{{ pending_invitations_count }}</span>
            {% endif %}
        </a>
        <div class="tw-dropdown-divider"></div>
        <a class="tw-dropdown-item tw-dropdown-item-danger no-underline"
           href="{% url 'core:logout' %}"
           role="menuitem">
            <i class="fas fa-sign-out-alt tw-dropdown-item-icon" aria-hidden="true"></i>
            Log out
        </a>
    </div>
</div>
