{% extends "core/public_base.htmx.j2" %}
{% load static %}
{% load django_vite %}
{% load public_url_tags %}
{% block title %}{{ workspace.name }} Trust Center{% endblock %}
{% block meta_description %}
    {{ workspace.name }} Trust Center: security advisories, product SBOMs, releases, and organization-wide compliance artifacts.
{% endblock %}
{% block og_title %}{{ workspace.name }} Trust Center{% endblock %}
{% block og_description %}
    {{ workspace.name }} Trust Center: security advisories, product SBOMs, releases, and organization-wide compliance artifacts.
{% endblock %}
{% block page_header %}
    {% comment %}
    A real page header, not a card: it spans the viewport and its text lines
    up with the content below, so the page reads as one document rather than
    a stack of boxes.
    {% endcomment %}
    <header class="tc-masthead">
        <div class="tc-masthead-inner">
            <p class="tc-eyebrow">
                <span class="tc-eyebrow-dot" aria-hidden="true"></span>
                Trust Center
            </p>
            <h1 class="tc-masthead-title">{{ workspace.name }}</h1>
            <p class="tc-masthead-lede">
                {% if brand.trust_center_description %}
                    {{ brand.trust_center_description }}
                {% else %}
                    Security advisories, software bills of materials, and compliance artifacts for everything we ship — published as we publish them.
                {% endif %}
            </p>
            <dl class="tc-stats">
                <div class="tc-stat">
                    <dt class="tc-stat-label">Advisories</dt>
                    <dd class="tc-stat-value">
                        {{ advisories.total }}
                    </dd>
                </div>
                <div class="tc-stat">
                    <dt class="tc-stat-label">Products</dt>
                    <dd class="tc-stat-value">
                        {{ products|length }}
                    </dd>
                </div>
                <div class="tc-stat">
                    <dt class="tc-stat-label">Compliance artifacts</dt>
                    <dd class="tc-stat-value">
                        {{ global_components|length }}
                    </dd>
                </div>
                <div class="tc-stat">
                    <dt class="tc-stat-label">Latest advisory</dt>
                    <dd class="tc-stat-value tc-stat-value-date">
                        {{ advisories.latest_display|default:"—" }}
                    </dd>
                </div>
            </dl>
        </div>
    </header>
{% endblock %}
{% block content %}
    {# ---- Security advisories -------------------------------------------- #}
    <section class="tc-section" id="advisories">
        <div class="tc-section-head">
            <div class="tc-section-heading">
                <h2 class="tc-section-title">Security advisories</h2>
                <p class="tc-section-sub">Vulnerabilities we have disclosed, what they affect, and where the fix is.</p>
            </div>
            {% if advisories.total %}
                <a class="tc-section-link"
                   href="{% public_url 'core:workspace_advisories_public' workspace_key=workspace.key %}">
                    All advisories <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            {% endif %}
        </div>
        {% if advisories.recent %}
            <div class="tc-advisory-list">
                {% for advisory in advisories.recent %}
                    {% include "core/components/trust_center/advisory_row.html.j2" with advisory=advisory %}
                {% endfor %}
            </div>
        {% else %}
            <div class="tc-empty">
                <i class="fas fa-shield-halved tc-empty-icon" aria-hidden="true"></i>
                <p class="tc-empty-title">No published advisories</p>
                <p class="tc-empty-body">
                    {% if advisories.hidden_count %}
                        No security advisories are visible to you. New disclosures appear here as they are released.
                    {% else %}
                        We have not published any security advisories. New disclosures appear here as they are released.
                    {% endif %}
                </p>
            </div>
        {% endif %}
        {% include "core/components/trust_center/restricted_notice.html.j2" with hidden_count=advisories.hidden_count viewer_is_authenticated=advisories.viewer_is_authenticated viewer_has_gated_grant=advisories.viewer_has_gated_grant %}
    </section>
    {# ---- Products -------------------------------------------------------- #}
    {% comment %}
    A searchable table rather than a card grid: a visitor with dozens of
    products is looking one up by name, not browsing. Filtering is client-side
    Alpine over the server-rendered rows — every product is already on the
    page, so hiding rows keeps the assessment badges server-rendered and the
    table intact without JavaScript.
    {% endcomment %}
    <section class="tc-section"
             id="products"
             x-data="{ q: '', currentPage: 1, perPage: 10, rows: [], init() { this.rows = Array.from(this.$root.querySelectorAll('tr[data-search]')).map(r => r.dataset.search); this.$watch('q', () => this.currentPage = 1) }, get needle() { return this.q.trim().toLowerCase() }, get matched() { const n = this.needle; return this.rows.reduce((acc, s, i) => { if (!n || s.includes(n)) acc.push(i); return acc; }, []) }, get totalPages() { return Math.max(1, Math.ceil(this.matched.length / this.perPage)) }, get pageIdx() { const start = (Math.min(this.currentPage, this.totalPages) - 1) * this.perPage; return this.matched.slice(start, start + this.perPage) }, show(i) { return this.pageIdx.includes(i) }, get startIndex() { return this.matched.length ? (Math.min(this.currentPage, this.totalPages) - 1) * this.perPage + 1 : 0 }, get endIndex() { return Math.min(Math.min(this.currentPage, this.totalPages) * this.perPage, this.matched.length) } }">
        <div class="tc-section-head">
            <div class="tc-section-heading">
                <h2 class="tc-section-title">Products</h2>
                <p class="tc-section-sub">Our products and their software bills of materials.</p>
            </div>
            {% if products %}
                <div class="tw-data-table-search" role="search">
                    <i class="fas fa-search tw-data-table-search-icon" aria-hidden="true"></i>
                    <label for="tc-products-search" class="sr-only">Search products</label>
                    <input type="search"
                           id="tc-products-search"
                           x-model="q"
                           placeholder="Search products..."
                           class="tw-data-table-search-input">
                </div>
            {% endif %}
        </div>
        {% if is_workspace_admin and not has_vulnerability_plugin %}
            <div class="tw-alert tw-alert-info mb-4">
                <i class="fas fa-shield-halved tw-alert-icon" aria-hidden="true"></i>
                <div class="tw-alert-content">
                    <p class="text-sm m-0">
                        Enable vulnerability scanning to show security status on your products.
                        <a href="{% url 'teams:team_settings' workspace.key %}#plugins"
                           class="font-medium">Settings → Plugins</a>
                    </p>
                </div>
            </div>
        {% endif %}
        {% if products %}
            <div class="tc-panel tc-panel-flush">
                <div class="tw-data-table-container">
                    <table class="tw-table">
                        <thead>
                            <tr>
                                <th scope="col">Product</th>
                                <th scope="col" class="hidden md:table-cell">Components</th>
                                <th scope="col" class="hidden md:table-cell">Assurance</th>
                                <th scope="col">
                                    <span class="sr-only">View</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for product in products %}
                                <tr data-search="{{ product.name|lower }} {{ product.description|default:''|lower }}"
                                    x-show="show({{ forloop.counter0 }})">
                                    <td>
                                        <a class="font-medium text-text hover:text-primary no-underline"
                                           href="{% public_url 'core:product_details_public' product_id=product.id product_slug=product.slug %}">{{ product.name }}</a>
                                        {% if product.description %}
                                            <div class="text-xs opacity-75 mt-1" title="{{ product.description }}">{{ product.description|truncatechars:80 }}</div>
                                        {% endif %}
                                        <div class="md:hidden text-xs opacity-75 mt-1">
                                            {{ product.component_count }} component{{ product.component_count|pluralize }}
                                        </div>
                                    </td>
                                    <td class="hidden md:table-cell whitespace-nowrap">
                                        {{ product.component_count }} component{{ product.component_count|pluralize }}
                                    </td>
                                    <td class="hidden md:table-cell">
                                        {% if product.passing_assessments %}
                                            <span class="inline-flex items-center gap-1">
                                                {% for assessment in product.passing_assessments %}
                                                    {% include 'plugins/components/public_assessment_icon.html.j2' with assessment=assessment %}
                                                {% endfor %}
                                            </span>
                                        {% else %}
                                            <span class="opacity-50">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-right">
                                        <a class="tc-section-link whitespace-nowrap"
                                           href="{% public_url 'core:product_details_public' product_id=product.id product_slug=product.slug %}"
                                           aria-label="View {{ product.name }}">
                                            View <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            <tr x-show="matched.length === 0" x-cloak>
                                <td colspan="4">
                                    <div class="tc-empty">
                                        <i class="fas fa-magnifying-glass tc-empty-icon" aria-hidden="true"></i>
                                        <p class="tc-empty-title">No products match</p>
                                        <p class="tc-empty-body">
                                            No product name or description contains "<span x-text="q"></span>".
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                {% comment %}
                Pager footer, shown only once the workspace outgrows a single
                page — a six-product trust center gets no pagination chrome.
                Counts follow the filtered set, so a search narrows the pager
                with it.
                {% endcomment %}
                <div class="tc-pager-foot px-6 py-3 flex flex-wrap items-center justify-between gap-3"
                     x-show="rows.length > perPage"
                     x-cloak>
                    <div class="tw-data-table-info">
                        Showing <strong x-text="startIndex"></strong> to <strong x-text="endIndex"></strong> of <strong x-text="matched.length"></strong> products
                        <template x-if="needle">
                            <span>(filtered from <strong x-text="rows.length"></strong> total)</span>
                        </template>
                    </div>
                    {% include "components/tw/table_pager.html.j2" %}
                </div>
            </div>
        {% else %}
            <div class="tc-empty">
                <i class="fas fa-cube tc-empty-icon" aria-hidden="true"></i>
                <p class="tc-empty-title">No public products</p>
                <p class="tc-empty-body">Products appear here once they are published with at least one public component.</p>
            </div>
        {% endif %}
    </section>
    {# ---- Compliance artifacts -------------------------------------------- #}
    <section class="tc-section" id="compliance">
        <div class="tc-section-head">
            <div class="tc-section-heading">
                <h2 class="tc-section-title">Compliance artifacts</h2>
                <p class="tc-section-sub">Organization-wide certifications, attestations and policy documents.</p>
            </div>
        </div>
        {% if global_components %}
            <div class="tc-card-grid">
                {% for component in global_components %}
                    <a class="tc-card"
                       href="{% public_url 'core:component_details_public' component_id=component.id component_slug=component.slug %}">
                        <div class="tc-card-head">
                            <h3 class="tc-card-title">{{ component.name }}</h3>
                            <span class="tc-card-tag">{{ component.component_type_display }}</span>
                        </div>
                        <p class="tc-card-desc">Organization-level artifact, applicable across everything we ship.</p>
                        <div class="tc-card-foot">
                            <span class="tc-card-count">Organization-wide</span>
                            <i class="fas fa-arrow-right tc-card-arrow" aria-hidden="true"></i>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="tc-empty">
                <i class="fas fa-award tc-empty-icon" aria-hidden="true"></i>
                <p class="tc-empty-title">No compliance artifacts</p>
                <p class="tc-empty-body">Organization-wide certifications and attestations appear here once published.</p>
            </div>
        {% endif %}
    </section>
{% endblock %}
{% block scripts %}
    {% vite_asset 'sbomify/apps/core/js/main.ts' %}
{% endblock %}
