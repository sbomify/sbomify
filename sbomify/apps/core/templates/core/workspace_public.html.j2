{% extends "core/public_base.htmx.j2" %}
{% load static %}
{% load django_vite %}
{% load public_url_tags %}
{% block title %}{{ workspace.name }} Trust Center{% endblock %}
{% block meta_description %}
    {{ workspace.name }} Trust Center: security advisories, product SBOMs, releases, and organization-wide compliance artifacts.
{% endblock %}
{% block og_title %}{{ workspace.name }} Trust Center{% endblock %}
{% block og_description %}
    {{ workspace.name }} Trust Center: security advisories, product SBOMs, releases, and organization-wide compliance artifacts.
{% endblock %}
{% block page_header %}
    {% comment %}
    A real page header, not a card: it spans the viewport and its text lines up
    with the content below, so the page reads as one document rather than a
    stack of boxes. The band and the width-limited track are layout, which the
    page owns; the heading, lede and figures are components.
    {% endcomment %}
    <header class="border-b border-solid border-border">
        <div class="mx-auto max-w-[1200px] px-4 py-12">
            <c-branded.page-header title="{{ workspace.name }}">
            <c-slot name="eyebrow">
            <c-branded.badge brand>Trust center</c-branded.badge>
            </c-slot>
            <c-slot name="lede">
            {% if brand.trust_center_description %}
                {{ brand.trust_center_description }}
            {% else %}
                Security advisories, software bills of materials, and compliance artifacts for everything we ship, published as we publish them.
            {% endif %}
            </c-slot>
            <c-branded.stats>
            <c-branded.stat label="Advisories">{{ advisories.total }}</c-branded.stat>
            <c-branded.stat label="Products">{{ products|length }}</c-branded.stat>
            <c-branded.stat label="Compliance artifacts">{{ global_components|length }}</c-branded.stat>
            <c-branded.stat label="Latest advisory">{{ advisories.latest_display|default:"Not yet" }}</c-branded.stat>
            </c-branded.stats>
            </c-branded.page-header>
        </div>
    </header>
{% endblock %}
{% block content %}
    {# Sections take their rhythm from the column, not from a margin each. #}
    <div class="flex flex-col gap-14">
        {# ---- Security advisories -------------------------------------------- #}
        <section class="flex flex-col gap-4 scroll-mt-[4.5rem]" id="advisories">
            <c-branded.section-header title="Security advisories" subtitle="Vulnerabilities we have disclosed, what they affect, and where the fix is.">
            {% if advisories.total %}
                <c-slot name="action">
                <c-buttons.secondary size="sm" href="{% public_url 'core:workspace_advisories_public' workspace_key=workspace.key %}">All advisories</c-buttons.secondary>
                </c-slot>
            {% endif %}
            </c-branded.section-header>
            {% if advisories.recent %}
                <c-branded.surface flush>
                {% for advisory in advisories.recent %}
                    {% include "core/components/trust_center/advisory_row.html.j2" with advisory=advisory %}
                {% endfor %}
                </c-branded.surface>
            {% else %}
                <c-feedback.empty-state icon="fas fa-shield-halved" icon_variant="neutral" title="No published advisories">
                {% if advisories.hidden_count %}
                    No security advisories are visible to you. New disclosures appear here as they are released.
                {% else %}
                    We have not published any security advisories. New disclosures appear here as they are released.
                {% endif %}
                </c-feedback.empty-state>
            {% endif %}
            {% include "core/components/trust_center/restricted_notice.html.j2" with hidden_count=advisories.hidden_count viewer_is_authenticated=advisories.viewer_is_authenticated viewer_has_gated_grant=advisories.viewer_has_gated_grant %}
        </section>
        {# ---- Products -------------------------------------------------------- #}
        {% comment %}
    A searchable table rather than a card grid: a visitor with dozens of
    products is looking one up by name, not browsing. Filtering is client-side
    Alpine over the server-rendered rows — every product is already on the
    page, so hiding rows keeps the assessment badges server-rendered and the
    table intact without JavaScript.
        {% endcomment %}
        <section class="flex flex-col gap-4 scroll-mt-[4.5rem]"
                 id="products"
                 x-data="{ q: '', currentPage: 1, perPage: 10, rows: [], init() { this.rows = Array.from(this.$root.querySelectorAll('tr[data-search]')).map(r => r.dataset.search); this.$watch('q', () => this.currentPage = 1) }, get needle() { return this.q.trim().toLowerCase() }, get matched() { const n = this.needle; return this.rows.reduce((acc, s, i) => { if (!n || s.includes(n)) acc.push(i); return acc; }, []) }, get totalPages() { return Math.max(1, Math.ceil(this.matched.length / this.perPage)) }, get pageIdx() { const start = (Math.min(this.currentPage, this.totalPages) - 1) * this.perPage; return this.matched.slice(start, start + this.perPage) }, show(i) { return this.pageIdx.includes(i) }, get startIndex() { return this.matched.length ? (Math.min(this.currentPage, this.totalPages) - 1) * this.perPage + 1 : 0 }, get endIndex() { return Math.min(Math.min(this.currentPage, this.totalPages) * this.perPage, this.matched.length) } }">
            <c-branded.section-header title="Products" subtitle="Our products and their software bills of materials.">
            {% if products %}
                <c-slot name="action">
                {# The search landmark stays on the wrapper; the component is the box inside it. #}
                <div role="search">
                    <c-tables.search id="tc-products-search" label="Search products" placeholder="Search products..." x-model="q" />
                </div>
                </c-slot>
            {% endif %}
            </c-branded.section-header>
            {% if is_workspace_admin and not has_vulnerability_plugin %}
                <c-feedback.alert icon="fas fa-shield-halved">
                Enable vulnerability scanning to show security status on your products.
                {% comment %}
                Through switch_team: this page is reachable for any workspace the
                viewer administers, while the Plugins page is scoped to the session's
                current workspace. Linking straight to it could offer to enable
                scanning on whichever workspace happened to be selected.
                {% endcomment %}
                <a href="{% url 'teams:switch_team' workspace.key %}?next={% url 'plugins:plugins_page' %}"
                   class="font-medium">Plugins</a>
                </c-feedback.alert>
            {% endif %}
            {% if products %}
                {# The panel already draws the frame, so the table brings only its own parts. #}
                <c-branded.surface flush>
                <c-tables.table>
                <c-tables.head>
                <c-tables.header-cell scope="col" nowrap>Product</c-tables.header-cell>
                <c-tables.header-cell scope="col" class="hidden md:table-cell">Components</c-tables.header-cell>
                <c-tables.header-cell scope="col" class="hidden md:table-cell">Assurance</c-tables.header-cell>
                <c-tables.header-cell scope="col">
                <span class="sr-only">View</span>
                </c-tables.header-cell>
                </c-tables.head>
                <tbody>
                    {% for product in products %}
                        <c-tables.row data-search="{{ product.name|lower }} {{ product.description|default:''|lower }}" x-show="show({{ forloop.counter0 }})">
                        <c-tables.cell nowrap>
                        <a class="font-medium text-text hover:text-text no-underline"
                           href="{% public_url 'core:product_details_public' product_id=product.id product_slug=product.slug %}">{{ product.name }}</a>
                        {% if product.description %}
                            <div class="text-xs opacity-75 mt-1" title="{{ product.description }}">{{ product.description|truncatechars:80 }}</div>
                        {% endif %}
                        <div class="md:hidden text-xs opacity-75 mt-1">
                            {{ product.component_count }} component{{ product.component_count|pluralize }}
                        </div>
                        </c-tables.cell>
                        <c-tables.cell class="hidden md:table-cell whitespace-nowrap">
                        {{ product.component_count }} component{{ product.component_count|pluralize }}
                        </c-tables.cell>
                        <c-tables.cell class="hidden md:table-cell">
                        {% if product.passing_assessments %}
                            <span class="inline-flex items-center gap-1">
                                {% for assessment in product.passing_assessments %}
                                    {% include 'plugins/components/public_assessment_icon.html.j2' with assessment=assessment %}
                                {% endfor %}
                            </span>
                        {% else %}
                            <span class="opacity-50">—</span>
                        {% endif %}
                        </c-tables.cell>
                        <c-tables.cell end>
                        <c-buttons.secondary size="sm" href="{% public_url 'core:product_details_public' product_id=product.id product_slug=product.slug %}" aria-label="View {{ product.name }}">View</c-buttons.secondary>
                        </c-tables.cell>
                        </c-tables.row>
                    {% endfor %}
                    <c-tables.row x-show="matched.length === 0" x-cloak>
                    <c-tables.cell colspan="4" nowrap>
                    <c-feedback.empty-state icon="fas fa-magnifying-glass" icon_variant="neutral" title="No products match">
                    No product name or description contains "<span x-text="q"></span>".
                    </c-feedback.empty-state>
                    </c-tables.cell>
                    </c-tables.row>
                </tbody>
                </c-tables.table>
                {% comment %}
                Pager footer, shown only once the workspace outgrows a single
                page — a six-product trust center gets no pagination chrome.
                Counts follow the filtered set, so a search narrows the pager
                with it.
                {% endcomment %}
                <div class="border-t border-solid border-border px-6 py-3 flex flex-wrap items-center justify-between gap-3"
                     x-show="rows.length > perPage"
                     x-cloak>
                    <c-tables.info>
                    Showing <strong x-text="startIndex"></strong> to <strong x-text="endIndex"></strong> of <strong x-text="matched.length"></strong> products
                    <template x-if="needle">
                        <span>(filtered from <strong x-text="rows.length"></strong> total)</span>
                    </template>
                    </c-tables.info>
                    <c-tables.pager />
                </div>
                </c-branded.surface>
            {% else %}
                <c-feedback.empty-state icon="fas fa-cube" icon_variant="neutral" title="No public products">
                Products appear here once they are published with at least one public component.
                </c-feedback.empty-state>
            {% endif %}
        </section>
        {# ---- Compliance artifacts -------------------------------------------- #}
        <section class="flex flex-col gap-4 scroll-mt-[4.5rem]" id="compliance">
            <c-branded.section-header title="Compliance artifacts" subtitle="Organization-wide certifications, attestations and policy documents." />
            {% if global_components %}
                {% comment %}
                A card here is a panel holding one record, so it is a surface
                and a row rather than a third shape with its own rules. The row
                already stretches its link across the whole card.
                {% endcomment %}
                <div class="grid gap-4 [grid-template-columns:repeat(auto-fill,minmax(18rem,1fr))]">
                    {% for component in global_components %}
                        <c-branded.surface flush>
                        <c-branded.list-row href="{% public_url 'core:component_details_public' component_id=component.id component_slug=component.slug %}">
                        <c-slot name="heading">{{ component.name }}</c-slot>
                        <c-slot name="summary">Organization-level artifact, applicable across everything we ship.</c-slot>
                        <c-slot name="side">
                        <c-branded.badge>{{ component.component_type_display }}</c-branded.badge>
                        </c-slot>
                        </c-branded.list-row>
                        </c-branded.surface>
                    {% endfor %}
                </div>
            {% else %}
                <c-feedback.empty-state icon="fas fa-award" icon_variant="neutral" title="No compliance artifacts">
                Organization-wide certifications and attestations appear here once published.
                </c-feedback.empty-state>
            {% endif %}
        </section>
    </div>
{% endblock %}
{% block scripts %}
    {% vite_asset 'sbomify/apps/core/js/main.ts' %}
{% endblock %}
