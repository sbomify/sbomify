{% load humanize %}
{% comment %}
    The queue renders inside the Trust Center tab, so it composes the same card
    the tab's other sections use instead of drawing a heading band of its own.
    The sub-sections are h3 under the card's h2; they were h6 under a hand
    styled h3, which skipped two levels for a screen reader and kept type
    styling on a page rather than in a component.

    Four empty sub-sections used to stack four grey sentences down the tab, so
    a workspace with nothing to review read as a wall of nothing. One empty
    state covers that case now.
{% endcomment %}
<c-cards.card flush>
<c-cards.header compact title="Access requests">
<c-buttons.primary size="sm" onclick="window.dispatchEvent(new CustomEvent('open-invite-user-modal'))">
<i class="fas fa-user-plus mr-1" aria-hidden="true"></i>Invite guest
</c-buttons.primary>
</c-cards.header>
<c-cards.body>
{% if not pending_requests and not pending_invitations and not approved_requests and not rejected_requests %}
    <c-feedback.empty-state compact icon="fas fa-user-shield" title="No access requests yet" message="Invite a guest, or wait for someone to ask for access to your gated components." />
{% else %}
    <c-forms.hint>Who can reach your gated components.</c-forms.hint>
    <div class="mt-4 flex flex-col gap-6">
        {# Pending Requests #}
        <div>
            <c-layout.section-header density="compact" title="Pending requests" class="mb-3">
            <c-slot name="actions">
            {% if pending_requests %}<c-badges.warning size="sm">{{ pending_requests|length }}</c-badges.warning>{% endif %}
            </c-slot>
            </c-layout.section-header>
            {% if pending_requests %}
                <c-tables.table>
                <c-tables.head>
                <c-tables.header-cell nowrap>User</c-tables.header-cell>
                <c-tables.header-cell>Email</c-tables.header-cell>
                <c-tables.header-cell>Requested</c-tables.header-cell>
                <c-tables.header-cell>NDA signed</c-tables.header-cell>
                <c-tables.actions-cell as="th" label="Actions" />
                </c-tables.head>
                <tbody>
                    {% for req in pending_requests %}
                        <c-tables.row>
                        <c-tables.cell nowrap class="font-medium">
                        {% if req.user.first_name or req.user.last_name %}
                            {{ req.user.first_name }} {{ req.user.last_name }}
                        {% else %}
                            {{ req.user.username }}
                        {% endif %}
                        </c-tables.cell>
                        <c-tables.cell muted>{{ req.user.email }}</c-tables.cell>
                        <c-tables.cell muted date>{{ req.requested_at|naturaltime }}</c-tables.cell>
                        <c-tables.cell>
                        {% if req.nda_signature %}
                            {% if req.has_current_nda_signature %}
                                {% if req.nda_signature.is_document_modified %}
                                    <c-badges.secondary title="NDA document has been modified after signing">Modified</c-badges.secondary>
                                {% else %}
                                    <c-badges.secondary>Yes</c-badges.secondary>
                                {% endif %}
                            {% else %}
                                <c-badges.secondary title="NDA version has been updated. User needs to sign the new version.">Invalid</c-badges.secondary>
                            {% endif %}
                        {% else %}
                            <c-badges.secondary>No</c-badges.secondary>
                        {% endif %}
                        {% if req.nda_signatures.all|length > 1 %}
                            <div class="text-xs text-text-muted mt-1"
                                 title="{% for sig in req.nda_signatures.all %}v{{ sig.nda_document.version }}, {{ sig.signed_name }}, {{ sig.signed_at|date:'j M Y, H:i' }}{% if sig.superseded_at %} (superseded){% endif %}{% if not forloop.last %} · {% endif %}{% endfor %}">
                                {{ req.nda_signatures.all|length }} signatures on record
                            </div>
                        {% endif %}
                        </c-tables.cell>
                        <c-tables.actions-cell>
                        <form method="post"
                              action="{% url 'documents:access_request_queue' team.key %}"
                              hx-post="{% url 'documents:access_request_queue' team.key %}"
                              hx-target="#access-requests-wrapper"
                              hx-swap="innerHTML"
                              hx-trigger="submit"
                              class="hidden"
                              id="access-request-form-{{ req.id }}">
                            {% csrf_token %}
                            <input type="hidden" name="request_id" value="{{ req.id }}">
                            <input type="hidden" name="active_tab" value="trust-center">
                        </form>
                        <c-actions-menu label="Request actions">
                        {% comment %}
                    The data-info-* attributes are read back by
                    openAccessRequestInfo, the plain listener at the foot of this
                    file, so they stay exactly where they were.
                        {% endcomment %}
                        {# djlint:off #}
                <c-dropdowns.item icon="fas fa-info-circle" data-info-request-id="{{ req.id }}" data-info-user-name="{% if req.user.first_name or req.user.last_name %}{{ req.user.first_name|escapejs }} {{ req.user.last_name|escapejs }}{% else %}{{ req.user.username|escapejs }}{% endif %}" data-info-user-email="{{ req.user.email|escapejs }}" data-info-status="{{ req.status|escapejs }}" data-info-requested-at="{{ req.requested_at|date:'F d, Y g:i A' }}" data-info-decided-at="{% if req.decided_at %}{{ req.decided_at|date:'F d, Y g:i A' }}{% endif %}" data-info-decided-by="{% if req.decided_by %}{{ req.decided_by.email|escapejs }}{% endif %}" data-info-revoked-at="{% if req.revoked_at %}{{ req.revoked_at|date:'F d, Y g:i A' }}{% endif %}" data-info-revoked-by="{% if req.revoked_by %}{{ req.revoked_by.email|escapejs }}{% endif %}" data-info-notes="{{ req.notes|default:''|escapejs }}" data-info-nda-signed="{% if req.nda_signature %}true{% else %}false{% endif %}" data-info-nda-signed-name="{% if req.nda_signature %}{{ req.nda_signature.signed_name|escapejs }}{% endif %}" data-info-nda-signed-at="{% if req.nda_signature %}{{ req.nda_signature.signed_at|date:'F d, Y g:i A' }}{% endif %}" data-info-nda-ip="{% if req.nda_signature %}{{ req.nda_signature.ip_address|default:''|escapejs }}{% endif %}" data-info-nda-user-agent="{% if req.nda_signature %}{{ req.nda_signature.user_agent|default:''|escapejs }}{% endif %}" data-info-nda-modified="{% if req.nda_signature and req.nda_signature.is_document_modified %}true{% else %}false{% endif %}" data-info-nda-current="{% if req.has_current_nda_signature %}true{% else %}false{% endif %}" data-info-nda-url="{% if req.nda_signature %}{% url 'documents:document_download' req.nda_signature.nda_document.id %}?view=inline{% endif %}" onclick="openAccessRequestInfo(this)">
                        {# djlint:on #}
                        View details
                        </c-dropdowns.item>
                        <c-dropdowns.item icon="fas fa-check" onclick="submitAccessRequestAction('{{ req.id }}', 'approve')">
                        Approve
                        </c-dropdowns.item>
                        <c-dropdowns.item-danger icon="fas fa-times" onclick="confirmRejectAccessRequest('{{ req.id }}', '{{ req.user.email|escapejs }}')">
                        Reject
                        </c-dropdowns.item-danger>
                        </c-actions-menu>
                        </c-tables.actions-cell>
                        </c-tables.row>
                    {% endfor %}
                </tbody>
                </c-tables.table>
            {% else %}
                <c-feedback.empty-state compact icon="fas fa-user-clock" title="No pending requests" message="Nobody is waiting for access right now." />
            {% endif %}
        </div>
        {# Pending Invitations #}
        <div class="pt-4 border-t border-border">
            <c-layout.section-header density="compact" title="Pending invitations" class="mb-3">
            <c-slot name="actions">
            {% if pending_invitations %}<c-badges.info size="sm">{{ pending_invitations|length }}</c-badges.info>{% endif %}
            </c-slot>
            </c-layout.section-header>
            {% if pending_invitations %}
                <c-tables.table>
                <c-tables.head>
                <c-tables.header-cell nowrap>Email</c-tables.header-cell>
                <c-tables.header-cell>Invited by</c-tables.header-cell>
                <c-tables.header-cell>Invited</c-tables.header-cell>
                <c-tables.actions-cell as="th" label="Actions" />
                </c-tables.head>
                <tbody>
                    {% for item in pending_invitations %}
                        {% with invitation=item.invitation inviter_email=item.inviter_email %}
                            <c-tables.row>
                            <c-tables.cell nowrap class="font-medium">{{ invitation.email }}</c-tables.cell>
                            <c-tables.cell muted>
                            {% if inviter_email %}
                                {{ inviter_email }}
                            {% else %}
                                <span class="text-text-muted">—</span>
                            {% endif %}
                            </c-tables.cell>
                            <c-tables.cell muted date>{{ invitation.created_at|naturaltime }}</c-tables.cell>
                            <c-tables.actions-cell>
                            <c-actions-menu label="Invitation actions">
                            <c-dropdowns.item-danger icon="fas fa-times" onclick="window.dispatchEvent(new CustomEvent('open-cancel-invitation-modal', { detail: { invitationId: '{{ invitation.id }}', invitationEmail: '{{ invitation.email|escapejs }}' } }))">
                            Cancel invitation
                            </c-dropdowns.item-danger>
                            </c-actions-menu>
                            </c-tables.actions-cell>
                            </c-tables.row>
                        {% endwith %}
                    {% endfor %}
                </tbody>
                </c-tables.table>
            {% else %}
                <c-feedback.empty-state compact icon="fas fa-envelope" title="No pending invitations" message="Invite a guest to give them access to your gated components." />
            {% endif %}
        </div>
        {# Approved Requests #}
        <div class="pt-4 border-t border-border">
            <c-layout.section-header density="compact" title="Approved requests" class="mb-3">
            <c-slot name="actions">
            {% if approved_requests %}<c-badges.success size="sm">{{ approved_requests|length }}</c-badges.success>{% endif %}
            </c-slot>
            </c-layout.section-header>
            {% if approved_requests %}
                <c-tables.table>
                <c-tables.head>
                <c-tables.header-cell nowrap>User</c-tables.header-cell>
                <c-tables.header-cell>Email</c-tables.header-cell>
                <c-tables.header-cell>Approved by</c-tables.header-cell>
                <c-tables.header-cell>NDA status</c-tables.header-cell>
                <c-tables.actions-cell as="th" label="Actions" />
                </c-tables.head>
                <tbody>
                    {% for req in approved_requests %}
                        <c-tables.row>
                        <c-tables.cell nowrap class="font-medium">
                        {% if req.user.first_name or req.user.last_name %}
                            {{ req.user.first_name }} {{ req.user.last_name }}
                        {% else %}
                            {{ req.user.username }}
                        {% endif %}
                        </c-tables.cell>
                        <c-tables.cell muted>{{ req.user.email }}</c-tables.cell>
                        <c-tables.cell muted>
                        {% if req.decided_by %}
                            {{ req.decided_by.email }}
                        {% else %}
                            <span class="text-text-muted">—</span>
                        {% endif %}
                        </c-tables.cell>
                        <c-tables.cell>
                        {% if req.nda_signature %}
                            {% if req.has_current_nda_signature %}
                                {% if req.nda_signature.is_document_modified %}
                                    <c-badges.secondary title="NDA document has been modified after signing">Modified</c-badges.secondary>
                                {% else %}
                                    <c-badges.secondary>Valid</c-badges.secondary>
                                {% endif %}
                            {% else %}
                                <c-badges.secondary title="NDA version has been updated. User needs to sign the new version.">Invalid</c-badges.secondary>
                            {% endif %}
                        {% else %}
                            <span class="text-text-muted">—</span>
                        {% endif %}
                        {% if req.nda_signatures.all|length > 1 %}
                            <div class="text-xs text-text-muted mt-1"
                                 title="{% for sig in req.nda_signatures.all %}v{{ sig.nda_document.version }}, {{ sig.signed_name }}, {{ sig.signed_at|date:'j M Y, H:i' }}{% if sig.superseded_at %} (superseded){% endif %}{% if not forloop.last %} · {% endif %}{% endfor %}">
                                {{ req.nda_signatures.all|length }} signatures on record
                            </div>
                        {% endif %}
                        </c-tables.cell>
                        <c-tables.actions-cell>
                        <c-actions-menu label="Request actions">
                        {# djlint:off #}
                <c-dropdowns.item icon="fas fa-info-circle" data-info-request-id="{{ req.id }}" data-info-user-name="{% if req.user.first_name or req.user.last_name %}{{ req.user.first_name|escapejs }} {{ req.user.last_name|escapejs }}{% else %}{{ req.user.username|escapejs }}{% endif %}" data-info-user-email="{{ req.user.email|escapejs }}" data-info-status="{{ req.status|escapejs }}" data-info-requested-at="{{ req.requested_at|date:'F d, Y g:i A' }}" data-info-decided-at="{% if req.decided_at %}{{ req.decided_at|date:'F d, Y g:i A' }}{% endif %}" data-info-decided-by="{% if req.decided_by %}{{ req.decided_by.email|escapejs }}{% endif %}" data-info-revoked-at="{% if req.revoked_at %}{{ req.revoked_at|date:'F d, Y g:i A' }}{% endif %}" data-info-revoked-by="{% if req.revoked_by %}{{ req.revoked_by.email|escapejs }}{% endif %}" data-info-notes="{{ req.notes|default:''|escapejs }}" data-info-nda-signed="{% if req.nda_signature %}true{% else %}false{% endif %}" data-info-nda-signed-name="{% if req.nda_signature %}{{ req.nda_signature.signed_name|escapejs }}{% endif %}" data-info-nda-signed-at="{% if req.nda_signature %}{{ req.nda_signature.signed_at|date:'F d, Y g:i A' }}{% endif %}" data-info-nda-ip="{% if req.nda_signature %}{{ req.nda_signature.ip_address|default:''|escapejs }}{% endif %}" data-info-nda-user-agent="{% if req.nda_signature %}{{ req.nda_signature.user_agent|default:''|escapejs }}{% endif %}" data-info-nda-modified="{% if req.nda_signature and req.nda_signature.is_document_modified %}true{% else %}false{% endif %}" data-info-nda-current="{% if req.has_current_nda_signature %}true{% else %}false{% endif %}" data-info-nda-url="{% if req.nda_signature %}{% url 'documents:document_download' req.nda_signature.nda_document.id %}?view=inline{% endif %}" onclick="openAccessRequestInfo(this)">
                        {# djlint:on #}
                        View details
                        </c-dropdowns.item>
                        <c-dropdowns.item-danger icon="fas fa-ban" onclick="window.dispatchEvent(new CustomEvent('open-revoke-access-modal', { detail: { requestId: '{{ req.id }}', userEmail: '{{ req.user.email|escapejs }}' } }))">
                        Revoke access
                        </c-dropdowns.item-danger>
                        </c-actions-menu>
                        </c-tables.actions-cell>
                        </c-tables.row>
                    {% endfor %}
                </tbody>
                </c-tables.table>
            {% else %}
                <c-feedback.empty-state compact icon="fas fa-user-check" title="No approved requests" message="Approved requests appear here." />
            {% endif %}
        </div>
        {# Rejected Requests #}
        <div class="pt-4 border-t border-border">
            <c-layout.section-header density="compact" title="Rejected requests" class="mb-3">
            <c-slot name="actions">
            {% if rejected_requests %}<c-badges.danger size="sm">{{ rejected_requests|length }}</c-badges.danger>{% endif %}
            </c-slot>
            </c-layout.section-header>
            {% if rejected_requests %}
                <c-tables.table>
                <c-tables.head>
                <c-tables.header-cell nowrap>User</c-tables.header-cell>
                <c-tables.header-cell>Email</c-tables.header-cell>
                <c-tables.header-cell>Rejected by</c-tables.header-cell>
                <c-tables.header-cell>Rejected</c-tables.header-cell>
                <c-tables.actions-cell as="th" label="Actions" />
                </c-tables.head>
                <tbody>
                    {% for req in rejected_requests %}
                        <c-tables.row>
                        <c-tables.cell nowrap class="font-medium">
                        {% if req.user.first_name or req.user.last_name %}
                            {{ req.user.first_name }} {{ req.user.last_name }}
                        {% else %}
                            {{ req.user.username }}
                        {% endif %}
                        </c-tables.cell>
                        <c-tables.cell muted>{{ req.user.email }}</c-tables.cell>
                        <c-tables.cell muted>
                        {% if req.decided_by %}
                            {{ req.decided_by.email }}
                        {% else %}
                            <span class="text-text-muted">—</span>
                        {% endif %}
                        </c-tables.cell>
                        <c-tables.cell muted date>{{ req.decided_at|naturaltime }}</c-tables.cell>
                        <c-tables.actions-cell>
                        <c-actions-menu label="Request actions">
                        {# djlint:off #}
                <c-dropdowns.item icon="fas fa-info-circle" data-info-request-id="{{ req.id }}" data-info-user-name="{% if req.user.first_name or req.user.last_name %}{{ req.user.first_name|escapejs }} {{ req.user.last_name|escapejs }}{% else %}{{ req.user.username|escapejs }}{% endif %}" data-info-user-email="{{ req.user.email|escapejs }}" data-info-status="{{ req.status|escapejs }}" data-info-requested-at="{{ req.requested_at|date:'F d, Y g:i A' }}" data-info-decided-at="{% if req.decided_at %}{{ req.decided_at|date:'F d, Y g:i A' }}{% endif %}" data-info-decided-by="{% if req.decided_by %}{{ req.decided_by.email|escapejs }}{% endif %}" data-info-revoked-at="{% if req.revoked_at %}{{ req.revoked_at|date:'F d, Y g:i A' }}{% endif %}" data-info-revoked-by="{% if req.revoked_by %}{{ req.revoked_by.email|escapejs }}{% endif %}" data-info-notes="{{ req.notes|default:''|escapejs }}" data-info-nda-signed="{% if req.nda_signature %}true{% else %}false{% endif %}" data-info-nda-signed-name="{% if req.nda_signature %}{{ req.nda_signature.signed_name|escapejs }}{% endif %}" data-info-nda-signed-at="{% if req.nda_signature %}{{ req.nda_signature.signed_at|date:'F d, Y g:i A' }}{% endif %}" data-info-nda-ip="{% if req.nda_signature %}{{ req.nda_signature.ip_address|default:''|escapejs }}{% endif %}" data-info-nda-user-agent="{% if req.nda_signature %}{{ req.nda_signature.user_agent|default:''|escapejs }}{% endif %}" data-info-nda-modified="{% if req.nda_signature and req.nda_signature.is_document_modified %}true{% else %}false{% endif %}" data-info-nda-current="{% if req.has_current_nda_signature %}true{% else %}false{% endif %}" data-info-nda-url="{% if req.nda_signature %}{% url 'documents:document_download' req.nda_signature.nda_document.id %}?view=inline{% endif %}" onclick="openAccessRequestInfo(this)">
                        {# djlint:on #}
                        View details
                        </c-dropdowns.item>
                        <c-dropdowns.item-danger icon="fas fa-trash" onclick="window.dispatchEvent(new CustomEvent('open-clear-rejection-modal', { detail: { requestId: '{{ req.id }}', userEmail: '{{ req.user.email|escapejs }}' } }))">
                        Remove from rejected list
                        </c-dropdowns.item-danger>
                        </c-actions-menu>
                        </c-tables.actions-cell>
                        </c-tables.row>
                    {% endfor %}
                </tbody>
                </c-tables.table>
            {% else %}
                <c-feedback.empty-state compact icon="fas fa-user-slash" title="No rejected requests" message="Rejected requests appear here." />
            {% endif %}
        </div>
    </div>
{% endif %}
</c-cards.body>
</c-cards.card>
<script>
    // Menu items call these directly, so they survive HTMX swaps and the
    // actions menu teleporting its content to the body.
    window.openAccessRequestInfo = function(button) {
        const d = button.dataset;
        window.dispatchEvent(new CustomEvent('open-access-request-info-modal', {
            detail: {
                requestId: d.infoRequestId,
                userName: d.infoUserName,
                userEmail: d.infoUserEmail,
                status: d.infoStatus,
                requestedAt: d.infoRequestedAt,
                decidedAt: d.infoDecidedAt,
                decidedBy: d.infoDecidedBy,
                revokedAt: d.infoRevokedAt,
                revokedBy: d.infoRevokedBy,
                notes: d.infoNotes,
                ndaSigned: d.infoNdaSigned === 'true',
                ndaSignedName: d.infoNdaSignedName,
                ndaSignedAt: d.infoNdaSignedAt,
                ndaIp: d.infoNdaIp,
                ndaUserAgent: d.infoNdaUserAgent,
                ndaModified: d.infoNdaModified === 'true',
                ndaCurrent: d.infoNdaCurrent === 'true',
                ndaUrl: d.infoNdaUrl
            }
        }));
    };

    window.submitAccessRequestAction = function(requestId, action) {
        const form = document.getElementById('access-request-form-' + requestId);
        if (!form) {
            console.error('Form not found for request ID:', requestId);
            return;
        }
        form.querySelectorAll('input[name="action"][type="hidden"]').forEach(input => input.remove());
        const actionInput = document.createElement('input');
        actionInput.type = 'hidden';
        actionInput.name = 'action';
        actionInput.value = action;
        form.appendChild(actionInput);
        // requestSubmit fires the submit event, which HTMX picks up
        form.requestSubmit();
    };

    window.confirmRejectAccessRequest = async function(requestId, userEmail) {
        const message = `Are you sure you want to reject the access request from ${userEmail}? This action cannot be undone.`;
        // Use window.showConfirmation if available, otherwise use native confirm
        const confirmed = typeof window.showConfirmation === 'function' ?
            await window.showConfirmation({
                title: 'Reject access request?',
                message: message,
                confirmButtonText: 'Reject',
                cancelButtonText: 'Cancel',
                type: 'warning'
            }) : confirm(message);
        if (confirmed) {
            window.submitAccessRequestAction(requestId, 'reject');
        }
    };
</script>
