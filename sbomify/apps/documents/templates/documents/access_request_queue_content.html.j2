{% load static %}
{% load humanize %}
{% load design_system %}
{# Access Requests Section #}
<div class="tw-dashboard-card mb-6">
    <div class="px-6 py-4 border-b border-border">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-info/10 flex items-center justify-center">
                    <i class="fas fa-user-clock text-info"></i>
                </div>
                <div>
                    <h5 class="text-lg font-semibold text-text m-0">Access Requests</h5>
                    <p class="text-text-muted text-sm m-0">Manage access to gated components</p>
                </div>
            </div>
            <button type="button"
                    class="tw-btn-primary tw-btn-sm"
                    onclick="window.dispatchEvent(new CustomEvent('open-invite-user-modal'))">
                <i class="fas fa-user-plus mr-1"></i>Invite
            </button>
        </div>
    </div>
    <div class="p-6 space-y-6">
        {# Pending Requests #}
        <div>
            <div class="flex items-center gap-2 mb-3">
                <h6 class="text-base font-semibold text-text m-0">Pending Requests</h6>
                {% if pending_requests %}<span class="tw-badge-warning tw-badge-sm">{{ pending_requests|length }}</span>{% endif %}
            </div>
            {% if pending_requests %}
                <div class="overflow-x-auto">
                    <table class="tw-table w-full">
                        <thead>
                            <tr>
                                <th class="text-left">User</th>
                                <th class="text-left">Email</th>
                                <th class="text-left">Requested</th>
                                <th class="text-left">NDA Signed</th>
                                <th class="tw-table-actions">
                                    <span class="sr-only">Actions</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for req in pending_requests %}
                                <tr>
                                    <td class="font-medium text-text">
                                        {% if req.user.first_name or req.user.last_name %}
                                            {{ req.user.first_name }} {{ req.user.last_name }}
                                        {% else %}
                                            {{ req.user.username }}
                                        {% endif %}
                                    </td>
                                    <td class="text-text-muted">{{ req.user.email }}</td>
                                    <td class="text-text-muted tw-cell-date">{{ req.requested_at|naturaltime }}</td>
                                    <td>
                                        {% if req.nda_signature %}
                                            {% if req.has_current_nda_signature %}
                                                {% if req.nda_signature.is_document_modified %}
                                                    <span class="tw-badge-secondary"
                                                          title="NDA document has been modified after signing">Modified</span>
                                                {% else %}
                                                    <span class="tw-badge-secondary">Yes</span>
                                                {% endif %}
                                            {% else %}
                                                <span class="tw-badge-secondary"
                                                      title="NDA version has been updated. User needs to sign the new version.">Invalid</span>
                                            {% endif %}
                                        {% else %}
                                            <span class="tw-badge-secondary">No</span>
                                        {% endif %}
                                    </td>
                                    <td class="tw-table-actions">
                                        <form method="post"
                                              action="{% url 'documents:access_request_queue' team.key %}"
                                              hx-post="{% url 'documents:access_request_queue' team.key %}"
                                              hx-target="#access-requests-wrapper"
                                              hx-swap="innerHTML"
                                              hx-trigger="submit"
                                              class="hidden"
                                              id="access-request-form-{{ req.id }}">
                                            {% csrf_token %}
                                            <input type="hidden" name="request_id" value="{{ req.id }}">
                                            <input type="hidden" name="active_tab" value="trust-center">
                                        </form>
                                        {% actions_menu label="Request actions" %}
                                        <button type="button"
                                                role="menuitem"
                                                class="tw-dropdown-item"
                                                data-info-request-id="{{ req.id }}"
                                                data-info-user-name="{% if req.user.first_name or req.user.last_name %}{{ req.user.first_name|escapejs }} {{ req.user.last_name|escapejs }}{% else %}{{ req.user.username|escapejs }}{% endif %}"
                                                data-info-user-email="{{ req.user.email|escapejs }}"
                                                data-info-status="{{ req.status|escapejs }}"
                                                data-info-requested-at="{{ req.requested_at|date:'F d, Y g:i A' }}"
                                                data-info-decided-at="{% if req.decided_at %}{{ req.decided_at|date:'F d, Y g:i A' }}{% endif %}"
                                                data-info-decided-by="{% if req.decided_by %}{{ req.decided_by.email|escapejs }}{% endif %}"
                                                data-info-revoked-at="{% if req.revoked_at %}{{ req.revoked_at|date:'F d, Y g:i A' }}{% endif %}"
                                                data-info-revoked-by="{% if req.revoked_by %}{{ req.revoked_by.email|escapejs }}{% endif %}"
                                                data-info-notes="{{ req.notes|default:''|escapejs }}"
                                                data-info-nda-signed="{% if req.nda_signature %}true{% else %}false{% endif %}"
                                                data-info-nda-signed-name="{% if req.nda_signature %}{{ req.nda_signature.signed_name|escapejs }}{% endif %}"
                                                data-info-nda-signed-at="{% if req.nda_signature %}{{ req.nda_signature.signed_at|date:'F d, Y g:i A' }}{% endif %}"
                                                data-info-nda-ip="{% if req.nda_signature %}{{ req.nda_signature.ip_address|default:''|escapejs }}{% endif %}"
                                                data-info-nda-user-agent="{% if req.nda_signature %}{{ req.nda_signature.user_agent|default:''|escapejs }}{% endif %}"
                                                data-info-nda-modified="{% if req.nda_signature and req.nda_signature.is_document_modified %}true{% else %}false{% endif %}"
                                                data-info-nda-current="{% if req.has_current_nda_signature %}true{% else %}false{% endif %}"
                                                data-info-nda-url="{% if req.nda_signature %}{% url 'documents:document_download' req.nda_signature.nda_document.id %}?view=inline{% endif %}"
                                                onclick="openAccessRequestInfo(this)">
                                            <i class="fas fa-info-circle tw-dropdown-item-icon" aria-hidden="true"></i>View details
                                        </button>
                                        <button type="button"
                                                role="menuitem"
                                                class="tw-dropdown-item"
                                                onclick="submitAccessRequestAction('{{ req.id }}', 'approve')">
                                            <i class="fas fa-check tw-dropdown-item-icon" aria-hidden="true"></i>Approve
                                        </button>
                                        <button type="button"
                                                role="menuitem"
                                                class="tw-dropdown-item tw-dropdown-item-danger"
                                                onclick="confirmRejectAccessRequest('{{ req.id }}', '{{ req.user.email|escapejs }}')">
                                            <i class="fas fa-times tw-dropdown-item-icon" aria-hidden="true"></i>Reject
                                        </button>
                                    {% endactions_menu %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="text-text-muted text-sm py-3">No pending access requests</p>
        {% endif %}
    </div>
    {# Pending Invitations #}
    <div class="pt-4 border-t border-border">
        <div class="flex items-center gap-2 mb-3">
            <h6 class="text-base font-semibold text-text m-0">Pending Invitations</h6>
            {% if pending_invitations %}<span class="tw-badge-info tw-badge-sm">{{ pending_invitations|length }}</span>{% endif %}
        </div>
        {% if pending_invitations %}
            <div class="overflow-x-auto">
                <table class="tw-table w-full">
                    <thead>
                        <tr>
                            <th class="text-left">Email</th>
                            <th class="text-left">Invited By</th>
                            <th class="text-left">Invited</th>
                            <th class="tw-table-actions">
                                <span class="sr-only">Actions</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in pending_invitations %}
                            {% with invitation=item.invitation inviter_email=item.inviter_email %}
                                <tr>
                                    <td class="font-medium text-text">{{ invitation.email }}</td>
                                    <td class="text-text-muted">
                                        {% if inviter_email %}
                                            {{ inviter_email }}
                                        {% else %}
                                            <span class="text-text-muted">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-text-muted tw-cell-date">{{ invitation.created_at|naturaltime }}</td>
                                    <td class="tw-table-actions">
                                        {% actions_menu label="Invitation actions" %}
                                        <button type="button"
                                                role="menuitem"
                                                class="tw-dropdown-item tw-dropdown-item-danger"
                                                onclick="window.dispatchEvent(new CustomEvent('open-cancel-invitation-modal', { detail: { invitationId: '{{ invitation.id }}', invitationEmail: '{{ invitation.email|escapejs }}' } }))">
                                            <i class="fas fa-times tw-dropdown-item-icon" aria-hidden="true"></i>Cancel invitation
                                        </button>
                                    {% endactions_menu %}
                                </td>
                            </tr>
                        {% endwith %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="text-text-muted text-sm py-3">No pending invitations</p>
    {% endif %}
</div>
{# Approved Requests #}
<div class="pt-4 border-t border-border">
    <div class="flex items-center gap-2 mb-3">
        <h6 class="text-base font-semibold text-text m-0">Approved Requests</h6>
        {% if approved_requests %}<span class="tw-badge-success tw-badge-sm">{{ approved_requests|length }}</span>{% endif %}
    </div>
    {% if approved_requests %}
        <div class="overflow-x-auto">
            <table class="tw-table w-full">
                <thead>
                    <tr>
                        <th class="text-left">User</th>
                        <th class="text-left">Email</th>
                        <th class="text-left">Approved By</th>
                        <th class="text-left">NDA Status</th>
                        <th class="tw-table-actions">
                            <span class="sr-only">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for req in approved_requests %}
                        <tr>
                            <td class="font-medium text-text">
                                {% if req.user.first_name or req.user.last_name %}
                                    {{ req.user.first_name }} {{ req.user.last_name }}
                                {% else %}
                                    {{ req.user.username }}
                                {% endif %}
                            </td>
                            <td class="text-text-muted">{{ req.user.email }}</td>
                            <td class="text-text-muted">
                                {% if req.decided_by %}
                                    {{ req.decided_by.email }}
                                {% else %}
                                    <span class="text-text-muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if req.nda_signature %}
                                    {% if req.has_current_nda_signature %}
                                        {% if req.nda_signature.is_document_modified %}
                                            <span class="tw-badge-secondary"
                                                  title="NDA document has been modified after signing">Modified</span>
                                        {% else %}
                                            <span class="tw-badge-secondary">Valid</span>
                                        {% endif %}
                                    {% else %}
                                        <span class="tw-badge-secondary"
                                              title="NDA version has been updated. User needs to sign the new version.">Invalid</span>
                                    {% endif %}
                                {% else %}
                                    <span class="text-text-muted">—</span>
                                {% endif %}
                            </td>
                            <td class="tw-table-actions">
                                {% actions_menu label="Request actions" %}
                                <button type="button"
                                        role="menuitem"
                                        class="tw-dropdown-item"
                                        data-info-request-id="{{ req.id }}"
                                        data-info-user-name="{% if req.user.first_name or req.user.last_name %}{{ req.user.first_name|escapejs }} {{ req.user.last_name|escapejs }}{% else %}{{ req.user.username|escapejs }}{% endif %}"
                                        data-info-user-email="{{ req.user.email|escapejs }}"
                                        data-info-status="{{ req.status|escapejs }}"
                                        data-info-requested-at="{{ req.requested_at|date:'F d, Y g:i A' }}"
                                        data-info-decided-at="{% if req.decided_at %}{{ req.decided_at|date:'F d, Y g:i A' }}{% endif %}"
                                        data-info-decided-by="{% if req.decided_by %}{{ req.decided_by.email|escapejs }}{% endif %}"
                                        data-info-revoked-at="{% if req.revoked_at %}{{ req.revoked_at|date:'F d, Y g:i A' }}{% endif %}"
                                        data-info-revoked-by="{% if req.revoked_by %}{{ req.revoked_by.email|escapejs }}{% endif %}"
                                        data-info-notes="{{ req.notes|default:''|escapejs }}"
                                        data-info-nda-signed="{% if req.nda_signature %}true{% else %}false{% endif %}"
                                        data-info-nda-signed-name="{% if req.nda_signature %}{{ req.nda_signature.signed_name|escapejs }}{% endif %}"
                                        data-info-nda-signed-at="{% if req.nda_signature %}{{ req.nda_signature.signed_at|date:'F d, Y g:i A' }}{% endif %}"
                                        data-info-nda-ip="{% if req.nda_signature %}{{ req.nda_signature.ip_address|default:''|escapejs }}{% endif %}"
                                        data-info-nda-user-agent="{% if req.nda_signature %}{{ req.nda_signature.user_agent|default:''|escapejs }}{% endif %}"
                                        data-info-nda-modified="{% if req.nda_signature and req.nda_signature.is_document_modified %}true{% else %}false{% endif %}"
                                        data-info-nda-current="{% if req.has_current_nda_signature %}true{% else %}false{% endif %}"
                                        data-info-nda-url="{% if req.nda_signature %}{% url 'documents:document_download' req.nda_signature.nda_document.id %}?view=inline{% endif %}"
                                        onclick="openAccessRequestInfo(this)">
                                    <i class="fas fa-info-circle tw-dropdown-item-icon" aria-hidden="true"></i>View details
                                </button>
                                <button type="button"
                                        role="menuitem"
                                        class="tw-dropdown-item tw-dropdown-item-danger"
                                        onclick="window.dispatchEvent(new CustomEvent('open-revoke-access-modal', { detail: { requestId: '{{ req.id }}', userEmail: '{{ req.user.email|escapejs }}' } }))">
                                    <i class="fas fa-ban tw-dropdown-item-icon" aria-hidden="true"></i>Revoke access
                                </button>
                            {% endactions_menu %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <p class="text-text-muted text-sm py-3">No approved access requests</p>
{% endif %}
</div>
{# Rejected Requests #}
<div class="pt-4 border-t border-border">
    <div class="flex items-center gap-2 mb-3">
        <h6 class="text-base font-semibold text-text m-0">Rejected Requests</h6>
        {% if rejected_requests %}<span class="tw-badge-danger tw-badge-sm">{{ rejected_requests|length }}</span>{% endif %}
    </div>
    {% if rejected_requests %}
        <div class="overflow-x-auto">
            <table class="tw-table w-full">
                <thead>
                    <tr>
                        <th class="text-left">User</th>
                        <th class="text-left">Email</th>
                        <th class="text-left">Rejected By</th>
                        <th class="text-left">Rejected</th>
                        <th class="tw-table-actions">
                            <span class="sr-only">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for req in rejected_requests %}
                        <tr>
                            <td class="font-medium text-text">
                                {% if req.user.first_name or req.user.last_name %}
                                    {{ req.user.first_name }} {{ req.user.last_name }}
                                {% else %}
                                    {{ req.user.username }}
                                {% endif %}
                            </td>
                            <td class="text-text-muted">{{ req.user.email }}</td>
                            <td class="text-text-muted">
                                {% if req.decided_by %}
                                    {{ req.decided_by.email }}
                                {% else %}
                                    <span class="text-text-muted">—</span>
                                {% endif %}
                            </td>
                            <td class="text-text-muted tw-cell-date">{{ req.decided_at|naturaltime }}</td>
                            <td class="tw-table-actions">
                                {% actions_menu label="Request actions" %}
                                <button type="button"
                                        role="menuitem"
                                        class="tw-dropdown-item"
                                        data-info-request-id="{{ req.id }}"
                                        data-info-user-name="{% if req.user.first_name or req.user.last_name %}{{ req.user.first_name|escapejs }} {{ req.user.last_name|escapejs }}{% else %}{{ req.user.username|escapejs }}{% endif %}"
                                        data-info-user-email="{{ req.user.email|escapejs }}"
                                        data-info-status="{{ req.status|escapejs }}"
                                        data-info-requested-at="{{ req.requested_at|date:'F d, Y g:i A' }}"
                                        data-info-decided-at="{% if req.decided_at %}{{ req.decided_at|date:'F d, Y g:i A' }}{% endif %}"
                                        data-info-decided-by="{% if req.decided_by %}{{ req.decided_by.email|escapejs }}{% endif %}"
                                        data-info-revoked-at="{% if req.revoked_at %}{{ req.revoked_at|date:'F d, Y g:i A' }}{% endif %}"
                                        data-info-revoked-by="{% if req.revoked_by %}{{ req.revoked_by.email|escapejs }}{% endif %}"
                                        data-info-notes="{{ req.notes|default:''|escapejs }}"
                                        data-info-nda-signed="{% if req.nda_signature %}true{% else %}false{% endif %}"
                                        data-info-nda-signed-name="{% if req.nda_signature %}{{ req.nda_signature.signed_name|escapejs }}{% endif %}"
                                        data-info-nda-signed-at="{% if req.nda_signature %}{{ req.nda_signature.signed_at|date:'F d, Y g:i A' }}{% endif %}"
                                        data-info-nda-ip="{% if req.nda_signature %}{{ req.nda_signature.ip_address|default:''|escapejs }}{% endif %}"
                                        data-info-nda-user-agent="{% if req.nda_signature %}{{ req.nda_signature.user_agent|default:''|escapejs }}{% endif %}"
                                        data-info-nda-modified="{% if req.nda_signature and req.nda_signature.is_document_modified %}true{% else %}false{% endif %}"
                                        data-info-nda-current="{% if req.has_current_nda_signature %}true{% else %}false{% endif %}"
                                        data-info-nda-url="{% if req.nda_signature %}{% url 'documents:document_download' req.nda_signature.nda_document.id %}?view=inline{% endif %}"
                                        onclick="openAccessRequestInfo(this)">
                                    <i class="fas fa-info-circle tw-dropdown-item-icon" aria-hidden="true"></i>View details
                                </button>
                                <button type="button"
                                        role="menuitem"
                                        class="tw-dropdown-item tw-dropdown-item-danger"
                                        onclick="window.dispatchEvent(new CustomEvent('open-clear-rejection-modal', { detail: { requestId: '{{ req.id }}', userEmail: '{{ req.user.email|escapejs }}' } }))">
                                    <i class="fas fa-trash tw-dropdown-item-icon" aria-hidden="true"></i>Remove from rejected list
                                </button>
                            {% endactions_menu %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <p class="text-text-muted text-sm py-3">No rejected access requests</p>
{% endif %}
</div>
</div>
</div>
<script>
    // Menu items call these directly, so they survive HTMX swaps and the
    // actions menu teleporting its content to the body.
    window.openAccessRequestInfo = function(button) {
        const d = button.dataset;
        window.dispatchEvent(new CustomEvent('open-access-request-info-modal', {
            detail: {
                requestId: d.infoRequestId,
                userName: d.infoUserName,
                userEmail: d.infoUserEmail,
                status: d.infoStatus,
                requestedAt: d.infoRequestedAt,
                decidedAt: d.infoDecidedAt,
                decidedBy: d.infoDecidedBy,
                revokedAt: d.infoRevokedAt,
                revokedBy: d.infoRevokedBy,
                notes: d.infoNotes,
                ndaSigned: d.infoNdaSigned === 'true',
                ndaSignedName: d.infoNdaSignedName,
                ndaSignedAt: d.infoNdaSignedAt,
                ndaIp: d.infoNdaIp,
                ndaUserAgent: d.infoNdaUserAgent,
                ndaModified: d.infoNdaModified === 'true',
                ndaCurrent: d.infoNdaCurrent === 'true',
                ndaUrl: d.infoNdaUrl
            }
        }));
    };

    window.submitAccessRequestAction = function(requestId, action) {
        const form = document.getElementById('access-request-form-' + requestId);
        if (!form) {
            console.error('Form not found for request ID:', requestId);
            return;
        }
        form.querySelectorAll('input[name="action"][type="hidden"]').forEach(input => input.remove());
        const actionInput = document.createElement('input');
        actionInput.type = 'hidden';
        actionInput.name = 'action';
        actionInput.value = action;
        form.appendChild(actionInput);
        // requestSubmit fires the submit event, which HTMX picks up
        form.requestSubmit();
    };

    window.confirmRejectAccessRequest = async function(requestId, userEmail) {
        const message = `Are you sure you want to reject the access request from ${userEmail}? This action cannot be undone.`;
        // Use window.showConfirmation if available, otherwise use native confirm
        const confirmed = typeof window.showConfirmation === 'function' ?
            await window.showConfirmation({
                title: 'Reject Access Request?',
                message: message,
                confirmButtonText: 'Reject',
                cancelButtonText: 'Cancel',
                type: 'warning'
            }) : confirm(message);
        if (confirmed) {
            window.submitAccessRequestAction(requestId, 'reject');
        }
    };
</script>
