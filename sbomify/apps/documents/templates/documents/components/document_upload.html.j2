<div class="contents"
     x-data="uploadDialog"
     @open-upload.window="uploadOpen = true"
     @close-upload.window="uploadOpen = false"
     @hashchange.window="openFromHash()">
    <c-modal id="upload-document" show="uploadOpen" title="Upload document" icon="fas fa-upload" x-data="documentUpload('{{ component_id }}', {{ max_upload_size_mb }})" x-init="documentTypeSubcategories = window.parseJsonScript('document-type-subcategories-{{ component_id }}')">
    {% with subcategories_id='document-type-subcategories-'|add:component_id %}
        {{ document_type_subcategories|json_script:subcategories_id }}
    {% endwith %}
    <div class="flex flex-col gap-4">
        <c-feedback.alert variant="info" title="Document upload">
        Upload specifications, reports or other documents for this component.
        </c-feedback.alert>
        <c-forms.field label="Version" for="document-version" required hint="Specify the version of this document.">
        <c-forms.input id="document-version" type="text" placeholder="e.g., 1.0, v2.1, latest" required x-model="documentVersion" />
        </c-forms.field>
        <c-forms.field label="Document type" for="document-type" hint="Choose a type to help identify this document.">
        <c-forms.select id="document-type" x-model="documentType" @change="documentSubcategory = ''">
        <option value="">Select document type (optional)</option>
        <optgroup label="Technical Documentation">
            <option value="specification">Specification</option>
            <option value="manual">Manual</option>
            <option value="readme">README</option>
            <option value="documentation">Documentation</option>
            <option value="build-instructions">Build Instructions</option>
            <option value="configuration">Configuration</option>
        </optgroup>
        <optgroup label="Legal and Compliance">
            <option value="license">License</option>
            <option value="nda">NDA</option>
            <option value="compliance">Compliance</option>
            <option value="evidence">Evidence</option>
        </optgroup>
        <optgroup label="Release Information">
            <option value="changelog">Changelog</option>
            <option value="release-notes">Release Notes</option>
        </optgroup>
        <optgroup label="Security Documents">
            <option value="security-advisory">Security Advisory</option>
            <option value="vulnerability-report">Vulnerability Report</option>
            <option value="threat-model">Threat Model</option>
            <option value="risk-assessment">Risk Assessment</option>
            <option value="pentest-report">Penetration Test Report</option>
        </optgroup>
        <optgroup label="Analysis Reports">
            <option value="static-analysis">Static Analysis Report</option>
            <option value="dynamic-analysis">Dynamic Analysis Report</option>
            <option value="quality-metrics">Quality Metrics</option>
            <option value="maturity-report">Maturity Report</option>
            <option value="report">Report</option>
        </optgroup>
        <optgroup label="Other">
            <option value="other">Other</option>
        </optgroup>
        </c-forms.select>
        </c-forms.field>
        <template x-for="(subcategoryInfo, docType) in documentTypeSubcategories"
                  :key="docType">
            <c-forms.field x-show="documentType === docType" hint="Choose a subcategory to help identify this document.">
            <c-forms.label ::for="'document-subcategory-' + docType"><span x-text="subcategoryInfo.label"></span></c-forms.label>
            <c-forms.select x-model="documentSubcategory" ::id="'document-subcategory-' + docType" ::name="subcategoryInfo.field_name">
            <option value="">Select subcategory (optional)</option>
            <template x-for="[value, label] in subcategoryInfo.choices" :key="value">
                <option :value="value" x-text="label"></option>
            </template>
            </c-forms.select>
            </c-forms.field>
        </template>
        <c-forms.field label="Description" for="document-description">
        <c-forms.textarea id="document-description" rows="3" placeholder="Brief description of this document (optional)" x-model="documentDescription" />
        </c-forms.field>
        <div @drop.prevent="handleDrop($event)"
             @dragover.prevent="isDragOver = true"
             @dragleave.prevent="isDragOver = false"
             @dragenter.prevent>
            <template x-if="!selectedFile && !isUploading">
                <c-forms.file-upload active="isDragOver" accept=".pdf,.doc,.docx,.txt,.md,.html,.json,.xml,.yaml,.yml" icon="fas fa-cloud-upload-alt" on_change="handleFileSelect($event)" hint="Supports PDF, Word, text, markdown, and other document formats (max {{ max_upload_size_mb }}MB)">
                <strong>Drop your document file here</strong> or <span class="text-primary font-medium">click to browse</span>
                </c-forms.file-upload>
            </template>
            <template x-if="selectedFile && !isUploading">
                <c-forms.file-preview>
                <c-slot name="name"><span x-text="selectedFile.name"></span></c-slot>
                <c-slot name="size"><span x-text="formatFileSize(selectedFile.size)"></span></c-slot>
                <c-slot name="action">
                <c-buttons.icon label="Remove selected file" title="Remove file" @click="clearSelectedFile()">
                <i class="fas fa-times" aria-hidden="true"></i>
                </c-buttons.icon>
                </c-slot>
                </c-forms.file-preview>
            </template>
            <template x-if="isUploading">
                <c-forms.file-upload static>
                <c-feedback.spinner size="sm" message="Uploading document">Uploading and processing document...</c-feedback.spinner>
                </c-forms.file-upload>
            </template>
        </div>
        <template x-if="selectedFile && !isUploading">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <c-forms.hint>Review the details before uploading.</c-forms.hint>
                <div class="flex gap-3">
                    <c-buttons.secondary @click="clearSelectedFile()">Cancel</c-buttons.secondary>
                    <c-buttons.primary ::disabled="!isFormValid" @click="saveDocument()">
                    <i class="fas fa-save mr-2"></i>
                    Save document
                    </c-buttons.primary>
                </div>
            </div>
        </template>
    </div>
    </c-modal>
</div>
