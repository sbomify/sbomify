<div x-data="{ open: false, documentTypeSubcategories: {} }"
     x-init="documentTypeSubcategories = JSON.parse(document.getElementById('edit-document-subcategories-{{ component_id }}').textContent)"
     @open-edit-document-modal.window="open = true">
    {% comment %}
        Parsed the same way the upload form parses it, from a string the view
        already json.dumps'd, so json_script would encode it twice.
    {% endcomment %}
    <script type="application/json"
            id="edit-document-subcategories-{{ component_id }}">{{ document_type_subcategories_json|safe }}</script>
    {% comment %}
        The form stays in the body and the actions sit in the footer band,
        associated with it by id, which is how a dialog keeps one submit for a
        body that scrolls under the 90vh cap.
    {% endcomment %}
    <c-modal id="edit-document-modal" show="open" title="Edit Document">
    <form id="edit-document-form"
          hx-post="{% url 'documents:documents_table' component_id %}"
          hx-disabled-elt="find button[type='submit']"
          hx-swap="none"
          @htmx:after-request="if($event.detail.successful) open = false">
        {% csrf_token %}
        <input type="hidden" name="_method" value="PATCH">
        <input type="hidden" name="document_id" x-model="editForm.document_id">
        <div class="mb-4">
            <c-forms.label for="edit-document-name" required>Name</c-forms.label>
            <c-forms.input id="edit-document-name" name="name" required x-model="editForm.name" />
        </div>
        <div class="mb-4">
            <c-forms.label for="edit-document-version" required>Version</c-forms.label>
            <c-forms.input id="edit-document-version" name="version" required x-model="editForm.version" />
        </div>
        <div class="mb-4">
            <c-forms.label for="edit-document-type" required>Document Type</c-forms.label>
            <c-forms.select id="edit-document-type" name="document_type" required x-model="editForm.document_type">
            <option value="">Select a type...</option>
            {% for value, label in document_type_choices %}<option value="{{ value }}">{{ label }}</option>{% endfor %}
            </c-forms.select>
        </div>
        {% comment %}
            The subcategory a document type carries, for the types that have
            one. Same map the upload form reads, built from the model choices,
            so a subcategory added to the model shows up in both without either
            template learning its name.

            Editing needs it as much as uploading does: without this control a
            report uploaded as plain "SOC 2" before the Type I / Type II split
            can never be re-tagged, and a mis-tagged one can never be corrected.
        {% endcomment %}
        <template x-for="(subcategoryInfo, docType) in documentTypeSubcategories"
                  :key="docType">
            <div class="mb-4" x-show="editForm.document_type === docType">
                <c-forms.label ::for="'edit-document-subcategory-' + docType">
                <span x-text="subcategoryInfo.label"></span>
                </c-forms.label>
                <c-forms.select x-model="editForm.compliance_subcategory" ::id="'edit-document-subcategory-' + docType" ::name="subcategoryInfo.field_name">
                <option value="">Select subcategory (optional)</option>
                <template x-for="[value, label] in subcategoryInfo.choices" :key="value">
                    <option :value="value" x-text="label"></option>
                </template>
                </c-forms.select>
            </div>
        </template>
        <div>
            <c-forms.label for="edit-document-description">Description</c-forms.label>
            <c-forms.textarea id="edit-document-description" name="description" rows="3" x-model="editForm.description" />
        </div>
    </form>
    <c-slot name="footer">
    <c-buttons.ghost @click="open = false">Cancel</c-buttons.ghost>
    <c-buttons.primary type="submit" form="edit-document-form">Save Changes</c-buttons.primary>
    </c-slot>
    </c-modal>
</div>
