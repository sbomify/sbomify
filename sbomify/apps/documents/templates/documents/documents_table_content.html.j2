{# The documents table body. Rows come from the documents projection via json_script and are paged in the browser by documentsTable. #}
{% if not documents %}
    <c-feedback.empty-state icon="fas fa-file-alt" icon_size="sm" icon_variant="neutral" message="No documents found for this component." />
{% else %}
    {# Inside the card on the private page the card draws the frame, so the shell drops its own. #}
    <c-tables.shell :nested="table_nested">
    <c-tables.toolbar>
    <c-tables.search id="documents-search" label="Search documents" placeholder="Search documents..." x-model="search" @input="currentPage = 1" />
    <c-slot name="right">
    <c-tables.page-size id="documents-per-page" x-model.number="pageSize" @change="currentPage = 1">
    <template x-for="size in pageSizeOptions" :key="size">
        <option :value="size" x-text="size"></option>
    </template>
    </c-tables.page-size>
    </c-slot>
    </c-tables.toolbar>
    <c-tables.table>
    <c-tables.head>
    <c-tables.header-cell sort="name" nowrap>Name</c-tables.header-cell>
    <c-tables.header-cell sort="document_type" class="hidden md:table-cell">Type</c-tables.header-cell>
    <c-tables.header-cell sort="version" class="hidden md:table-cell">Version</c-tables.header-cell>
    <c-tables.header-cell sort="created_at" date>Created</c-tables.header-cell>
    <c-tables.header-cell class="hidden lg:table-cell">Releases</c-tables.header-cell>
    <c-tables.actions-cell as="th" label="Actions" />
    </c-tables.head>
    <tbody>
        <template x-for="item in paginatedData" :key="item.document.id">
            <c-tables.row>
            <c-tables.cell nowrap>
            <a :href="'{% if is_public_view %}{% url 'core:component_item_public' component_id=component_id item_type='documents' item_id='DOC_ID' %}{% else %}{% url 'core:component_item' component_id=component_id item_type='documents' item_id='DOC_ID' %}{% endif %}'.replace('DOC_ID', item.document.id)"
               class="text-primary font-medium hover:underline"
               x-text="item.document.name"></a>
            {# Mobile: Show type #}
            <div class="md:hidden mt-1">
                <c-badges.warning x-text="item.document.document_type_display || 'Document'" />
            </div>
            </c-tables.cell>
            <c-tables.cell class="hidden md:table-cell">
            <c-badges.warning x-text="item.document.document_type_display || 'Document'" />
            </c-tables.cell>
            <c-tables.cell class="hidden md:table-cell">
            <span class="text-text"
                  x-text="item.document.version.length > 20 ? item.document.version.slice(0, 20) + '...' : item.document.version"
                  :title="item.document.version"></span>
            </c-tables.cell>
            <c-tables.cell date>
            <span class="text-text-muted text-sm"
                  x-text="new Date(item.document.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })"></span>
            </c-tables.cell>
            <c-tables.cell class="hidden lg:table-cell">
            <template x-if="item.releases && item.releases.length > 0">
                <div class="flex flex-wrap gap-1">
                    <template x-for="release in item.releases.slice(0, 2)" :key="release.id">
                        <c-badges.secondary x-text="release.name || release.version" />
                    </template>
                    <template x-if="item.releases.length > 2">
                        <c-badges.secondary x-text="'+' + (item.releases.length - 2)" />
                    </template>
                </div>
            </template>
            <template x-if="!item.releases || item.releases.length === 0">
                <span class="text-text-muted">—</span>
            </template>
            </c-tables.cell>
            <c-tables.actions-cell>
            <c-actions-menu label="Document actions" width="w-56">
            <c-dropdowns.item icon="fas fa-download" href="#" ::href="'{% url 'documents:document_download' 'DOC_ID' %}'.replace('DOC_ID', item.document.id)">
            Download
            </c-dropdowns.item>
            {% if has_crud_permissions %}
                <c-dropdowns.item icon="fas fa-edit" @click="$dispatch('open-edit-document-modal'); editDocument(item.document.id)">
                Edit
                </c-dropdowns.item>
                <c-dropdowns.item-danger icon="fas fa-trash" @click="$dispatch('open-delete-document-modal', { displayName: item.document.name, formData: { document_id: item.document.id } })">
                Delete
                </c-dropdowns.item-danger>
            {% endif %}
            </c-actions-menu>
            </c-tables.actions-cell>
            </c-tables.row>
        </template>
        <template x-if="paginatedData.length === 0 && search">
            <tr>
                <td colspan="6" class="text-center py-8 text-text-muted">
                    <i class="fas fa-search text-2xl mb-2 opacity-50"></i>
                    <p>No documents match your search</p>
                    <button @click="search = ''"
                            class="mt-3 text-xs text-primary hover:underline">Clear search</button>
                </td>
            </tr>
        </template>
    </tbody>
    </c-tables.table>
    <c-tables.footer>
    <c-tables.info>
    Showing <strong x-text="startItem"></strong> to <strong x-text="endItem"></strong> of <strong x-text="filteredData.length"></strong> entries
    <template x-if="search">
        <span>(filtered from <strong x-text="allDocuments.length"></strong> total)</span>
    </template>
    </c-tables.info>
    <c-tables.pager />
    </c-tables.footer>
    </c-tables.shell>
{% endif %}
