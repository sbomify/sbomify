{% extends "core/public_base.htmx.j2" %}
{% block title %}Request access - {{ team.name }}{% endblock %}
{% block content %}
    <c-layout.frame class="max-w-lg mx-auto">
    <c-branded.page-header title="Request access" lede="Request access to download gated components from {{ team.name }}." />
    <c-branded.surface>
    <form method="post"
          action="{% url 'documents:request_access' team.key %}"
          class="flex flex-col gap-5">
        {% csrf_token %}
        {% if was_rejected %}
            <c-feedback.alert>Your earlier request was not approved. You can submit a new one.</c-feedback.alert>
        {% endif %}
        {% if not user %}
            <c-forms.field label="Email address" for="email" required>
            <c-forms.input id="email" name="email" type="email" required placeholder="your.email@example.com" autocomplete="email" />
            </c-forms.field>
            <c-forms.field label="Name (optional)" for="name">
            <c-forms.input id="name" name="name" placeholder="Your name" autocomplete="name" />
            </c-forms.field>
        {% else %}
            <c-typography.description>Requesting as {{ user.email }}.</c-typography.description>
        {% endif %}
        {% if requires_nda %}
            <c-feedback.alert variant="warning" title="NDA required" icon="fas fa-file-signature">
            You will be asked to sign a Non-Disclosure Agreement after submitting this request.
            </c-feedback.alert>
        {% endif %}
        <div class="flex flex-wrap gap-3">
            <c-buttons.secondary type="submit">
            <i class="fas fa-paper-plane" aria-hidden="true"></i>Request access
            </c-buttons.secondary>
            <c-buttons.secondary href="{% url 'core:workspace_public' workspace_key=team.key %}">Cancel</c-buttons.secondary>
        </div>
    </form>
    </c-branded.surface>
    </c-layout.frame>
{% endblock %}
