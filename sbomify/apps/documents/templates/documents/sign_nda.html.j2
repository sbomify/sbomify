{% extends "core/public_base.htmx.j2" %}
{% block title %}Sign NDA - {{ team.name }}{% endblock %}
{% block content %}
    <c-layout.frame class="max-w-3xl mx-auto">
    <c-branded.page-header title="Sign Non-Disclosure Agreement" lede="Review and sign the NDA to complete your access request for {{ team.name }}." />
    <c-branded.surface>
    <form method="post"
          action="{% url 'documents:sign_nda' team.key access_request.id %}"
          class="flex flex-col gap-5">
        {% csrf_token %}
        <c-branded.section-header title="NDA document">
        <c-slot name="action">
        <div class="flex flex-wrap items-center gap-3">
            {% if nda_document.file_size %}
                <c-typography.description size="sm">{{ nda_document.file_size|filesizeformat }}</c-typography.description>
            {% endif %}
            <c-buttons.secondary href="{% url 'documents:document_download' nda_document.id %}?view=inline" target="_blank" rel="noopener" size="sm">
            <i class="fas fa-external-link-alt" aria-hidden="true"></i>Open in new tab
            </c-buttons.secondary>
        </div>
        </c-slot>
        </c-branded.section-header>
        <c-branded.surface flush>
        <iframe src="{% url 'documents:document_download' nda_document.id %}?view=inline"
                title="NDA document"
                class="w-full h-96 border-0"></iframe>
        </c-branded.surface>
        <c-forms.field label="Full name" for="signed_name" required hint="This name will be recorded with your NDA signature.">
        <c-forms.input id="signed_name" name="signed_name" required placeholder="Enter your full name" autocomplete="name" />
        </c-forms.field>
        <c-forms.checkbox id="consent" name="consent" value="on" required>
        I have read and agree to the terms of the Non-Disclosure Agreement
        </c-forms.checkbox>
        <c-feedback.alert variant="warning" title="Before you sign">
        By signing this NDA, you agree to keep confidential information secure.
        Your signature, IP address, and timestamp will be recorded.
        </c-feedback.alert>
        <div class="flex flex-wrap gap-3">
            <c-buttons.secondary type="submit">
            <i class="fas fa-signature" aria-hidden="true"></i>Sign NDA and submit request
            </c-buttons.secondary>
            <c-buttons.secondary href="{% url 'core:workspace_public' workspace_key=team.key %}">Cancel</c-buttons.secondary>
        </div>
    </form>
    </c-branded.surface>
    </c-layout.frame>
{% endblock %}
