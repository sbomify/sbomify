{% comment %}
Connecting a provider whose API only answers the workspace's own application:
the steps to create one there, and the two fields to paste its credentials in.

Posted over HTMX to the panel, so a refusal comes back as this form with the
reason above the fields and the client ID still filled in, instead of a
redirect and a toast that reads as being bounced back. The action URL is the
fallback without JavaScript. The secret field is a password input with
autocomplete off and is never filled back in.
{% endcomment %}
<form method="post"
      action="{% url 'integrations:connect' team.key card.provider.key %}"
      hx-post="{% url 'integrations:panel' team.key %}"
      hx-target="#integrations-wrapper"
      hx-swap="innerHTML"
      hx-disabled-elt="find button[type='submit']"
      class="mt-6 space-y-4 max-w-[36rem]">
    {% csrf_token %}
    <input type="hidden" name="action" value="connect">
    <input type="hidden" name="provider" value="{{ card.provider.key }}">
    {% if card.provider.setup_template %}
        {% include card.provider.setup_template %}
    {% endif %}
    {% if card.credentials_error %}
        <c-feedback.alert variant="danger" title="Could not connect {{ card.provider.name }}">
        {{ card.credentials_error }}
        </c-feedback.alert>
    {% endif %}
    <c-forms.field label="Client ID" for="{{ card.provider.key }}-client-id" hint="{{ card.provider.client_id_hint }}" required>
    <c-forms.input name="client_id" id="{{ card.provider.key }}-client-id" value="{{ card.credentials_client_id|default:'' }}" size="sm" required autocomplete="off" spellcheck="false" />
    </c-forms.field>
    <c-forms.field label="Client secret" for="{{ card.provider.key }}-client-secret" hint="{{ card.provider.client_credential_hint }}" required>
    <c-forms.input type="password" name="client_secret" id="{{ card.provider.key }}-client-secret" size="sm" required autocomplete="off" spellcheck="false" />
    </c-forms.field>
    <c-buttons.primary size="sm" type="submit">
    {% if card.needs_reconnect %}
        Reconnect {{ card.provider.name }}
    {% else %}
        Connect {{ card.provider.name }}
    {% endif %}
    </c-buttons.primary>
</form>
