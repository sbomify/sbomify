{% comment %}
Connecting a provider whose API only answers the workspace's own application:
the steps to create one there, and the two fields to paste its credentials in.

A plain form post, like the Connect button: the view redirects back to this
tab with a message either way. The secret field is a password input with
autocomplete off and is never filled back in, so a failed attempt asks for it
again rather than putting it in the page.
{% endcomment %}
<form method="post"
      action="{% url 'integrations:connect' team.key card.provider.key %}"
      class="mt-6 space-y-4 max-w-[36rem]">
    {% csrf_token %}
    <div>
        <h4 class="text-sm font-semibold text-text m-0">Connect with your own {{ card.provider.name }} application</h4>
        <ol class="mt-2 space-y-1 list-decimal pl-5 text-sm text-text-muted">
            {% for step in card.provider.setup_steps %}<li>{{ step }}</li>{% endfor %}
        </ol>
        <a href="{{ card.provider.docs_url }}"
           target="_blank"
           rel="noopener"
           class="inline-block mt-2 text-sm font-medium">{{ card.provider.name }} docs</a>
    </div>
    <c-forms.field label="Client ID" for="{{ card.provider.key }}-client-id" required>
    <c-forms.input name="client_id" id="{{ card.provider.key }}-client-id" size="sm" required autocomplete="off" spellcheck="false" />
    </c-forms.field>
    <c-forms.field label="Client secret" for="{{ card.provider.key }}-client-secret" required>
    <c-forms.input type="password" name="client_secret" id="{{ card.provider.key }}-client-secret" size="sm" required autocomplete="off" spellcheck="false" />
    </c-forms.field>
    <c-buttons.primary size="sm" type="submit">
    {% if card.needs_reconnect %}
        Reconnect {{ card.provider.name }}
    {% else %}
        Connect {{ card.provider.name }}
    {% endif %}
    </c-buttons.primary>
</form>
