{% comment %}
    Trusted Publishers section for a Component.

    Rendered both:
      * on page load, into the trusted-publishers modal body (the hx-get='load'
        shell in core/components/trusted_publishers_modal.html.j2)
      * as an HTMX swap target after create/delete

    The whole section is the swap target (id="trusted-publishers-section")
    so create + delete + form errors all land back into the same shell. The
    modal owns the title and chrome, so this renders bare content.

    The revoke control stays an inline icon button rather than moving into
    c-actions-menu: the modal around it is z-[100] and a dropdown panel is
    z-50, so a menu opened here would render under the dialog.

    NOTE: this file is rendered by Django's template engine despite the
    ``.html.j2`` extension (sbomify-wide convention — see CLAUDE.md).
    Django's ``{# ... #}`` comments are single-line per the engine's
    spec; multi-line block comments need the ``{% comment %}`` tag,
    otherwise the second line is parsed as template content. Jinja2
    proper would tolerate multi-line ``{# ... #}`` — we don't have that
    parser here.
{% endcomment %}
<section id="trusted-publishers-section">
<div class="space-y-4">
<p class="text-sm text-text-muted m-0">
Authorise a GitHub repository to push SBOMs and documents to this
component without long-lived secrets. Tokens are issued from the
workflow's OIDC identity and are valid for 15 minutes.
</p>
{% if bindings %}
<c-tables.table>
<c-tables.head>
<c-tables.header-cell>Provider</c-tables.header-cell>
<c-tables.header-cell nowrap>Repository</c-tables.header-cell>
<c-tables.header-cell>Added by</c-tables.header-cell>
<c-tables.header-cell date>Last used</c-tables.header-cell>
<c-tables.actions-cell as="th" />
</c-tables.head>
<tbody>
{% for binding in bindings %}
<c-tables.row>
<c-tables.cell>
<c-badges.secondary>
<i class="fab fa-github mr-1"></i>{{ binding.get_provider_display }}
</c-badges.secondary>
</c-tables.cell>
<c-tables.cell nowrap>
<div class="flex items-center gap-2">
<code class="text-sm font-medium">{{ binding.repository }}</code>
<a href="https://github.com/{{ binding.repository }}" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary transition-colors" title="Open on GitHub">
<i class="fas fa-arrow-up-right-from-square text-xs"></i>
</a>
</div>
<div class="text-xs text-text-muted mt-1 font-mono" title="Immutable IDs used to defeat account-resurrection attacks. Pinned at setup for public repos; pinned from the first OIDC publish for private repos.">
{% if binding.repository_id %}
owner_id={{ binding.repository_owner_id }} ·
repo_id={{ binding.repository_id }}
{% else %}
<span class="italic">awaiting first publish, IDs pin automatically</span>
{% endif %}
</div>
</c-tables.cell>
{% comment %}
    The muted ink sits on a wrapper rather than on the cell: the cell owns its
    own colour and its own size, and a second one beside it would be resolved
    by stylesheet order. text-sm here is the size these two columns always had.
{% endcomment %}
<c-tables.cell>
<div class="text-sm text-text-muted">
{% if binding.created_by %}
{{ binding.created_by.get_full_name|default:binding.created_by.username }}
{% else %}
—
{% endif %}
<div class="text-xs">{{ binding.created_at|date:"Y-m-d" }}</div>
</div>
</c-tables.cell>
<c-tables.cell date>
<div class="text-sm text-text-muted">
{% if binding.last_used_at %}
{{ binding.last_used_at|date:"Y-m-d H:i" }} UTC
{% else %}
<span class="italic">never</span>
{% endif %}
</div>
</c-tables.cell>
<c-tables.actions-cell>
<c-buttons.icon variant="danger" size="sm" label="Revoke trusted publisher" hx-post="{% url 'oidc:trusted_publisher_delete' component_id=component.id binding_id=binding.id %}" hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}' hx-target="#trusted-publishers-section" hx-swap="outerHTML" hx-confirm="Remove the trusted-publisher binding for '{{ binding.repository }}'? This will immediately revoke every short-lived token it ever issued." title="Revoke this trusted publisher">
<i class="fas fa-trash" aria-hidden="true"></i>
</c-buttons.icon>
</c-tables.actions-cell>
</c-tables.row>
{% endfor %}
</tbody>
</c-tables.table>
{% else %}
<c-feedback.empty-state icon="fas fa-shield-halved" title="No trusted publishers yet" message="Add a repository below. Its workflow authenticates with OIDC, no long-lived API tokens required." />
{% endif %}
<div class="pt-1">
<form method="post" hx-post="{% url 'oidc:trusted_publishers' component_id=component.id %}" hx-target="#trusted-publishers-section" hx-swap="outerHTML" class="space-y-3">
{% csrf_token %}
<div class="grid grid-cols-1 md:grid-cols-[180px_1fr_auto] gap-3 items-start">
<div>
<c-forms.label for="id_provider">Provider</c-forms.label>
{{ form.provider }}
{% if form.provider.errors %}<c-forms.error>{{ form.provider.errors.0 }}</c-forms.error>{% endif %}
</div>
<div>
<c-forms.label for="id_repository">Repository</c-forms.label>
{{ form.repository }}
{% if form.repository.errors %}
<c-forms.error>{{ form.repository.errors.0 }}</c-forms.error>
{% else %}
<c-forms.hint>{{ form.repository.help_text }}</c-forms.hint>
{% endif %}
</div>
<c-buttons.primary type="submit" class="md:mt-7">
<i class="fas fa-plus"></i>
Add publisher
</c-buttons.primary>
</div>
</form>
</div>
<c-navigation.accordion density="sm">
<c-navigation.disclosure label_class="flex items-center gap-2">
<c-slot name="label">
<i class="fas fa-code text-text-muted" aria-hidden="true"></i>
Configure your GitHub Actions workflow
</c-slot>
<div class="space-y-3">
<p class="text-text-muted m-0">
Add this step to the workflow that should be authorised to push to this
component. The <c-code-inline>audience</c-code-inline> value must be exactly
<c-code-inline>{{ oidc_github_audience }}</c-code-inline>. The backend rejects
tokens minted for any other audience.
</p>
{# djlint:off #}
<c-code-block filename="workflow.yml"><c-slot name="code">{% verbatim %}permissions:
  id-token: write    # required to mint the OIDC token
  contents: read

steps:
  - name: Get OIDC token from GitHub
    id: oidc
    uses: actions/github-script@v7
    with:
      script: |
        const token = await core.getIDToken('{% endverbatim %}{{ oidc_github_audience }}{% verbatim %}')
        core.setSecret(token)
        core.setOutput('token', token)

  - name: Exchange for sbomify token
    id: sbomify
    run: |
      RESP=$(curl -sS -X POST \
        -H "Authorization: Bearer ${{ steps.oidc.outputs.token }}" \
        -H "Content-Type: application/json" \
        -d '{"component_id": "{% endverbatim %}{{ component.id }}{% verbatim %}"}' \
        {% endverbatim %}{{ api_base_url }}{% verbatim %}/api/v1/auth/oidc/github/exchange)
      echo "::add-mask::$(echo "$RESP" | jq -r '.access_token')"
      echo "token=$(echo "$RESP" | jq -r '.access_token')" &gt;&gt; "$GITHUB_OUTPUT"

  - name: Upload SBOM
    run: |
      curl -sS -X POST \
        -H "Authorization: Bearer ${{ steps.sbomify.outputs.token }}" \
        -H "Content-Type: application/json" \
        --data-binary @bom.json \
        {% endverbatim %}{{ api_base_url }}{% verbatim %}/api/v1/sboms/artifact/cyclonedx/{% endverbatim %}{{ component.id }}</c-slot></c-code-block>
{# djlint:on #}
<p class="text-xs text-text-muted m-0 flex items-center gap-1.5">
<i class="fas fa-clock text-text-muted" aria-hidden="true"></i>
The sbomify token expires after 15 minutes. Request a fresh one for each run.
</p>
</div>
</c-navigation.disclosure>
</c-navigation.accordion>
</div>
</section>
