{% load humanize plugins_extras %}
{% comment %}One run as a row of the assessment list. tile is its entry from the assessment_scorecards filter, which carries the verdict, reason and bar; run is the same run. Queued and running rows have nothing to show yet, so they do not open.

The checks are fetched when the row is first opened, not when the page is built: see _assessment_run_findings.html.j2. The row's button carries the id the hx-trigger listens on, so one click both opens the row and asks for the checks.

The host around them is preserved through a page refresh. The server always sends the unopened placeholder, and the once trigger has already fired, so a morph would leave a spinner nothing ever fetches. The mark sits on the host rather than on the panel because the panel replaces itself, and an element that is both preserved and self-replacing never loads at all: htmx restores the old one over its own response.{% endcomment %}
{% if run.status == 'completed' or run.status == 'failed' %}
    <c-assessments.row anchor="plugin-{{ run.plugin_name }}" id="run-trigger-{{ run.id }}" state="$store.openAssessments.isOpen('{{ run.id }}')" @click="$store.openAssessments.toggle('{{ run.id }}')" name="{{ run.plugin_display_name|default:run.plugin_name }}" tone="{{ tile.tone }}" label="{{ tile.label }}" caption="{{ tile.caption }}" :segments="tile.segments" bar_label="{{ tile.bar_label }}" :stale="run.current_version">
    <c-slot name="details">
    {% if run.status == 'failed' and run.error_message %}
        <div class="px-4 pt-4">
            <c-feedback.alert variant="danger">{{ run.error_message }}</c-feedback.alert>
        </div>
    {% endif %}
    <div id="findings-host-{{ run.id }}" hx-preserve>
        <div id="findings-{{ run.id }}"
             class="run-findings"
             hx-get="{% url 'plugins:assessment_run_findings' run.id %}"
             hx-trigger="click once from:#run-trigger-{{ run.id }}"
             hx-swap="outerHTML">
            <c-feedback.loading-table nested message="Loading vulnerabilities..." />
        </div>
    </div>
    {% comment %}Where the result came from, in one quiet line under the checks it explains.{% endcomment %}
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 text-xs text-text-muted">
        <span>v{{ run.plugin_version }}
            {% if run.current_version %}(latest v{{ run.current_version }}){% endif %}
        </span>
        <span>{{ run.run_reason|format_run_reason }}</span>
        {% if run.completed_at %}<span>{{ run.completed_at|date:"j M Y, H:i" }}</span>{% endif %}
        {% for name in run.release_names %}
            <c-badges.secondary title="Release this result applies to">
            <i class="fas fa-tag mr-1" aria-hidden="true"></i>{{ name }}
            </c-badges.secondary>
        {% endfor %}
        {% with standard=run.result.metadata %}
            {% if standard.standard_url %}
                <a href="{{ standard.standard_url }}"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="text-primary hover:underline">{{ standard.standard_name|default:"Read the standard" }} <i class="fas fa-external-link-alt ml-1 text-[0.625rem]"
    aria-hidden="true"></i></a>
            {% endif %}
        {% endwith %}
        {% include 'plugins/components/_rerun_button.html.j2' %}
    </div>
    </c-slot>
    </c-assessments.row>
{% else %}
    <c-assessments.row anchor="plugin-{{ run.plugin_name }}" name="{{ run.plugin_display_name|default:run.plugin_name }}" tone="{{ tile.tone }}" label="{{ tile.label }}" caption="{{ tile.caption }}" :segments="tile.segments" bar_label="{{ tile.bar_label }}" />
{% endif %}
