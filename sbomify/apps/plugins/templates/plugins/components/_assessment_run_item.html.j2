{# Individual assessment run collapsible card - rendered server-side #}
{% load design_system %}
{% load plugins_extras %}
{% load advisory_tags %}
{# Safely compute has_issues - run.result may be None for pending/running assessments #}
{% with run_id=run.id|default:loop_index result=run.result|default_if_none:"" summary=run.result.summary|default_if_none:"" fail_count=run.result.summary.fail_count|default:0 error_count=run.result.summary.error_count|default:0 pass_count=run.result.summary.pass_count|default:0 %}
    {% comment %}has_issues is the explicit-failure signal (fail+error). A run with only warnings (pass_count==0) is shown as "Warnings Only" rather than "Passed" so the per-card badge matches the dashboard summary and BSI's dependency gate (see _is_run_failing and orchestrator._is_passing).
    skipped mirrors _is_run_skipped in plugins/apis.py. A plugin that could not run (Dependency Track handed an SPDX SBOM, PQC handed a document with no crypto assets) reports one info/warning finding and metadata.skipped, which the counters above cannot tell apart from a real warnings-only verdict. Without this the card claims the plugin ran and disagreed with the scanners beside it.{% endcomment %}
    {% with has_issues=fail_count|add:error_count is_security=run.category|is_security_category skipped=result.metadata.skipped %}
        {# Compute security total from by_severity #}
        {% if is_security and run.result.summary.by_severity %}
            {% with sev=run.result.summary.by_severity security_total=run.result.summary.total_findings|default:0 %}
                {% comment %}A skipped run keeps the neutral base border: it produced no verdict, so it is neither a warning nor a clean scan.{% endcomment %}
                {# The level must render as one bare word, so its branch stays on one line. #}
                {# djlint:off #}
                <c-cards.collapsible level="{% if skipped %}{% elif security_total %}warning{% elif run.status == 'completed' %}success{% endif %}" id="plugin-{{ run.plugin_name }}" x-data="{ expanded: false }">
                {# djlint:on #}
                <c-cards.collapsible-trigger bare state="expanded" @click="expanded = !expanded">
                <div class="flex items-center gap-3 flex-grow min-w-0">
                    <span class="font-semibold text-text">{{ run.plugin_display_name|default:run.plugin_name }}</span>
                    {# release_names is populated by _run_to_schema from the M2M #}
                    {% if run.release_names %}
                        <span class="flex items-center gap-1 flex-wrap">
                            {% for name in run.release_names %}
                                <c-badges.secondary title="Release this scan result applies to">
                                <i class="fas fa-tag mr-1"></i>{{ name }}
                                </c-badges.secondary>
                            {% endfor %}
                        </span>
                    {% endif %}
                    {% if run.status == 'completed' %}
                        {% comment %}A skipped scanner counts its own stand-down notice as one info finding, so security_total is 1 and the card would otherwise claim a vulnerability the scanner never reported.{% endcomment %}
                        {% if skipped %}
                            <c-badges.secondary title="This plugin did not scan, so it reported no verdict.">
                            <i class="fas fa-ban mr-1"></i>Skipped
                            </c-badges.secondary>
                        {% elif security_total %}
                            <c-badges.secondary>
                            <i class="fas fa-shield-alt mr-1"></i>{{ security_total }} Vulnerabilit{{ security_total|pluralize:"y,ies" }}
                            </c-badges.secondary>
                        {% else %}
                            <c-badges.secondary>
                            <i class="fas fa-check-circle mr-1"></i>No Vulnerabilities
                            </c-badges.secondary>
                        {% endif %}
                    {% elif run.status == 'failed' %}
                        <c-badges.secondary>
                        <i class="fas fa-times-circle mr-1"></i>Error
                        </c-badges.secondary>
                    {% elif run.status == 'running' %}
                        <c-badges.secondary>
                        {% include "core/components/brand/loader.html.j2" with class="tw-loader-inline mr-1" %}
                        Running
                        </c-badges.secondary>
                    {% else %}
                        <c-badges.secondary>
                        <i class="fas fa-clock mr-1"></i>Pending
                        </c-badges.secondary>
                    {% endif %}
                    {% comment %}A skipped run's finding count is always 1 and means nothing; the reader wants the reason, which otherwise stays hidden until the card is expanded.{% endcomment %}
                    {% if skipped %}
                        <span class="text-text-muted text-sm truncate">{{ run.result.findings.0.title }}</span>
                    {% elif run.result.summary %}
                        <span class="text-text-muted text-sm hidden md:inline">{{ run.result.summary.total_findings|default:0 }} findings</span>
                    {% endif %}
                </div>
                </c-cards.collapsible-trigger>
                <c-cards.collapsible-body state="expanded">
                {% if run.status == 'completed' or run.status == 'failed' %}
                    {# Run Metadata #}
                    <div class="flex flex-wrap gap-4 pb-4 mb-4 border-b border-border text-sm text-text-muted">
                        <span>
                            <i class="fas fa-code-branch mr-1"></i>
                            v{{ run.plugin_version }}
                        </span>
                        <span>
                            <i class="fas fa-play-circle mr-1"></i>
                            {{ run.run_reason|format_run_reason }}
                        </span>
                        {% include 'plugins/components/_rerun_button.html.j2' %}
                        {% if run.completed_at %}
                            <span>
                                <i class="fas fa-calendar-check mr-1"></i>
                                {{ run.completed_at|date:"M d, Y \a\t H:i" }}
                            </span>
                        {% endif %}
                    </div>
                    {% if run.status == 'failed' and run.error_message %}
                        {# Error Message #}
                        <c-feedback.alert variant="danger" class="mb-4">{{ run.error_message }}</c-feedback.alert>
                    {% endif %}
                    {% if run.result.summary %}
                        {# Security Summary - Severity grid #}
                        <div class="mb-4">
                            <div class="grid grid-cols-2 md:grid-cols-5 gap-2">
                                <c-layout.stat-card compact accent="danger">
                                <c-layout.stat.value>{{ sev.critical|default:0 }}</c-layout.stat.value>
                                <c-layout.stat.label>Critical</c-layout.stat.label>
                                </c-layout.stat-card>
                                <c-layout.stat-card compact accent="warning">
                                <c-layout.stat.value>{{ sev.high|default:0 }}</c-layout.stat.value>
                                <c-layout.stat.label>High</c-layout.stat.label>
                                </c-layout.stat-card>
                                <c-layout.stat-card compact style="--stat-accent: var(--color-severity-medium)">
                                <c-layout.stat.value>{{ sev.medium|default:0 }}</c-layout.stat.value>
                                <c-layout.stat.label>Medium</c-layout.stat.label>
                                </c-layout.stat-card>
                                <c-layout.stat-card compact style="--stat-accent: var(--color-severity-low)">
                                <c-layout.stat.value>{{ sev.low|default:0 }}</c-layout.stat.value>
                                <c-layout.stat.label>Low</c-layout.stat.label>
                                </c-layout.stat-card>
                                <c-layout.stat-card compact>
                                <c-layout.stat.value>{{ security_total }}</c-layout.stat.value>
                                <c-layout.stat.label>Total</c-layout.stat.label>
                                </c-layout.stat-card>
                                {% if run.result.summary.suppressed_count %}
                                    <c-layout.stat-card compact style="--stat-accent: var(--color-info)" title="Findings suppressed by VEX (not_affected / false_positive)">
                                    <c-layout.stat.value>{{ run.result.summary.suppressed_count }}</c-layout.stat.value>
                                    <c-layout.stat.label>VEX suppressed</c-layout.stat.label>
                                    </c-layout.stat-card>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                    {% if run.result.findings %}
                        {# Security Findings List #}
                        <div class="findings-list">
                            <h6>
                                <i class="fas fa-list-ul mr-1"></i>Vulnerabilities
                            </h6>
                            {% for finding in run.result.findings %}
                                <div class="finding-item {{ finding.severity|severity_border_class }}">
                                    <div class="flex items-start">
                                        <span class="finding-status-icon {{ finding.severity|severity_text_class }}">
                                            <i class="{{ finding.severity|severity_icon }}"></i>
                                        </span>
                                        <div class="flex-1 ml-2">
                                            <div class="finding-title flex items-center gap-2 flex-wrap">
                                                {% comment %}Not every finding id is an advisory: a plugin's own operational ids (dependency-track:unsupported-format) used to be linked to OSV too, which resolved to nothing.{% endcomment %}
                                                {% with finding_url=finding.id|advisory_url %}
                                                    {% if finding_url %}
                                                        <a href="{{ finding_url }}"
                                                           target="_blank"
                                                           rel="noopener noreferrer"
                                                           class="text-primary hover:underline no-underline inline-flex items-center gap-1">
                                                            <i class="fas fa-external-link-alt text-xs"></i>{{ finding.id }}
                                                        </a>
                                                    {% else %}
                                                        <span class="text-text font-medium">{{ finding.id }}</span>
                                                    {% endif %}
                                                {% endwith %}
                                                {# Severity badge #}
                                                {% comment %}The band off the scale takes the component's unknown tint, which is what the else-branch here used to spell out.{% endcomment %}
                                                {% if finding.severity %}
                                                    <c-badges.severity level="{{ finding.severity|lower }}">{{ finding.severity|upper }}</c-badges.severity>
                                                {% endif %}
                                                {# CVSS score #}
                                                {% if finding.cvss_score is not None %}<c-chips.neutral>CVSS: {{ finding.cvss_score }}</c-chips.neutral>{% endif %}
                                                {% comment %}A malicious package is a different decision from a vulnerable one: rip it out now rather than schedule a patch. Shown ahead of severity because the severity is not the point, and the OpenSSF records carry none at all.{% endcomment %}
                                                {% if finding.malicious %}
                                                    <c-badges.solid-danger size="sm" class="uppercase" title="Malicious package: remove it rather than upgrade">
                                                    <i class="fas fa-skull-crossbones mr-1"></i>Malicious
                                                    </c-badges.solid-danger>
                                                {% endif %}
                                                {# CISA KEV: confirmed exploited in the wild #}
                                                {% comment %}EPSS is the likelihood half of the pair: CVSS says how bad, EPSS says how likely. Rendered as the raw 0..1 probability to three decimals, which is how FIRST publishes it. Both badges test "is not None" rather than truthiness, because 0.0 is a real score for either and would otherwise vanish.{% endcomment %}
                                                {% if finding.epss_score is not None %}
                                                    <c-chips.neutral title="EPSS: probability of exploitation in the next 30 days">EPSS: {{ finding.epss_score|floatformat:"-3" }}</c-chips.neutral>
                                                {% endif %}
                                                {% if finding.kev %}
                                                    <c-badges.solid-danger size="sm" class="uppercase" title="In CISA's Known Exploited Vulnerabilities catalog">KEV</c-badges.solid-danger>
                                                {% endif %}
                                                {% if finding.euvd %}
                                                    <c-badges.solid-danger size="sm" class="uppercase" title="In ENISA's EUVD exploited vulnerabilities list">EU KEV</c-badges.solid-danger>
                                                {% endif %}
                                                {# VEX analysis state #}
                                                {% if finding.analysis_state %}
                                                    <c-badges.info title="{{ finding.analysis_justification|default:'' }} {{ finding.analysis_detail|default:'' }}">
                                                    <i class="fas fa-clipboard-check mr-0.5"></i>{{ finding.analysis_state }}
                                                    </c-badges.info>
                                                {% endif %}
                                                {# Stale: a component-wide suppression asserted for a different version of this package #}
                                                {% if finding.analysis_stale %}
                                                    <c-badges.warning title="This suppression was asserted for a different version of this package. Re-review whether it still applies">
                                                    <i class="fas fa-triangle-exclamation mr-0.5"></i>re-review
                                                    </c-badges.warning>
                                                {% endif %}
                                                {% if can_triage and run.category == 'security' %}
                                                    <c-buttons.outline size="sm" @click="$dispatch('open-triage', { id: '{{ finding.id|escapejs }}', purl: '{{ finding.component.purl|default:''|escapejs }}', state: '{{ finding.analysis_state|default:''|escapejs }}', justification: '{{ finding.analysis_justification|default:''|escapejs }}', detail: '{{ finding.analysis_detail|default:''|escapejs }}', aliases: '{{ finding.aliases|default:''|join:','|escapejs }}' })">
                                                    <i class="fas fa-stethoscope mr-1"></i>Triage
                                                    </c-buttons.outline>
                                                {% endif %}
                                            </div>
                                            <div class="finding-description">{{ finding.title }}</div>
                                            {# Component info #}
                                            {% if finding.component %}
                                                <div class="mt-1 text-sm text-text-muted">
                                                    <i class="fas fa-cube mr-1"></i>
                                                    <span class="font-mono">{{ finding.component.name }}
                                                        {% if finding.component.version %}@{{ finding.component.version }}{% endif %}
                                                    </span>
                                                    {% if finding.component.ecosystem %}
                                                        <c-badges.secondary size="sm" class="ml-1">{{ finding.component.ecosystem }}</c-badges.secondary>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                            {# Aliases #}
                                            {% if finding.aliases %}
                                                <div class="mt-1 flex flex-wrap gap-1">
                                                    {% for alias in finding.aliases %}
                                                        {% with alias_url=alias|advisory_url %}
                                                            {% if alias_url %}
                                                                <a href="{{ alias_url }}"
                                                                   target="_blank"
                                                                   rel="noopener noreferrer"
                                                                   class="hover:underline no-underline">
                                                                    <c-code-inline accent="primary">{{ alias }}</c-code-inline>
                                                                </a>
                                                            {% else %}
                                                                <c-code-inline>{{ alias }}</c-code-inline>
                                                            {% endif %}
                                                        {% endwith %}
                                                    {% endfor %}
                                                </div>
                                            {% endif %}
                                            {# References #}
                                            {% if finding.references %}
                                                <div class="mt-2">
                                                    {% if finding.references|length <= 3 %}
                                                        <span class="text-xs text-text-muted">References:</span>
                                                        {% for ref in finding.references %}
                                                            {% if ref and ref != "" %}
                                                                <a href="{{ ref }}"
                                                                   target="_blank"
                                                                   rel="noopener noreferrer"
                                                                   class="inline-flex items-center gap-1 text-xs text-primary hover:underline no-underline mr-2">
                                                                    <i class="fas fa-external-link-alt"></i>Reference
                                                                </a>
                                                            {% endif %}
                                                        {% endfor %}
                                                    {% else %}
                                                        <details class="group">
                                                            <summary class="text-xs text-primary cursor-pointer hover:underline">
                                                                {{ finding.references|length }} references
                                                            </summary>
                                                            <div class="mt-1 flex flex-col gap-1">
                                                                {% for ref in finding.references %}
                                                                    {% if ref and ref != "" %}
                                                                        <a href="{{ ref }}"
                                                                           target="_blank"
                                                                           rel="noopener noreferrer"
                                                                           class="inline-flex items-center gap-1 text-xs text-primary hover:underline no-underline truncate">
                                                                            <i class="fas fa-external-link-alt flex-shrink-0"></i>{{ ref|truncatechars:80 }}
                                                                        </a>
                                                                    {% endif %}
                                                                {% endfor %}
                                                            </div>
                                                        </details>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                {% else %}
                    {# Pending state #}
                    <div class="text-center text-text-muted py-6">
                        {% include "core/components/brand/loader.html.j2" with class="tw-loader-inline text-2xl block mb-3" %}
                        <p class="mb-0">Assessment in progress...</p>
                    </div>
                {% endif %}
                </c-cards.collapsible-body>
                </c-cards.collapsible>
            {% endwith %}
        {% else %}
            {# Compliance / non-security rendering #}
            {% comment %}A skipped run keeps the neutral base border: it produced no verdict, so it is neither a warning nor a pass.{% endcomment %}
            {# The level must render as one bare word, so its branch stays on one line. #}
            {# djlint:off #}
            <c-cards.collapsible level="{% if skipped %}{% elif error_count %}danger{% elif fail_count %}warning{% elif run.status == 'completed' and pass_count == 0 %}warning{% elif run.status == 'completed' %}success{% endif %}" id="plugin-{{ run.plugin_name }}" x-data="{ expanded: false }">
            {# djlint:on #}
            <c-cards.collapsible-trigger bare state="expanded" @click="expanded = !expanded">
            <div class="flex items-center gap-3 flex-grow min-w-0">
                <span class="font-semibold text-text">{{ run.plugin_display_name|default:run.plugin_name }}</span>
                {# release_names is populated by _run_to_schema from the M2M #}
                {% if run.release_names %}
                    <span class="flex items-center gap-1 flex-wrap">
                        {% for name in run.release_names %}
                            <c-badges.secondary title="Release this scan result applies to">
                            <i class="fas fa-tag mr-1"></i>{{ name }}
                            </c-badges.secondary>
                        {% endfor %}
                    </span>
                {% endif %}
                {% if run.status == 'completed' %}
                    {% if skipped %}
                        <c-badges.secondary title="This plugin did not run, so it reported no verdict.">
                        <i class="fas fa-ban mr-1"></i>Skipped
                        </c-badges.secondary>
                    {% elif has_issues %}
                        <c-badges.secondary>
                        <i class="fas fa-exclamation-triangle mr-1"></i>{{ has_issues }} Issue{{ has_issues|pluralize }}
                        </c-badges.secondary>
                    {% elif pass_count == 0 %}
                        {% comment %}All findings were warnings — no positive verdict was produced. Surface distinctly so operators don't misread as a pass.{% endcomment %}
                        <c-badges.secondary>
                        <i class="fas fa-exclamation-circle mr-1"></i>Warnings Only
                        </c-badges.secondary>
                    {% else %}
                        <c-badges.secondary>
                        <i class="fas fa-check-circle mr-1"></i>Passed
                        </c-badges.secondary>
                    {% endif %}
                {% elif run.status == 'failed' %}
                    <c-badges.secondary>
                    <i class="fas fa-times-circle mr-1"></i>Error
                    </c-badges.secondary>
                {% elif run.status == 'running' %}
                    <c-badges.secondary>
                    {% include "core/components/brand/loader.html.j2" with class="tw-loader-inline mr-1" %}
                    Running
                    </c-badges.secondary>
                {% else %}
                    <c-badges.secondary>
                    <i class="fas fa-clock mr-1"></i>Pending
                    </c-badges.secondary>
                {% endif %}
                {% comment %}A skipped run's finding count is always 1 and means nothing; the reader wants the reason, which otherwise stays hidden until the card is expanded.{% endcomment %}
                {% if skipped %}
                    <span class="text-text-muted text-sm truncate">{{ run.result.findings.0.title }}</span>
                {% elif run.result.summary %}
                    <span class="text-text-muted text-sm hidden md:inline">{{ run.result.summary.total_findings|default:0 }} findings</span>
                {% endif %}
            </div>
            </c-cards.collapsible-trigger>
            <c-cards.collapsible-body state="expanded">
            {% if run.status == 'completed' or run.status == 'failed' %}
                {# Run Metadata #}
                <div class="flex flex-wrap gap-4 pb-4 mb-4 border-b border-border text-sm text-text-muted">
                    <span>
                        <i class="fas fa-code-branch mr-1"></i>
                        v{{ run.plugin_version }}
                    </span>
                    <span>
                        <i class="fas fa-play-circle mr-1"></i>
                        {{ run.run_reason|format_run_reason }}
                    </span>
                    {% include 'plugins/components/_rerun_button.html.j2' %}
                    {% if run.completed_at %}
                        <span>
                            <i class="fas fa-calendar-check mr-1"></i>
                            {{ run.completed_at|date:"M d, Y \a\t H:i" }}
                        </span>
                    {% endif %}
                </div>
                {% if run.status == 'failed' and run.error_message %}
                    {# Error Message #}
                    <c-feedback.alert variant="danger" class="mb-4">{{ run.error_message }}</c-feedback.alert>
                {% endif %}
                {% if run.result.summary %}
                    {# Compliance Findings Summary - Compact grid #}
                    <div class="mb-4">
                        <div class="grid grid-cols-3 md:grid-cols-6 gap-2">
                            <c-layout.stat-card compact accent="success">
                            <c-layout.stat.value>{{ run.result.summary.pass_count|default:0 }}</c-layout.stat.value>
                            <c-layout.stat.label>Pass</c-layout.stat.label>
                            </c-layout.stat-card>
                            <c-layout.stat-card compact accent="warning">
                            <c-layout.stat.value>{{ run.result.summary.fail_count|default:0 }}</c-layout.stat.value>
                            <c-layout.stat.label>Fail</c-layout.stat.label>
                            </c-layout.stat-card>
                            <c-layout.stat-card compact accent="danger">
                            <c-layout.stat.value>{{ run.result.summary.error_count|default:0 }}</c-layout.stat.value>
                            <c-layout.stat.label>Error</c-layout.stat.label>
                            </c-layout.stat-card>
                            <c-layout.stat-card compact style="--stat-accent: var(--color-info)">
                            <c-layout.stat.value>{{ run.result.summary.warning_count|default:0 }}</c-layout.stat.value>
                            <c-layout.stat.label>Warn</c-layout.stat.label>
                            </c-layout.stat-card>
                            <c-layout.stat-card compact accent="muted">
                            <c-layout.stat.value>{{ run.result.summary.info_count|default:0 }}</c-layout.stat.value>
                            <c-layout.stat.label>Info</c-layout.stat.label>
                            </c-layout.stat-card>
                            <c-layout.stat-card compact>
                            <c-layout.stat.value>{{ run.result.summary.total_findings|default:0 }}</c-layout.stat.value>
                            <c-layout.stat.label>Total</c-layout.stat.label>
                            </c-layout.stat-card>
                        </div>
                    </div>
                {% endif %}
                {% if run.result.findings %}
                    {# Compliance Findings List #}
                    <div class="findings-list">
                        <h6>
                            <i class="fas fa-list-ul mr-1"></i>Findings
                        </h6>
                        {% for finding in run.result.findings %}
                            <div class="finding-item {{ finding.status|status_border_class }}">
                                <div class="flex items-start">
                                    <span class="finding-status-icon {{ finding.status|status_text_class }}">
                                        <i class="{{ finding.status|status_icon }}"></i>
                                    </span>
                                    <div class="flex-1 ml-2">
                                        <div class="finding-title">{{ finding.title }}</div>
                                        <div class="finding-description">{{ finding.description|format_finding_description }}</div>
                                        {% if finding.remediation %}
                                            <div class="finding-remediation">
                                                <i class="fas fa-lightbulb mr-1"></i>
                                                {{ finding.remediation }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
                {% if run.result.metadata.standard_name %}
                    {# Standard Info (for compliance plugins) #}
                    <div class="standard-info mt-4">
                        <h6>
                            <i class="fas fa-book mr-1"></i>Standard Reference
                        </h6>
                        <div class="text-sm">
                            <strong>Standard:</strong> {{ run.result.metadata.standard_name }}
                            <br>
                            <strong>Version:</strong> {{ run.result.metadata.standard_version }}
                            {% if run.result.metadata.standard_url %}
                                <br>
                                <strong>Reference:</strong>
                                <a href="{{ run.result.metadata.standard_url }}"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="text-primary hover:underline no-underline">
                                    View Standard <i class="fas fa-external-link-alt ml-1"></i>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            {% else %}
                {# Pending state #}
                <div class="text-center text-text-muted py-6">
                    {% include "core/components/brand/loader.html.j2" with class="tw-loader-inline text-2xl block mb-3" %}
                    <p class="mb-0">Assessment in progress...</p>
                </div>
            {% endif %}
            </c-cards.collapsible-body>
            </c-cards.collapsible>
        {% endif %}
    {% endwith %}
{% endwith %}
