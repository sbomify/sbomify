{% load static %}
{% load json_extras %}
<link rel="stylesheet"
      href="{% static 'css/components/assessment-badge.css' %}">
<div class="assessment-badge-wrapper"
     data-sbom-detail-url="{% url 'core:component_item' component_id 'sboms' sbom_id %}">
    <div x-data="assessmentBadge('{{ sbom_id }}', '{{ component_id }}', '{{ assessments_data|jsonify|escapejs }}', '{{ team_billing_plan|default:""|escapejs }}')">
        {% comment %}
            The pill's variant is decided in assessment-badge.ts from the run
            counts, so it stays a bound class here: the recipe never reaches the
            server and the component library has no say in it.
        {% endcomment %}
        {% if team_billing_plan == 'community' %}
            <a href="{% url 'billing:select_plan' team_key %}"
               class="px-2 py-1 text-xs font-medium rounded-full no-underline flex items-center gap-1"
               :class="getBadgeClasses()"
               x-tooltip="getTooltipText()">
                <i :class="getBadgeIconClass()"></i>
                <span x-text="getBadgeText()"></span>
            </a>
        {% else %}
            <button type="button"
                    class="px-2 py-1 text-xs font-medium rounded-full flex items-center gap-1 border-0 bg-transparent"
                    :class="getBadgeClasses()"
                    x-tooltip="getTooltipText()"
                    :style="isBadgeClickable() ? 'cursor: pointer' : 'cursor: default'"
                    :tabindex="isBadgeClickable() ? '0' : '-1'"
                    :aria-label="'Assessment status: ' + getBadgeText()"
                    @click="isBadgeClickable() ? showDetailsModal = true : null">
                <i :class="getBadgeIconClass()"></i>
                <span x-text="getBadgeText()"></span>
            </button>
        {% endif %}
        <c-modal id="assessment-results-modal" show="showDetailsModal" size="lg" title="Assessment Results" icon="fas fa-clipboard-check" x-init="initModal($el)">
        <!-- Summary -->
        <div class="mb-6">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <c-layout.stat-card compact accent="success">
                <c-layout.stat.value x-text="passingCount" />
                <c-layout.stat.label>Passing</c-layout.stat.label>
                </c-layout.stat-card>
                <c-layout.stat-card compact accent="warning">
                <c-layout.stat.value x-text="failingCount" />
                <c-layout.stat.label>Failing</c-layout.stat.label>
                </c-layout.stat-card>
                <c-layout.stat-card compact style="--stat-accent: var(--color-info)">
                <c-layout.stat.value x-text="pendingCount" />
                <c-layout.stat.label>Pending</c-layout.stat.label>
                </c-layout.stat-card>
                <c-layout.stat-card compact accent="muted">
                <c-layout.stat.value x-text="totalAssessments" />
                <c-layout.stat.label>Total</c-layout.stat.label>
                </c-layout.stat-card>
            </div>
        </div>
        <!-- Per-plugin results -->
        <div>
            <h6 class="font-semibold text-text mb-3 flex items-center gap-2">
                <i class="fas fa-puzzle-piece"></i>
                Plugin Results
            </h6>
            <template x-for="plugin in plugins" :key="plugin.name">
                <div class="mb-3 p-4 border border-border rounded-lg">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-text" x-text="plugin.display_name"></span>
                            {% comment %}
                                The per-plugin status class comes from the same script as
                                the pill above, so it is bound rather than named here.
                            {% endcomment %}
                            <span class="px-2 py-0.5 text-xs font-medium rounded-full"
                                  :class="getPluginStatusBadgeClass(plugin.status)"
                                  x-text="getPluginStatusText(plugin.status)"></span>
                        </div>
                        <div class="flex items-center gap-4">
                            <div class="text-text-muted text-sm">
                                <template x-if="plugin.status === 'pass' || plugin.status === 'fail'">
                                    <span>
                                        <span x-text="plugin.findings_count"></span> findings
                                        <template x-if="plugin.fail_count > 0">
                                            <span class="text-warning">
                                                (<span x-text="plugin.fail_count"></span> failed)
                                            </span>
                                        </template>
                                    </span>
                                </template>
                                <template x-if="plugin.status === 'pending'">
                                    <span class="text-info flex items-center gap-1">
                                        <i class="fas fa-clock fa-pulse"></i>
                                        Processing...
                                    </span>
                                </template>
                            </div>
                            <template x-if="plugin.status !== 'pending'">
                                {% comment %}
                                    The row's link is built in the browser, so the anchor
                                    carries a placeholder target that x-bind replaces.
                                {% endcomment %}
                                <c-buttons.icon href="#" ::href="getPluginDetailUrl(plugin.name)" variant="primary" label="View findings" class="no-underline" title="View findings">
                                <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                </c-buttons.icon>
                            </template>
                        </div>
                    </div>
                </div>
            </template>
            <template x-if="plugins.length === 0">
                <div class="text-center text-text-muted py-8">
                    <i class="fas fa-info-circle mb-2 text-xl"></i>
                    <p class="m-0">No assessments have been run yet.</p>
                </div>
            </template>
        </div>
        <c-slot name="footer">
        <c-buttons.ghost @click="showDetailsModal = false">Close</c-buttons.ghost>
        </c-slot>
        </c-modal>
    </div>
</div>
