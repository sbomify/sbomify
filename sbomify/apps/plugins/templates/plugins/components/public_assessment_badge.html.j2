{# Public assessment badge - shows only PASSING assessments with category-aware icons #}
{# Never displays failures on public pages #}
{% comment %}
   Usage: {% include 'plugins/components/public_assessment_badge.html.j2' with assessment=assessment %}

   Expected assessment dict:
   - display_name: str
   - category: str (attestation, compliance, license); security scans are never shown
   Optional citable facts (rendered when present, omitted when not):
   - standard_name, standard_version, standard_url: which standard was checked
   - pass_count, total_findings: how many checks passed
   - completed_at: when the passing run finished ("verified" date)
{% endcomment %}
{% if assessment and assessment.category != 'security' %}
    {% if assessment.category == 'attestation' %}
        {% include 'plugins/components/_public_assessment_badge_inner.html.j2' with badge_class="badge-attestation" badge_icon="fa-certificate" status_phrase="Attestation verified" %}
    {% elif assessment.category == 'license' %}
        {% include 'plugins/components/_public_assessment_badge_inner.html.j2' with badge_class="badge-license" badge_icon="fa-scale-balanced" status_phrase="All checks passed" %}
    {% else %}
        {# Default: compliance or unknown category #}
        {% include 'plugins/components/_public_assessment_badge_inner.html.j2' with badge_class="badge-compliance" badge_icon="fa-check-circle" status_phrase="All checks passed" %}
    {% endif %}
{% endif %}
