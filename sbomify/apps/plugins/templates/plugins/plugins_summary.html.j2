{% if plugin_stats %}
    <div class="grid grid-cols-2 gap-3 md:grid-cols-[repeat(auto-fit,minmax(0,1fr))]">
        <c-layout.stat-card compact :value="plugin_stats.total" label="Available plugins" icon="fas fa-puzzle-piece" />
        <c-layout.stat-card compact :value="plugin_stats.enabled" label="Enabled plugins" icon="fas fa-circle-check" accent="success" />
        {% for category, count in plugin_stats.categories.items %}
            <c-layout.stat-card compact :value="count" label="{{ category|capfirst }}" />
        {% endfor %}
    </div>
{% endif %}
