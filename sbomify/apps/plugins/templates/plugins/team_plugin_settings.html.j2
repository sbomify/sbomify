<form id="plugin-settings-form"
      class="flex min-w-0 flex-col gap-6"
      hx-post="{% url 'plugins:team_plugin_settings' team.key %}"
      hx-swap="none"
      hx-disabled-elt="find button[type='submit']"
      hx-indicator="#plugin-settings-spinner">
    {% csrf_token %}
    {% if plugin_settings.available_plugins %}
        <c-layout.section-header level="2" title="Assessment plugins" subtitle="Select plugins and save your changes to apply them.">
        <c-slot name="actions">
        <c-buttons.primary size="sm" type="submit">Save changes</c-buttons.primary>
        </c-slot>
        </c-layout.section-header>
        {% regroup plugin_settings.available_plugins by category as plugin_groups %}
        {% for group in plugin_groups %}
            <c-cards.card flush class="overflow-hidden">
            <c-cards.header compact title="{{ group.grouper|default:'Other'|capfirst }}">
            <c-badges.secondary>{{ group.list|length }}</c-badges.secondary>
            </c-cards.header>
            {% for plugin in group.list %}
                <c-layout.select-row divided toggle_ref="toggle" :disabled="plugin.requires_upgrade" x_data="{ enabled: {{ plugin.is_enabled|yesno:'true,false' }} }">
                <c-forms.checkbox-input name="enabled_plugins" value="{{ plugin.name }}" id="plugin-{{ plugin.name }}" aria-label="Enable {{ plugin.display_name|default:plugin.name }}" x-ref="toggle" x-model="enabled" :checked="plugin.is_enabled" :disabled="plugin.requires_upgrade" />
                <div class="flex min-w-0 flex-1 flex-col gap-3">
                    <div class="flex min-w-0 flex-col gap-2">
                        <c-forms.label compact for="plugin-{{ plugin.name }}">{{ plugin.display_name }}</c-forms.label>
                        <div class="flex flex-wrap items-center gap-2">
                            <c-badges.secondary>v{{ plugin.version }}</c-badges.secondary>
                            {% for bom_type in plugin.supported_bom_types %}
                                <c-badges.secondary title="Runs on {{ bom_type|upper }} artifacts">{{ bom_type|upper }}</c-badges.secondary>
                            {% endfor %}
                            {% if plugin.is_beta %}<c-badges.info>Beta</c-badges.info>{% endif %}
                            {% if plugin.requires_upgrade %}
                                <c-badges.warning>{{ plugin.required_plan }} plan required</c-badges.warning>
                            {% endif %}
                        </div>
                        <c-forms.hint compact>{{ plugin.description }}</c-forms.hint>
                    </div>
                    {% if plugin.requires_upgrade %}
                        <div>
                            <c-buttons.secondary size="sm" href="{% url 'billing:select_plan' team.key %}">View plans</c-buttons.secondary>
                        </div>
                    {% endif %}
                    {% if plugin.has_visible_config %}
                        <c-cards.inset x-show="enabled" x-cloak>
                        <div class="grid gap-4 sm:grid-cols-2">
                            {% for field in plugin.config_schema %}
                                {% if field.type == "select" and not field.choices and field.hide_if_no_choices %}
                                    {# The plan has no configurable choices for this field. #}
                                {% elif field.type == "boolean" %}
                                    <c-forms.field hint="{{ field.help_text }}">
                                    {% if field.current_value == "true" %}
                                        <c-forms.checkbox name="plugin_config_{{ plugin.name }}_{{ field.key }}" id="plugin_config_{{ plugin.name }}_{{ field.key }}" value="true" checked>{{ field.label }}</c-forms.checkbox>
                                    {% else %}
                                        <c-forms.checkbox name="plugin_config_{{ plugin.name }}_{{ field.key }}" id="plugin_config_{{ plugin.name }}_{{ field.key }}" value="true">{{ field.label }}</c-forms.checkbox>
                                    {% endif %}
                                    </c-forms.field>
                                {% else %}
                                    <c-forms.field label="{{ field.label }}" for="plugin_config_{{ plugin.name }}_{{ field.key }}" hint="{{ field.help_text }}">
                                    {% if field.type == "select" %}
                                        <c-forms.select name="plugin_config_{{ plugin.name }}_{{ field.key }}" id="plugin_config_{{ plugin.name }}_{{ field.key }}">
                                        <option value="">Default</option>
                                        {% for choice in field.choices %}
                                            <option value="{{ choice.value }}"
                                                    {% if field.current_value == choice.value %}selected{% endif %}>
                                                {{ choice.label }}
                                            </option>
                                        {% endfor %}
                                        </c-forms.select>
                                    {% elif field.type == "number" %}
                                        <c-forms.input type="number" name="plugin_config_{{ plugin.name }}_{{ field.key }}" id="plugin_config_{{ plugin.name }}_{{ field.key }}" value="{{ field.current_value }}" />
                                    {% else %}
                                        <c-forms.input name="plugin_config_{{ plugin.name }}_{{ field.key }}" id="plugin_config_{{ plugin.name }}_{{ field.key }}" value="{{ field.current_value }}" />
                                    {% endif %}
                                    </c-forms.field>
                                {% endif %}
                            {% endfor %}
                        </div>
                        </c-cards.inset>
                    {% endif %}
                </div>
                </c-layout.select-row>
            {% endfor %}
            </c-cards.card>
        {% endfor %}
        <div class="flex flex-wrap items-center justify-between gap-3">
            <c-forms.hint compact>Changes apply to new uploads. Existing assessment results are kept.</c-forms.hint>
            <div class="flex items-center gap-2">
                <span id="plugin-settings-spinner" class="htmx-indicator">
                    <c-feedback.spinner size="sm" />
                </span>
                <c-buttons.primary type="submit" size="sm">Save changes</c-buttons.primary>
            </div>
        </div>
    {% else %}
        <c-feedback.empty-state icon="fas fa-puzzle-piece" title="No plugins available" message="Plugins will appear here when an administrator adds them." />
    {% endif %}
</form>
<c-cards.card>
<div class="flex flex-col gap-5">
    <c-layout.section-header level="2" title="About assessments" />
    <div class="grid gap-6 md:grid-cols-2">
        <c-layout.section-header title="Automatic assessments" subtitle="Enabled plugins assess new uploads. Open an artifact to see its results." icon="fas fa-circle-check" accent="success" />
        <c-layout.section-header title="Assessment history" subtitle="Past results are preserved so you can track security and compliance over time." icon="fas fa-history" accent="neutral" />
        <c-layout.section-header title="Supported artifacts" subtitle="Each plugin lists the artifact types it can assess." icon="fas fa-file-shield" accent="neutral" />
        <c-layout.section-header title="Plugin configuration" subtitle="Select a plugin to see any available configuration fields." icon="fas fa-sliders" accent="neutral" />
    </div>
</div>
</c-cards.card>
