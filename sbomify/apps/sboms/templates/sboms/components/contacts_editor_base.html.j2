<!-- Contact Badges -->
<template x-if="contacts && contacts.length">
    <div class="flex flex-wrap gap-2 mb-3">
        <template x-for="(contact, index) in contacts" :key="index">
            {% comment %}
            The contact is built in the browser, so the close button's name is
            bound rather than written: the tag names itself from the row.
            {% endcomment %}
            <c-tags.primary removable remove_label="'Remove ' + contact.name" remove_title="Remove contact" remove_click="removeContact(index)">
            <span x-text="contact.name"></span>
            <span x-show="contact.email" x-text="'(' + contact.email + ')'"></span>
            </c-tags.primary>
        </template>
    </div>
</template>
<!-- Add Contact Form -->
<template x-if="addingContact">
    <c-cards.inset class="mb-3">
    <div class="mb-3">
        <label class="block text-sm font-medium text-text mb-1">
            Name <span class="text-danger">*</span>
        </label>
        <c-forms.input x-model="newContact.name" placeholder="Enter name" ::data-state="formErrors.name ? 'error' : ''" @keyup.enter="saveContact()" />
        <template x-if="formErrors.name">
            <div class="text-danger text-sm mt-1" x-text="formErrors.name"></div>
        </template>
    </div>
    <div class="mb-3">
        <label class="block text-sm font-medium text-text mb-1">Email</label>
        <c-forms.input type="email" x-model="newContact.email" placeholder="Enter email address" ::data-state="formErrors.email ? 'error' : ''" @keyup.enter="saveContact()" />
        <template x-if="formErrors.email">
            <div class="text-danger text-sm mt-1" x-text="formErrors.email"></div>
        </template>
    </div>
    <div class="mb-3">
        <label class="block text-sm font-medium text-text mb-1">Phone</label>
        <c-forms.input type="tel" x-model="newContact.phone" placeholder="Enter phone number" ::data-state="formErrors.phone ? 'error' : ''" @keyup.enter="saveContact()" />
        <template x-if="formErrors.phone">
            <div class="text-danger text-sm mt-1" x-text="formErrors.phone"></div>
        </template>
    </div>
    <div class="flex justify-end gap-2">
        <c-buttons.secondary @click="cancelAddContact()">
        <i class="fas fa-times mr-1"></i>
        Cancel
        </c-buttons.secondary>
        <c-buttons.primary ::disabled="!newContact.name" @click="saveContact()">
        <i class="fas fa-check mr-1"></i>
        Save <span x-text="capitalizedContactType"></span>
        </c-buttons.primary>
    </div>
    </c-cards.inset>
</template>
<!-- Add Contact Button -->
<template x-if="!addingContact">
    <button type="button"
            class="flex items-center gap-2 text-primary hover:text-primary/80 transition-colors text-sm"
            @click="startAddContact()">
        <i class="fas fa-plus-circle"></i>
        <span x-text="addButtonText"></span>
    </button>
</template>
