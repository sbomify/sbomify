{% load pqc_extras %}
{% comment %}
Lazy-loaded component-level post-quantum posture card (HTMX partial, no base
template). Summarizes the overall PQC readiness of the component's most recent
artifact and links through to the per-SBOM cryptographic-asset detail. Renders
nothing (placeholder collapses) when the latest artifact has no crypto assets.
{% endcomment %}
<c-cards.card id="crypto-posture-card">
<c-slot name="header">
{% comment %}
    The band the app's cards carry: shorter than the library header and without
    its wash. Kept as the page's own markup so the migration moves no pixels;
    the library has no matching part yet.
{% endcomment %}
<div class="px-6 py-4 border-b border-border flex items-center justify-between gap-2">
    <h4 class="text-lg font-semibold text-text flex items-center gap-2 m-0">
        <i class="fas fa-shield-halved text-primary" aria-hidden="true"></i>
        Post-Quantum Posture
    </h4>
    {% comment %}
        The readiness verdict is a filter's output rather than one of a handful
        the template can branch on, so the badge takes the value on its
        attribute and holds every recipe itself.
    {% endcomment %}
    <c-badges.dynamic data-variant="{{ posture.pqc_overall|pqc_overall_variant }}">
    {{ posture.pqc_overall|pqc_overall_label }}
    </c-badges.dynamic>
</div>
</c-slot>
<div class="space-y-4">
    <div class="grid grid-cols-3 gap-3">
        <c-layout.stat-card compact accent="danger">
        <c-layout.stat.value>{{ posture.pqc_counts.quantum_vulnerable|default:0 }}</c-layout.stat.value>
        <c-layout.stat.label>Vulnerable</c-layout.stat.label>
        </c-layout.stat-card>
        <c-layout.stat-card compact accent="warning">
        <c-layout.stat.value>{{ posture.pqc_counts.review|default:0 }}</c-layout.stat.value>
        <c-layout.stat.label>Review</c-layout.stat.label>
        </c-layout.stat-card>
        <c-layout.stat-card compact accent="success">
        <c-layout.stat.value>{{ posture.pqc_counts.quantum_safe|default:0 }}</c-layout.stat.value>
        <c-layout.stat.label>Quantum-safe</c-layout.stat.label>
        </c-layout.stat-card>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-2">
        <a href="{% url 'core:component_item' component_id 'sboms' sbom_id %}"
           class="text-sm text-primary hover:underline inline-flex items-center gap-1">
            View {{ posture.count }} cryptographic asset{{ posture.count|pluralize }}
            <i class="fas fa-arrow-right text-xs"></i>
        </a>
        {% if posture.by_asset_type.certificate %}
            <c-chips.neutral>
            <i class="fas fa-certificate" aria-hidden="true"></i>
            {{ posture.by_asset_type.certificate }} certificate{{ posture.by_asset_type.certificate|pluralize }}
            </c-chips.neutral>
        {% endif %}
    </div>
</div>
</c-cards.card>
