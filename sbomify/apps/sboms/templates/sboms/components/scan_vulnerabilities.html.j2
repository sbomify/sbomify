{% comment %}Refreshed in place after a triage decision and again when the
background re-apply broadcasts, rather than reloading the page out from under
the reader. The triage modal dispatches refresh-assessments when it saves; the
re-apply's vex_reapplied arrives on the socket, and the bridge below turns it
into the same event for this component only, debounced as on the artifact page.
scan_refresh_query keeps the active filters and page; morph keeps scroll and
focus.{% endcomment %}
<div id="scan-vulnerabilities"
     x-data
     hx-target="this"
     hx-swap="morph"
     hx-get="{% url 'sboms:sbom_vulnerabilities' sbom.id %}?{{ scan_refresh_query }}"
     hx-trigger="refresh-assessments from:body"
     @ws:message.window=" if ($event.detail.type === 'vex_reapplied' && $event.detail.component_id === '{{ component_id }}') { clearTimeout($el._wsDebounce); $el._wsDebounce = setTimeout(() => document.body.dispatchEvent(new CustomEvent('refresh-assessments')), 500); } ">
    <c-tables.shell nested>
    <c-vulnerabilities.filters :panel="scan_panel" url="{% url 'sboms:sbom_vulnerabilities' sbom.id %}" target="scan-vulnerabilities" id="scan" prefix="scan_" push_url="true" />
    <c-vulnerabilities.table :rows="scan_panel.rows" :can_triage="can_triage" />
    <c-vulnerabilities.footer :panel="scan_panel" url="{% url 'sboms:sbom_vulnerabilities' sbom.id %}" query="{{ scan_query_string }}" prefix="scan_" />
    </c-tables.shell>
</div>
