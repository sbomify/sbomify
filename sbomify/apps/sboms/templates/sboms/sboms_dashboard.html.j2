{% extends "core/dashboard_base.htmx.j2" %}
{% load widget_tweaks %}
{% load form_helpers %}
{% load django_vite %}
{% block title %}sbomify SBOMs{% endblock %}
{% block content %}
    <div>
        {# Page Header #}
        <div class="mb-6">
            <div class="flex items-center gap-3">
                <c-chips.icon-chip>
                <i class="fas fa-file-code text-lg" aria-hidden="true"></i>
                </c-chips.icon-chip>
                <div>
                    <h1 class="text-2xl font-bold text-text">SBOMs</h1>
                    <p class="text-text-muted text-sm">Software Bill of Materials across all components</p>
                </div>
            </div>
        </div>
        {# Upload Card #}
        {% if has_crud_permissions %}
            <c-cards.card class="mb-6">
            <c-slot name="header">
            {% comment %}
                The band the app's cards carry: shorter than the library header
                and without its wash. Kept as the page's own markup so the
                migration moves no pixels; the library has no matching part yet.
            {% endcomment %}
            <div class="px-6 py-4 border-b border-border">
                <h4 class="text-lg font-semibold text-text">Upload SBOM File</h4>
            </div>
            </c-slot>
            <form action="{% url 'sboms:sboms_dashboard' %}"
                  method="post"
                  enctype="multipart/form-data"
                  class="flex flex-wrap items-center gap-4">
                {% csrf_token %}
                <div>{{ sbom_upload_form.sbom_file }}</div>
                <c-buttons.primary type="submit">
                <i class="fas fa-upload mr-2"></i>Upload
                </c-buttons.primary>
            </form>
            </c-cards.card>
        {% endif %}
        {# SBOMs Table #}
        {% if sboms %}
            {# The shell draws the frame itself, so the table needs no card around it. #}
            <c-tables.shell>
            <div class="px-6 py-4 border-b border-border">
                <h4 class="text-lg font-semibold text-text">All SBOMs</h4>
            </div>
            <c-tables.table>
            <c-tables.head>
            <c-tables.header-cell nowrap>Name</c-tables.header-cell>
            <c-tables.header-cell>Version</c-tables.header-cell>
            <c-tables.header-cell>Visibility</c-tables.header-cell>
            <c-tables.actions-cell as="th" />
            </c-tables.head>
            <tbody>
                {% for sbom in sboms %}
                    <c-tables.row>
                    <c-tables.cell nowrap>
                    <a href="{% url 'core:component_item' component_id=sbom.component_id item_type='sboms' item_id=sbom.id %}"
                       class="text-primary font-medium hover:underline">{{ sbom.name }}</a>
                    </c-tables.cell>
                    <c-tables.cell>{{ sbom.version }}</c-tables.cell>
                    <c-tables.cell class="text-center">
                    {% if sbom.public_access_allowed %}
                        <c-badges.success>Public</c-badges.success>
                    {% else %}
                        <c-badges.secondary>Private</c-badges.secondary>
                    {% endif %}
                    </c-tables.cell>
                    <c-tables.actions-cell>
                    <c-buttons.icon href="{% url 'core:component_item' component_id=sbom.component_id item_type='sboms' item_id=sbom.id %}" label="View details for {{ sbom.name }}" variant="primary" size="sm" title="View details">
                    <i class="fas fa-eye" aria-hidden="true"></i>
                    </c-buttons.icon>
                    </c-tables.actions-cell>
                    </c-tables.row>
                {% endfor %}
            </tbody>
            </c-tables.table>
            </c-tables.shell>
        {% else %}
            <c-cards.card flush>
            <div class="flex flex-col items-center justify-center py-12 px-6">
                <div class="w-16 h-16 rounded-full bg-border/30 flex items-center justify-center mb-4">
                    <i class="fas fa-file-code text-2xl text-text-muted"></i>
                </div>
                <p class="text-text-muted text-center">No SBOMs uploaded yet</p>
            </div>
            </c-cards.card>
        {% endif %}
    </div>
{% endblock %}
