{% load static %}
{% load json_extras %}
{% load humanize %}
{% if not sboms %}
    <div class="flex flex-col items-center justify-center py-12 px-6">
        <div class="w-16 h-16 rounded-full bg-border/30 flex items-center justify-center mb-4">
            <i class="fas fa-file-code text-2xl text-text-muted"></i>
        </div>
        <p class="text-text-muted text-center">No BOMs found for this component.</p>
    </div>
{% else %}
    {% comment %}
    Nested either way: the private page wraps this in the shell that carries the
    card's title band, and the public page renders it inside the trust-centre
    panel. A second frame here would draw a box inside a box.
    {% endcomment %}
    <c-tables.shell nested>
    <c-tables.toolbar>
    <c-tables.search id="sboms-search" label="Search artifacts" placeholder="Search artifacts..." x-model="search" @input="currentPage = 1" />
    <c-tables.select id="sboms-type-filter" label="Filter by type" x-model="typeFilter" @change="currentPage = 1">
    <option value="all">All Types</option>
    <template x-for="t in bomTypes" :key="t">
        <option :value="t" x-text="t.toUpperCase()"></option>
    </template>
    </c-tables.select>
    {% if full_view %}
        <c-slot name="right">
        <c-tables.page-size id="sboms-per-page" x-model.number="pageSize" @change="currentPage = 1">
        <template x-for="size in pageSizeOptions" :key="size">
            <option :value="size" x-text="size"></option>
        </template>
        </c-tables.page-size>
        </c-slot>
    {% endif %}
    </c-tables.toolbar>
    <c-tables.table>
    <c-tables.head>
    <c-tables.header-cell sort="name">Name</c-tables.header-cell>
    <c-tables.header-cell>Type</c-tables.header-cell>
    <c-tables.header-cell sort="version" class="hidden md:table-cell">Version</c-tables.header-cell>
    {% if not is_public_view %}<c-tables.header-cell>Vulnerabilities</c-tables.header-cell>{% endif %}
    {% if not is_public_view %}
        <c-tables.header-cell class="hidden lg:table-cell">Assessments</c-tables.header-cell>
    {% endif %}
    <c-tables.header-cell sort="created_at" date>Uploaded</c-tables.header-cell>
    <c-tables.actions-cell as="th" />
    </c-tables.head>
    <tbody>
        <template x-for="item in paginatedData" :key="item.sbom.id">
            <c-tables.row x-data="{ get bomType() { return item.sbom.bom_type || 'sbom' } }">
            <c-tables.cell class="break-all">
            <a :href="(item.sbom.bom_type === 'vex' ? '{% if is_public_view %}{% url 'core:component_item_public' component_id=component_id item_type='vex' item_id='SBOM_ID' %}{% else %}{% url 'core:component_item' component_id=component_id item_type='vex' item_id='SBOM_ID' %}{% endif %}' : item.sbom.bom_type === 'cbom' ? '{% if is_public_view %}{% url 'core:component_item_public' component_id=component_id item_type='cbom' item_id='SBOM_ID' %}{% else %}{% url 'core:component_item' component_id=component_id item_type='cbom' item_id='SBOM_ID' %}{% endif %}' : '{% if is_public_view %}{% url 'core:component_item_public' component_id=component_id item_type='sboms' item_id='SBOM_ID' %}{% else %}{% url 'core:component_item' component_id=component_id item_type='sboms' item_id='SBOM_ID' %}{% endif %}').replace('SBOM_ID', item.sbom.id)"
               class="text-primary font-medium hover:underline"
               x-text="item.sbom.name"></a>
            {% comment %}
            Mobile fallback for the columns hidden under md: format pill (with format_version)
            plus the SBOM version. flex-wrap lets each pill drop to its own line if the column
            is narrow, so the table doesn't horizontally scroll.

            The format is only known in the browser, so the pill binds data-format
            and the badge holds both recipes.
            {% endcomment %}
            <div class="md:hidden mt-1 flex flex-wrap items-center gap-1.5 text-xs">
                <c-badges.format ::data-format="item.sbom.format.toLowerCase().includes('cyclonedx') ? 'cyclonedx' : 'spdx'" x-text="(item.sbom.format_display || item.sbom.format).toUpperCase() + ' ' + item.sbom.format_version" />
                <span class="text-text-muted font-mono"
                      x-text="'v' + (item.sbom.version.length > 16 ? item.sbom.version.slice(0, 16) + '…' : item.sbom.version)"
                      :title="item.sbom.version"></span>
            </div>
            </c-tables.cell>
            <c-tables.cell>
            {% comment %}
            The artifact type comes from the row Alpine builds, so the badge binds
            data-variant rather than picking a variant component.
            {% endcomment %}
            <c-badges.dynamic ::data-variant="({ sbom: 'info', vex: 'violet', cbom: 'success' })[bomType] || 'secondary'" x-text="bomType.toUpperCase()" />
            </c-tables.cell>
            <c-tables.cell class="hidden md:table-cell">
            <span class="font-mono text-sm text-text"
                  x-text="item.sbom.version.length > 20 ? item.sbom.version.slice(0, 20) + '...' : item.sbom.version"
                  :title="item.sbom.version"></span>
            </c-tables.cell>
            {% if not is_public_view %}
                <c-tables.cell class="whitespace-nowrap">
                <template x-if="!item.vuln && bomType === 'sbom'">
                    <span class="text-text-muted text-sm">Not scanned</span>
                </template>
                <template x-if="!item.vuln && bomType !== 'sbom'">
                    <span class="text-text-muted text-sm">—</span>
                </template>
                {% comment %}
                Nothing scanned is not nothing found. A skipped
                run stores zero findings exactly as a clean scan
                does, so without this branch an artifact no
                scanner could read renders as "Clean".
                {% endcomment %}
                <template x-if="item.vuln && item.vuln.total === 0 && item.vuln.scanned_nothing">
                    <c-badges.warning title="A scan ran but matched no packages, so nothing was checked against any advisory source.">
                    Nothing scanned
                    </c-badges.warning>
                </template>
                <template x-if="item.vuln && item.vuln.total === 0 && !item.vuln.scanned_nothing">
                    <c-badges.success>Clean</c-badges.success>
                </template>
                <template x-if="item.vuln && item.vuln.total > 0">
                    <div class="flex items-center gap-1.5 flex-wrap">
                        <template x-if="item.vuln.critical > 0">
                            <c-badges.severity level="critical" x-text="item.vuln.critical + ' Critical'" />
                        </template>
                        <template x-if="item.vuln.high > 0">
                            <c-badges.severity level="high" x-text="item.vuln.high + ' High'" />
                        </template>
                        <template x-if="item.vuln.medium > 0">
                            <c-badges.severity level="medium" x-text="item.vuln.medium + ' Medium'" />
                        </template>
                        <template x-if="item.vuln.low > 0">
                            <c-badges.severity level="low" x-text="item.vuln.low + ' Low'" />
                        </template>
                    </div>
                </template>
                </c-tables.cell>
                <c-tables.cell class="hidden lg:table-cell">
                <template x-if="bomType === 'sbom' && item.assessments && item.assessments.plugins && item.assessments.plugins.length > 0">
                    <div class="flex flex-wrap items-center gap-1">
                        <!-- Individual plugin badges (show up to 3) -->
                        <template x-for="plugin in item.assessments.plugins.slice(0, 3)"
                                  :key="plugin.name">
                            <c-chips.assessment ::data-status="plugin.status" ::title="plugin.display_name + ' - ' + (plugin.status === 'pass' ? 'Passed' : plugin.status === 'fail' ? 'Failed (' + plugin.fail_count + ')' : plugin.status.charAt(0).toUpperCase() + plugin.status.slice(1))">
                            <i :class="{ 'fas fa-check': plugin.status === 'pass', 'fas fa-xmark': plugin.status === 'fail', 'fas fa-clock': plugin.status === 'pending', 'fas fa-triangle-exclamation': plugin.status === 'error' }"></i>
                            <span class="max-w-20 overflow-hidden text-ellipsis"
                                  x-text="plugin.display_name.length > 8 ? plugin.display_name.slice(0, 8) + '...' : plugin.display_name"></span>
                            </c-chips.assessment>
                        </template>
                        <!-- More indicator with count -->
                        <template x-if="item.assessments.plugins.length > 3">
                            <c-chips.assessment ::title="(item.assessments.plugins.length - 3) + ' more assessment' + (item.assessments.plugins.length - 3 > 1 ? 's' : '')" x-text="'+' + (item.assessments.plugins.length - 3)" />
                        </template>
                        <!-- Failure summary (only if there are hidden failures) -->
                        <template x-if="item.assessments.failing_count > 0 && item.assessments.plugins.slice(0, 3).filter(p => p.status === 'fail').length < item.assessments.failing_count">
                            <c-chips.assessment status="summary-fail" ::title="item.assessments.failing_count + ' assessment' + (item.assessments.failing_count > 1 ? 's' : '') + ' failed'">
                            <i class="fas fa-circle-exclamation"></i>
                            <span x-text="item.assessments.failing_count + ' Failed'"></span>
                            </c-chips.assessment>
                        </template>
                    </div>
                </template>
                <template x-if="bomType === 'sbom' && item.assessments && (!item.assessments.plugins || item.assessments.plugins.length === 0) && (item.assessments.overall_status === 'pending' || item.assessments.overall_status === 'in_progress')">
                    <span class="inline-flex items-center gap-1.5 text-info text-sm">
                        <i class="fas fa-clock fa-pulse"></i>
                        <span>Checking...</span>
                    </span>
                </template>
                <template x-if="bomType !== 'sbom' || !item.assessments || (item.assessments.overall_status === 'no_assessments' && (!item.assessments.plugins || item.assessments.plugins.length === 0))">
                    <span class="text-text-muted text-sm">—</span>
                </template>
                </c-tables.cell>
            {% endif %}
            <c-tables.cell date>
            <span x-text="new Date(item.sbom.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })"></span>
            <div class="text-xs text-text-muted"
                 x-text="(item.sbom.format_display || item.sbom.format).toUpperCase() + ' ' + item.sbom.format_version">
            </div>
            </c-tables.cell>
            {% comment %}
            `from_public=true` flag tells SbomDownloadView to render the friendly
            gated-access page instead of a generic 403 when a public visitor hits a
            gated SBOM. Internal downloads omit the flag.
            {% endcomment %}
            <c-tables.actions-cell>
            <c-buttons.icon href="#" label="Download SBOM" variant="primary" size="sm" title="Download" ::href="'{% url 'sboms:sbom_download' 'SBOM_ID' %}'.replace('SBOM_ID', item.sbom.id)
            {% if is_public_view %}+ '?from_public=true'{% endif %}
            ">
            <i class="fas fa-download" aria-hidden="true"></i>
            </c-buttons.icon>
            </c-tables.actions-cell>
            </c-tables.row>
        </template>
        <template x-if="paginatedData.length === 0 && search">
            <tr>
                <td colspan="{% if is_public_view %}5{% else %}7{% endif %}"
                    class="text-center py-8 text-text-muted">
                    <i class="fas fa-search text-2xl mb-2 opacity-50"></i>
                    <p>No BOMs match your search</p>
                    <button @click="search = ''"
                            class="mt-3 text-xs text-primary hover:underline">Clear search</button>
                </td>
            </tr>
        </template>
    </tbody>
    </c-tables.table>
    <c-tables.footer>
    <c-tables.info>
    Showing <strong x-text="startItem"></strong> to <strong x-text="endItem"></strong> of <strong x-text="filteredData.length"></strong>
    <template x-if="search"><span>(filtered from <strong x-text="allSboms.length"></strong> total)</span></template>
    </c-tables.info>
    <div x-show="totalPages > 1">
        <c-tables.pager />
    </div>
    </c-tables.footer>
    </c-tables.shell>
{% endif %}
