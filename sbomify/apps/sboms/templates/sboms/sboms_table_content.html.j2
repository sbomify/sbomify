{% load static %}
{% load json_extras %}
{% load humanize %}
{% if not sboms %}
    <c-feedback.empty-state icon="fas fa-file-code" title="No artifacts yet" message="No artifacts have been uploaded to this component.">
    {% if has_crud_permissions and not is_public_view %}
        <c-buttons.primary href="{% url 'core:component_details' component_id %}#upload-artifact" @click="$dispatch('open-upload')"><i class="fas fa-upload" aria-hidden="true"></i>Upload artifact</c-buttons.primary>
    {% endif %}
    </c-feedback.empty-state>
{% else %}
    {% comment %}
    Nested either way: the private page wraps this in the shell that carries the
    card's title band, and the public page renders it inside the trust-centre
    panel. A second frame here would draw a box inside a box.
    {% endcomment %}
    <c-tables.shell nested>
    <c-tables.toolbar>
    <c-forms.search-input size="sm" id="sboms-search" label="Search artifacts" placeholder="Search artifacts..." x-model="search" @input="currentPage = 1" />
    <c-forms.select size="md" id="sboms-type-filter" label="Filter by type" x-model="typeFilter" @change="currentPage = 1">
    <option value="all">All Types</option>
    <template x-for="t in bomTypes" :key="t">
        <option :value="t" x-text="t.toUpperCase()"></option>
    </template>
    </c-forms.select>
    {% if full_view %}
        <c-slot name="right">
        <c-tables.page-size id="sboms-per-page" x-model.number="pageSize" @change="currentPage = 1">
        <template x-for="size in pageSizeOptions" :key="size">
            <option :value="size" x-text="size"></option>
        </template>
        </c-tables.page-size>
        </c-slot>
    {% endif %}
    </c-tables.toolbar>
    <c-tables.table x-show="filteredData.length > 0" sized variant_class="
    {% if is_public_view %}
        min-w-144 md:min-w-192
    {% else %}
        min-w-192 md:min-w-224 lg:min-w-296
    {% endif %}
    " aria-label="Artifacts">
    <c-tables.head>
    <c-tables.header-cell sort="name" nowrap>Name</c-tables.header-cell>
    <c-tables.header-cell class="w-28">Type</c-tables.header-cell>
    <c-tables.header-cell sort="version" class="hidden md:table-cell w-28">Version</c-tables.header-cell>
    {% if not is_public_view %}
        <c-tables.header-cell class="w-56">Vulnerabilities</c-tables.header-cell>
        <c-tables.header-cell class="hidden lg:table-cell w-52">Assessments</c-tables.header-cell>
    {% endif %}
    <c-tables.header-cell sort="created_at" date class="w-36 sm:w-40">Uploaded</c-tables.header-cell>
    <c-tables.actions-cell as="th" />
    </c-tables.head>
    <tbody>
        <template x-for="item in paginatedData" :key="item.sbom.id">
            <c-tables.row x-data="{ get bomType() { return item.sbom.bom_type || 'sbom' } }">
            <c-tables.cell nowrap>
            <a :href="(item.sbom.bom_type === 'vex' ? '{% if is_public_view %}{% url 'core:component_item_public' component_id=component_id item_type='vex' item_id='SBOM_ID' %}{% else %}{% url 'core:component_item' component_id=component_id item_type='vex' item_id='SBOM_ID' %}{% endif %}' : item.sbom.bom_type === 'cbom' ? '{% if is_public_view %}{% url 'core:component_item_public' component_id=component_id item_type='cbom' item_id='SBOM_ID' %}{% else %}{% url 'core:component_item' component_id=component_id item_type='cbom' item_id='SBOM_ID' %}{% endif %}' : '{% if is_public_view %}{% url 'core:component_item_public' component_id=component_id item_type='sboms' item_id='SBOM_ID' %}{% else %}{% url 'core:component_item' component_id=component_id item_type='sboms' item_id='SBOM_ID' %}{% endif %}').replace('SBOM_ID', item.sbom.id)"
               class="text-primary font-medium hover:underline"
               x-text="item.sbom.name"></a>
            {% comment %}
            Fallback for the columns hidden from sm to md: the format and the SBOM
            version. Below sm the table stacks and shows those columns itself.
            {% endcomment %}
            <div class="hidden sm:block md:hidden mt-1 text-xs text-text-muted">
                <span x-text="(item.sbom.format_display || item.sbom.format).toUpperCase() + ' ' + item.sbom.format_version"></span>
                <span class="font-mono"
                      x-text="' · v' + (item.sbom.version.length > 16 ? item.sbom.version.slice(0, 16) + '…' : item.sbom.version)"
                      :title="item.sbom.version"></span>
            </div>
            </c-tables.cell>
            <c-tables.cell>
            <span class="text-xs font-semibold tracking-wide text-text-muted"
                  x-text="bomType.toUpperCase()"></span>
            </c-tables.cell>
            <c-tables.cell nowrap class="hidden md:table-cell">
            <span class="font-mono text-sm text-text"
                  x-text="item.sbom.version.length > 20 ? item.sbom.version.slice(0, 20) + '...' : item.sbom.version"
                  :title="item.sbom.version"></span>
            </c-tables.cell>
            {% if not is_public_view %}
                <c-tables.cell>
                <template x-if="!item.vuln && bomType !== 'sbom'">
                    <span class="text-sm text-text-muted">—</span>
                </template>
                <template x-if="!item.vuln && bomType === 'sbom'">
                    <span class="text-sm text-text-muted">Not scanned</span>
                </template>
                {% comment %}
                Nothing scanned is not nothing found. A skipped run stores zero
                findings exactly as a clean scan does, so without this branch an
                artifact no scanner could read renders as clean.
                {% endcomment %}
                <template x-if="item.vuln && item.vuln.total === 0 && item.vuln.scanned_nothing">
                    <c-feedback.status tone="warning" label="Nothing scanned" title="Every scanner skipped this artifact. Open it to see why." />
                </template>
                <template x-if="item.vuln && item.vuln.total === 0 && !item.vuln.scanned_nothing">
                    <c-feedback.status tone="success" label="No vulnerabilities" />
                </template>
                <template x-if="item.vuln && item.vuln.total > 0">
                    <c-vulnerabilities.summary bind="item.vuln" />
                </template>
                </c-tables.cell>
                <c-tables.cell class="hidden lg:table-cell">
                <template x-if="bomType === 'sbom' && item.assessments?.plugins?.length > 0">
                    <c-assessments.summary bind="item.assessments" />
                </template>
                <template x-if="bomType === 'sbom' && !item.assessments?.plugins?.length && ['pending', 'in_progress'].includes(item.assessments?.overall_status)">
                    <c-feedback.status label="Checking" />
                </template>
                <template x-if="bomType !== 'sbom' || (!item.assessments?.plugins?.length && !['pending', 'in_progress'].includes(item.assessments?.overall_status))">
                    <span class="text-sm text-text-muted">—</span>
                </template>
                </c-tables.cell>
            {% endif %}
            <c-tables.cell date>
            <span x-text="new Date(item.sbom.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })"></span>
            <div class="text-xs text-text-muted"
                 x-text="(item.sbom.format_display || item.sbom.format).toUpperCase() + ' ' + item.sbom.format_version">
            </div>
            </c-tables.cell>
            {% comment %}
            `from_public=true` flag tells SbomDownloadView to render the friendly
            gated-access page instead of a generic 403 when a public visitor hits a
            gated SBOM. Internal downloads omit the flag.
            {% endcomment %}
            <c-tables.actions-cell>
            <c-buttons.icon href="#" label="Download SBOM" variant="primary" size="sm" title="Download" ::href="'{% url 'sboms:sbom_download' 'SBOM_ID' %}'.replace('SBOM_ID', item.sbom.id)
            {% if is_public_view %}+ '?from_public=true'{% endif %}
            ">
            <i class="fas fa-download" aria-hidden="true"></i>
            </c-buttons.icon>
            </c-tables.actions-cell>
            </c-tables.row>
        </template>
    </tbody>
    </c-tables.table>
    <c-feedback.empty-state x-cloak x-show="filteredData.length === 0" icon="fas fa-search" title="No matching artifacts" message="Try another search or clear the filters.">
    <c-buttons.secondary @click="search = ''; typeFilter = 'all'; currentPage = 1">Clear filters</c-buttons.secondary>
    </c-feedback.empty-state>
    <c-tables.footer>
    <c-tables.info>
    Showing <strong x-text="$number(startItem)"></strong> to <strong x-text="$number(endItem)"></strong> of <strong x-text="$number(filteredData.length)"></strong>
    <template x-if="search"><span>(filtered from <strong x-text="$number(allSboms.length)"></strong> total)</span></template>
    </c-tables.info>
    <div x-show="totalPages > 1">
        <c-tables.pager />
    </div>
    </c-tables.footer>
    </c-tables.shell>
{% endif %}
