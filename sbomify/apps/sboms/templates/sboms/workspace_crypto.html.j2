{% extends "core/dashboard_base.htmx.j2" %}
{% load pqc_extras %}
{% block title %}Cryptography{% endblock %}
{% block dashboard_content %}
    <div class="mb-6">
        <div class="flex items-center gap-3">
            <c-chips.icon-chip>
            <i class="fas fa-lock text-lg" aria-hidden="true"></i>
            </c-chips.icon-chip>
            <div>
                <h1 class="text-2xl font-bold text-text">Cryptography</h1>
                <p class="text-text-muted text-sm">{{ team.name }} · quantum readiness and migration priority across all components</p>
            </div>
        </div>
    </div>
    {% if rollup.has_crypto_data %}
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 mb-6">
            <c-layout.stat-card compact accent="danger">
            <c-layout.stat.value>{{ rollup.verdict_counts.at_risk|default:0 }}</c-layout.stat.value>
            <c-layout.stat.label>At risk</c-layout.stat.label>
            </c-layout.stat-card>
            <c-layout.stat-card compact accent="warning">
            <c-layout.stat.value>{{ rollup.verdict_counts.needs_review|default:0 }}</c-layout.stat.value>
            <c-layout.stat.label>Needs review</c-layout.stat.label>
            </c-layout.stat-card>
            <c-layout.stat-card compact accent="success">
            <c-layout.stat.value>{{ rollup.verdict_counts.ready|default:0 }}</c-layout.stat.value>
            <c-layout.stat.label>Quantum-ready</c-layout.stat.label>
            </c-layout.stat-card>
            <c-layout.stat-card compact accent="muted">
            <c-layout.stat.value>{{ rollup.verdict_counts.no_crypto|default:0 }}</c-layout.stat.value>
            <c-layout.stat.label>No crypto</c-layout.stat.label>
            </c-layout.stat-card>
            {% comment %}
                Resolved before the tag: a component prop is compared exactly, and
                the formatter puts a branch inside an attribute on its own lines.
            {% endcomment %}
            {% firstof rollup.certificates.expired|yesno:"danger," rollup.certificates.expiring_soon|yesno:"warning," "" as certs_accent %}
            <c-layout.stat-card compact accent="{{ certs_accent }}">
            {% if rollup.certificates.expired %}
                <c-layout.stat.value>{{ rollup.certificates.expired }}</c-layout.stat.value>
                <c-layout.stat.label>Expired certs</c-layout.stat.label>
            {% else %}
                <c-layout.stat.value>{{ rollup.certificates.expiring_soon }}</c-layout.stat.value>
                <c-layout.stat.label>Certs expiring ≤90d</c-layout.stat.label>
            {% endif %}
            </c-layout.stat-card>
        </div>
        {% if rollup.top_vulnerable %}
            <c-cards.card class="mb-6">
            <c-slot name="header">
            {% comment %}
                The band the app's cards carry: shorter than the library header
                and without its wash. Kept as the page's own markup so the
                migration moves no pixels; the library has no matching part yet.
            {% endcomment %}
            <div class="px-6 py-4 border-b border-border">
                <h4 class="text-lg font-semibold text-text m-0">Migrate first</h4>
            </div>
            </c-slot>
            <div class="flex flex-wrap gap-2">
                {% for entry in rollup.top_vulnerable %}
                    <c-tags.danger>
                    {{ entry.name }}
                    <span class="text-xs opacity-75">· {{ entry.components }} component{{ entry.components|pluralize }}</span>
                    </c-tags.danger>
                {% endfor %}
            </div>
            <p class="text-xs text-text-muted mt-4 mb-0">
                CNSA 2.0 sets 2030 to 2033 transition deadlines for quantum-vulnerable algorithms; EO 14412
                directs CBOM minimum-elements guidance by March 2027.
            </p>
            </c-cards.card>
        {% endif %}
        {# The shell draws the frame itself, so the table needs no card around it. #}
        <c-tables.shell>
        <div class="px-6 py-4 border-b border-border">
            <h4 class="text-lg font-semibold text-text m-0">Components</h4>
        </div>
        <c-tables.table>
        <c-tables.head>
        <c-tables.header-cell nowrap>Component</c-tables.header-cell>
        <c-tables.header-cell>Readiness</c-tables.header-cell>
        <c-tables.header-cell>Vulnerable</c-tables.header-cell>
        <c-tables.header-cell>Review</c-tables.header-cell>
        <c-tables.header-cell>Safe</c-tables.header-cell>
        <c-tables.header-cell>Certificates</c-tables.header-cell>
        </c-tables.head>
        <tbody>
            {% for row in rollup.rows %}
                <c-tables.row>
                <c-tables.cell nowrap>
                {% if row.sbom_id %}
                    <a href="{% url 'core:component_item' row.id 'sboms' row.sbom_id %}"
                       class="font-medium text-primary hover:underline no-underline">{{ row.name }}</a>
                {% else %}
                    <span class="font-medium text-text">{{ row.name }}</span>
                {% endif %}
                </c-tables.cell>
                <c-tables.cell>
                {% comment %}
                    The readiness verdict is a filter's output rather than one of a
                    handful the template can branch on, so the badge takes the
                    value on its attribute and holds every recipe itself.
                {% endcomment %}
                <c-badges.dynamic data-variant="{{ row.verdict|pqc_overall_variant }}">{{ row.verdict|pqc_overall_label }}</c-badges.dynamic>
                </c-tables.cell>
                {% comment %}
                    Counts stay in the cell's own ink. The colour these cells used
                    to name never applied: the stylesheet's `.tw-table td` colour
                    is unlayered and outranked the utility, so the numbers have
                    always rendered in the body colour.
                {% endcomment %}
                <c-tables.cell class="{{ row.counts.quantum_vulnerable|yesno:'font-semibold,' }}">
                {{ row.counts.quantum_vulnerable }}
                </c-tables.cell>
                <c-tables.cell class="{{ row.counts.review|yesno:'font-semibold,' }}">
                {{ row.counts.review }}
                </c-tables.cell>
                <c-tables.cell>{{ row.counts.quantum_safe }}</c-tables.cell>
                <c-tables.cell>
                {% if row.certificates %}
                    {% if row.certificates.expired %}
                        <c-badges.danger>{{ row.certificates.expired }} expired</c-badges.danger>
                    {% elif row.certificates.expiring_soon %}
                        <c-badges.severity level="high">{{ row.certificates.expiring_soon }} expiring</c-badges.severity>
                    {% else %}
                        <span class="text-text-muted">{{ row.certificates.count }}</span>
                    {% endif %}
                {% else %}
                    <span class="text-text-muted">—</span>
                {% endif %}
                </c-tables.cell>
                </c-tables.row>
            {% endfor %}
        </tbody>
        </c-tables.table>
        </c-tables.shell>
    {% else %}
        <c-cards.card flush>
        <div class="p-12 text-center">
            <c-chips.icon-chip size="lg" accent="neutral" class="mx-auto mb-4">
            <i class="fas fa-lock text-lg" aria-hidden="true"></i>
            </c-chips.icon-chip>
            <h3 class="text-lg font-semibold text-text mb-2">No crypto data yet</h3>
            <p class="text-text-muted text-sm mb-0 max-w-md mx-auto">
                Upload a CBOM to a component, or enable the PQC readiness plugin so scanned SBOMs with embedded
                crypto assets get assessed. Results roll up here per component.
            </p>
        </div>
        </c-cards.card>
    {% endif %}
{% endblock %}
