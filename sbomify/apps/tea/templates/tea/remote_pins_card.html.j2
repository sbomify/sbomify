{% comment %}
    A release's remote artifacts: what it pins from TEA subscriptions, each with
    what has happened to it upstream, worst first. Its own live region, so a
    check that changes a finding, or a pin made elsewhere, repaints it. Hidden
    while there is nothing pinned and nothing to pin.
{% endcomment %}
<div id="release-remote-pins"
     class="flex flex-col gap-3"
     x-data="liveRegion({ refresh: ['release_updated'], key: 'release_id', id: '{{ release.id|escapejs }}' })"
     hx-get="{{ request.get_full_path }}"
     hx-select="#release-remote-pins"
     hx-trigger="live-refresh, refresh-remote-pins from:body"
     hx-swap="morph"
     hx-disinherit="*"
     {% if not remote_pins and not remote_pin_choices %}hidden{% endif %}>
    {% if remote_pins or remote_pin_choices %}
        <c-cards.card title="Remote artifacts" subtitle="Pinned from TEA subscriptions as they were when pinned. sbomify checks them every hour and lists what changed upstream." flush>
        {% if remote_pins %}
            <c-tables.table>
            <c-tables.head>
            <c-tables.header-cell nowrap>Artifact</c-tables.header-cell>
            <c-tables.header-cell>Subscription</c-tables.header-cell>
            <c-tables.header-cell>Upstream</c-tables.header-cell>
            {% if can_unpin_remote %}<c-tables.actions-cell as="th" label="Actions" />{% endif %}
            </c-tables.head>
            <tbody>
                {% for pin in remote_pins %}
                    <c-tables.row>
                    <c-tables.cell class="font-medium">
                    <span class="break-all">{{ pin.name }}</span>
                    <span class="block text-xs text-text-muted">version {{ pin.version }}
                        {% if pin.auto_pinned %}, follows upstream{% endif %}
                    </span>
                    </c-tables.cell>
                    <c-tables.cell>
                    <a href="{% url 'core:component_details' pin.component_id %}">{{ pin.component_name }}</a>
                    <span class="block text-xs text-text-muted">release {{ pin.remote_release }}</span>
                    </c-tables.cell>
                    <c-tables.cell>
                    <div class="flex flex-wrap gap-1">
                        {% for finding in pin.findings %}
                            <c-badges.dynamic size="sm" data-variant="{{ finding.tone }}">{{ finding.label }}</c-badges.dynamic>
                        {% empty %}
                            <c-badges.success size="sm">Current</c-badges.success>
                        {% endfor %}
                    </div>
                    </c-tables.cell>
                    {% if can_unpin_remote %}
                        <c-tables.cell end>
                        <form hx-post="{% url 'core:tea_release_pins' release.id %}"
                              hx-swap="none"
                              hx-disabled-elt="find button[type='submit']">
                            {% csrf_token %}
                            <input type="hidden" name="action" value="unpin">
                            <input type="hidden" name="pin_id" value="{{ pin.id }}">
                            <c-buttons.ghost size="sm" type="submit"><span>Unpin</span></c-buttons.ghost>
                        </form>
                        </c-tables.cell>
                    {% endif %}
                    </c-tables.row>
                {% endfor %}
            </tbody>
            </c-tables.table>
        {% else %}
            <c-feedback.empty-state compact icon="fas fa-satellite-dish" title="Nothing pinned yet" message="Pin what a subscription publishes now, and it stays as it is in this release." />
        {% endif %}
        </c-cards.card>
        {% if remote_pin_choices %}
            <form class="flex flex-wrap items-end justify-end gap-2"
                  hx-post="{% url 'core:tea_release_pins' release.id %}"
                  hx-swap="none"
                  hx-disabled-elt="find button[type='submit']">
                {% csrf_token %}
                <input type="hidden" name="action" value="pin">
                <c-forms.field label="Pin a remote artifact" for="remote_artifact_id">
                <c-forms.select id="remote_artifact_id" name="remote_artifact_id" :options="remote_pin_choices" placeholder="Pick an artifact" required />
                </c-forms.field>
                <c-buttons.secondary type="submit"><span>Pin</span></c-buttons.secondary>
            </form>
        {% endif %}
    {% endif %}
</div>
