{% url 'core:tea_subscription_new' as wizard_url %}
{% include "tea/wizard/_stepper.html.j2" %}
<c-layout.form-section step="2" title="Find" description="Pick the product that ships the component.">
{% if page.items %}
    <c-cards.card flush>
    <c-tables.table>
    <c-tables.head>
    <c-tables.header-cell nowrap>Product</c-tables.header-cell>
    <c-tables.header-cell>Identifiers</c-tables.header-cell>
    <c-tables.actions-cell as="th" label="Actions" />
    </c-tables.head>
    <tbody>
        {% for product in page.items %}
            <c-tables.row>
            <c-tables.cell nowrap class="font-medium">{{ product.name }}</c-tables.cell>
            <c-tables.cell muted>
            {% for identifier in product.identifiers %}
                <span class="block break-all">{{ identifier.id_type }} {{ identifier.id_value }}</span>
            {% empty %}
                None published
            {% endfor %}
            </c-tables.cell>
            <c-tables.cell end>
            <form hx-post="{{ wizard_url }}"
                  hx-target="#tea-wizard"
                  hx-disabled-elt="find button">
                {% csrf_token %}
                <input type="hidden" name="step" value="releases">
                <input type="hidden" name="server" value="{{ server.base_url }}">
                <input type="hidden" name="product_uuid" value="{{ product.uuid }}">
                <c-buttons.ghost type="submit" size="sm"><span>Pick</span><i class="fas fa-arrow-right" aria-hidden="true"></i></c-buttons.ghost>
            </form>
            </c-tables.cell>
            </c-tables.row>
        {% endfor %}
    </tbody>
    </c-tables.table>
    </c-cards.card>
{% else %}
    <c-cards.card flush>
    <c-feedback.empty-state icon="fas fa-magnifying-glass" title="No products found" message="Try another identifier, or browse all products." />
    </c-cards.card>
{% endif %}
<div class="flex flex-wrap items-center justify-end gap-2">
    <form hx-post="{{ wizard_url }}"
          hx-target="#tea-wizard"
          hx-disabled-elt="find button">
        {% csrf_token %}
        <input type="hidden" name="step" value="find">
        <input type="hidden" name="source" value="custom">
        <input type="hidden" name="custom_server" value="{{ server.base_url }}">
        <c-buttons.ghost type="submit"><i class="fas fa-arrow-left" aria-hidden="true"></i><span>Search again</span></c-buttons.ghost>
    </form>
    {% if page.next_page_token %}
        <form hx-post="{{ wizard_url }}"
              hx-target="#tea-wizard"
              hx-disabled-elt="find button">
            {% csrf_token %}
            <input type="hidden" name="step" value="products">
            <input type="hidden" name="server" value="{{ server.base_url }}">
            <input type="hidden" name="id_type" value="{{ id_type }}">
            <input type="hidden" name="id_value" value="{{ id_value }}">
            <input type="hidden" name="page_token" value="{{ page.next_page_token }}">
            <c-buttons.secondary type="submit"><span>Next page</span></c-buttons.secondary>
        </form>
    {% endif %}
</div>
</c-layout.form-section>
