{% if suppliers %}
    <div class="tw-data-table-container">
        <table class="tw-table tw-table-fixed">
            <thead>
                <tr>
                    <th scope="col">Supplier</th>
                    <th scope="col">Contact</th>
                    <th scope="col">Website</th>
                    <th scope="col" class="tw-cell-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for supplier in suppliers %}
                    <tr>
                        <td>
                            <span class="text-text font-medium block">{{ supplier.name }}</span>
                            {% if supplier.notes %}
                                <span class="text-text-muted text-sm block truncate max-w-xs">{{ supplier.notes }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if supplier.contact_email %}
                                {% if supplier.contact_name %}<span class="text-text block">{{ supplier.contact_name }}</span>{% endif %}
                                <a href="mailto:{{ supplier.contact_email }}"
                                   class="text-primary hover:underline text-sm">{{ supplier.contact_email }}</a>
                            {% else %}
                                {% comment %}A vendor is often tracked before anyone has found a contact, so this is a normal state rather than an error.{% endcomment %}
                                <span class="text-text-muted text-sm">No contact yet</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if supplier.website %}
                                <a href="{{ supplier.website }}"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="text-primary hover:underline text-sm">{{ supplier.website }}</a>
                            {% else %}
                                <span class="text-text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="tw-cell-end">
                            <div class="flex items-center justify-end gap-1">
                                {% comment %}Values ride on data attributes so Django escapes them; interpolating them into an inline Alpine call would break on any name containing a quote.{% endcomment %}
                                <button type="button"
                                        class="tw-btn-secondary tw-btn-sm"
                                        data-supplier-id="{{ supplier.id }}"
                                        data-supplier-name="{{ supplier.name }}"
                                        data-supplier-contact-name="{{ supplier.contact_name }}"
                                        data-supplier-contact-email="{{ supplier.contact_email }}"
                                        data-supplier-website="{{ supplier.website }}"
                                        data-supplier-notes="{{ supplier.notes }}"
                                        @click="edit($el.dataset)"
                                        aria-label="Edit {{ supplier.name }}">
                                    <i class="fas fa-pen" aria-hidden="true"></i>
                                </button>
                                <form method="post"
                                      hx-post="{% url 'teams:suppliers' team.key %}"
                                      hx-swap="none"
                                      class="inline">
                                    {% csrf_token %}
                                    <input type="hidden" name="action" value="delete">
                                    <input type="hidden" name="supplier_id" value="{{ supplier.id }}">
                                    <button type="submit"
                                            class="tw-btn-danger tw-btn-sm"
                                            aria-label="Remove {{ supplier.name }}">
                                        <i class="fas fa-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="py-12 text-center">
        <span class="tw-icon-chip tw-icon-chip-lg tw-icon-chip-neutral mx-auto mb-3">
            <i class="fas fa-truck-field" aria-hidden="true"></i>
        </span>
        {% if search %}
            <p class="text-text font-medium m-0">No suppliers match "{{ search }}"</p>
            <p class="text-text-muted text-sm m-0 mt-1">Try a different name or email.</p>
        {% else %}
            <p class="text-text font-medium m-0">No suppliers yet</p>
            <p class="text-text-muted text-sm m-0 mt-1">Add the vendors you collect SBOMs and documents from.</p>
            <button type="button" class="tw-btn-primary mt-4" @click="add()">
                <i class="fas fa-plus mr-2" aria-hidden="true"></i>Add your first supplier
            </button>
        {% endif %}
    </div>
{% endif %}
