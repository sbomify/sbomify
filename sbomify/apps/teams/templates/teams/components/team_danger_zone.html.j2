{% load static %}
<div x-cloak
     x-data="{ showDeleteModal: false, confirmText: '', isExpanded: false, get canConfirm() { return this.confirmText.toLowerCase() === 'delete'; } }">
    <c-cards.dangerzone-collapsible>
    <div class="flex flex-col gap-4">
        <c-layout.section-header title="Delete workspace" subtitle="Delete this workspace and all its products, components and artifacts.">
        <c-slot name="actions">
        <c-buttons.danger size="sm" id="del_{{ team_key }}" :disabled="is_default_team" @click.prevent.stop="showDeleteModal = true" aria-label="Delete workspace {{ team_name }}">Delete workspace</c-buttons.danger>
        </c-slot>
        </c-layout.section-header>
        {% if is_default_team %}
            <c-feedback.alert variant="warning">Set another workspace as your default before deleting this one.</c-feedback.alert>
        {% endif %}
    </div>
    </c-cards.dangerzone-collapsible>
    {# Custom Delete Modal for Workspace #}
    <c-modal id="deleteWorkspaceModal" show="showDeleteModal" title="Delete workspace" icon="fas fa-exclamation-triangle" role="alertdialog" aria-describedby="deleteWorkspaceModalDesc">
    <p class="mb-2">
        Are you sure you want to delete the workspace
        <strong>{{ team_name }}</strong>?
    </p>
    <c-forms.hint id="deleteWorkspaceModalDesc" class="mb-4">
    This action cannot be undone. All products, components, SBOMs, and documents in this workspace will be permanently deleted.
    </c-forms.hint>
    <c-forms.label for="delete-confirm-{{ team_key }}">Type <strong>delete</strong> to confirm:</c-forms.label>
    <c-forms.input id="delete-confirm-{{ team_key }}" placeholder="Type 'delete' to confirm" autocomplete="off" x-model="confirmText" @keydown.enter="if (canConfirm) $refs.deleteForm.submit()" />
    <c-slot name="footer">
    <c-buttons.ghost @click="showDeleteModal = false; confirmText = ''">Cancel</c-buttons.ghost>
    <form x-ref="deleteForm"
          method="post"
          action="{% url 'teams:team_general' team_key %}">
        {% csrf_token %}
        <input type="hidden" name="action" value="delete">
        <c-buttons.danger type="submit" ::disabled="!canConfirm">
        <i class="fas fa-trash mr-2" aria-hidden="true"></i>Delete workspace
        </c-buttons.danger>
    </form>
    </c-slot>
    </c-modal>
</div>
