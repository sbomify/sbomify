{% load static %}
<div x-cloak
     x-data="{ showDeleteModal: false, confirmText: '', isExpanded: false, get canConfirm() { return this.confirmText.toLowerCase() === 'delete'; } }">
    {# Danger Zone Section - Collapsible. The trigger is the library's real button, so Enter and Space reach it natively. #}
    <c-cards.collapsible level="danger">
    <c-cards.collapsible-trigger state="isExpanded" @click="isExpanded = !isExpanded">
    <i class="fas fa-exclamation-triangle text-danger" aria-hidden="true"></i>
    <span class="flex flex-col">
        <span class="text-base font-semibold text-danger">Danger Zone</span>
        <span class="text-text-muted text-sm font-normal">Irreversible and destructive actions</span>
    </span>
    </c-cards.collapsible-trigger>
    <c-cards.collapsible-body state="isExpanded">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div class="flex items-start gap-3">
            <c-chips.icon-chip accent="danger">
            <i class="fas fa-trash-alt" aria-hidden="true"></i>
            </c-chips.icon-chip>
            <div>
                <h6 class="font-medium text-text mb-1">Delete Workspace</h6>
                <p class="text-sm text-text-muted m-0">Permanently remove this workspace and all its associated data.</p>
                {% if is_default_team %}
                    <p class="text-sm text-warning m-0 mt-2">
                        <i class="fas fa-info-circle mr-1" aria-hidden="true"></i>
                        You must set another workspace as default before deleting this one.
                    </p>
                {% endif %}
            </div>
        </div>
        <c-buttons.danger size="sm" id="del_{{ team_key }}" class="flex-shrink-0" :disabled="is_default_team" @click.prevent.stop="showDeleteModal = true" aria-label="Delete workspace {{ team_name }}">
        <i class="fas fa-trash-alt mr-2" aria-hidden="true"></i>
        Delete Workspace
        </c-buttons.danger>
    </div>
    </c-cards.collapsible-body>
    </c-cards.collapsible>
    {# Custom Delete Modal for Workspace #}
    <c-modal id="deleteWorkspaceModal" show="showDeleteModal" title="Delete Workspace" icon="fas fa-exclamation-triangle" role="alertdialog" aria-describedby="deleteWorkspaceModalDesc">
    <p class="text-text mb-2">
        Are you sure you want to delete the workspace
        <span class="font-semibold text-danger">{{ team_name }}</span>?
    </p>
    <p id="deleteWorkspaceModalDesc" class="text-sm text-text-muted mb-4">
        This action cannot be undone. All products, components, SBOMs, and documents in this workspace will be permanently deleted.
    </p>
    <c-forms.label for="delete-confirm-{{ team_key }}">Type <strong>delete</strong> to confirm:</c-forms.label>
    <c-forms.input id="delete-confirm-{{ team_key }}" placeholder="Type 'delete' to confirm" autocomplete="off" x-model="confirmText" @keydown.enter="if (canConfirm) $refs.deleteForm.submit()" />
    <c-slot name="footer">
    <c-buttons.ghost @click="showDeleteModal = false; confirmText = ''">Cancel</c-buttons.ghost>
    <form x-ref="deleteForm"
          method="post"
          action="{% url 'teams:team_general' team_key %}">
        {% csrf_token %}
        <input type="hidden" name="action" value="delete">
        <c-buttons.danger type="submit" ::disabled="!canConfirm">
        <i class="fas fa-trash mr-2" aria-hidden="true"></i>Delete Workspace
        </c-buttons.danger>
    </form>
    </c-slot>
    </c-modal>
</div>
