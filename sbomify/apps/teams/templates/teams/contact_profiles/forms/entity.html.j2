{# The card body is flush: the summary and the editor state their own padding, and only one of them is on screen. #}
{# entity-card is a JS hook, not a style: partials/alpine_components.html.j2 finds every card by it. #}
<c-cards.card flush class="entity-card overflow-hidden" x-data="contactEntity('{{ form.prefix|escapejs }}')" x-show="!deleted" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100" @start-edit="editing = true" @contact-removed="updateContactCount" @contact-updated="updateContactCount">
{# Hidden fields for form management #}
{% for hidden in form.hidden_fields %}{{ hidden }}{% endfor %}
<input type="hidden" name="{{ form.prefix }}-DELETE" x-model="deleted">
{# Summary View (Visible when not editing) #}
<div x-show="!editing"
     x-transition
     class="cursor-pointer hover:bg-background/30 transition-colors"
     @click="editing = true">
    <div class="p-4">
        <div class="flex items-start gap-3">
            {# Entity icon #}
            <c-chips.icon-chip accent="neutral">
            <i class="fas fa-building" aria-hidden="true"></i>
            </c-chips.icon-chip>
            {# Entity info #}
            <div class="flex-grow min-w-0">
                <div class="flex items-center gap-2 mb-1">
                    <h6 class="m-0 font-semibold text-text truncate"
                        x-text="name || (isAuthorOnly ? 'Authors' : 'New Entity')"></h6>
                    {# Role badges #}
                    <div class="flex gap-1 flex-wrap flex-shrink-0">
                        <c-badges.badge size="sm" x-show="isManufacturer">Manufacturer</c-badges.badge>
                        <c-badges.badge size="sm" x-show="isSupplier">Supplier</c-badges.badge>
                        <c-badges.badge size="sm" x-show="isAuthor">Author</c-badges.badge>
                    </div>
                </div>
                {# Details row #}
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-text-muted">
                    <span x-show="email" class="flex items-center">
                        <i class="fas fa-envelope mr-1.5 text-xs opacity-60"></i>
                        <span x-text="email" class="truncate max-w-[180px]"></span>
                    </span>
                    <span class="flex items-center"
                          :class="activeContactsCount === 0 ? 'text-danger font-medium' : ''">
                        <i class="fas fa-users mr-1.5 text-xs opacity-60"></i>
                        <span x-text="activeContactsCount + ' contact' + (activeContactsCount !== 1 ? 's' : '')"></span>
                        <i class="fas fa-exclamation-circle ml-1 text-xs"
                           x-show="activeContactsCount === 0"></i>
                    </span>
                </div>
                {# Role required warning #}
                <c-forms.error x-show="!isManufacturer && !isSupplier && !isAuthor && touched">
                <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                <span>Role required</span>
                </c-forms.error>
            </div>
            {# Action buttons #}
            <div class="flex items-center gap-1 flex-shrink-0">
                <c-buttons.icon size="sm" label="Edit entity" @click.stop="editing = true" title="Edit entity">
                <i class="fas fa-pen text-xs"></i>
                </c-buttons.icon>
                <c-buttons.icon size="sm" variant="danger" label="Remove entity" @click.stop="removeEntity" title="Remove entity">
                <i class="fas fa-trash-alt text-xs"></i>
                </c-buttons.icon>
            </div>
        </div>
    </div>
</div>
{# Editor Content #}
<div class="entity-editor-content" x-show="editing" x-transition>
    <div class="p-5">
        {# Role Selection #}
        <div class="mb-5 pb-4 border-b border-border">
            <c-forms.label required>Entity Role(s)</c-forms.label>
            {# djlint:off #}
            {% comment %}
            A role arrives ticked when the entity has it, and on a brand new entity, where every role starts on.
            Cotton drops a bare attribute a template tag produced, so the state is the attribute's value, and the
            formatter must not break that value across lines: the whitespace it would add reads as "ticked".
{% endcomment %}
            <div class="flex gap-6 flex-wrap">
                <label class="flex items-center gap-3"
                       :class="!canSelectManufacturer && !isManufacturer ? 'opacity-50' : ''"
                       :title="!canSelectManufacturer && !isManufacturer ? 'Another entity is already assigned as manufacturer' : 'The organization that created or manufactured the component'">
                    <c-forms.checkbox-input name="{{ form.prefix }}-is_manufacturer" id="{{ form.prefix }}-role-manufacturer" x-model="isManufacturer" ::disabled="!canSelectManufacturer && !isManufacturer" checked="{% if form.instance.is_manufacturer or not form.instance.pk %}1{% endif %}" />
                    <span class="text-sm text-text">Manufacturer</span>
                </label>
                <label class="flex items-center gap-3"
                       :class="!canSelectSupplier && !isSupplier ? 'opacity-50' : ''"
                       :title="!canSelectSupplier && !isSupplier ? 'Another entity is already assigned as supplier' : 'The organization that provided the component'">
                    <c-forms.checkbox-input name="{{ form.prefix }}-is_supplier" id="{{ form.prefix }}-role-supplier" x-model="isSupplier" ::disabled="!canSelectSupplier && !isSupplier" checked="{% if form.instance.is_supplier or not form.instance.pk %}1{% endif %}" />
                    <span class="text-sm text-text">Supplier</span>
                </label>
                <label class="flex items-center gap-3" title="Group of individual authors">
                    <c-forms.checkbox-input name="{{ form.prefix }}-is_author" id="{{ form.prefix }}-role-author" x-model="isAuthor" checked="{% if form.instance.is_author or not form.instance.pk %}1{% endif %}" />
                    <span class="text-sm text-text">Author</span>
                </label>
            </div>
            {# djlint:on #}
            <c-forms.error x-show="!isManufacturer && !isSupplier && !isAuthor && touched">
            <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
            <span>Please select at least one role</span>
            </c-forms.error>
        </div>
        {# Author-only message #}
        <c-feedback.alert class="mb-5" x-show="isAuthorOnly" x-transition>
        <strong>Author entity:</strong> No organization name or email required. Just add the author contacts below.
        </c-feedback.alert>
        {# Hidden fields for author-only entities #}
        <template x-if="isAuthorOnly">
            <div>
                <input type="hidden" name="{{ form.name.html_name }}" :value="name">
                <input type="hidden" name="{{ form.email.html_name }}" :value="email">
            </div>
        </template>
        {# Entity Details Grid #}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5"
             x-show="!isAuthorOnly"
             x-transition>
            <div class="md:col-span-2">
                <c-forms.label for="{{ form.name.id_for_label }}">
                Entity Name <span class="text-danger" x-show="!isAuthorOnly">*</span>
                </c-forms.label>
                <c-forms.input name="{{ form.name.html_name }}" id="{{ form.name.id_for_label }}" value="{{ form.name.value|default:'' }}" placeholder="e.g. Acme Corporation" x-model.trim="name" ::required="!deleted && !isAuthorOnly" maxlength="255" />
                {% if form.name.errors %}<c-forms.error>{{ form.name.errors.0 }}</c-forms.error>{% endif %}
            </div>
            <div>
                <c-forms.label for="{{ form.email.id_for_label }}">
                Email Address <span class="text-danger" x-show="!isAuthorOnly">*</span>
                </c-forms.label>
                <c-forms.input type="email" name="{{ form.email.html_name }}" id="{{ form.email.id_for_label }}" value="{{ form.email.value|default:'' }}" placeholder="contact@example.com" x-model.trim="email" ::required="!deleted && !isAuthorOnly" />
                {% if form.email.errors %}<c-forms.error>{{ form.email.errors.0 }}</c-forms.error>{% endif %}
            </div>
            <div>
                <c-forms.label for="{{ form.phone.id_for_label }}">Phone Number</c-forms.label>
                <c-forms.input name="{{ form.phone.html_name }}" id="{{ form.phone.id_for_label }}" value="{{ form.phone.value|default:'' }}" placeholder="+1 555 123 4567" x-model.trim="phone" />
            </div>
            <div class="md:col-span-2">
                <c-forms.label for="{{ form.address.id_for_label }}">Address</c-forms.label>
                <c-forms.textarea name="{{ form.address.html_name }}" id="{{ form.address.id_for_label }}" rows="2" value="{{ form.address.value|default:'' }}" placeholder="123 Main Street, City, State, Country" x-model.trim="address" />
            </div>
            <div class="md:col-span-2">
                <c-forms.label for="{{ form.website_urls_text.id_for_label }}">Website URLs</c-forms.label>
                {# djlint:off #}
                {% comment %}
                The placeholder is two lines. Cotton hands the attribute on verbatim, so the break has to be a real
                one: an entity reference reaches the browser as its own characters. The formatter would join the two
                lines back up, which is what the block above turns off.
{% endcomment %}
                <c-forms.textarea name="{{ form.website_urls_text.html_name }}" id="{{ form.website_urls_text.id_for_label }}" rows="2" value="{{ form.website_urls_text.value|default:'' }}" placeholder="Enter one URL per line
https://example.com" x-model="websites" class="font-mono" />
                {# djlint:on #}
            </div>
        </div>
        {# Contacts Section #}
        <div class="border-t border-border pt-5">
            <div class="flex justify-between items-center mb-3">
                <div class="flex items-center gap-2">
                    <h6 class="m-0 font-semibold text-text text-sm">
                        <i class="fas fa-users text-text-muted mr-1.5"></i>Contacts
                    </h6>
                    <span class="text-danger text-xs">*</span>
                    <c-badges.badge size="sm" x-text="activeContactsCount">0</c-badges.badge>
                </div>
                <c-buttons.secondary size="sm" @click="addContact" title="Add a contact person">
                <i class="fas fa-plus mr-1"></i>Add Contact
                </c-buttons.secondary>
            </div>
            {# Contact warnings #}
            <c-feedback.alert variant="warning" class="mb-3" x-show="activeContactsCount === 0 && !contactsTouched">
            Add at least one contact person for this entity.
            </c-feedback.alert>
            <c-feedback.alert variant="danger" icon="fas fa-exclamation-circle" class="mb-3" x-show="activeContactsCount === 0 && contactsTouched">
            Missing contacts: add at least one contact person.
            </c-feedback.alert>
            {# Contacts list — contacts-list is a JS hook: addContactRow appends into it. #}
            <div class="contacts-list bg-background/50 rounded-lg border border-border overflow-hidden"
                 x-show="activeContactsCount > 0">
                {% if contacts_formset %}
                    {{ contacts_formset.management_form }}
                    {% for contact_form in contacts_formset %}
                        {% include "teams/contact_profiles/forms/contact.html.j2" with form=contact_form parent_prefix=form.prefix %}
                    {% endfor %}
                {% endif %}
            </div>
        </div>
        {# Editor Actions #}
        <div class="flex justify-end gap-2 mt-5 pt-4 border-t border-border">
            <c-buttons.secondary size="sm" @click="cancelEdit()">Cancel</c-buttons.secondary>
            <c-buttons.primary size="sm" @click="saveEdit()">
            <i class="fas fa-check mr-1"></i>Done
            </c-buttons.primary>
        </div>
    </div>
</div>
</c-cards.card>
