{% extends "core/dashboard_base.htmx.j2" %}
{% load teams %}
{% block title %}Workspaces · sbomify{% endblock %}
{% block content %}
    <c-layout.page-header title="Workspaces" subtitle="Switch workspaces or choose the one that opens when you sign in.">
    <c-buttons.primary @click="$dispatch('open-add-workspace-modal')"><i class="fas fa-plus" aria-hidden="true"></i>Add workspace</c-buttons.primary>
    </c-layout.page-header>
    {% if teams %}
        <section class="flex flex-col gap-3" aria-label="Your workspaces">
            <c-layout.section-header title="Your workspaces" level="2">
            <c-slot name="actions"><c-badges.secondary size="sm">{{ teams|length }} workspace{{ teams|length|pluralize }}</c-badges.secondary></c-slot>
            </c-layout.section-header>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                {% for team in teams %}
                    {% current_member team.members as me %}
                    <c-workspaces.card name="{{ team.name|workspace_display }}" role="{{ me.role }}" member_count="{{ team.members|length }}" invitation_count="{{ team.invitations|length }}" workspace_key="{{ team.key }}" current_key="{{ request.session.current_team.key }}" :default="me.is_default_workspace">
                    <c-slot name="actions">
                    <c-actions-menu label="Actions for {{ team.name|workspace_display }}">
                    <form method="post" action="{% url 'teams:teams_dashboard' %}">
                        {% csrf_token %}
                        <input type="hidden" name="_method" value="PATCH">
                        <input type="hidden" name="key" value="{{ team.key }}">
                        {% if me.is_default_workspace %}
                            <c-dropdowns.item type="submit" icon="fas fa-star" disabled>Default workspace</c-dropdowns.item>
                        {% else %}
                            <c-dropdowns.item type="submit" icon="fas fa-star">Make default</c-dropdowns.item>
                        {% endif %}
                    </form>
                    {% if me.role == 'owner' and not me.is_default_workspace %}
                        <c-dropdowns.divider />
                        <c-dropdowns.item-danger icon="fas fa-trash" @click="$dispatch('open-delete-workspace-modal', { formData: { key: '{{ team.key|escapejs }}' }, displayName: '{{ team.name|workspace_display|escapejs }}' })">Delete workspace</c-dropdowns.item-danger>
                    {% endif %}
                    </c-actions-menu>
                    </c-slot>
                    {% if request.session.current_team.key == team.key %}
                        <c-buttons.secondary size="sm" href="{% url 'core:dashboard' %}">Open workspace<i class="fas fa-arrow-right" aria-hidden="true"></i></c-buttons.secondary>
                    {% else %}
                        <c-buttons.secondary size="sm" href="{% url 'teams:switch_team' team.key %}">Open workspace<i class="fas fa-arrow-right" aria-hidden="true"></i></c-buttons.secondary>
                    {% endif %}
                    <c-buttons.secondary size="sm" href="{% url 'teams:team_settings' team.key %}"><i class="fas fa-gear" aria-hidden="true"></i>Settings</c-buttons.secondary>
                    </c-workspaces.card>
                {% endfor %}
            </div>
        </section>
    {% else %}
        <c-cards.card flush>
        <c-feedback.empty-state icon="fas fa-building" title="Create your first workspace" message="Keep your products, components and members together in a workspace.">
        <c-buttons.primary @click="$dispatch('open-add-workspace-modal')">Add workspace</c-buttons.primary>
        </c-feedback.empty-state>
        </c-cards.card>
    {% endif %}
    {% include "components/modals/delete_modal.html.j2" with modal_id="delete-workspace-modal" modal_title="Delete workspace" message_text="Delete the workspace" warning_text="This deletes the workspace and all its data. This cannot be undone." form_action=request.path form=delete_form submit_text="Delete workspace" %}
{% endblock %}
