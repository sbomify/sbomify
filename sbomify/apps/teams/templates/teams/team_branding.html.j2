{% load utils %}
{{ branding_info|pydantic_json|json_script:"branding-data" }}
<div id="team-branding-content"
     x-cloak
     x-data="teamBranding(window.parseJsonScript('branding-data'))"
     @file-selected.window="handleFileFromComponent($event.detail.field,$event.detail.file)"
     @file-removed.window="removeFile($event.detail.field)"
     @existing-file-removed.window="handleExistingFileRemoval($event.detail.field)"
     class="flex flex-col gap-5">
    <c-layout.section-header level="2" title="Branding" subtitle="Your colors and logo on the pages you share with customers." />
    <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] xl:items-start">
        <form id="team-branding-form"
              class="min-w-0 flex flex-col gap-5"
              method="post"
              enctype="multipart/form-data"
              hx-post="{% url 'teams:team_branding' team.key %}"
              hx-disabled-elt="#team-branding-save-btn"
              hx-swap="none">
            {% csrf_token %}
            {% if not branding_info.branding_enabled %}
                <c-feedback.alert variant="warning">Custom branding is off, so customers still see the default sbomify look. Enable it below to use your saved colors and logo.</c-feedback.alert>
            {% endif %}
            <c-cards.card flush>
            <c-cards.header compact title="Colors"><c-buttons.ghost size="sm" @click="setDefaultColors">Reset</c-buttons.ghost></c-cards.header>
            <c-cards.body>
            <div class="space-y-4">
                <c-forms.color-field size="sm" id="brand-color" name="brand_color" label="Brand color" hint="Your workspace's primary brand color." colour="uiColors.brand_color" on_input="updateColor('brand_color', $event.target.value)" submit_value="localBrandingInfo.brand_color || ''" />
                <c-forms.color-field size="sm" id="accent-color" name="accent_color" label="Accent color" hint="Highlights on your public pages." colour="uiColors.accent_color" on_input="updateColor('accent_color', $event.target.value)" submit_value="localBrandingInfo.accent_color || ''" />
            </div>
            </c-cards.body>
            </c-cards.card>
            <c-cards.card flush>
            <c-cards.header compact title="Logo and icon" />
            <c-cards.body>
            <div class="flex flex-col gap-5">
                <c-forms.field label="Logo" hint="Shown in your Trust Center header. 1200 × 300 px PNG or SVG works best.">
                {% include 'core/components/file_drag_and_drop.html.j2' with accept='image/*' existing_url=branding_info.logo_url field_name='logo' %}
                <input type="hidden"
                       name="logo_pending_deletion"
                       :value="localBrandingInfo.logo_pending_deletion ? 'true' : 'false'">
                </c-forms.field>
                <c-forms.field label="Icon" hint="A square fallback when there is no logo. 512 × 512 px PNG or SVG works best.">
                {% include 'core/components/file_drag_and_drop.html.j2' with accept='image/*' existing_url=branding_info.icon_url field_name='icon' %}
                <input type="hidden"
                       name="icon_pending_deletion"
                       :value="localBrandingInfo.icon_pending_deletion ? 'true' : 'false'">
                </c-forms.field>
            </div>
            </c-cards.body>
            </c-cards.card>
            <c-cards.card>
            <c-forms.checkbox id="branding-enabled-toggle" :checked="branding_info.branding_enabled" x-model="localBrandingInfo.branding_enabled">Use custom branding</c-forms.checkbox>
            <c-forms.hint>Turn off to use the default sbomify appearance. Your colors and assets stay saved.</c-forms.hint>
            <input type="hidden"
                   name="branding_enabled"
                   :value="localBrandingInfo.branding_enabled ? 'true' : 'false'">
            </c-cards.card>
            <div class="flex items-center justify-end gap-2">
                <c-buttons.secondary size="sm" ::disabled="!hasUnsavedChanges()" @click="$dispatch('refreshTeamBranding')">Discard</c-buttons.secondary>
                <c-buttons.primary type="submit" size="sm" id="team-branding-save-btn" ::disabled="!hasUnsavedChanges()">Save changes</c-buttons.primary>
            </div>
        </form>
        <aside class="min-w-0 flex flex-col gap-3 xl:sticky xl:top-6">
            <c-layout.section-header title="Live preview">
            <c-slot name="actions"><c-buttons.ghost size="sm" href="{% url 'core:workspace_public' workspace_key=team.key %}" target="_blank" rel="noopener">Open Trust Center</c-buttons.ghost></c-slot>
            </c-layout.section-header>
            {% url 'core:workspace_public' workspace_key=team.key as public_path %}
            <c-branding.preview name="{{ team.name }}" accent="{{ branding_info.accent_color }}" address="{{ request.get_host }}{{ public_path }}" />
            <c-forms.hint>Example content. Your customers see changes only after you save.</c-forms.hint>
        </aside>
    </div>
</div>
