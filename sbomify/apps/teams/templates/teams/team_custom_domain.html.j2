<div x-cloak x-data="customDomain({ teamKey: '{{ team.key }}', initialDomain: '{{ team.custom_domain|default:''|escapejs }}', isValidated: {{ team.custom_domain_validated|yesno:'true,false' }}, lastCheckedAt:
    {% if team.custom_domain_last_checked_at %}
        '{{ team.custom_domain_last_checked_at|date:'c'|escapejs }}'
    {% else %}
        null
    {% endif %}
    , hasAccess: {{ has_custom_domain_access|yesno:'true,false' }} })">
    <c-cards.card flush>
    <c-cards.header compact title="Custom domain" hint="Serve your Trust Center from your own address." />
    {% if has_custom_domain_access %}
        <c-forms.field horizontal label="Custom domain" for="custom-domain-input" hint="Enter a subdomain such as trust.example.com, without http:// or https://.">
        <c-forms.input size="sm" id="custom-domain-input" placeholder="trust.example.com" x-model="localDomain" ::data-state="error ? 'error' : ''" />
        <c-forms.error x-show="error" x-text="error" />
        </c-forms.field>
        <c-forms.field horizontal label="Verification status">
        <c-feedback.status x-show="!currentDomain" label="No domain configured" />
        <c-feedback.status tone="success" x-show="currentDomain && validated" label="Verified" />
        <c-feedback.status tone="warning" x-show="currentDomain && !validated" label="Pending verification" />
        <c-forms.hint x-show="currentDomain && lastChecked">Last checked: <span x-text="formatLastChecked()"></span></c-forms.hint>
        </c-forms.field>
        <c-cards.body>
        <div class="flex flex-col gap-4">
            <c-layout.section-header title="DNS configuration" subtitle="Add these records with your DNS provider." />
            <c-tables.shell>
            <c-tables.table>
            <c-tables.head>
            <c-tables.header-cell compact>Purpose</c-tables.header-cell>
            <c-tables.header-cell compact>Type</c-tables.header-cell>
            <c-tables.header-cell compact>Name</c-tables.header-cell>
            <c-tables.header-cell compact>Target</c-tables.header-cell>
            </c-tables.head>
            <tbody>
                <c-tables.row>
                <c-tables.cell compact>Domain</c-tables.cell>
                <c-tables.cell compact>CNAME</c-tables.cell>
                <c-tables.cell compact><c-code-inline x-text="localDomain || 'trust'" /></c-tables.cell>
                <c-tables.cell compact><c-code-inline>{{ app_hostname }}</c-code-inline></c-tables.cell>
                </c-tables.row>
                {% if dcv_hostname %}
                    <c-tables.row>
                    <c-tables.cell compact>Certificate (DCV delegation)</c-tables.cell>
                    <c-tables.cell compact>CNAME</c-tables.cell>
                    <c-tables.cell compact><c-code-inline>_acme-challenge.<span x-text="localDomain || 'trust'"></span></c-code-inline></c-tables.cell>
                    <c-tables.cell compact><c-code-inline><span x-text="localDomain || 'trust.example.com'"></span>.{{ dcv_hostname }}</c-code-inline></c-tables.cell>
                    </c-tables.row>
                {% endif %}
            </tbody>
            </c-tables.table>
            </c-tables.shell>
            {% if dcv_hostname %}
                <c-forms.hint>The second record enables automatic SSL certificate issuance and renewal.</c-forms.hint>
            {% endif %}
            <c-feedback.alert variant="info">Enter names relative to your DNS zone. For trust.example.com in the example.com zone, enter trust. DNS changes can take up to 48 hours. Verification runs automatically.</c-feedback.alert>
            <div class="flex flex-wrap justify-end items-center gap-2">
                <c-buttons.secondary size="sm" x-show="hasUnsavedChanges() && !isLoading" @click="cancelChanges()">Discard</c-buttons.secondary>
                <c-buttons.primary size="sm" x-show="hasUnsavedChanges() && !isLoading" @click="saveDomain()" ::disabled="!canSave()">Save domain</c-buttons.primary>
                <c-buttons.outline-danger size="sm" x-show="currentDomain && !hasUnsavedChanges() && !isLoading" @click="removeDomain()">Remove domain</c-buttons.outline-danger>
                <c-feedback.spinner size="inline" message="Saving domain" x-show="isLoading" x-cloak>Saving...</c-feedback.spinner>
            </div>
        </div>
        </c-cards.body>
    {% else %}
        <c-feedback.empty-state compact icon="fas fa-globe" title="Use your own domain" message="Custom domains are available on Business and Enterprise plans.">
        {% if can_administer %}
            <c-buttons.secondary size="sm" href="{% url 'billing:select_plan' team.key %}">Upgrade plan</c-buttons.secondary>
        {% endif %}
        </c-feedback.empty-state>
    {% endif %}
    </c-cards.card>
</div>
