{% load static %}
{% comment %}
    The Alpine state stays on a plain wrapper: its initialiser spans several
    lines and carries an {% if %}, which a component attribute is no place for.
{% endcomment %}
<div x-cloak x-data="customDomain({ teamKey: '{{ team.key }}', initialDomain: '{{ team.custom_domain|default:''|escapejs }}', isValidated: {{ team.custom_domain_validated|yesno:'true,false' }}, lastCheckedAt:
    {% if team.custom_domain_last_checked_at %}
        '{{ team.custom_domain_last_checked_at|date:'c'|escapejs }}'
    {% else %}
        null
    {% endif %}
    , hasAccess: {{ has_custom_domain_access|yesno:'true,false' }} })">
    {# Section heading, matching the settings-tab style: no card chrome. #}
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
            <h3 class="text-sm font-semibold text-text m-0">Custom domain</h3>
            {% if not has_custom_domain_access %}
                <c-badges.secondary size="sm">Business / Enterprise</c-badges.secondary>
            {% endif %}
        </div>
        <div class="flex items-center gap-2" x-show="hasAccess">
            <c-buttons.secondary size="sm" x-show="hasUnsavedChanges() && !isLoading" @click="cancelChanges()">
            <i class="fas fa-undo mr-2"></i> Cancel
            </c-buttons.secondary>
            <c-buttons.primary size="sm" x-show="hasUnsavedChanges() && !isLoading" @click="saveDomain()" ::disabled="!canSave()">
            <i class="fas fa-save mr-2"></i>
            Save domain
            </c-buttons.primary>
            <c-buttons.outline-danger size="sm" x-show="currentDomain && !hasUnsavedChanges() && !isLoading" @click="removeDomain()">
            <i class="fas fa-trash mr-2"></i>
            Remove domain
            </c-buttons.outline-danger>
            <span x-show="isLoading" class="text-text-muted">
                {% include "core/components/brand/loader.html.j2" with class="tw-loader-inline mr-1" %}
                Saving...
            </span>
        </div>
    </div>
    {% if has_custom_domain_access %}
        <p class="text-sm text-text-muted mt-1 mb-6">Serve your Trust Center from your own branded URL.</p>
        <!-- Domain Configuration -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
                <c-forms.label for="custom-domain-input">Custom Domain</c-forms.label>
                <c-forms.input id="custom-domain-input" placeholder="trust.yourcompany.com" x-model="localDomain" ::class="{ 'border-danger focus:ring-danger/30': error }" />
                <div class="text-danger text-sm mt-1" x-show="error" x-text="error"></div>
                <p class="text-text-muted text-xs mt-1">
                    Enter a subdomain (e.g., trust.example.com). Do not include http:// or https://
                </p>
            </div>
            <div>
                <c-forms.label>Verification Status</c-forms.label>
                <div class="flex items-center gap-2">
                    <template x-if="!currentDomain">
                        <c-chips.metric-chip>
                        <i class="fas fa-minus-circle text-text-muted" aria-hidden="true"></i>
                        <c-chips.metric.value>No domain configured</c-chips.metric.value>
                        </c-chips.metric-chip>
                    </template>
                    <template x-if="currentDomain && validated">
                        <c-chips.metric-chip accent="success">
                        <i class="fas fa-check-circle" aria-hidden="true"></i>
                        <c-chips.metric.value>Verified</c-chips.metric.value>
                        </c-chips.metric-chip>
                    </template>
                    <template x-if="currentDomain && !validated">
                        <c-chips.metric-chip accent="warning">
                        <i class="fas fa-clock" aria-hidden="true"></i>
                        <c-chips.metric.value>Pending verification</c-chips.metric.value>
                        </c-chips.metric-chip>
                    </template>
                </div>
                <template x-if="currentDomain && lastChecked">
                    <p class="text-text-muted text-xs mt-2">
                        Last checked: <span x-text="formatLastChecked()"></span>
                    </p>
                </template>
            </div>
        </div>
        <!-- DNS Setup Instructions -->
        <c-feedback.alert variant="info" title="DNS Configuration Required">
        <span class="block text-text-muted text-sm mb-4">
            To use a custom domain, create the following <strong>CNAME</strong>
            {% if dcv_hostname %}
                records
            {% else %}
                record
            {% endif %}
            in your DNS provider:
        </span>
        <!-- Primary CNAME Record -->
        <h6 class="text-sm font-semibold text-text mb-2">1. Domain CNAME Record</h6>
        <div class="bg-surface border border-border rounded-lg p-4 mb-4">
            <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
                <div>
                    <span class="text-text-muted">Type:</span>
                    <span class="text-text font-medium ml-2">CNAME</span>
                </div>
                <div>
                    <span class="text-text-muted">Name:</span>
                    <c-code-inline class="ml-2" x-text="localDomain || 'trust'" />
                </div>
                <div class="min-w-0">
                    <span class="text-text-muted">Target:</span>
                    <c-code-inline class="ml-2 break-all">{{ app_hostname }}</c-code-inline>
                </div>
            </div>
        </div>
        {% if dcv_hostname %}
            <!-- DCV Delegation CNAME Record -->
            <h6 class="text-sm font-semibold text-text mb-2">2. SSL Certificate CNAME Record (DCV Delegation)</h6>
            <div class="bg-surface border border-border rounded-lg p-4 mb-4">
                <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
                    <div>
                        <span class="text-text-muted">Type:</span>
                        <span class="text-text font-medium ml-2">CNAME</span>
                    </div>
                    <div class="min-w-0">
                        <span class="text-text-muted">Name:</span>
                        <c-code-inline class="ml-2 break-all">_acme-challenge.<span x-text="localDomain || 'trust'"></span></c-code-inline>
                    </div>
                    <div class="min-w-0 max-w-full">
                        <span class="text-text-muted">Target:</span>
                        <c-code-inline class="ml-2 break-all"><span x-text="localDomain || 'trust.example.com'"></span>.{{ dcv_hostname }}</c-code-inline>
                    </div>
                </div>
            </div>
            <p class="text-text-muted text-xs mb-4">
                <i class="fas fa-shield-alt mr-1"></i>
                This record enables automatic SSL certificate issuance and renewal for your custom domain.
            </p>
        {% endif %}
        <div class="space-y-2 text-sm text-text-muted">
            <p class="flex items-start gap-2 m-0">
                <i class="fas fa-lightbulb text-warning mt-0.5"></i>
                <span><strong class="text-text">Note:</strong> The Name field shows the full domain. In your DNS provider, enter only the subdomain portion relative to your zone (e.g., for <c-code-inline>trust.example.com</c-code-inline> in zone <c-code-inline>example.com</c-code-inline>, enter <c-code-inline>trust</c-code-inline>).</span>
            </p>
            <p class="flex items-start gap-2 m-0">
                <i class="fas fa-clock text-info mt-0.5"></i>
                <span>DNS changes may take up to 48 hours to propagate. Verification happens automatically once the DNS is configured correctly.</span>
            </p>
        </div>
        </c-feedback.alert>
    {% else %}
        <div class="flex items-start gap-4 p-6 mt-4 bg-border/20 rounded-xl">
            <c-chips.icon-chip size="lg">
            <i class="fas fa-globe text-xl" aria-hidden="true"></i>
            </c-chips.icon-chip>
            <div>
                <h6 class="font-semibold text-text mb-2">Custom Domain Feature</h6>
                <p class="text-text-muted text-sm mb-4">
                    Custom domains allow you to serve your Trust Center from your own branded URL (e.g., trust.yourcompany.com).
                    This feature is available on Business and Enterprise plans.
                </p>
                {% if can_administer %}
                    <c-buttons.primary href="{% url 'billing:select_plan' team.key %}">
                    <i class="fas fa-arrow-up mr-2"></i>Upgrade Plan
                    </c-buttons.primary>
                {% else %}
                    <p class="text-text-muted text-sm m-0">
                        <i class="fas fa-info-circle mr-1"></i>
                        Ask a workspace owner to upgrade the plan.
                    </p>
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>
