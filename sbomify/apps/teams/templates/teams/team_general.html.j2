<div id="team-general-content"
     data-team-name="{{ team.name }}"
     data-freshness-days="{{ team.sbom_freshness_days|default_if_none:'' }}"
     class="flex flex-col gap-5"
     x-cloak
     x-data="teamGeneral($el.dataset.teamName, $el.dataset.freshnessDays)">
    <c-layout.section-header level="2" title="General" subtitle="Your workspace's name, defaults and security targets." />
    <form id="team-general-form"
          method="post"
          hx-post="{% url 'teams:team_general' team.key %}"
          hx-disabled-elt="#team-general-save-btn"
          hx-swap="none"
          class="flex flex-col gap-5">
        {% csrf_token %}
        <c-cards.card flush>
        <c-cards.header compact title="Workspace" />
        <c-forms.field horizontal label="Workspace name" for="workspace-name" hint="Shown in navigation and across your workspace.">
        <c-forms.input size="sm" id="workspace-name" name="name" value="{{ team.name }}" maxlength="255" required x-model="localName" />
        </c-forms.field>
        <c-forms.field horizontal label="Workspace key" hint="Your workspace's permanent identifier.">
        {% include 'core/components/copyable_value.html.j2' with value=team.key title='Copy workspace key' only %}
        </c-forms.field>
        <c-forms.field horizontal label="Default workspace" hint="The workspace you open when you sign in.">
        {% if is_default_team %}
            <c-feedback.status tone="success" label="Your default workspace" />
        {% else %}
            <c-buttons.secondary type="submit" form="default-workspace-form" size="sm">Make default</c-buttons.secondary>
        {% endif %}
        </c-forms.field>
        </c-cards.card>
        <c-cards.card flush>
        <c-cards.header compact title="Freshness" />
        <c-forms.field horizontal label="Freshness window (days)" for="sbom-freshness-days" hint="Flag components with an older SBOM as stale. Leave empty for no policy. Components can override this.">
        <c-forms.input size="sm" type="number" id="sbom-freshness-days" name="sbom_freshness_days" value="{{ team.sbom_freshness_days|default_if_none:'' }}" placeholder="No freshness policy" min="0" max="3650" step="1" x-model="localFreshness" />
        </c-forms.field>
        </c-cards.card>
        <div class="flex items-center justify-end gap-2">
            <c-buttons.secondary size="sm" ::disabled="!hasUnsavedChanges()" @click="localName = originalName; localFreshness = originalFreshness">Discard</c-buttons.secondary>
            <c-buttons.primary type="submit" size="sm" id="team-general-save-btn" ::disabled="!hasUnsavedChanges()">Save changes</c-buttons.primary>
        </div>
    </form>
    {% if not is_default_team %}
        <form id="default-workspace-form"
              hidden
              method="post"
              hx-post="{% url 'teams:team_general' team.key %}"
              hx-swap="none">
            {% csrf_token %}
            <input type="hidden" name="action" value="set_default">
        </form>
    {% endif %}
    <div id="patch-sla-wrapper"
         hx-get="{% url 'teams:team_general' team.key %}"
         hx-select="#patch-sla-form"
         hx-trigger="refreshPatchSLA from:body"
         hx-swap="innerHTML">{% include 'teams/components/patch_sla_form.html.j2' %}</div>
    <form method="post"
          hx-post="{% url 'teams:team_general' team.key %}"
          hx-swap="none"
          hx-disabled-elt="find button[type='submit']"
          class="flex flex-col gap-4">
        {% csrf_token %}
        <input type="hidden" name="action" value="update_support_period">
        <c-cards.card flush>
        <c-cards.header compact title="Product support" />
        <c-forms.field horizontal label="Default support period (years)" for="default-support-period" hint="Used for new product assessments. Product support dates take precedence. Existing assessments keep their dates. Leave empty for no default.">
        <c-forms.input size="sm" id="default-support-period" name="default_support_period_years" type="number" min="5" max="100" step="1" value="{{ default_support_period_years|default_if_none:'' }}" placeholder="No default" />
        </c-forms.field>
        </c-cards.card>
        <div class="flex justify-end">
            <c-buttons.primary size="sm" type="submit">Save support period</c-buttons.primary>
        </div>
    </form>
    {% if is_owner %}
        {% include 'teams/components/team_danger_zone.html.j2' with team_key=team.key team_name=team.name is_default_team=is_default_team %}
    {% endif %}
</div>
