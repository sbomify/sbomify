<div id="team-general-content" class="flex flex-col gap-5">
    <c-layout.section-header level="2" title="General" subtitle="Your workspace's name, defaults and security targets." />
    <div id="workspace-card-wrapper"
         hx-get="{% url 'teams:team_general' team.key %}"
         hx-select="#workspace-card"
         hx-trigger="refreshWorkspaceCard from:body"
         hx-swap="innerHTML">
        <div id="workspace-card">
            <form id="team-general-form"
                  method="post"
                  hx-post="{% url 'teams:team_general' team.key %}"
                  hx-disabled-elt="#team-general-save-btn"
                  hx-swap="none"
                  x-data="dirtySettingsForm(window.parseJsonScript('team-general-fields'))"
                  class="flex flex-col gap-4">
                {{ team_general_fields|json_script:"team-general-fields" }}
                {% csrf_token %}
                <c-cards.card flush>
                <c-cards.header compact title="Workspace" />
                <c-forms.field horizontal label="Workspace name" for="workspace-name" hint="Shown in navigation and across your workspace.">
                <c-forms.input size="sm" id="workspace-name" name="name" value="{{ team.name }}" maxlength="255" required x-model="fields.name" />
                </c-forms.field>
                <c-forms.field horizontal label="Workspace key" hint="Your workspace's permanent identifier.">
                {% include 'core/components/copyable_value.html.j2' with value=team.key title='Copy workspace key' only %}
                </c-forms.field>
                <c-forms.field horizontal label="Default workspace" hint="The workspace you open when you sign in.">
                {% if is_default_team %}
                    <c-feedback.status tone="success" label="Your default workspace" />
                {% else %}
                    <c-buttons.secondary type="submit" form="default-workspace-form" size="sm">Make default</c-buttons.secondary>
                {% endif %}
                </c-forms.field>
                <c-forms.field horizontal label="Freshness window (days)" for="sbom-freshness-days" hint="Flag components with an older SBOM as stale. Leave empty for no policy. Components can override this.">
                <c-forms.input size="sm" type="number" id="sbom-freshness-days" name="sbom_freshness_days" value="{{ team.sbom_freshness_days|default_if_none:'' }}" placeholder="No freshness policy" min="0" max="3650" step="1" x-model="fields.sbom_freshness_days" />
                </c-forms.field>
                </c-cards.card>
                <div class="flex items-center justify-end gap-2">
                    <c-buttons.secondary size="sm" disabled ::disabled="!hasUnsavedChanges()" @click="discard()">Discard</c-buttons.secondary>
                    <c-buttons.primary type="submit" size="sm" disabled id="team-general-save-btn" ::disabled="!hasUnsavedChanges()">Save changes</c-buttons.primary>
                </div>
            </form>
            {% if not is_default_team %}
                <form id="default-workspace-form"
                      hidden
                      method="post"
                      hx-post="{% url 'teams:team_general' team.key %}"
                      hx-swap="none">
                    {% csrf_token %}
                    <input type="hidden" name="action" value="set_default">
                </form>
            {% endif %}
        </div>
    </div>
    <div id="patch-sla-wrapper"
         hx-get="{% url 'teams:team_general' team.key %}"
         hx-select="#patch-sla-form"
         hx-trigger="refreshPatchSLA from:body"
         hx-swap="innerHTML">{% include 'teams/components/patch_sla_form.html.j2' %}</div>
    <div id="support-period-wrapper"
         hx-get="{% url 'teams:team_general' team.key %}"
         hx-select="#support-period-form"
         hx-trigger="refreshSupportPeriod from:body"
         hx-swap="innerHTML">
        <form id="support-period-form"
              method="post"
              hx-post="{% url 'teams:team_general' team.key %}"
              hx-swap="none"
              hx-disabled-elt="find button[type='submit']"
              x-data="dirtySettingsForm(window.parseJsonScript('support-period-fields'))"
              class="flex flex-col gap-4">
            {{ support_period_fields|json_script:"support-period-fields" }}
            {% csrf_token %}
            <input type="hidden" name="action" value="update_support_period">
            <c-cards.card flush>
            <c-cards.header compact title="Product support" />
            <c-forms.field horizontal label="Default support period (years)" for="default-support-period" hint="Used for new product assessments. Product support dates take precedence. Existing assessments keep their dates. Enter 5 years or more, or leave empty for no default.">
            <c-forms.input size="sm" id="default-support-period" name="default_support_period_years" type="number" min="5" max="100" step="1" value="{{ default_support_period_years|default_if_none:'' }}" placeholder="No default" x-model="fields.default_support_period_years" />
            </c-forms.field>
            </c-cards.card>
            <div class="flex items-center justify-end gap-2">
                <c-buttons.secondary size="sm" disabled ::disabled="!hasUnsavedChanges()" @click="discard()">Discard</c-buttons.secondary>
                <c-buttons.primary size="sm" type="submit" disabled ::disabled="!hasUnsavedChanges()">Save support period</c-buttons.primary>
            </div>
        </form>
    </div>
    {% if is_owner %}
        {% include 'teams/components/team_danger_zone.html.j2' with team_key=team.key team_name=team.name is_default_team=is_default_team %}
    {% endif %}
</div>
