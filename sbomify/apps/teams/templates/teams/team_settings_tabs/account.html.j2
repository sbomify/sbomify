<div class="max-w-2xl"
     x-data="accountDangerZone({ csrfToken: '{{ csrf_token }}', tokenCount: {{ access_token_count }} })">
    {# Account, in the settings-tab style the branding tab set: no card chrome. #}
    <div class="mb-8">
        <h2 class="text-lg font-semibold text-text m-0">Account</h2>
        <p class="text-sm text-text-muted mt-1 m-0">Your personal account.</p>
    </div>
    <c-cards.dangerzone-collapsible>
    <div class="flex items-center gap-4">
        <div class="flex-1">
            <h6 class="text-sm font-semibold text-text m-0">Delete account</h6>
            <p class="text-text-muted text-sm mt-1 m-0">
                Your account will be deactivated immediately and permanently removed after 14 days.
            </p>
        </div>
        <c-buttons.danger class="flex-shrink-0" @click.prevent="openDeleteModal()" aria-label="Delete your account">
        <i class="fas fa-user-slash" aria-hidden="true"></i>
        Delete account
        </c-buttons.danger>
    </div>
    </c-cards.dangerzone-collapsible>
    {# Delete Account Modal #}
    <c-modal id="deleteAccountModal" show="showDeleteModal" title="Delete your account" icon="fas fa-exclamation-triangle" role="alertdialog" aria-describedby="deleteAccountModalDesc">
    <p id="deleteAccountModalDesc" class="text-text-muted mb-4">
        Your account will be deactivated immediately and permanently deleted after <strong class="text-text">14 days</strong>.
    </p>
    <c-feedback.alert variant="warning" icon="fas fa-key" class="mb-4" x-show="tokenCount > 0" x-cloak>
    You have <strong x-text="tokenCount"></strong> active API token(s) that will be <strong>immediately revoked</strong>. Any CI/CD pipelines using these tokens will stop working.
    </c-feedback.alert>
    <c-feedback.alert variant="info" title="Immediate effects" class="mb-4">
    <ul class="text-sm m-0 pl-4 space-y-1">
        <li>Account deactivated (cannot log in)</li>
        <li>Personal access tokens revoked</li>
        <li>Pending invitations removed</li>
        <li>
            Workspaces where you are the sole member will be deleted, <strong>including all their products, SBOMs, and documents</strong>
        </li>
        <li>Stripe subscriptions for deleted workspaces will be cancelled</li>
    </ul>
    </c-feedback.alert>
    <c-feedback.alert variant="info" icon="fas fa-clock" title="After 14 days" class="mb-4">
    <ul class="text-sm m-0 pl-4 space-y-1">
        <li>Account permanently deleted</li>
        <li>Contact support to cancel deletion within the grace period</li>
    </ul>
    </c-feedback.alert>
    {# Validation Error Display #}
    <c-feedback.alert variant="danger" class="mb-4" x-show="validationError" x-cloak>
    <span x-text="validationError"></span>
    </c-feedback.alert>
    <div class="mt-4">
        <c-forms.label for="delete-account-confirm">Type <strong>delete</strong> to confirm:</c-forms.label>
        <c-forms.input id="delete-account-confirm" placeholder="Type 'delete' to confirm" autocomplete="off" x-model="confirmText" ::disabled="isDeleting" @keydown.enter="if (canConfirm && !isDeleting) deleteAccount()" />
    </div>
    <c-slot name="footer">
    <c-buttons.ghost @click="closeModal()" ::disabled="isDeleting">Cancel</c-buttons.ghost>
    <c-buttons.danger @click="deleteAccount()" ::disabled="!canConfirm || isDeleting">
    <span x-show="isDeleting">{% include "core/components/brand/loader.html.j2" with class="tw-loader-inline" %}</span>
    <i x-show="!isDeleting" class="fas fa-trash"></i>
    <span x-text="isDeleting ? 'Deleting…' : 'Delete my account'"></span>
    </c-buttons.danger>
    </c-slot>
    </c-modal>
</div>
