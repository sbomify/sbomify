<div class="flex flex-col gap-5">
    <c-layout.section-header level="2" title="Billing" subtitle="Your subscription, limits and included features." />
    <c-cards.card flush>
    <c-cards.header compact title="Current plan" />
    <c-forms.field horizontal label="{{ team.billing_plan|default:'community'|title }}" hint="{{ plan_pricing.amount|default:'$0' }} {{ plan_pricing.period|default:'' }}">
    {% if can_administer %}
        <c-buttons.primary size="sm" href="{% url 'billing:select_plan' team.key %}">
        {% if team.billing_plan == 'community' or not team.billing_plan %}
            Upgrade plan
        {% else %}
            Change plan
        {% endif %}
        </c-buttons.primary>
    {% endif %}
    </c-forms.field>
    {% if plan_pricing.billing_period and team.billing_plan and team.billing_plan != 'community' %}
        <c-forms.field horizontal label="Billing cycle"><c-badges.secondary>{{ plan_pricing.billing_period|title }}</c-badges.secondary></c-forms.field>
    {% endif %}
    {% if plan_pricing.next_billing_date %}
        <c-forms.field horizontal label="
        {% if team.billing_plan_limits.cancel_at_period_end %}
            Plan ends on
        {% else %}
            Next billing
        {% endif %}
        ">
        <c-forms.hint>{{ plan_pricing.next_billing_date|date:'j M Y' }}</c-forms.hint>
        </c-forms.field>
    {% endif %}
    </c-cards.card>
    {% if team.billing_plan_limits.subscription_status == 'past_due' %}
        <c-feedback.alert variant="danger" title="Payment Failed">Check your dashboard for the grace period status and update your billing details.</c-feedback.alert>
    {% endif %}
    {% if plan_limits %}
        <section class="flex flex-col gap-4">
            <c-layout.section-header title="Plan limits" />
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                {% for limit in plan_limits %}
                    <c-layout.stat-card compact icon="fas fa-{{ limit.icon }}" :value="limit.value" label="{{ limit.label }}" />
                {% endfor %}
            </div>
        </section>
    {% endif %}
    {% if plan_features %}
        <c-cards.card flush>
        <c-cards.header compact title="Included features" />
        <c-cards.body>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {% for feature in plan_features %}<c-feedback.status tone="success" label="{{ feature }}" />{% endfor %}
        </div>
        </c-cards.body>
        </c-cards.card>
    {% endif %}
</div>
