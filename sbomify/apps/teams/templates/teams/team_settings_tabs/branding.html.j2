<div id="team-branding-wrapper"
     hx-get="{% url 'teams:team_branding' team.key %}"
     hx-trigger="load, refreshTeamBranding from:body"
     hx-swap="innerHTML">
    {# Skeleton loading state, shaped like the loaded layout: form rail left, preview right. #}
    <div class="grid grid-cols-1 gap-10 xl:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] xl:items-start">
        <div class="space-y-6">
            <div>
                <div class="h-5 w-28 bg-border/50 rounded animate-pulse"></div>
                <div class="h-4 w-56 bg-border/30 rounded animate-pulse mt-2"></div>
            </div>
            <div class="space-y-3">
                <div class="h-4 w-20 bg-border/50 rounded animate-pulse"></div>
                <div class="h-12 bg-border/30 rounded-lg animate-pulse"></div>
                <div class="h-12 bg-border/30 rounded-lg animate-pulse"></div>
            </div>
            <div class="space-y-3">
                <div class="h-4 w-24 bg-border/50 rounded animate-pulse"></div>
                <c-feedback.skeleton type="image" height="8rem" />
            </div>
        </div>
        <div class="space-y-3">
            <div class="h-4 w-24 bg-border/50 rounded animate-pulse"></div>
            <c-feedback.skeleton type="image" height="24rem" />
        </div>
    </div>
    <c-feedback.loading row message="Loading branding settings..." class="mt-4" />
</div>
