{% url 'teams:contact_profiles_list' team.key as profile_list_url %}
{# The group lets the header action step aside while a profile is open below it. #}
<div class="group/parties flex flex-col gap-5">
    <c-layout.section-header level="2" title="Parties" subtitle="Supplier, manufacturer and security contacts, reused across components.">
    <c-slot name="actions">
    <c-buttons.primary size="sm" class="group-has-[.profile-form]/parties:hidden" hx-get="{% url 'teams:contact_profiles_form' team.key %}" hx-target="#contact-profiles-content" hx-swap="innerHTML settle:0">Add party</c-buttons.primary>
    </c-slot>
    </c-layout.section-header>
    <c-cards.card flush>
    <div id="contact-profiles-content"
         hx-get="{{ profile_list_url }}"
         hx-trigger="refreshProfileList from:body"
         hx-swap="innerHTML settle:0"
         data-edit-url="{% url 'teams:contact_profiles_detail_form' team.key '0000' %}"
         data-list-url="{{ profile_list_url }}">{% include 'teams/contact_profiles/profile_list.html.j2' %}</div>
    </c-cards.card>
</div>
{% include 'teams/contact_profiles/partials/alpine_components.html.j2' %}
