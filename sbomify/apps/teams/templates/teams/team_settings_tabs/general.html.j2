<div id="team-general-wrapper"
     hx-get="{% url 'teams:team_general' team.key %}"
     hx-trigger="load, refreshTeamGeneral from:body"
     hx-swap="innerHTML">
    {# Skeleton loading state, shaped like the loaded layout. #}
    <div class="max-w-2xl space-y-6">
        <div>
            <div class="h-5 w-24 bg-border/50 rounded animate-pulse"></div>
            <div class="h-4 w-52 bg-border/30 rounded animate-pulse mt-2"></div>
        </div>
        <div>
            <div class="h-4 w-32 bg-border/50 rounded animate-pulse mb-2"></div>
            <div class="h-10 w-full bg-border/30 rounded-lg animate-pulse"></div>
        </div>
        <div>
            <div class="h-4 w-28 bg-border/50 rounded animate-pulse mb-2"></div>
            <div class="h-10 w-full bg-border/30 rounded-lg animate-pulse"></div>
        </div>
    </div>
    <c-feedback.loading row message="Loading general settings..." class="mt-4" />
</div>
