{% load teams %}
<div class="flex flex-col gap-5">
    <c-layout.section-header level="2" title="Members" subtitle="Who has access to this workspace.">
    <c-slot name="actions">
    {% if can_administer %}
        <c-buttons.primary size="sm" href="{% url 'teams:invite_user' team.key %}">Invite member</c-buttons.primary>
    {% endif %}
    </c-slot>
    </c-layout.section-header>
    {% if pending_invitations %}
        <c-cards.card flush>
        <c-cards.header compact title="Incoming invitations" hint="You have been invited to these workspaces." />
        {% for inv in pending_invitations %}
            <c-forms.field horizontal label="{{ inv.team_name }}" hint="Expires {{ inv.expires_at|date:'j M Y' }}">
            <div class="flex items-center gap-2">
                <c-badges.secondary>{{ inv.role|title }}</c-badges.secondary>
                <form method="post"
                      action="{% url 'core:accept_user_invitation' inv.id %}"
                      hx-boost="false">
                    {% csrf_token %}<c-buttons.primary type="submit" size="sm">Accept</c-buttons.primary>
                </form>
                <form method="post"
                      action="{% url 'core:reject_user_invitation' inv.id %}"
                      hx-boost="false">
                    {% csrf_token %}<c-buttons.secondary type="submit" size="sm">Decline</c-buttons.secondary>
                </form>
            </div>
            </c-forms.field>
        {% endfor %}
        </c-cards.card>
    {% endif %}
    <c-cards.card flush>
    <c-cards.header compact title="Workspace members" hint="{{ team.members|length }} member{{ team.members|length|pluralize }}" />
    <c-tables.table>
    <c-tables.head>
    <c-tables.header-cell compact>Member</c-tables.header-cell>
    <c-tables.header-cell compact>Role</c-tables.header-cell>
    <c-tables.actions-cell as="th" />
    </c-tables.head>
    <tbody>
        {% for member in team.members %}
            <c-tables.row>
            <c-tables.cell compact>
            <div class="flex items-center gap-3">
                <c-avatar size="sm" initials="{{ member.user|user_initials }}" />
                <div class="min-w-0">
                    <c-overview.record title="{{ member.user.first_name }} {{ member.user.last_name }}" detail="{{ member.user.email }}" />
                </div>
            </div>
            </c-tables.cell>
            <c-tables.cell compact><c-badges.secondary>{{ member.role|title }}</c-badges.secondary></c-tables.cell>
            <c-tables.actions-cell>
            {% if can_administer and member.role != 'owner' %}
                <c-actions-menu label="Member actions">
                <c-dropdowns.item-danger icon="fas fa-user-minus" @click="$dispatch('open-delete-member-modal', { displayName: '{{ member.user.first_name|escapejs }} {{ member.user.last_name|escapejs }}', formData: { member_id: '{{ member.id }}' } })">Remove member</c-dropdowns.item-danger>
                </c-actions-menu>
            {% endif %}
            </c-tables.actions-cell>
            </c-tables.row>
        {% endfor %}
    </tbody>
    </c-tables.table>
    <c-navigation.accordion-item native label="What can each role do?" id="role-legend">
    <div class="space-y-3">
        {% for role_key, role_label, role_description in role_descriptions %}
            <c-overview.record title="{{ role_label }}" detail="{{ role_description }}" />
        {% endfor %}
    </div>
    </c-navigation.accordion-item>
    </c-cards.card>
    {% if can_administer %}
        <c-cards.card flush>
        <c-cards.header compact title="Pending invitations" hint="{{ team.invitations|length }} pending" />
        {% if team.invitations %}
            <c-tables.table>
            <c-tables.head>
            <c-tables.header-cell compact>Email</c-tables.header-cell>
            <c-tables.header-cell compact>Role</c-tables.header-cell>
            <c-tables.header-cell compact>Expires</c-tables.header-cell>
            <c-tables.actions-cell as="th" />
            </c-tables.head>
            <tbody>
                {% for invitation in team.invitations %}
                    <c-tables.row>
                    <c-tables.cell compact>{{ invitation.email }}</c-tables.cell>
                    <c-tables.cell compact><c-badges.secondary>{{ invitation.role|title }}</c-badges.secondary></c-tables.cell>
                    <c-tables.cell compact date muted>{{ invitation.expires_at|date:"j M Y" }}</c-tables.cell>
                    <c-tables.actions-cell>
                    <c-buttons.icon-quiet size="sm" label="Cancel invitation for {{ invitation.email }}" @click="$dispatch('open-delete-invitation-modal', { displayName: '{{ invitation.email|escapejs }}', formData: { invitation_id: '{{ invitation.id }}' } })"><i class="fas fa-xmark" aria-hidden="true"></i></c-buttons.icon-quiet>
                    </c-tables.actions-cell>
                    </c-tables.row>
                {% endfor %}
            </tbody>
            </c-tables.table>
        {% else %}
            <c-feedback.empty-state compact icon="fas fa-envelope" title="No pending invitations" message="Invite a member to give them access to this workspace." />
        {% endif %}
        </c-cards.card>
        {% include "components/modals/delete_modal.html.j2" with modal_id="delete-member-modal" modal_title="Remove Member" message_text="Are you sure you want to remove" warning_text="This action will immediately remove the member from the workspace and revoke their access." form_action=request.path form=delete_member_form submit_text="Remove Member" additional_fields='<input type="hidden" name="active_tab" value="members">' %}
        {% include "components/modals/delete_modal.html.j2" with modal_id="delete-invitation-modal" modal_title="Cancel Invitation" message_text="Are you sure you want to cancel the invitation for" warning_text="This action will immediately cancel the invitation and the user will no longer be able to join the workspace using this invite." form_action=request.path form=delete_invitation_form submit_text="Cancel Invitation" additional_fields='<input type="hidden" name="active_tab" value="members">' %}
    {% endif %}
</div>
