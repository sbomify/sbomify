{% load public_url_tags %}
<div class="flex flex-col gap-5">
    <c-layout.section-header level="2" title="Trust Center" subtitle="Choose what you share with customers and how they access it." />
    <c-cards.card flush>
    <c-cards.header compact title="Public access" />
    {% include 'teams/components/trust_center_toggle.html.j2' with label='Enable Trust Center' hint='Share your public products and security artifacts with visitors.' control_id='workspace-visibility-toggle' control_label='Make workspace publicly visible' action_name='visibility_action' field_name='is_public' enabled=team.is_public save_label='Save visibility' %}
    {% if team.is_public %}
        {% trust_center_absolute_url team as public_url %}
        <c-forms.field horizontal label="Public URL" hint="The address you can share with customers.">
        <c-copy-field value="{{ public_url }}" label="public URL" id="trust-center-public-url">
        <c-buttons.icon-quiet size="sm" href="{{ public_url }}" target="_blank" rel="noopener" label="Open Trust Center"><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i></c-buttons.icon-quiet>
        </c-copy-field>
        </c-forms.field>
    {% endif %}
    </c-cards.card>
    {% if not can_set_private %}
        <c-feedback.alert variant="info">Disabling the Trust Center requires a Business or Enterprise plan.</c-feedback.alert>
    {% endif %}
    {% if team.is_public %}
        {% if trust_center_domain %}
            <form method="post"
                  action="{% url 'teams:team_settings' team.key %}"
                  x-data="{ slug: '{{ team_obj.slug|default:''|escapejs }}' }"
                  class="space-y-4">
                {% csrf_token %}
                <input type="hidden" name="slug_action" value="update">
                <input type="hidden" name="active_tab" value="trust-center">
                <c-cards.card flush>
                <c-cards.header compact title="Address" />
                <c-forms.field horizontal label="Subdomain slug" for="slug" hint="3 to 63 lowercase letters, numbers or hyphens. Start and end with a letter or number.">
                <c-forms.input size="sm" id="slug" name="slug" value="{{ team_obj.slug|default:'' }}" maxlength="63" minlength="3" pattern="[a-z0-9]([a-z0-9-]*[a-z0-9])?" placeholder="my-company" disabled="{{ can_administer|yesno:',1' }}" x-model="slug" />
                <c-forms.hint><span x-text="slug ? (slug + '.{{ trust_center_domain|escapejs }}') : 'Choose a subdomain'"></span></c-forms.hint>
                </c-forms.field>
                </c-cards.card>
                <div class="flex justify-end">
                    <c-buttons.primary type="submit" size="sm" disabled="{{ can_administer|yesno:',1' }}">Save slug</c-buttons.primary>
                </div>
            </form>
        {% endif %}
        <c-cards.card flush>
        <c-cards.header compact title="Sharing" />
        {% include 'teams/components/trust_center_toggle.html.j2' with label='Publish vulnerability posture' hint='Show vulnerability details on public release pages. Only public components are counted, after applying VEX statements.' control_id='vuln-posture-toggle' control_label='Publish vulnerability posture on the Trust Center' action_name='vulnerability_posture_action' field_name='publish_vulnerability_posture' enabled=team_obj.publish_vulnerability_posture save_label='Save vulnerability posture setting' %}
        {% include 'teams/components/trust_center_toggle.html.j2' with label='Transparency Exchange API (TEA)' hint='Let tools discover and retrieve your software transparency information. This feature is in beta.' control_id='tea-toggle' control_label='Enable Transparency Exchange API' action_name='tea_action' field_name='tea_enabled' enabled=team_obj.tea_enabled save_label='Save TEA setting' %}
        {% if team_obj.tea_enabled %}
            <c-forms.field horizontal label="TEA discovery endpoint">
            {% if team_obj.custom_domain and team_obj.custom_domain_validated %}
                {% with tea_url='https://'|add:team_obj.custom_domain|add:'/.well-known/tea' %}
                    <c-copy-field value="{{ tea_url }}" label="TEA discovery URL" id="tea-discovery-url" />
                {% endwith %}
            {% elif trust_center_domain and team_obj.slug %}
                {% with tea_url='https://'|add:team_obj.slug|add:'.'|add:trust_center_domain|add:'/.well-known/tea' %}
                    <c-copy-field value="{{ tea_url }}" label="TEA discovery URL" id="tea-discovery-url" />
                {% endwith %}
            {% else %}
                <c-forms.hint>Configure a custom domain or Trust Center slug to enable discovery.</c-forms.hint>
            {% endif %}
            </c-forms.field>
        {% endif %}
        </c-cards.card>
        <form method="post"
              action="{% url 'teams:team_settings' team.key %}"
              class="space-y-4">
            {% csrf_token %}
            <input type="hidden" name="trust_center_description_action" value="update">
            <input type="hidden" name="active_tab" value="trust-center">
            <c-cards.card flush>
            <c-cards.header compact title="Description" />
            <c-forms.field horizontal label="Welcome message" for="trust_center_description" hint="Shown at the top of your Trust Center. Maximum 500 characters. Leave empty for the default description.">
            <c-forms.textarea id="trust_center_description" name="trust_center_description" rows="4" maxlength="500" placeholder="Introduce your Trust Center" disabled="{{ can_administer|yesno:',1' }}" value="{{ branding_info.trust_center_description|default:'' }}" />
            </c-forms.field>
            </c-cards.card>
            <div class="flex justify-end">
                <c-buttons.primary type="submit" size="sm" disabled="{{ can_administer|yesno:',1' }}">Save description</c-buttons.primary>
            </div>
        </form>
        {% include 'teams/components/security_txt_form.html.j2' %}
        <c-cards.card flush>
        <c-cards.header compact title="Company NDA" hint="Require an agreement before sharing restricted content." />
        {% include 'teams/components/nda_guidance.html.j2' %}
        {% if company_nda_document %}
            <c-forms.field horizontal label="{{ company_nda_document.name }}" hint="Version {{ company_nda_document.version|default:'1' }}. {{ company_nda_document.file_size|filesizeformat }}.">
            <c-buttons.secondary size="sm" href="{% url 'documents:document_download' company_nda_document.id %}" target="_blank" rel="noopener">View NDA</c-buttons.secondary>
            </c-forms.field>
        {% endif %}
        <c-cards.body>
        <form method="post"
              action="{% url 'teams:team_settings' team.key %}"
              enctype="multipart/form-data"
              class="space-y-4"
              x-data="{ fileName: '' }">
            {% csrf_token %}
            <input type="hidden" name="company_nda_action" value="upload">
            <input type="hidden" name="active_tab" value="trust-center">
            <c-forms.file-upload name="company_nda_file" id="company_nda_file" accept=".pdf" required disabled="{{ can_administer|yesno:',1' }}" hint="PDF only, up to {{ max_upload_size_mb }} MB." on_change="fileName = $event.target.files[0]?.name || ''"><span x-text="fileName || 'Choose an NDA file'"></span></c-forms.file-upload>
            {% if company_nda_document %}
                <c-feedback.alert variant="warning">Uploading a new version invalidates existing signatures. Requesters will need to sign again.</c-feedback.alert>
            {% endif %}
            <div class="flex justify-end">
                <c-buttons.primary type="submit" size="sm" disabled="{{ can_administer|yesno:',1' }}">
                {% if company_nda_document %}
                    Upload new version
                {% else %}
                    Upload NDA
                {% endif %}
                </c-buttons.primary>
            </div>
        </form>
        </c-cards.body>
        </c-cards.card>
        <div id="access-requests-wrapper"
             x-data
             hx-get="{% url 'documents:access_request_queue' team.key %}?partial=true"
             hx-trigger="load, refreshAccessRequests from:body"
             hx-swap="innerHTML settle:0"
             @ws:message.window="if ($event.detail.type === 'access_request_updated') $dispatch('refreshAccessRequests')">
            <c-feedback.loading-table message="Loading access requests..." />
        </div>
        <div id="team-custom-domain-wrapper"
             hx-get="{% url 'teams:team_custom_domain' team.key %}"
             hx-trigger="load, refreshTeamCustomDomain from:body"
             hx-swap="innerHTML settle:0">
            <c-cards.card flush><c-feedback.loading message="Loading custom domain settings..." /></c-cards.card>
        </div>
    {% else %}
        <c-feedback.empty-state icon="fas fa-globe" title="Your Trust Center is off" message="Enable it to configure sharing, security contacts, access requests and a custom domain." />
    {% endif %}
</div>
