{% load public_url_tags %}
{# Trust Center Availability Section #}
<div class="tw-dashboard-card mb-6">
    <div class="px-6 py-4 border-b border-border">
        <div class="flex items-center gap-3">
            <span class="tw-icon-chip {% if team.is_public %}tw-icon-chip-success{% else %}tw-icon-chip-neutral{% endif %}">
                <i class="fas {% if team.is_public %}fa-globe{% else %}fa-lock{% endif %}"
                   aria-hidden="true"></i>
            </span>
            <div>
                <h5 class="text-lg font-semibold text-text m-0">Trust Center availability</h5>
                <p class="text-text-muted text-sm m-0">Control public access to your Trust Center</p>
            </div>
        </div>
    </div>
    <div class="p-6">
        <div class="flex items-center justify-between gap-4 mb-4">
            <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium {% if team.is_public %}bg-success/10 text-success{% else %}bg-border/50 text-text-muted{% endif %}">
                {{ team.is_public|yesno:'Enabled,Disabled' }}
            </span>
            <form method="post"
                  action="{% url 'teams:team_settings' team.key %}"
                  class="flex-shrink-0">
                {% csrf_token %}
                <input type="hidden" name="visibility_action" value="update">
                <input type="hidden" name="is_public" value="false">
                <input type="hidden" name="active_tab" value="trust-center">
                <c-forms.toggle id="workspace-visibility-toggle" name="is_public" value="true" aria-label="Make workspace publicly visible" checked="{{ team.is_public|yesno:'1,' }}" disabled="{{ can_administer|yesno:',1' }}" onchange="this.form.submit()" />
                <button type="submit" class="sr-only">Save visibility</button>
            </form>
        </div>
        <p class="text-text-muted mb-4">
            {% if team.is_public %}
                Your Trust Center is publicly accessible. Visitors can view your public products and security artifacts.
            {% else %}
                Your Trust Center is currently disabled. Enable it to share your security posture with customers and partners.
            {% endif %}
        </p>
        {% if team.is_public %}
            {% trust_center_absolute_url team as public_url %}
            <div class="p-4 bg-background/50 rounded-lg border border-border"
                 x-data="{ copied: false }">
                <label class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2 block">Public URL</label>
                <div class="flex items-center gap-2">
                    <code class="flex-1 min-w-0 px-3 py-2 bg-background border border-border rounded-lg text-sm text-text font-mono truncate">{{ public_url }}</code>
                    <button type="button"
                            class="tw-copy-btn flex-shrink-0"
                            :class="{ copied: copied }"
                            title="Copy public URL"
                            aria-label="Copy public URL"
                            @click="navigator.clipboard.writeText('{{ public_url }}'); copied = true; setTimeout(() => copied = false, 2000)">
                        <i x-show="!copied" class="fas fa-copy tw-copy-btn-icon"></i>
                        <i x-show="copied" x-cloak class="fas fa-check tw-copy-btn-icon"></i>
                        <span x-text="copied ? 'Copied!' : 'Copy'"></span>
                    </button>
                    <a href="{{ public_url }}"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="tw-btn-ghost tw-btn-sm flex-shrink-0"
                       title="Open Trust Center"
                       aria-label="Open Trust Center (opens in new tab)">
                        <i class="fas fa-external-link-alt" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        {% endif %}
        {% if not can_administer %}
            <div class="tw-alert tw-alert-info mt-4">
                <i class="fas fa-info-circle tw-alert-icon"></i>
                <div class="tw-alert-content">
                    <p class="text-sm m-0">Only workspace owners and admins can change Trust Center visibility.</p>
                </div>
            </div>
        {% elif not can_set_private %}
            <div class="tw-alert tw-alert-info mt-4">
                <i class="fas fa-crown tw-alert-icon"></i>
                <div class="tw-alert-content">
                    <p class="text-sm m-0">Disabling the Trust Center is available on Business or Enterprise plans.</p>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{# Trust Center Slug Section #}
{% if team.is_public and trust_center_domain %}
    <div class="tw-dashboard-card mb-6">
        <div class="px-6 py-4 border-b border-border">
            <div class="flex items-center gap-3">
                <span class="tw-icon-chip">
                    <i class="fas fa-link" aria-hidden="true"></i>
                </span>
                <div>
                    <h5 class="text-lg font-semibold text-text m-0">Trust Center Slug</h5>
                    <p class="text-text-muted text-sm m-0">Customize your Trust Center subdomain</p>
                </div>
            </div>
        </div>
        <div class="p-6">
            <form method="post"
                  action="{% url 'teams:team_settings' team.key %}"
                  class="w-full"
                  x-data="{ slug: '{{ team_obj.slug|default:'' }}' }">
                {% csrf_token %}
                <input type="hidden" name="slug_action" value="update">
                <input type="hidden" name="active_tab" value="trust-center">
                <div class="mb-4">
                    <label for="slug" class="tw-form-label">Subdomain Slug</label>
                    <div class="flex items-center gap-2">
                        <input id="slug"
                               type="text"
                               name="slug"
                               class="tw-form-input flex-1"
                               x-model="slug"
                               value="{{ team_obj.slug|default:'' }}"
                               maxlength="63"
                               minlength="3"
                               pattern="[a-z0-9]([a-z0-9-]*[a-z0-9])?"
                               placeholder="my-company"
                               {% if not can_administer %}disabled{% endif %}>
                    </div>
                    <p class="tw-form-hint mt-2">
                        Your Trust Center will be available at:
                        <code class="text-primary"
                              x-text="slug ? (slug + '.{{ trust_center_domain }}') : '...'"></code>
                    </p>
                    <p class="tw-form-hint">
                        Lowercase letters, numbers, and hyphens only. Must not start or end with a hyphen. 3–63 characters.
                    </p>
                </div>
                <div class="flex justify-end">
                    <button type="submit"
                            class="tw-btn-primary"
                            {% if not can_administer %}disabled{% endif %}>
                        <i class="fas fa-save mr-2"></i>Save Slug
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endif %}
{# TEA Section - uses team_obj (Django model) for tea_enabled since team is a Pydantic schema #}
{% if team.is_public %}
    <div class="tw-dashboard-card mb-6">
        <div class="px-6 py-4 border-b border-border">
            <div class="flex items-center gap-3">
                <span class="tw-icon-chip {% if team_obj.tea_enabled %}tw-icon-chip-success{% else %}tw-icon-chip-neutral{% endif %}">
                    <i class="fas fa-exchange-alt" aria-hidden="true"></i>
                </span>
                <div>
                    <h5 class="text-lg font-semibold text-text m-0">
                        Transparency Exchange API (TEA)
                        <span class="tw-badge-info text-xs align-middle ml-2">
                            <i class="fas fa-flask mr-1"></i>Beta
                        </span>
                    </h5>
                    <p class="text-text-muted text-sm m-0">Standardized access to software transparency information</p>
                </div>
            </div>
        </div>
        <div class="p-6">
            <div class="flex items-center justify-between gap-4 mb-4">
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium {% if team_obj.tea_enabled %}bg-success/10 text-success{% else %}bg-border/50 text-text-muted{% endif %}">
                    {{ team_obj.tea_enabled|yesno:'Enabled,Disabled' }}
                </span>
                <form method="post"
                      action="{% url 'teams:team_settings' team.key %}"
                      class="flex-shrink-0">
                    {% csrf_token %}
                    <input type="hidden" name="tea_action" value="update">
                    <input type="hidden" name="tea_enabled" value="false">
                    <input type="hidden" name="active_tab" value="trust-center">
                    <c-forms.toggle id="tea-toggle" name="tea_enabled" value="true" aria-label="Enable Transparency Exchange API" checked="{{ team_obj.tea_enabled|yesno:'1,' }}" disabled="{{ can_administer|yesno:',1' }}" onchange="this.form.submit()" />
                    <button type="submit" class="sr-only">Save TEA setting</button>
                </form>
            </div>
            <p class="text-text-muted mb-4">
                The Transparency Exchange API (TEA) provides standardized access to your software transparency
                information via a well-known discovery endpoint and REST API.
                <a href="https://github.com/CycloneDX/transparency-exchange-api"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="text-primary hover:underline">Learn more</a>
            </p>
            {% if team_obj.tea_enabled and team_obj.custom_domain and team_obj.custom_domain_validated %}
                <div class="p-4 bg-background/50 rounded-lg border border-border"
                     x-data="{ copied: false }">
                    <label class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2 block">TEA Discovery Endpoint</label>
                    <div class="flex items-center gap-2">
                        <code class="flex-1 min-w-0 px-3 py-2 bg-background border border-border rounded-lg text-sm text-text font-mono truncate">https://{{ team_obj.custom_domain }}/.well-known/tea</code>
                        <button type="button"
                                class="tw-copy-btn flex-shrink-0"
                                :class="{ copied: copied }"
                                title="Copy TEA discovery URL"
                                aria-label="Copy TEA discovery URL"
                                @click="navigator.clipboard.writeText('https://{{ team_obj.custom_domain }}/.well-known/tea'); copied = true; setTimeout(() => copied = false, 2000)">
                            <i x-show="!copied" class="fas fa-copy tw-copy-btn-icon"></i>
                            <i x-show="copied" x-cloak class="fas fa-check tw-copy-btn-icon"></i>
                            <span x-text="copied ? 'Copied!' : 'Copy'"></span>
                        </button>
                    </div>
                </div>
            {% elif team_obj.tea_enabled and trust_center_domain and team_obj.slug %}
                <div class="p-4 bg-background/50 rounded-lg border border-border"
                     x-data="{ copied: false }">
                    <label class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2 block">TEA Discovery Endpoint</label>
                    <div class="flex items-center gap-2">
                        <code class="flex-1 min-w-0 px-3 py-2 bg-background border border-border rounded-lg text-sm text-text font-mono truncate">https://{{ team_obj.slug }}.{{ trust_center_domain }}/.well-known/tea</code>
                        <button type="button"
                                class="tw-copy-btn flex-shrink-0"
                                :class="{ copied: copied }"
                                title="Copy TEA discovery URL"
                                aria-label="Copy TEA discovery URL"
                                @click="navigator.clipboard.writeText('https://{{ team_obj.slug }}.{{ trust_center_domain }}/.well-known/tea'); copied = true; setTimeout(() => copied = false, 2000)">
                            <i x-show="!copied" class="fas fa-copy tw-copy-btn-icon"></i>
                            <i x-show="copied" x-cloak class="fas fa-check tw-copy-btn-icon"></i>
                            <span x-text="copied ? 'Copied!' : 'Copy'"></span>
                        </button>
                    </div>
                </div>
            {% elif team_obj.tea_enabled %}
                <div class="tw-alert tw-alert-info mt-4">
                    <i class="fas fa-info-circle tw-alert-icon"></i>
                    <div class="tw-alert-content">
                        <p class="text-sm m-0">
                            Configure a custom domain or Trust Center slug to enable TEA discovery via <code>.well-known/tea</code>.
                        </p>
                    </div>
                </div>
            {% endif %}
            {% if not can_administer %}
                <div class="tw-alert tw-alert-info mt-4">
                    <i class="fas fa-info-circle tw-alert-icon"></i>
                    <div class="tw-alert-content">
                        <p class="text-sm m-0">Only workspace owners and admins can change TEA settings.</p>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endif %}
{# Security.txt (RFC 9116) Section #}
{% if team.is_public %}
    <div class="tw-dashboard-card mb-6"
         x-data="{ securityTxtEnabled: {{ security_txt_config.enabled|default:False|yesno:'true,false' }} }">
        <div class="px-6 py-4 border-b border-border">
            <div class="flex items-center gap-3">
                <span class="tw-icon-chip"
                      :class="securityTxtEnabled ? 'tw-icon-chip-success' : 'tw-icon-chip-neutral'">
                    <i class="fas fa-shield-alt" aria-hidden="true"></i>
                </span>
                <div>
                    <h5 class="text-lg font-semibold text-text m-0">
                        Security.txt
                        <span class="text-text-muted font-normal text-sm ml-1">(RFC 9116)</span>
                    </h5>
                    <p class="text-text-muted text-sm m-0">Help security researchers report vulnerabilities via a standard contact file</p>
                </div>
                <div class="ml-auto">
                    <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium"
                          :class="securityTxtEnabled ? 'bg-success/10 text-success' : 'bg-border/50 text-text-muted'"
                          x-text="securityTxtEnabled ? 'Enabled' : 'Disabled'"></span>
                </div>
            </div>
        </div>
        <div class="p-6">
            <form method="post"
                  action="{% url 'teams:team_settings' team.key %}"
                  class="w-full">
                {% csrf_token %}
                <input type="hidden" name="security_txt_action" value="update">
                <input type="hidden" name="active_tab" value="trust-center">
                <input type="hidden" name="security_txt_enabled" value="false">
                {# Enable toggle #}
                <div class="flex items-center justify-between gap-4 mb-6">
                    <div>
                        <p class="text-text font-medium m-0">Enable security.txt</p>
                        <p class="text-text-muted text-sm m-0">
                            Served at <code class="text-xs">/.well-known/security.txt</code> on your Trust Center domain and any validated custom domains
                        </p>
                    </div>
                    <c-forms.toggle id="security-txt-toggle" name="security_txt_enabled" value="true" aria-label="Enable security.txt" checked="{{ security_txt_config.enabled|yesno:'1,' }}" disabled="{{ can_administer|yesno:',1' }}" x-model="securityTxtEnabled" />
                </div>
                {# Configuration fields — shown when enabled #}
                <div x-show="securityTxtEnabled" x-cloak>
                    {# Required: Contact #}
                    <div class="mb-6 pb-6 border-b border-border/50">
                        <h6 class="text-sm font-semibold text-text uppercase tracking-wider mb-3">
                            <i class="fas fa-envelope text-primary mr-2"></i>Contact (required)
                        </h6>
                        <div>
                            <label for="security_txt_contact_id" class="tw-form-label">Contact for vulnerability reports</label>
                            <select id="security_txt_contact_id"
                                    name="security_txt_contact_id"
                                    class="tw-form-select"
                                    {% if not can_administer %}disabled{% endif %}>
                                <option value="">Auto-detect (security contact from default profile)</option>
                                {% for contact in security_txt_contacts %}
                                    <option value="{{ contact.id }}"
                                            {% if security_txt_config.contact_id == contact.id %}selected{% endif %}>
                                        {{ contact.name }} ({{ contact.email }})
                                        — {{ contact.entity__profile__name }}
                                    </option>
                                {% endfor %}
                            </select>
                            <p class="tw-form-hint mt-1">
                                Choose who receives vulnerability reports.
                                Manage contacts in
                                <a href="{% url 'teams:team_settings' team.key %}#contact-profiles"
                                   class="text-primary hover:underline">Contact Profiles</a>.
                            </p>
                        </div>
                    </div>
                    {# Optional: Links #}
                    <div class="mb-6 pb-6 border-b border-border/50">
                        <h6 class="text-sm font-semibold text-text uppercase tracking-wider mb-3">
                            <i class="fas fa-link text-primary mr-2"></i>Links (optional)
                        </h6>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label for="security_txt_policy_url" class="tw-form-label">Policy URL</label>
                                <input id="security_txt_policy_url"
                                       type="url"
                                       name="security_txt_policy_url"
                                       class="tw-form-input"
                                       value="{{ security_txt_config.policy_url|default:'' }}"
                                       placeholder="https://example.com/security-policy"
                                       {% if not can_administer %}disabled{% endif %}>
                                <p class="tw-form-hint mt-1">Vulnerability disclosure policy</p>
                            </div>
                            {{ security_txt_config.encryption_urls|json_script:"encryption-urls-data" }}
                            <div x-data="{ urls: (() => { let d = JSON.parse(document.getElementById('encryption-urls-data')?.textContent || '[]'); return Array.isArray(d) ? d : []; })() }">
                                <label class="tw-form-label">Encryption Key URLs</label>
                                <template x-for="(url, index) in urls" :key="index">
                                    <div class="flex gap-2 mb-2">
                                        <input type="url"
                                               :name="'security_txt_encryption_url_' + index"
                                               class="tw-form-input flex-1"
                                               x-model="urls[index]"
                                               placeholder="https://example.com/pgp-key.txt"
                                               {% if not can_administer %}disabled{% endif %}>
                                        <button type="button"
                                                @click="urls.splice(index, 1)"
                                                class="tw-btn-outline-primary tw-btn-sm text-danger"
                                                {% if not can_administer %}disabled{% endif %}>
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </template>
                                <button type="button"
                                        @click="urls.push('')"
                                        class="text-xs text-primary hover:underline"
                                        {% if not can_administer %}disabled{% endif %}>
                                    <i class="fas fa-plus mr-1"></i>Add encryption key URL
                                </button>
                                <input type="hidden"
                                       name="security_txt_encryption_urls"
                                       :value="JSON.stringify(urls)">
                                <p class="tw-form-hint mt-1">PGP public keys for encrypted reports (multiple allowed per RFC 9116)</p>
                            </div>
                            <div>
                                <label for="security_txt_acknowledgments_url" class="tw-form-label">Acknowledgments URL</label>
                                <input id="security_txt_acknowledgments_url"
                                       type="url"
                                       name="security_txt_acknowledgments_url"
                                       class="tw-form-input"
                                       value="{{ security_txt_config.acknowledgments_url|default:'' }}"
                                       placeholder="https://example.com/hall-of-fame"
                                       {% if not can_administer %}disabled{% endif %}>
                                <p class="tw-form-hint mt-1">Security researcher acknowledgments</p>
                            </div>
                            <div>
                                <label for="security_txt_hiring_url" class="tw-form-label">Hiring URL</label>
                                <input id="security_txt_hiring_url"
                                       type="url"
                                       name="security_txt_hiring_url"
                                       class="tw-form-input"
                                       value="{{ security_txt_config.hiring_url|default:'' }}"
                                       placeholder="https://example.com/security-jobs"
                                       {% if not can_administer %}disabled{% endif %}>
                                <p class="tw-form-hint mt-1">Security-related job openings</p>
                            </div>
                        </div>
                    </div>
                    {# Optional: Additional settings #}
                    <div class="mb-6">
                        <h6 class="text-sm font-semibold text-text uppercase tracking-wider mb-3">
                            <i class="fas fa-cog text-primary mr-2"></i>Additional settings
                        </h6>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div x-data="{ open: false, selected: '{{ security_txt_config.preferred_languages|default:'en' }}'.split(',').map(s => s.trim()).filter(Boolean), languages: [ {code: 'en', name: 'English'}, {code: 'de', name: 'German'}, {code: 'fr', name: 'French'}, {code: 'es', name: 'Spanish'}, {code: 'pt', name: 'Portuguese'}, {code: 'it', name: 'Italian'}, {code: 'nl', name: 'Dutch'}, {code: 'ja', name: 'Japanese'}, {code: 'ko', name: 'Korean'}, {code: 'zh', name: 'Chinese'}, {code: 'ar', name: 'Arabic'}, {code: 'ru', name: 'Russian'}, {code: 'pl', name: 'Polish'}, {code: 'sv', name: 'Swedish'}, {code: 'da', name: 'Danish'}, {code: 'no', name: 'Norwegian'}, {code: 'fi', name: 'Finnish'}, {code: 'tr', name: 'Turkish'}, {code: 'hi', name: 'Hindi'}, {code: 'he', name: 'Hebrew'}, ], toggle(code) { this.selected.includes(code) ? this.selected = this.selected.filter(c => c !== code) : this.selected.push(code); } }"
                                 @click.outside="open = false">
                                <label class="tw-form-label">Preferred Languages</label>
                                <button type="button"
                                        @click="open = !open"
                                        class="tw-form-input w-full text-left flex items-center justify-between"
                                        {% if not can_administer %}disabled{% endif %}>
                                    <span x-text="selected.length ? selected.join(', ') : 'Select languages'"
                                          class="truncate"
                                          :class="{ 'text-text-muted': !selected.length }"></span>
                                    <i class="fas fa-chevron-down text-text-muted text-xs transition-transform"
                                       :class="{ 'rotate-180': open }"></i>
                                </button>
                                <div x-show="open"
                                     x-cloak
                                     x-transition
                                     class="absolute z-10 mt-1 w-full max-h-48 overflow-y-auto rounded-lg border border-border bg-card shadow-lg p-1">
                                    <template x-for="lang in languages" :key="lang.code">
                                        <label class="flex items-center gap-2 px-3 py-1.5 rounded hover:bg-primary/5 cursor-pointer text-sm">
                                            <input type="checkbox"
                                                   :checked="selected.includes(lang.code)"
                                                   @change="toggle(lang.code)"
                                                   class="rounded border-border text-primary focus:ring-primary">
                                            <span x-text="lang.name" class="text-text"></span>
                                            <span x-text="lang.code" class="text-text-muted text-xs ml-auto"></span>
                                        </label>
                                    </template>
                                </div>
                                <input type="hidden"
                                       name="security_txt_preferred_languages"
                                       :value="selected.join(', ')">
                                <p class="tw-form-hint mt-1">English is selected by default</p>
                            </div>
                            <div>
                                <label class="tw-form-label">Canonical URL</label>
                                <div class="tw-form-input bg-border/20 text-text-muted text-sm">
                                    {% if trust_center_url %}
                                        {{ trust_center_url }}/.well-known/security.txt
                                    {% else %}
                                        Auto-set when Trust Center URL is configured
                                    {% endif %}
                                </div>
                                <input type="hidden"
                                       name="security_txt_canonical_url"
                                       value="{% if trust_center_url %}{{ trust_center_url }}/.well-known/security.txt{% endif %}">
                                <p class="tw-form-hint mt-1">Automatically set to your Trust Center's security.txt URL</p>
                            </div>
                        </div>
                    </div>
                    {# Info about Expires #}
                    <div class="tw-alert tw-alert-info mb-4">
                        <i class="fas fa-info-circle tw-alert-icon"></i>
                        <div class="tw-alert-content">
                            <p class="text-sm m-0">
                                The <strong>Expires</strong> field is automatically set to one year from now
                                and refreshed each time you save.
                            </p>
                        </div>
                    </div>
                </div>
                {# Save button + owner gate #}
                <div class="flex items-center justify-end mt-4 gap-4">
                    {% if not can_administer %}
                        <p class="text-text-muted text-sm m-0 mr-auto">
                            <i class="fas fa-lock mr-1"></i>Only workspace owners and admins can change these settings.
                        </p>
                    {% endif %}
                    <button type="submit"
                            class="tw-btn-primary"
                            {% if not can_administer %}disabled{% endif %}>
                        <i class="fas fa-save mr-2"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endif %}
{# Trust Center Description Section #}
{% if team.is_public %}
    <div class="tw-dashboard-card mb-6">
        <div class="px-6 py-4 border-b border-border">
            <div class="flex items-center gap-3">
                <span class="tw-icon-chip">
                    <i class="fas fa-align-left" aria-hidden="true"></i>
                </span>
                <div>
                    <h5 class="text-lg font-semibold text-text m-0">Trust Center Description</h5>
                    <p class="text-text-muted text-sm m-0">Customize your landing page messaging</p>
                </div>
            </div>
        </div>
        <div class="p-6">
            <form method="post"
                  action="{% url 'teams:team_settings' team.key %}"
                  class="w-full">
                {% csrf_token %}
                <input type="hidden" name="trust_center_description_action" value="update">
                <input type="hidden" name="active_tab" value="trust-center">
                <div class="mb-4">
                    <label for="trust_center_description" class="tw-form-label">Description</label>
                    <textarea id="trust_center_description"
                              class="tw-form-textarea"
                              name="trust_center_description"
                              rows="4"
                              maxlength="500"
                              placeholder="Your centralized hub for transparency and compliance. Browse our public products, releases, and organization-wide security artifacts."
                              {% if not can_administer %}disabled{% endif %}>{{ branding_info.trust_center_description|default:'' }}</textarea>
                    <span class="tw-form-hint">Max 500 characters. Leave empty to use the default description.</span>
                </div>
                <div class="flex justify-end">
                    <button type="submit"
                            class="tw-btn-primary"
                            {% if not can_administer %}disabled{% endif %}>
                        <i class="fas fa-save mr-2"></i>Save Description
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endif %}
{# Company NDA Section #}
{% if team.is_public %}
    <div class="tw-dashboard-card mb-6">
        <div class="px-6 py-4 border-b border-border">
            <div class="flex items-center gap-3">
                <span class="tw-icon-chip tw-icon-chip-warning">
                    <i class="fas fa-file-contract" aria-hidden="true"></i>
                </span>
                <div>
                    <h5 class="text-lg font-semibold text-text m-0">Company NDA</h5>
                    <p class="text-text-muted text-sm m-0">Non-disclosure agreement for gated content</p>
                </div>
            </div>
        </div>
        <div class="p-6">
            {# Preparation guidance — the signing flow is click-wrap, and a document drafted for wet signatures reads broken inside it #}
            <div class="mb-6 border border-border rounded-xl"
                 x-data="{ guideOpen: false }">
                <button type="button"
                        class="w-full flex items-center justify-between gap-3 px-4 py-3 text-sm text-text-muted hover:text-text transition-colors"
                        @click="guideOpen = !guideOpen"
                        :aria-expanded="guideOpen">
                    <span class="flex items-center gap-2 font-medium">
                        <i class="fas fa-circle-question" aria-hidden="true"></i>
                        How to prepare your NDA
                    </span>
                    <i class="fas fa-chevron-down transition-transform"
                       :class="guideOpen ? 'rotate-180' : ''"
                       aria-hidden="true"></i>
                </button>
                <div x-show="guideOpen"
                     x-cloak
                     x-collapse
                     class="px-4 pb-4 text-sm text-text-muted space-y-3">
                    <p class="m-0">
                        Nobody signs the PDF itself. A requester reads it in the browser, types their
                        full name, and confirms acceptance — sbomify then records their name, the time,
                        their IP address, and a cryptographic fingerprint of the exact document version
                        they accepted. Draft the document for that process:
                    </p>
                    <ul class="m-0 pl-5 space-y-1.5 list-disc">
                        <li>
                            Write it as a one-way agreement: obligations on the recipient, covering
                            "information made available through this Trust Center".
                        </li>
                        <li>Replace the signature block with an electronic-execution clause, for example:</li>
                    </ul>
                    <blockquote class="m-0 ml-5 pl-3 border-l-2 border-border italic">
                        This Agreement is executed electronically. By typing your name and confirming
                        acceptance, you agree to be bound by it; your typed name, the date and time,
                        your IP address, and a fingerprint of this document version are recorded
                        together and constitute your signature. You represent that you are authorized
                        to enter into this Agreement on behalf of the organization for which you are
                        requesting access.
                    </blockquote>
                    <ul class="m-0 pl-5 space-y-1.5 list-disc">
                        <li>Leave no blank name, date, or signature lines — they stay empty forever.</li>
                        <li>
                            If your company should appear as a signatory, put its name, title, and date
                            (or a scanned signature) in the PDF before uploading, so every acceptance is
                            against an already-countersigned document.
                        </li>
                        <li>
                            Finalize the wording first: uploading a replacement version invalidates every
                            existing signature and all requesters sign again.
                        </li>
                    </ul>
                </div>
            </div>
            {% if company_nda_document %}
                {# Current NDA Display #}
                <div class="mb-6 p-4 bg-success/5 border border-success/20 rounded-xl">
                    <div class="flex items-start gap-4">
                        <span class="tw-icon-chip tw-icon-chip-lg tw-icon-chip-success">
                            <i class="fas fa-file-pdf text-xl" aria-hidden="true"></i>
                        </span>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1">
                                <h6 class="font-medium text-text m-0 truncate">{{ company_nda_document.name }}</h6>
                                {% if company_nda_document.version %}
                                    <span class="tw-badge-success">v{{ company_nda_document.version }}</span>
                                {% endif %}
                            </div>
                            <div class="flex items-center gap-3 text-sm text-text-muted">
                                <span class="flex items-center gap-1">
                                    <i class="fas fa-calendar-alt text-xs"></i>
                                    {% include 'core/components/relative_time.html.j2' with timestamp=company_nda_document.created_at %}
                                </span>
                                {% if company_nda_document.file_size %}
                                    <span class="flex items-center gap-1">
                                        <i class="fas fa-weight text-xs"></i>
                                        {{ company_nda_document.file_size|filesizeformat }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                        <a href="{% url 'documents:document_download' company_nda_document.id %}"
                           class="tw-btn-secondary tw-btn-sm"
                           target="_blank"
                           rel="noopener noreferrer">
                            <i class="fas fa-eye mr-1"></i>View
                        </a>
                    </div>
                </div>
            {% endif %}
            {# Upload Form #}
            <form method="post"
                  action="{% url 'teams:team_settings' team.key %}"
                  enctype="multipart/form-data"
                  class="w-full"
                  x-data="{ fileName: '' }">
                {% csrf_token %}
                <input type="hidden" name="company_nda_action" value="upload">
                <input type="hidden" name="active_tab" value="trust-center">
                <label for="company_nda_file"
                       class="tw-file-upload relative block mb-4 {% if not can_administer %}opacity-50 pointer-events-none{% endif %}">
                    <input type="file"
                           id="company_nda_file"
                           name="company_nda_file"
                           class="sr-only"
                           accept=".pdf"
                           {% if not can_administer %}disabled{% endif %}
                           required
                           @change="fileName = $event.target.files[0] ? $event.target.files[0].name : ''">
                    <div class="tw-file-upload-icon">
                        <i class="fas fa-cloud-upload-alt text-xl"></i>
                    </div>
                    <p class="tw-file-upload-text">
                        <template x-if="fileName">
                            <span class="text-success font-medium" x-text="fileName"></span>
                        </template>
                        <template x-if="!fileName">
                            <span><span class="text-primary font-medium">Click to upload</span> or drag and drop</span>
                        </template>
                    </p>
                    <p class="tw-file-upload-hint">PDF files only. Max 50MB.</p>
                </label>
                <div class="flex justify-end">
                    <button type="submit"
                            class="tw-btn-primary"
                            {% if not can_administer %}disabled{% endif %}>
                        <i class="fas fa-upload mr-2"></i>
                        {% if company_nda_document %}
                            Upload New Version
                        {% else %}
                            Upload NDA
                        {% endif %}
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endif %}
{# Access Requests Section #}
{% if team.is_public %}
    <div id="access-requests-wrapper"
         x-data
         hx-get="{% url 'documents:access_request_queue' team.key %}?partial=true"
         hx-trigger="load, refreshAccessRequests from:body"
         hx-swap="innerHTML"
         @ws:message.window="if ($event.detail.type === 'access_request_updated') { document.body.dispatchEvent(new CustomEvent('refreshAccessRequests')); }">
        <div class="tw-dashboard-card mb-6">
            <div class="px-6 py-4 border-b border-border">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-background flex items-center justify-center">
                        {% include "core/components/brand/loader.html.j2" with class="tw-loader-sm mx-auto text-primary" %}
                    </div>
                    <div>
                        <div class="h-5 w-32 bg-border/50 rounded animate-pulse"></div>
                        <div class="h-4 w-48 bg-border/30 rounded animate-pulse mt-1"></div>
                    </div>
                </div>
            </div>
            <div class="p-6">
                <div class="flex items-center justify-center py-8">
                    {% include "core/components/brand/loader.html.j2" with class="tw-loader-md mx-auto text-primary" %}
                    <span class="ml-3 text-text-muted">Loading access requests...</span>
                </div>
            </div>
        </div>
    </div>
{% endif %}
{# Custom Domain Section #}
{% if team.is_public %}
    <div id="team-custom-domain-wrapper"
         hx-get="{% url 'teams:team_custom_domain' team.key %}"
         hx-trigger="load, refreshTeamCustomDomain from:body"
         hx-swap="innerHTML">
        <div class="tw-dashboard-card mb-6">
            <div class="px-6 py-4 border-b border-border">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-background flex items-center justify-center">
                        {% include "core/components/brand/loader.html.j2" with class="tw-loader-sm mx-auto text-primary" %}
                    </div>
                    <div>
                        <div class="h-5 w-32 bg-border/50 rounded animate-pulse"></div>
                        <div class="h-4 w-48 bg-border/30 rounded animate-pulse mt-1"></div>
                    </div>
                </div>
            </div>
            <div class="p-6">
                <div class="flex items-center justify-center py-8">
                    {% include "core/components/brand/loader.html.j2" with class="tw-loader-md mx-auto text-primary" %}
                    <span class="ml-3 text-text-muted">Loading custom domain settings...</span>
                </div>
            </div>
        </div>
    </div>
{% else %}
    <div class="tw-dashboard-card mb-6">
        <div class="px-6 py-4 border-b border-border">
            <div class="flex items-center gap-3">
                <span class="tw-icon-chip tw-icon-chip-neutral">
                    <i class="fas fa-globe" aria-hidden="true"></i>
                </span>
                <div>
                    <h5 class="text-lg font-semibold text-text m-0">Custom Domain</h5>
                    <p class="text-text-muted text-sm m-0">Use your own domain for the Trust Center</p>
                </div>
            </div>
        </div>
        <div class="p-6">
            <div class="tw-empty-state py-8">
                <div class="tw-empty-state-icon bg-border/30">
                    <i class="fas fa-lock text-2xl text-text-muted"></i>
                </div>
                <h4 class="tw-empty-state-title">Trust Center Required</h4>
                <p class="tw-empty-state-description">Enable your Trust Center above to configure a custom domain.</p>
            </div>
        </div>
    </div>
{% endif %}
