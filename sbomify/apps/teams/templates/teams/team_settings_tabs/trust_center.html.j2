{% load public_url_tags %}
{% comment %}
    Trust Center, in the settings-tab style the branding tab set: no card
    chrome, an h2 and one explainer line up top with the availability toggle
    beside them, then plain h3 sections separated by hairlines. This rewrite
    also retires the tab's tw-* legacy classes in favour of the component
    library.
{% endcomment %}
<div>
    {# Availability: the tab's master switch sits in the heading row. #}
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h2 class="text-lg font-semibold text-text m-0">Trust Center</h2>
            <p class="text-sm text-text-muted mt-1 m-0">The public page where customers read your security posture.</p>
        </div>
        <div class="flex items-center gap-3">
            {% if team.is_public %}
                <c-badges.success>Enabled</c-badges.success>
            {% else %}
                <c-badges.secondary>Disabled</c-badges.secondary>
            {% endif %}
            <form method="post"
                  action="{% url 'teams:team_settings' team.key %}"
                  class="flex-shrink-0">
                {% csrf_token %}
                <input type="hidden" name="visibility_action" value="update">
                <input type="hidden" name="is_public" value="false">
                <input type="hidden" name="active_tab" value="trust-center">
                <c-forms.toggle id="workspace-visibility-toggle" name="is_public" value="true" aria-label="Make workspace publicly visible" checked="{{ team.is_public|yesno:'1,' }}" disabled="{{ can_administer|yesno:',1' }}" onchange="this.form.submit()" />
                <button type="submit" class="sr-only">Save visibility</button>
            </form>
        </div>
    </div>
    <p class="text-sm text-text-muted mt-4 m-0">
        {% if team.is_public %}
            Your Trust Center is publicly accessible. Visitors can view your public products and security artifacts.
        {% else %}
            Your Trust Center is currently disabled. Enable it to share your security posture with customers and partners.
        {% endif %}
    </p>
    {% if team.is_public %}
        {% trust_center_absolute_url team as public_url %}
        <div class="mt-4 p-4 bg-background/50 rounded-xl border border-border"
             x-data="{ copied: false }">
            <label class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2 block">Public URL</label>
            <div class="flex items-center gap-2">
                <code class="flex-1 min-w-0 px-3 py-2 bg-background border border-border rounded-lg text-sm text-text font-mono truncate">{{ public_url }}</code>
                <c-buttons.secondary size="sm" class="flex-shrink-0" title="Copy public URL" aria-label="Copy public URL" @click="navigator.clipboard.writeText('{{ public_url }}'); copied = true; setTimeout(() => copied = false, 2000)">
                <i x-show="!copied" class="fas fa-copy" aria-hidden="true"></i>
                <i x-show="copied" x-cloak class="fas fa-check" aria-hidden="true"></i>
                <span x-text="copied ? 'Copied!' : 'Copy'">Copy</span>
                </c-buttons.secondary>
                <c-buttons.ghost size="sm" class="flex-shrink-0" href="{{ public_url }}" target="_blank" rel="noopener noreferrer" title="Open Trust Center" aria-label="Open Trust Center (opens in new tab)">
                <i class="fas fa-external-link-alt" aria-hidden="true"></i>
                </c-buttons.ghost>
            </div>
        </div>
    {% endif %}
    {% if not can_administer %}
        <c-feedback.alert variant="info" class="mt-4">
        Only workspace owners and admins can change Trust Center visibility.
        </c-feedback.alert>
    {% elif not can_set_private %}
        <c-feedback.alert variant="info" icon="fas fa-crown" class="mt-4">
        Disabling the Trust Center is available on Business or Enterprise plans.
        </c-feedback.alert>
    {% endif %}
    {# Trust Center address #}
    {% if team.is_public and trust_center_domain %}
        <section class="mt-8 pt-8 border-t border-border">
            <h3 class="text-sm font-semibold text-text m-0">Address</h3>
            <p class="text-sm text-text-muted mt-1 m-0">The subdomain your Trust Center lives at.</p>
            <form method="post"
                  action="{% url 'teams:team_settings' team.key %}"
                  class="mt-4"
                  x-data="{ slug: '{{ team_obj.slug|default:'' }}' }">
                {% csrf_token %}
                <input type="hidden" name="slug_action" value="update">
                <input type="hidden" name="active_tab" value="trust-center">
                <div>
                    <c-forms.label for="slug">Subdomain slug</c-forms.label>
                    <c-forms.input id="slug" name="slug" value="{{ team_obj.slug|default:'' }}" maxlength="63" minlength="3" pattern="[a-z0-9]([a-z0-9-]*[a-z0-9])?" placeholder="my-company" disabled="{{ can_administer|yesno:',1' }}" x-model="slug" />
                    <c-forms.hint class="mt-2">
                    Your Trust Center will be available at:
                    <code class="text-primary"
                          x-text="slug ? (slug + '.{{ trust_center_domain }}') : '...'"></code>
                    </c-forms.hint>
                    <c-forms.hint>Lowercase letters, numbers, and hyphens only. Must not start or end with a hyphen. 3 to 63 characters.</c-forms.hint>
                </div>
                <div class="flex justify-end mt-4">
                    <c-buttons.primary type="submit" size="sm" disabled="{{ can_administer|yesno:',1' }}">
                    <i class="fas fa-save mr-2"></i>Save slug
                    </c-buttons.primary>
                </div>
            </form>
        </section>
    {% endif %}
    {# TEA - uses team_obj (Django model) for tea_enabled since team is a Pydantic schema #}
    {% if team.is_public %}
        <section class="mt-8 pt-8 border-t border-border">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h3 class="text-sm font-semibold text-text m-0 flex items-center gap-2">
                    Transparency Exchange API (TEA)
                    <c-badges.info size="sm">
                    <i class="fas fa-flask mr-1"></i>Beta
                    </c-badges.info>
                </h3>
                <div class="flex items-center gap-3">
                    {% if team_obj.tea_enabled %}
                        <c-badges.success>Enabled</c-badges.success>
                    {% else %}
                        <c-badges.secondary>Disabled</c-badges.secondary>
                    {% endif %}
                    <form method="post"
                          action="{% url 'teams:team_settings' team.key %}"
                          class="flex-shrink-0">
                        {% csrf_token %}
                        <input type="hidden" name="tea_action" value="update">
                        <input type="hidden" name="tea_enabled" value="false">
                        <input type="hidden" name="active_tab" value="trust-center">
                        <c-forms.toggle id="tea-toggle" name="tea_enabled" value="true" aria-label="Enable Transparency Exchange API" checked="{{ team_obj.tea_enabled|yesno:'1,' }}" disabled="{{ can_administer|yesno:',1' }}" onchange="this.form.submit()" />
                        <button type="submit" class="sr-only">Save TEA setting</button>
                    </form>
                </div>
            </div>
            <p class="text-sm text-text-muted mt-2 m-0">
                Standardized access to your software transparency information via a well-known discovery endpoint and REST API.
                <a href="https://github.com/CycloneDX/transparency-exchange-api"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="text-primary hover:underline">Learn more</a>
            </p>
            {% if team_obj.tea_enabled and team_obj.custom_domain and team_obj.custom_domain_validated %}
                <div class="mt-4 p-4 bg-background/50 rounded-xl border border-border"
                     x-data="{ copied: false }">
                    <label class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2 block">TEA Discovery Endpoint</label>
                    <div class="flex items-center gap-2">
                        <code class="flex-1 min-w-0 px-3 py-2 bg-background border border-border rounded-lg text-sm text-text font-mono truncate">https://{{ team_obj.custom_domain }}/.well-known/tea</code>
                        <c-buttons.secondary size="sm" class="flex-shrink-0" title="Copy TEA discovery URL" aria-label="Copy TEA discovery URL" @click="navigator.clipboard.writeText('https://{{ team_obj.custom_domain }}/.well-known/tea'); copied = true; setTimeout(() => copied = false, 2000)">
                        <i x-show="!copied" class="fas fa-copy" aria-hidden="true"></i>
                        <i x-show="copied" x-cloak class="fas fa-check" aria-hidden="true"></i>
                        <span x-text="copied ? 'Copied!' : 'Copy'">Copy</span>
                        </c-buttons.secondary>
                    </div>
                </div>
            {% elif team_obj.tea_enabled and trust_center_domain and team_obj.slug %}
                <div class="mt-4 p-4 bg-background/50 rounded-xl border border-border"
                     x-data="{ copied: false }">
                    <label class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2 block">TEA Discovery Endpoint</label>
                    <div class="flex items-center gap-2">
                        <code class="flex-1 min-w-0 px-3 py-2 bg-background border border-border rounded-lg text-sm text-text font-mono truncate">https://{{ team_obj.slug }}.{{ trust_center_domain }}/.well-known/tea</code>
                        <c-buttons.secondary size="sm" class="flex-shrink-0" title="Copy TEA discovery URL" aria-label="Copy TEA discovery URL" @click="navigator.clipboard.writeText('https://{{ team_obj.slug }}.{{ trust_center_domain }}/.well-known/tea'); copied = true; setTimeout(() => copied = false, 2000)">
                        <i x-show="!copied" class="fas fa-copy" aria-hidden="true"></i>
                        <i x-show="copied" x-cloak class="fas fa-check" aria-hidden="true"></i>
                        <span x-text="copied ? 'Copied!' : 'Copy'">Copy</span>
                        </c-buttons.secondary>
                    </div>
                </div>
            {% elif team_obj.tea_enabled %}
                <c-feedback.alert variant="info" class="mt-4">
                Configure a custom domain or Trust Center slug to enable TEA discovery via <code>.well-known/tea</code>.
                </c-feedback.alert>
            {% endif %}
            {% if not can_administer %}
                <c-feedback.alert variant="info" class="mt-4">
                Only workspace owners and admins can change TEA settings.
                </c-feedback.alert>
            {% endif %}
        </section>
    {% endif %}
    {# Security.txt (RFC 9116) #}
    {% if team.is_public %}
        <section class="mt-8 pt-8 border-t border-border"
                 x-data="{ securityTxtEnabled: {{ security_txt_config.enabled|default:False|yesno:'true,false' }} }">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h3 class="text-sm font-semibold text-text m-0">
                    Security.txt
                    <span class="text-text-muted font-normal">(RFC 9116)</span>
                </h3>
                <span class="text-xs font-medium"
                      :class="securityTxtEnabled ? 'text-success' : 'text-text-muted'"
                      x-text="securityTxtEnabled ? 'Enabled' : 'Disabled'"></span>
            </div>
            <p class="text-sm text-text-muted mt-1 m-0">
                Help security researchers report vulnerabilities via a standard contact file.
            </p>
            <form method="post"
                  action="{% url 'teams:team_settings' team.key %}"
                  class="mt-4">
                {% csrf_token %}
                <input type="hidden" name="security_txt_action" value="update">
                <input type="hidden" name="active_tab" value="trust-center">
                <input type="hidden" name="security_txt_enabled" value="false">
                {# Enable toggle #}
                <div class="flex items-center justify-between gap-4 mb-6">
                    <div>
                        <p class="text-text font-medium m-0">Enable security.txt</p>
                        <p class="text-text-muted text-sm m-0">
                            Served at <code class="text-xs">/.well-known/security.txt</code> on your Trust Center domain and any validated custom domains
                        </p>
                    </div>
                    <c-forms.toggle id="security-txt-toggle" name="security_txt_enabled" value="true" aria-label="Enable security.txt" checked="{{ security_txt_config.enabled|yesno:'1,' }}" disabled="{{ can_administer|yesno:',1' }}" x-model="securityTxtEnabled" />
                </div>
                {# Configuration fields — shown when enabled #}
                <div x-show="securityTxtEnabled" x-cloak>
                    {# Required: Contact #}
                    <div class="mb-6 pb-6 border-b border-border/50">
                        <h4 class="text-xs font-semibold text-text uppercase tracking-wider mb-3">
                            <i class="fas fa-envelope text-primary mr-2"></i>Contact (required)
                        </h4>
                        <div>
                            <c-forms.label for="security_txt_contact_id">Contact for vulnerability reports</c-forms.label>
                            <c-forms.select id="security_txt_contact_id" name="security_txt_contact_id" disabled="{{ can_administer|yesno:',1' }}">
                            <option value="">Auto-detect (security contact from default profile)</option>
                            {% for contact in security_txt_contacts %}
                                <option value="{{ contact.id }}"
                                        {% if security_txt_config.contact_id == contact.id %}selected{% endif %}>
                                    {{ contact.name }} ({{ contact.email }}), {{ contact.entity__profile__name }}
                                </option>
                            {% endfor %}
                            </c-forms.select>
                            <c-forms.hint class="mt-1">
                            Choose who receives vulnerability reports.
                            Manage contacts in
                            <a href="{% url 'teams:team_settings' team.key %}#contact-profiles"
                               class="text-primary hover:underline">Contact Profiles</a>.
                            </c-forms.hint>
                        </div>
                    </div>
                    {# Optional: Links #}
                    <div class="mb-6 pb-6 border-b border-border/50">
                        <h4 class="text-xs font-semibold text-text uppercase tracking-wider mb-3">
                            <i class="fas fa-link text-primary mr-2"></i>Links (optional)
                        </h4>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <c-forms.label for="security_txt_policy_url">Policy URL</c-forms.label>
                                <c-forms.input type="url" id="security_txt_policy_url" name="security_txt_policy_url" value="{{ security_txt_config.policy_url|default:'' }}" placeholder="https://example.com/security-policy" disabled="{{ can_administer|yesno:',1' }}" />
                                <c-forms.hint class="mt-1">Vulnerability disclosure policy</c-forms.hint>
                            </div>
                            {{ security_txt_config.encryption_urls|json_script:"encryption-urls-data" }}
                            <div x-data="{ urls: (() => { let d = JSON.parse(document.getElementById('encryption-urls-data')?.textContent || '[]'); return Array.isArray(d) ? d : []; })() }">
                                <c-forms.label>Encryption Key URLs</c-forms.label>
                                <template x-for="(url, index) in urls" :key="index">
                                    <div class="flex gap-2 mb-2">
                                        <c-forms.input type="url" class="flex-1" ::name="'security_txt_encryption_url_' + index" x-model="urls[index]" placeholder="https://example.com/pgp-key.txt" disabled="{{ can_administer|yesno:',1' }}" />
                                        <c-buttons.ghost-danger size="sm" @click="urls.splice(index, 1)" disabled="{{ can_administer|yesno:',1' }}" aria-label="Remove encryption key URL">
                                        <i class="fas fa-times"></i>
                                        </c-buttons.ghost-danger>
                                    </div>
                                </template>
                                <button type="button"
                                        @click="urls.push('')"
                                        class="text-xs text-primary hover:underline"
                                        {% if not can_administer %}disabled{% endif %}>
                                    <i class="fas fa-plus mr-1"></i>Add encryption key URL
                                </button>
                                <input type="hidden"
                                       name="security_txt_encryption_urls"
                                       :value="JSON.stringify(urls)">
                                <c-forms.hint class="mt-1">PGP public keys for encrypted reports (multiple allowed per RFC 9116)</c-forms.hint>
                            </div>
                            <div>
                                <c-forms.label for="security_txt_acknowledgments_url">Acknowledgments URL</c-forms.label>
                                <c-forms.input type="url" id="security_txt_acknowledgments_url" name="security_txt_acknowledgments_url" value="{{ security_txt_config.acknowledgments_url|default:'' }}" placeholder="https://example.com/hall-of-fame" disabled="{{ can_administer|yesno:',1' }}" />
                                <c-forms.hint class="mt-1">Security researcher acknowledgments</c-forms.hint>
                            </div>
                            <div>
                                <c-forms.label for="security_txt_hiring_url">Hiring URL</c-forms.label>
                                <c-forms.input type="url" id="security_txt_hiring_url" name="security_txt_hiring_url" value="{{ security_txt_config.hiring_url|default:'' }}" placeholder="https://example.com/security-jobs" disabled="{{ can_administer|yesno:',1' }}" />
                                <c-forms.hint class="mt-1">Security-related job openings</c-forms.hint>
                            </div>
                        </div>
                    </div>
                    {# Optional: Additional settings #}
                    <div class="mb-6">
                        <h4 class="text-xs font-semibold text-text uppercase tracking-wider mb-3">
                            <i class="fas fa-cog text-primary mr-2"></i>Additional settings
                        </h4>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="relative"
                                 x-data="{ open: false, selected: '{{ security_txt_config.preferred_languages|default:'en' }}'.split(',').map(s => s.trim()).filter(Boolean), languages: [ {code: 'en', name: 'English'}, {code: 'de', name: 'German'}, {code: 'fr', name: 'French'}, {code: 'es', name: 'Spanish'}, {code: 'pt', name: 'Portuguese'}, {code: 'it', name: 'Italian'}, {code: 'nl', name: 'Dutch'}, {code: 'ja', name: 'Japanese'}, {code: 'ko', name: 'Korean'}, {code: 'zh', name: 'Chinese'}, {code: 'ar', name: 'Arabic'}, {code: 'ru', name: 'Russian'}, {code: 'pl', name: 'Polish'}, {code: 'sv', name: 'Swedish'}, {code: 'da', name: 'Danish'}, {code: 'no', name: 'Norwegian'}, {code: 'fi', name: 'Finnish'}, {code: 'tr', name: 'Turkish'}, {code: 'hi', name: 'Hindi'}, {code: 'he', name: 'Hebrew'}, ], toggle(code) { this.selected.includes(code) ? this.selected = this.selected.filter(c => c !== code) : this.selected.push(code); } }"
                                 @click.outside="open = false">
                                <c-forms.label>Preferred Languages</c-forms.label>
                                <button type="button"
                                        @click="open = !open"
                                        class="w-full px-4 py-3 bg-surface border-[1.5px] border-solid border-border rounded-lg text-sm text-left flex items-center justify-between focus:outline-none focus:border-primary"
                                        {% if not can_administer %}disabled{% endif %}>
                                    <span x-text="selected.length ? selected.join(', ') : 'Select languages'"
                                          class="truncate"
                                          :class="{ 'text-text-muted': !selected.length }"></span>
                                    <i class="fas fa-chevron-down text-text-muted text-xs transition-transform"
                                       :class="{ 'rotate-180': open }"></i>
                                </button>
                                <div x-show="open"
                                     x-cloak
                                     x-transition
                                     class="absolute z-10 mt-1 w-full max-h-48 overflow-y-auto rounded-lg border border-border bg-surface shadow-lg p-1">
                                    <template x-for="lang in languages" :key="lang.code">
                                        <label class="flex items-center gap-2 px-3 py-1.5 rounded hover:bg-primary/5 cursor-pointer text-sm">
                                            <input type="checkbox"
                                                   :checked="selected.includes(lang.code)"
                                                   @change="toggle(lang.code)"
                                                   class="rounded border-border text-primary focus:ring-primary">
                                            <span x-text="lang.name" class="text-text"></span>
                                            <span x-text="lang.code" class="text-text-muted text-xs ml-auto"></span>
                                        </label>
                                    </template>
                                </div>
                                <input type="hidden"
                                       name="security_txt_preferred_languages"
                                       :value="selected.join(', ')">
                                <c-forms.hint class="mt-1">English is selected by default</c-forms.hint>
                            </div>
                            <div>
                                <c-forms.label>Canonical URL</c-forms.label>
                                <div class="px-4 py-3 bg-background border-[1.5px] border-solid border-border rounded-lg text-sm text-text-muted truncate">
                                    {% if trust_center_url %}
                                        {{ trust_center_url }}/.well-known/security.txt
                                    {% else %}
                                        Auto-set when Trust Center URL is configured
                                    {% endif %}
                                </div>
                                <input type="hidden"
                                       name="security_txt_canonical_url"
                                       value="{% if trust_center_url %}{{ trust_center_url }}/.well-known/security.txt{% endif %}">
                                <c-forms.hint class="mt-1">Automatically set to your Trust Center's security.txt URL</c-forms.hint>
                            </div>
                        </div>
                    </div>
                    {# Info about Expires #}
                    <c-feedback.alert variant="info" class="mb-4">
                    The <strong>Expires</strong> field is automatically set to one year from now and refreshed each time you save.
                    </c-feedback.alert>
                </div>
                {# Save button + owner gate #}
                <div class="flex items-center justify-end mt-4 gap-4">
                    {% if not can_administer %}
                        <p class="text-text-muted text-sm m-0 mr-auto">
                            <i class="fas fa-lock mr-1"></i>Only workspace owners and admins can change these settings.
                        </p>
                    {% endif %}
                    <c-buttons.primary type="submit" size="sm" disabled="{{ can_administer|yesno:',1' }}">
                    <i class="fas fa-save mr-2"></i>Save
                    </c-buttons.primary>
                </div>
            </form>
        </section>
    {% endif %}
    {# Trust Center description #}
    {% if team.is_public %}
        <section class="mt-8 pt-8 border-t border-border">
            <h3 class="text-sm font-semibold text-text m-0">Description</h3>
            <p class="text-sm text-text-muted mt-1 m-0">The message at the top of your Trust Center landing page.</p>
            <form method="post"
                  action="{% url 'teams:team_settings' team.key %}"
                  class="mt-4">
                {% csrf_token %}
                <input type="hidden" name="trust_center_description_action" value="update">
                <input type="hidden" name="active_tab" value="trust-center">
                <div>
                    <c-forms.label for="trust_center_description">Description</c-forms.label>
                    <c-forms.textarea id="trust_center_description" name="trust_center_description" rows="4" maxlength="500" placeholder="Your centralized hub for transparency and compliance. Browse our public products, releases, and organization-wide security artifacts." disabled="{{ can_administer|yesno:',1' }}" value="{{ branding_info.trust_center_description|default:'' }}" />
                    <c-forms.hint>Max 500 characters. Leave empty to use the default description.</c-forms.hint>
                </div>
                <div class="flex justify-end mt-4">
                    <c-buttons.primary type="submit" size="sm" disabled="{{ can_administer|yesno:',1' }}">
                    <i class="fas fa-save mr-2"></i>Save description
                    </c-buttons.primary>
                </div>
            </form>
        </section>
    {% endif %}
    {# Company NDA #}
    {% if team.is_public %}
        <section class="mt-8 pt-8 border-t border-border">
            <h3 class="text-sm font-semibold text-text m-0">Company NDA</h3>
            <p class="text-sm text-text-muted mt-1 m-0">The non-disclosure agreement gating restricted content.</p>
            {# Preparation guidance — the signing flow is click-wrap, and a document drafted for wet signatures reads broken inside it #}
            <div class="mt-4 border border-border rounded-xl"
                 x-data="{ guideOpen: false }">
                <button type="button"
                        class="w-full flex items-center justify-between gap-3 px-4 py-3 text-sm text-text-muted hover:text-text transition-colors"
                        @click="guideOpen = !guideOpen"
                        :aria-expanded="guideOpen">
                    <span class="flex items-center gap-2 font-medium">
                        <i class="fas fa-circle-question" aria-hidden="true"></i>
                        How to prepare your NDA
                    </span>
                    <i class="fas fa-chevron-down transition-transform"
                       :class="guideOpen ? 'rotate-180' : ''"
                       aria-hidden="true"></i>
                </button>
                <div x-show="guideOpen"
                     x-cloak
                     x-collapse
                     class="px-4 pb-4 text-sm text-text-muted space-y-3">
                    <p class="m-0">
                        Nobody signs the PDF itself. A requester reads it in the browser, types their
                        full name, and confirms acceptance. sbomify then records their name, the time,
                        their IP address, and a cryptographic fingerprint of the exact document version
                        they accepted. Draft the document for that process:
                    </p>
                    <ul class="m-0 pl-5 space-y-1.5 list-disc">
                        <li>
                            Write it as a one-way agreement: obligations on the recipient, covering
                            "information made available through this Trust Center".
                        </li>
                        <li>Replace the signature block with an electronic-execution clause, for example:</li>
                    </ul>
                    <blockquote class="m-0 ml-5 pl-3 border-l-2 border-border italic">
                        This Agreement is executed electronically. By typing your name and confirming
                        acceptance, you agree to be bound by it; your typed name, the date and time,
                        your IP address, and a fingerprint of this document version are recorded
                        together and constitute your signature. You represent that you are authorized
                        to enter into this Agreement on behalf of the organization for which you are
                        requesting access.
                    </blockquote>
                    <ul class="m-0 pl-5 space-y-1.5 list-disc">
                        <li>Leave no blank name, date, or signature lines: they stay empty forever.</li>
                        <li>
                            If your company should appear as a signatory, put its name, title, and date
                            (or a scanned signature) in the PDF before uploading, so every acceptance is
                            against an already-countersigned document.
                        </li>
                        <li>
                            Finalize the wording first: uploading a replacement version invalidates every
                            existing signature and all requesters sign again.
                        </li>
                    </ul>
                </div>
            </div>
            {% if company_nda_document %}
                {# Current NDA Display #}
                <div class="mt-4 p-4 bg-success/5 border border-success/20 rounded-xl">
                    <div class="flex items-start gap-4">
                        <c-chips.icon-chip size="lg" accent="success">
                        <i class="fas fa-file-pdf text-xl" aria-hidden="true"></i>
                        </c-chips.icon-chip>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1">
                                <h6 class="font-medium text-text m-0 truncate">{{ company_nda_document.name }}</h6>
                                {% if company_nda_document.version %}
                                    <c-badges.success size="sm">v{{ company_nda_document.version }}</c-badges.success>
                                {% endif %}
                            </div>
                            <div class="flex items-center gap-3 text-sm text-text-muted">
                                <span class="flex items-center gap-1">
                                    <i class="fas fa-calendar-alt text-xs"></i>
                                    {% include 'core/components/relative_time.html.j2' with timestamp=company_nda_document.created_at %}
                                </span>
                                {% if company_nda_document.file_size %}
                                    <span class="flex items-center gap-1">
                                        <i class="fas fa-weight text-xs"></i>
                                        {{ company_nda_document.file_size|filesizeformat }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                        <c-buttons.secondary size="sm" href="{% url 'documents:document_download' company_nda_document.id %}" target="_blank" rel="noopener noreferrer">
                        <i class="fas fa-eye mr-1"></i>View
                        </c-buttons.secondary>
                    </div>
                </div>
            {% endif %}
            {# Upload Form #}
            <form method="post"
                  action="{% url 'teams:team_settings' team.key %}"
                  enctype="multipart/form-data"
                  class="mt-4"
                  x-data="{ fileName: '' }">
                {% csrf_token %}
                <input type="hidden" name="company_nda_action" value="upload">
                <input type="hidden" name="active_tab" value="trust-center">
                <label for="company_nda_file"
                       class="relative block mb-4 border-2 border-dashed border-border rounded-xl p-8 text-center cursor-pointer transition-colors hover:border-primary/50 {% if not can_administer %}opacity-50 pointer-events-none{% endif %}">
                    <input type="file"
                           id="company_nda_file"
                           name="company_nda_file"
                           class="sr-only"
                           accept=".pdf"
                           {% if not can_administer %}disabled{% endif %}
                           required
                           @change="fileName = $event.target.files[0] ? $event.target.files[0].name : ''">
                    <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-primary/10 flex items-center justify-center">
                        <i class="fas fa-cloud-upload-alt text-xl text-primary"></i>
                    </div>
                    <p class="text-sm text-text m-0">
                        <template x-if="fileName">
                            <span class="text-success font-medium" x-text="fileName"></span>
                        </template>
                        <template x-if="!fileName">
                            <span><span class="text-primary font-medium">Click to upload</span> or drag and drop</span>
                        </template>
                    </p>
                    <p class="text-xs text-text-muted mt-1 m-0">PDF files only. Max 50MB.</p>
                </label>
                <div class="flex justify-end">
                    <c-buttons.primary type="submit" size="sm" disabled="{{ can_administer|yesno:',1' }}">
                    <i class="fas fa-upload mr-2"></i>
                    {% if company_nda_document %}
                        Upload new version
                    {% else %}
                        Upload NDA
                    {% endif %}
                    </c-buttons.primary>
                </div>
            </form>
        </section>
    {% endif %}
    {# Access requests #}
    {% if team.is_public %}
        <section class="mt-8 pt-8 border-t border-border">
            <div id="access-requests-wrapper"
                 x-data
                 hx-get="{% url 'documents:access_request_queue' team.key %}?partial=true"
                 hx-trigger="load, refreshAccessRequests from:body"
                 hx-swap="innerHTML"
                 @ws:message.window="if ($event.detail.type === 'access_request_updated') { document.body.dispatchEvent(new CustomEvent('refreshAccessRequests')); }">
                <div class="space-y-3">
                    <div class="h-5 w-40 bg-border/50 rounded animate-pulse"></div>
                    <div class="h-4 w-56 bg-border/30 rounded animate-pulse"></div>
                    <div class="flex items-center justify-center py-8">
                        {% include "core/components/brand/loader.html.j2" with class="tw-loader-md mx-auto text-primary" %}
                        <span class="ml-3 text-text-muted">Loading access requests...</span>
                    </div>
                </div>
            </div>
        </section>
    {% endif %}
    {# Custom domain #}
    {% if team.is_public %}
        <section class="mt-8 pt-8 border-t border-border">
            <div id="team-custom-domain-wrapper"
                 hx-get="{% url 'teams:team_custom_domain' team.key %}"
                 hx-trigger="load, refreshTeamCustomDomain from:body"
                 hx-swap="innerHTML">
                <div class="space-y-3">
                    <div class="h-5 w-36 bg-border/50 rounded animate-pulse"></div>
                    <div class="h-4 w-52 bg-border/30 rounded animate-pulse"></div>
                    <div class="flex items-center justify-center py-8">
                        {% include "core/components/brand/loader.html.j2" with class="tw-loader-md mx-auto text-primary" %}
                        <span class="ml-3 text-text-muted">Loading custom domain settings...</span>
                    </div>
                </div>
            </div>
        </section>
    {% else %}
        <section class="mt-8 pt-8 border-t border-border">
            <h3 class="text-sm font-semibold text-text m-0">Custom domain</h3>
            <p class="text-sm text-text-muted mt-1 m-0">Use your own domain for the Trust Center.</p>
            <div class="mt-4">
                <c-feedback.empty-state icon="fas fa-lock" icon_variant="neutral" title="Trust Center required" message="Enable your Trust Center above to configure a custom domain." />
            </div>
        </section>
    {% endif %}
</div>
