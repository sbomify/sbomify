{% load form_helpers %}
<div class="flex flex-col gap-5"
     x-data="{ showCreateToken: false }"
     hx-history="false">
    <c-layout.section-header level="2" title="API tokens" subtitle="Your personal tokens for this workspace. Other members cannot see or manage them.">
    <c-slot name="actions"><c-buttons.primary size="sm" @click="showCreateToken = true">Generate token</c-buttons.primary></c-slot>
    </c-layout.section-header>
    {% if has_unscoped_tokens %}
        <c-feedback.alert variant="warning" title="Unscoped tokens detected">
        These tokens reach every workspace you belong to. They stay valid until you rotate them, with no forced cutover or auto-expiry. Create a workspace-scoped replacement before revoking them.
        </c-feedback.alert>
    {% endif %}
    {% if new_encoded_access_token %}
        <c-feedback.alert variant="warning" title="Copy your token now">You cannot see this token again.</c-feedback.alert>
        <c-token-display token="{{ new_encoded_access_token }}" masked />
    {% endif %}
    <c-cards.card flush>
    <c-cards.header compact title="Your tokens" />
    {% if access_tokens or unscoped_tokens %}
        <div x-data="window.getBulkRevokeData({ url: '{% url 'teams:team_tokens' team.key %}', csrfToken: '{{ csrf_token }}', refreshEvent: 'refreshTeamTokens' })">
            <c-tables.toolbar>
            <c-forms.checkbox @change="toggleAll($event.target.checked, [
            {% for t in access_tokens %}{{ t.id }},{% endfor %}
            {% for t in unscoped_tokens %}{{ t.id }},{% endfor %}
            ])">Select all</c-forms.checkbox>
            <div class="flex flex-wrap items-center gap-2">
                <c-buttons.danger size="sm" x-show="selected.length" x-cloak @click="showBulkModal = true"><span x-text="`Revoke selected (${selected.length})`">Revoke selected</span></c-buttons.danger>
                <c-buttons.ghost-danger size="sm" @click="showRevokeAllModal = true">Revoke all</c-buttons.ghost-danger>
            </div>
            </c-tables.toolbar>
            <c-tables.table>
            <c-tables.head>
            <c-tables.header-cell compact><span class="sr-only">Select</span></c-tables.header-cell>
            <c-tables.header-cell compact>Name</c-tables.header-cell>
            <c-tables.header-cell compact>Created</c-tables.header-cell>
            <c-tables.header-cell compact>Last used</c-tables.header-cell>
            <c-tables.header-cell compact>Expires</c-tables.header-cell>
            <c-tables.actions-cell as="th" />
            </c-tables.head>
            <tbody>
                {% for token in access_tokens %}
                    {% include 'teams/components/token_row.html.j2' with unscoped=False %}
                {% endfor %}
                {% for token in unscoped_tokens %}
                    {% include 'teams/components/token_row.html.j2' with unscoped=True %}
                {% endfor %}
            </tbody>
            </c-tables.table>
            {% include 'components/delete_confirmation_modal.html.j2' with modal_id='showBulkModal' title='Revoke tokens' message='Are you sure you want to revoke' item_name_expression='countLabel' warning_message='This action cannot be undone. The selected tokens will stop working immediately.' confirm_text='Revoke' confirm_callback='revokeSelected()' %}
            {% include 'components/delete_confirmation_modal.html.j2' with modal_id='showRevokeAllModal' title='Revoke all tokens' message='Are you sure you want to revoke' item_name='all tokens in this workspace' warning_message='This action cannot be undone. Every token listed here, including unscoped legacy tokens, will stop working immediately.' confirm_text='Revoke all' confirm_callback='revokeAll()' %}
        </div>
    {% else %}
        <c-feedback.empty-state compact icon="fas fa-key" title="No tokens yet" message="Generate a token to connect your tools to this workspace." />
    {% endif %}
    </c-cards.card>
    <c-feedback.alert variant="info" title="Keep tokens private">Use a narrow scope and short expiry. Treat tokens like passwords and never commit them to version control.</c-feedback.alert>
    <c-modal teleport="false" id="createTokenModal" show="showCreateToken" title="Generate token" size="lg">
    <form method="post"
          id="tokenGenerationForm"
          x-data="{ expiryChoice: '{{ create_access_token_form.expires_in_hours.value|default:"2160"|escapejs }}' }"
          hx-post="{% url 'teams:team_tokens' team.key %}"
          hx-target="#team-tokens-content"
          hx-disabled-elt="#generate-token-button"
          hx-swap="innerHTML settle:0"
          class="space-y-4">
        {% csrf_token %}
        {% with field=create_access_token_form.description %}
            <c-forms.field label="Token name" for="{{ field.id_for_label }}" error="{{ field.errors|join:', ' }}">
            <c-forms.input size="sm" id="{{ field.id_for_label }}" name="{{ field.html_name }}" value="{{ field.value|default_if_none:'' }}" required maxlength="255" />
            </c-forms.field>
        {% endwith %}
        {% with field=create_access_token_form.scope %}
            <c-forms.field label="Access scope" for="{{ field.id_for_label }}" error="{{ field.errors|join:', ' }}">
            <c-forms.select size="sm" id="{{ field.id_for_label }}" name="{{ field.html_name }}">
            {% for value, label in field.field.choices %}
                <option value="{{ value }}"
                        {% if field.value|stringformat:"s" == value|stringformat:"s" %}selected{% endif %}>
                    {{ label }}
                </option>
            {% endfor %}
            </c-forms.select>
            </c-forms.field>
        {% endwith %}
        {% with field=create_access_token_form.expires_in_hours %}
            <c-forms.field label="Expiration" for="{{ field.id_for_label }}" error="{{ field.errors|join:', ' }}">
            <c-forms.select size="sm" id="{{ field.id_for_label }}" name="{{ field.html_name }}" x-model="expiryChoice">
            {% for value, label in field.field.choices %}
                <option value="{{ value }}"
                        {% if field.value|stringformat:"s" == value|stringformat:"s" %}selected{% endif %}>
                    {{ label }}
                </option>
            {% endfor %}
            </c-forms.select>
            </c-forms.field>
        {% endwith %}
        {% with field=create_access_token_form.custom_expiry_value %}
            <c-forms.field label="Expires after" for="{{ field.id_for_label }}" error="{{ field.errors|join:', ' }}" x-show="expiryChoice === 'custom'" x-cloak>
            <c-forms.input size="sm" id="{{ field.id_for_label }}" name="{{ field.html_name }}" value="{{ field.value|default_if_none:'' }}" type="number" min="1" />
            </c-forms.field>
        {% endwith %}
        {% with field=create_access_token_form.custom_expiry_unit %}
            <c-forms.field label="Unit" for="{{ field.id_for_label }}" error="{{ field.errors|join:', ' }}" x-show="expiryChoice === 'custom'" x-cloak>
            <c-forms.select size="sm" id="{{ field.id_for_label }}" name="{{ field.html_name }}">
            {% for value, label in field.field.choices %}
                <option value="{{ value }}"
                        {% if field.value|stringformat:"s" == value|stringformat:"s" %}selected{% endif %}>
                    {{ label }}
                </option>
            {% endfor %}
            </c-forms.select>
            </c-forms.field>
        {% endwith %}
    </form>
    <c-slot name="footer">
    <c-buttons.secondary size="sm" @click="showCreateToken = false">Cancel</c-buttons.secondary>
    <c-buttons.primary size="sm" type="submit" form="tokenGenerationForm" id="generate-token-button">Generate token</c-buttons.primary>
    </c-slot>
    </c-modal>
</div>
