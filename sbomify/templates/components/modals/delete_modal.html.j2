{% load widget_tweaks %}
{% comment %}
    The destructive confirmation, opened by an `open-<modal_id>` window event
    carrying the name to show and the fields to post. The wrapper keeps the id
    and the state; the dialog itself is c-modal.

    It keeps its own centred body rather than the dialog's title band: the
    medallion, the sentence and the warning read as one block, and the close
    control sits over them, pinned to the viewport as it always has been.

    The actions end on the right, where the dialog's own footer band puts them
    and where they already rendered: the legacy footer's justify-center never
    reached the band, whose class set the alignment and outranked it.
{% endcomment %}
{# djlint:off #}
<div id="{{ modal_id }}"
     x-data="{ open: false, displayName: '', formData: {}, init() { this.$watch('open', (value) => { if (!value) { this.displayName = ''; this.formData = {}; } }); }, openModal(event) { this.open = true; if (event.detail) { this.displayName = event.detail.displayName || ''; this.formData = event.detail.formData || {}; } }, close() { this.open = false; } }"
     @open-{{ modal_id }}.window="openModal($event)">
{# djlint:on #}
<c-modal show="open" close="close()" size="sm" role="alertdialog" aria-labelledby="{{ modal_id }}-label">
<div class="text-center">
    <c-buttons.icon label="Close" class="absolute top-4 right-4" @click="close()">
    <i class="fas fa-times"></i>
    </c-buttons.icon>
    <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-danger/10 flex items-center justify-center">
        <i class="fas fa-exclamation-triangle text-danger text-xl"></i>
    </div>
    <h4 id="{{ modal_id }}-label"
        class="text-lg font-semibold text-text tracking-[-0.01em] mb-2">{{ modal_title }}</h4>
    <p class="text-sm text-text mb-2">
        {{ message_text }} <span class="font-semibold text-danger" x-text="displayName"></span>?
    </p>
    <p class="text-xs text-text-muted">
        {{ warning_text|default:"This action cannot be undone and will permanently remove the item from the system." }}
    </p>
</div>
<c-slot name="footer">
<c-buttons.ghost @click="close()">Cancel</c-buttons.ghost>
{# djlint:off #}
    <form id="{{ modal_id }}-form"
          class="inline"
          {% if use_htmx %}hx-post="{{ form_action }}"{% if hx_target %} hx-target="{{ hx_target }}"{% endif %}
          {% if hx_swap %} hx-swap="{{ hx_swap }}"{% else %} hx-swap="none"{% endif %}
          @htmx:after-request="if($event.detail.successful) close()"
          {% else %}
          method="post"
          action="{{ form_action }}"
          {% endif %}>
{# djlint:on #}
{% csrf_token %}
<input type="hidden" name="_method" value="DELETE">
<template x-if="Object.keys(formData).length === 0">
    <div>
        {% for field in form %}{{ field }}{% endfor %}
    </div>
</template>
{% if additional_fields %}{{ additional_fields|safe }}{% endif %}
    <template x-for="(value, key) in formData" :key="key">
        <input type="hidden" :name="key" :value="value">
    </template>
    <c-buttons.danger type="submit">
    <i class="fas fa-trash mr-2"></i>
    {{ submit_text }}
    </c-buttons.danger>
</form>
</c-slot>
</c-modal>
</div>
