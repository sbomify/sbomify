{% load widget_tweaks %}
{% comment %}
    A dialog holding one Django form, opened by an `open-<modal_id>` window
    event. The wrapper keeps the id and the open state; the dialog itself is
    c-modal, which owns the panel, the title band and the ways out.

    The form sits in the body and the submit control names it through its form
    attribute, the pattern every migrated dialog uses: c-modal renders the body
    and the footer as siblings, so a form cannot wrap both.

    The controls are Django's own widgets, so they keep the legacy tw-form-*
    class: a class name is all add_class can attach, and c-forms.input paints an
    element this partial never gets to write. The label is the library's.
{% endcomment %}
{# djlint:off #}
<div id="{{ modal_id }}"
     x-data="{ open: false, close() { this.open = false; } }"
     @open-{{ modal_id }}.window="open = true">
{# djlint:on #}
{% if icon %}
    {% firstof "fas "|add:icon as modal_icon %}
{% endif %}
<c-modal id="{{ modal_id }}-dialog" title="{{ modal_title }}" icon="{{ modal_icon }}" close="close()">
<form id="{{ modal_id }}-form" action="{{ form_action }}" method="post">
    {% csrf_token %}
    <input type="hidden" name="_method" value="POST">
    {% if additional_fields %}{{ additional_fields|safe }}{% endif %}
    {% for field in form %}
        <div class="mb-4">
            <c-forms.label for="{{ field.id_for_label }}" :required="field.field.required">{{ field.label }}</c-forms.label>
            {{ field|add_class:'tw-form-input' }}
            {% if field.errors %}<div class="text-danger text-sm mt-1">{{ field.errors|join:", " }}</div>{% endif %}
            {% if field.help_text %}<div class="text-text-muted text-xs mt-1">{{ field.help_text }}</div>{% endif %}
        </div>
    {% endfor %}
</form>
<c-slot name="footer">
<c-buttons.ghost @click="close()">Cancel</c-buttons.ghost>
<c-buttons.primary type="submit" form="{{ modal_id }}-form">
{% if icon %}<i class="fas {{ icon }} mr-2"></i>{% endif %}
{{ submit_text|default:"Submit" }}
</c-buttons.primary>
</c-slot>
</c-modal>
</div>
{% if autofocus|default:True %}
    <script>
    // Auto-focus first input when modal opens
    document.addEventListener('alpine:initialized', () => {
        const modal = document.getElementById('{{ modal_id }}');
        if (modal && modal.__x) {
            const observer = new MutationObserver(() => {
                const firstInput = modal.querySelector('input[type="text"], input[type="email"], textarea, select');
                if (firstInput && modal.__x.$data.open) {
                    setTimeout(() => firstInput.focus(), 100);
                }
            });
            observer.observe(modal, { attributes: true, subtree: true });
        }
    });
    </script>
{% endif %}
